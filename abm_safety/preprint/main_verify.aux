\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Champion leaderboard, Stage-5 education destination: best BIC/n so far per independent search run. \textbf  {A} is \texttt  {qld\_shard2} (30 generations) and \textbf  {B} is \texttt  {qld\_shard3} (30 generations, an independent rerun of the same slot); \textbf  {C} is \texttt  {qld\_full40} (40 generations plus a 13-generation restart that found no improvement, 53 generations in all). A and B are bit-identical, so one is drawn solid and the other dashed directly on top of it and the pair reads as a single trajectory ending at generation~29; C runs on to generation~52. C dominates from generation~2 and finishes at $1.0498$ against $1.1413$ for A and B, and both levels are reached by generation~2 and then held --- including the new-best events at generations 3 and 13 of C, which occur at unchanged fitness and are the dead-term signature audited in the text. Companion boards cover the remaining slots.\relax }}{34}{figure.caption.78}}
\newlabel{fig:champedu}{{3}{34}{Champion leaderboard, Stage-5 education destination: best BIC/n so far per independent search run. \textbf {A} is \texttt {qld\_shard2} (30 generations) and \textbf {B} is \texttt {qld\_shard3} (30 generations, an independent rerun of the same slot); \textbf {C} is \texttt {qld\_full40} (40 generations plus a 13-generation restart that found no improvement, 53 generations in all). A and B are bit-identical, so one is drawn solid and the other dashed directly on top of it and the pair reads as a single trajectory ending at generation~29; C runs on to generation~52. C dominates from generation~2 and finishes at $1.0498$ against $1.1413$ for A and B, and both levels are reached by generation~2 and then held --- including the new-best events at generations 3 and 13 of C, which occur at unchanged fitness and are the dead-term signature audited in the text. Companion boards cover the remaining slots.\relax }{figure.caption.78}{}}
\newlabel{fig:champedu@cref}{{[figure][3][]3}{[1][33][]34}}
