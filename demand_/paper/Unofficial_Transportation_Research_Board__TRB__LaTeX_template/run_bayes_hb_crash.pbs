#!/bin/bash -l
#PBS -N bayes_hbcrash
#PBS -l walltime=24:00:00
#PBS -l select=1:ncpus=4:mem=64GB
#PBS -j oe
#PBS -r n
# Bayesian compilation of the best HB / crash specs (package-native PyMC).
# Tune via -v BAYES_ARGS="--draws 1000 --tune 1000 --chains 4".

PROJ_DIR=/mnt/hpccs01/home/ahernz/test_runs_tours/demand_/paper/Unofficial_Transportation_Research_Board__TRB__LaTeX_template
module purge
module load Anaconda3/2024.02-1
conda activate zigenv
module unload Anaconda3
pip install --quiet "metacountregressor[bayesian]==1.0.151" 2>&1 | tail -2
python -c "import metacountregressor, pymc; print('mcr', metacountregressor.__version__, '| pymc', pymc.__version__)"
export PYTHONWARNINGS="ignore::RuntimeWarning"
export OMP_NUM_THREADS=4
export XLA_PYTHON_CLIENT_PREALLOCATE=false
export XLA_PYTHON_CLIENT_MEM_FRACTION=0.6
export JAX_PLATFORMS=cpu
cd "$PROJ_DIR"
echo "Job $PBS_JOBID started on $(hostname) at $(date)"
python -u bayes_hb_crash.py --data "$PROJ_DIR/near_miss_hb_ecf.csv" --out-dir "$PROJ_DIR" $BAYES_ARGS 2>&1
EXIT_CODE=$?
for f in "$PROJ_DIR/bayes_hb.tex" "$PROJ_DIR/bayes_hb.csv" "$PROJ_DIR/bayes_crash.tex" "$PROJ_DIR/bayes_crash.csv"; do
  if [ ! -f "$f" ]; then echo "MISSING bayes output: $f"; EXIT_CODE=1; fi
done
echo "Job finished at $(date) exit=$EXIT_CODE"
exit $EXIT_CODE
