\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces \textcolor {Highlight}{Fitted game-day speeding model.} Negative-binomial count stage on the segment$\times $15-minute panel, refitted after structure search (13 fixed terms, one normal random coefficient, one grouped coefficient). The exposure elasticity $\hat  \beta _E=1.097$ against a theoretical value of $1$ is the single most important check on the model: a 1\% increase in exposure raises expected speeding by 0.97\%. Terms marked \emph  {random} and \emph  {grouped} are slopes that vary across segments; their SD terms are scale parameters and carry no direction.}}{4}{table.caption.16}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{tab:gamedaycoef}{{1}{4}{\textcolor {Highlight}{Fitted game-day speeding model.} Negative-binomial count stage on the segment$\times $15-minute panel, refitted after structure search (13 fixed terms, one normal random coefficient, one grouped coefficient). The exposure elasticity $\hat \beta _E=1.097$ against a theoretical value of $1$ is the single most important check on the model: a 1\% increase in exposure raises expected speeding by 0.97\%. Terms marked \emph {random} and \emph {grouped} are slopes that vary across segments; their SD terms are scale parameters and carry no direction}{table.caption.16}{}}
\newlabel{tab:gamedaycoef@cref}{{[table][1][]1}{[1][4][]4}}
