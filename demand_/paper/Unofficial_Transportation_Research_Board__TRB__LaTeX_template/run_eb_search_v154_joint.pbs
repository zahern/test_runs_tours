#!/bin/bash -l
#PBS -N eb_v154_joint
#PBS -l walltime=48:00:00
#PBS -l select=1:ncpus=4:mem=64GB
#PBS -j oe
#PBS -r n
# Joint HB-crash structure search with the 1.0.154 copula menu (rerun for a
# better joint model with additional copulas):
#  1-2. Gumbel x2 seeds (NEW in 1.0.154; upper-tail dependence, motivated by
#         the Gaussian-Joe mixture win) -- the priority runs.
#  3.   Joe x1 seed on 1.0.154 (version-contrast vs the queued 1.0.151
#         eb_search_deep Joe runs; engine changed under fit_model).
# Normal copula deliberately excluded (multivariate_normal.cdf per IFM eval
# is too slow for 60x30 searches); frank/kimeldorf were degenerate on fixed
# margins (+4M dBIC) and add nothing here.
# All write to SCRATCH dirs; winners promoted manually after comparing
# joint BICs across families/seeds/versions.
# Est: ~3-5h per joint run. Total ~9-15h on 4 cpus.

PROJ_DIR=/mnt/hpccs01/home/ahernz/test_runs_tours/demand_/paper/Unofficial_Transportation_Research_Board__TRB__LaTeX_template
SCR1=$PROJ_DIR/eb_v154_joint_gum44
SCR2=$PROJ_DIR/eb_v154_joint_gum45
SCR3=$PROJ_DIR/eb_v154_joint_joe44
module purge
module load Anaconda3/2024.02-1
conda activate zigenv
module unload Anaconda3
# ALWAYS ensure the pinned estimator: flock-serialized so concurrent paper jobs
# don't race pip into the shared env (hardened after jobs 25258209/25271015).
mkdir -p /mnt/hpccs01/home/ahernz/test_runs_tours/code
(
    flock -w 900 9 2>/dev/null || echo "(flock unavailable, proceeding without lock)"
    pip install --quiet --upgrade --retries 5 --timeout 60 metacountregressor 2>&1 | tail -5
) 9>/mnt/hpccs01/home/ahernz/test_runs_tours/code/.pkg_upgrade.lock
# Hard gate (this file has NO `set -e`, so a bare failing assert would NOT stop
# the job -- reads distribution metadata, NOT m.__version__).
python -c "from importlib.metadata import version as _v; v=tuple(map(int, _v('metacountregressor').split('.')[:3])); assert v>=(1,0,165), f\"stale mcr {_v('metacountregressor')} -- aborting\"; print('mcr', _v('metacountregressor'), 'OK')" || exit 1
export PYTHONWARNINGS="ignore::RuntimeWarning"
export OMP_NUM_THREADS=4
export XLA_PYTHON_CLIENT_PREALLOCATE=false
export XLA_PYTHON_CLIENT_MEM_FRACTION=0.6
export JAX_PLATFORMS=cpu
cd "$PROJ_DIR"
mkdir -p "$SCR1" "$SCR2" "$SCR3"
echo "Job $PBS_JOBID started on $(hostname) at $(date)"
EXIT_CODE=0
python -u eb_searched_rp.py --data "$PROJ_DIR/near_miss_hb_ecf.csv" --out-dir "$SCR1" --search joint --load-best --best-dir "$PROJ_DIR" --joint-gen 60 --joint-pop 30 --joint-seed 44 --joint-copula gumbel 2>&1
[ $? -ne 0 ] && { echo "STEP joint-gumbel-s44 FAILED"; EXIT_CODE=1; }
python -u eb_searched_rp.py --data "$PROJ_DIR/near_miss_hb_ecf.csv" --out-dir "$SCR2" --search joint --load-best --best-dir "$PROJ_DIR" --joint-gen 60 --joint-pop 30 --joint-seed 45 --joint-copula gumbel 2>&1
[ $? -ne 0 ] && { echo "STEP joint-gumbel-s45 FAILED"; EXIT_CODE=1; }
python -u eb_searched_rp.py --data "$PROJ_DIR/near_miss_hb_ecf.csv" --out-dir "$SCR3" --search joint --load-best --best-dir "$PROJ_DIR" --joint-gen 60 --joint-pop 30 --joint-seed 44 --joint-copula joe 2>&1
[ $? -ne 0 ] && { echo "STEP joint-joe-s44 FAILED"; EXIT_CODE=1; }
# Gates: joint search outputs per scratch dir.
for d in "$SCR1" "$SCR2" "$SCR3"; do
  for f in "$d/eb_search_joint_best.csv" "$d/eb_search_joint_best.tex" \
           "$d/eb_search_hist_joint.csv" "$d/eb_search_convergence_joint.png"; do
    if [ ! -f "$f" ]; then echo "MISSING joint output: $f"; EXIT_CODE=1; fi
  done
done
echo "Job finished at $(date) exit=$EXIT_CODE"
exit $EXIT_CODE


