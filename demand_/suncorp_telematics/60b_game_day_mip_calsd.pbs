#!/bin/bash -l
#PBS -N suncorp_gameday_mip_calsd
#PBS -l walltime=03:00:00
#PBS -l select=1:ncpus=8:mem=64GB
#PBS -j oe
#PBS -m abe
#PBS -r y

# Refuse to run outside PBS: keep all compute off the login/head node.
if [ -z "${PBS_JOBID:-}" ] && [ "${ALLOW_HEAD_NODE:-0}" != "1" ]; then
  echo "$(basename "$0"): PBS batch script; refusing to run on $(hostname). Submit with qsub." >&2
  exit 2
fi

set -euo pipefail

# Job 60b: police site-selection MIP on the STRUCTURAL SD-twin surface
# (pred_sd_game from 59) into separate dirs, so the default-surface 60
# outputs are never clobbered. Compares the flow-coupled, density-mediated
# surface against the regression surface (60) on the same fixtures.
# NOTE: the surface is pred_sd_game, NOT pred_speeding_calsd. The lift
# calibration was demoted to reporting-only (see 59 --sd-lift-cal-apply):
# its slope was fit on ~35 fixtures with an errors-in-variables regressor,
# so it can no longer rescale a shipped surface by default.

PROJ_DIR=/mnt/hpccs01/home/ahernz/test_runs_tours/demand_/suncorp_telematics
SCRIPT_DIR=$PROJ_DIR/scripts
RESULTS_DIR=$PROJ_DIR/results
FIG_DIR=$PROJ_DIR/figures

module purge
module load Anaconda3/2024.02-1
conda activate zigenv
module unload Anaconda3

export PYTHONWARNINGS="ignore::RuntimeWarning"
export OMP_NUM_THREADS=8
export OPENBLAS_NUM_THREADS=8
export MKL_NUM_THREADS=8

cd "$SCRIPT_DIR"

echo "=================================================================="
echo "Job $PBS_JOBID started on $(hostname) at $(date)"
echo "60b: game-day MIP on pred_sd_game (structural twin)"
echo "=================================================================="

[ -s "$RESULTS_DIR/game_day_pred_15min.parquet" ] \
  || { echo "FATAL: missing results/game_day_pred_15min.parquet (run 59 first)"; exit 1; }

python -u 60_game_day_mip.py \
  --pred-col pred_sd_game \
  --out-dir "$RESULTS_DIR/mip_sd" \
  --fig-dir "$FIG_DIR/mip_sd" \
  --min-marg 0.5 --max-segments 250 \
  --chunk-m 150 --max-chunks-per-road 3 \
  --travel-speed-kmh 43.2 --detour-factor 1.3 \
  --setup-min 5 --max-travel-m 4000 2>&1

for f in game_day_mip_sites.csv game_day_mip_plans.csv game_day_mip_summary.json \
         game_day_mip_schedule.csv game_day_mip.tex; do
  [ -s "$RESULTS_DIR/mip_sd/$f" ] || { echo "FATAL: 60b missing $f"; exit 1; }
done

echo "60b OK (surface=pred_sd_game)"
echo "Job finished at $(date)"

