#!/bin/bash -l
#PBS -N suncorp_speeding
#PBS -l walltime=01:00:00
#PBS -l select=1:ncpus=4:mem=32GB
#PBS -j oe
#PBS -m abe
#PBS -r y

# ======================================================================
# Speeding risk + max-detection deployment (no RSP content).
# Fits a convergent speeding SPF, ranks corridors, staffs top-P police
# posts by speeding intensity. Paper inputs: results/speeding_effect.tex,
# figures/speeding_*.png
# Submit: cd $PROJ_DIR && qsub 11_speeding_maxdetect.pbs
# ======================================================================

PROJ_DIR=/mnt/hpccs01/home/ahernz/test_runs_tours/demand_/suncorp_telematics
SCRIPT_DIR=$PROJ_DIR/scripts
DATA_DIR=$PROJ_DIR/data
RESULTS_DIR=$PROJ_DIR/results

module purge
module load Anaconda3/2024.02-1
conda activate zigenv
module unload Anaconda3

export PROJ="$PROJ_DIR"
export PYTHONWARNINGS="ignore::RuntimeWarning"
export OMP_NUM_THREADS=4
export OPENBLAS_NUM_THREADS=4
export MKL_NUM_THREADS=4

cd "$SCRIPT_DIR"

echo "=================================================================="
echo "Job $PBS_JOBID started on $(hostname) at $(date)"
echo "=================================================================="

for f in "$DATA_DIR/near_miss_hb_ecf.csv" \
         "$DATA_DIR/osm_roads_suncorp.geojson" \
         "$RESULTS_DIR/post_selection_mip.csv"; do
  if [ ! -s "$f" ]; then echo "FATAL: missing input $f"; exit 1; fi
done
echo "Inputs OK."

python -u 41_speeding_max_detect.py --staffed-p 5 2>&1
EXIT_CODE=$?
if [ $EXIT_CODE -ne 0 ] || [ ! -s "$RESULTS_DIR/speeding_audit.json" ]; then
  echo "FATAL: speeding pipeline failed (exit=$EXIT_CODE)"
  exit 1
fi

python - "$RESULTS_DIR/speeding_audit.json" <<'EOF'
import json, os, sys
base = "/mnt/hpccs01/home/ahernz/test_runs_tours/demand_/suncorp_telematics"
a = json.load(open(f"{base}/results/speeding_audit.json"))
assert a.get("spf_converged"), "SPF not converged"
assert abs(a["total_eb"] - a["total_obs"]) / max(a["total_obs"], 1) < 0.05, "EB total off"
for f in ["results/speeding_effect.tex", "figures/speeding_top_corridors.png",
          "figures/speeding_coverage.png"]:
    assert os.path.getsize(f"{base}/{f}") > 0, f"missing {f}"
print(f"OK: AIC={a['spf_aic']:.0f} alpha={a['spf_alpha']:.3f} top={a['top_corridor']}")
print(f"OK: coverage={100*a['coverage_staffed']:.1f}% detections={a['detections']:.0f}")
EOF
EXIT_CODE=$?

echo "=================================================================="
echo "Job finished at $(date) - exit_code=$EXIT_CODE"
echo "=================================================================="
exit $EXIT_CODE
