#!/bin/bash -l
#PBS -N suncorp_eb
#PBS -l walltime=04:00:00
#PBS -l select=1:ncpus=8:mem=64GB
#PBS -j oe
#PBS -m abe
#PBS -r y

# ══════════════════════════════════════════════════════════════════════════════
# Job 2: Empirical Bayes Analysis for Suncorp Telematics
# Fits NB random-parameters count model via metacountregressor, computes EB adjustments, cross-validation, and generates figures
# ══════════════════════════════════════════════════════════════════════════════

PROJ_DIR=/mnt/hpccs01/home/ahernz/test_runs_tours/demand_/suncorp_telematics
SCRIPT_DIR=$PROJ_DIR/scripts
DATA_DIR=$PROJ_DIR/data
RESULTS_DIR=$PROJ_DIR/results
FIG_DIR=$PROJ_DIR/figures

# ── Load environment ──────────────────────────────────────────────────────────
module purge
module load Anaconda3/2024.02-1
conda activate zigenv
module unload Anaconda3

# Ensure required packages are present in the conda env (force-repair broken installs)
echo "Checking/installing required Python packages..."
for pkg in scipy scikit-learn statsmodels seaborn matplotlib pandas numpy; do
    python -c "import ${pkg%%-*}" 2>/dev/null || pip install --force-reinstall --no-deps $pkg
done

# ── Environment variables ─────────────────────────────────────────────────────
export PYTHONWARNINGS="ignore::RuntimeWarning"
export OMP_NUM_THREADS=8
export OPENBLAS_NUM_THREADS=8
export MKL_NUM_THREADS=8
export JAX_PLATFORMS=cpu

cd "$SCRIPT_DIR"

echo "════════════════════════════════════════════════════════════════════════════"
echo "Job $PBS_JOBID started on $(hostname) at $(date)"
echo "Project dir:  $PROJ_DIR"
echo "Input data:   $DATA_DIR/near_miss_hb_ecf.csv"
echo "Results dir:  $RESULTS_DIR"
echo "Figures dir:  $FIG_DIR"
echo "════════════════════════════════════════════════════════════════════════════"

# ── Check input file exists ───────────────────────────────────────────────────
if [ ! -f "$DATA_DIR/near_miss_hb_ecf.csv" ]; then
    echo "✗ ERROR: near_miss_hb_ecf.csv not found!"
    echo "   Please run 01_prepare_data.pbs first."
    exit 1
fi

# ── Update paths in Python script ─────────────────────────────────────────────
echo "Updating paths for HPC environment..."
sed -i "s|PROJ = r\"C:\\\\Users\\\\ahernz.*\"|PROJ = \"$PROJ_DIR\"|g" 19_eb_analysis.py

# ── Run EB analysis ───────────────────────────────────────────────────────────
echo ""
echo "Running 19_eb_analysis.py..."
echo ""

python -u 19_eb_analysis.py 2>&1
EXIT_CODE=$?

# ── Check outputs ─────────────────────────────────────────────────────────────
echo ""
echo "Checking outputs..."
OUTPUTS_OK=0

if [ -f "$RESULTS_DIR/eb_results.tex" ]; then
    echo "✓ eb_results.tex created"
    OUTPUTS_OK=$((OUTPUTS_OK + 1))
fi

if [ -f "$RESULTS_DIR/eb_spf_coef.csv" ]; then
    echo "✓ eb_spf_coef.csv created"
    OUTPUTS_OK=$((OUTPUTS_OK + 1))
fi

if [ -f "$RESULTS_DIR/eb_predictions.csv" ]; then
    echo "✓ eb_predictions.csv created"
    wc -l "$RESULTS_DIR/eb_predictions.csv"
    OUTPUTS_OK=$((OUTPUTS_OK + 1))
fi

if [ -f "$FIG_DIR/eb_obs_vs_pred.png" ]; then
    echo "✓ Figures generated"
    OUTPUTS_OK=$((OUTPUTS_OK + 1))
fi

echo ""
if [ $OUTPUTS_OK -eq 4 ]; then
    echo "✓ All outputs created successfully!"
else
    echo "✗ Some outputs missing (created $OUTPUTS_OK/4)"
    EXIT_CODE=1
fi

echo ""
echo "════════════════════════════════════════════════════════════════════════════"
echo "Job finished at $(date) — exit_code=$EXIT_CODE"
echo "════════════════════════════════════════════════════════════════════════════"

exit $EXIT_CODE
