#!/bin/bash -l
# Orchestrator: submit the sharded (micro-job) GA chain.
# 21 small cooperative jobs (1 shqard = 1 stage x 1 segment) + 1 merge job.
# See SHARDED_JOBS.md for the shard table, variant matrix, and outputs.
#
# Submit (from ~/test_runs_tours/code on an aqua login node):
#   qsub -v "RUN_TAG=qld_shard1,GA_BUDGET=smoke" job_submit_ga_sharded.pbs
#   DRY_RUN=1 bash job_submit_ga_sharded.pbs   # print plan without submitting
#
# Key overrides (-v):
#   GA_BUDGET, GA_ESTIMATOR (default metacount_mv), GA_ENGINE (default agds)
#   GA_S4_VARIANTS (default rrm;tdd; or all)
#   GA_S5_MODE_VARIANTS (default nl;mnl; or all for +mxl,gse)
#   GA_S5_DEST_VARIANTS (default mnl;nl_dist; or all for +exploded note)
#   GA_SHARD_VARIANTS=0 to skip the family shootout (search-only shards)
#   STAGES (default 0,1,2,3,4,5) to run a subset, e.g. STAGES=4,5
#   INTER_QUEUE=cpu_inter with INTER_QUEUE_SHARDS=2:start;2:end to route an
#     explicit set of eligible shards to the lightly loaded inter queue.
# PBS -v passes variables COMMA-separated, so NO value sent via -v may itself
# contain a comma. Multi-value knobs (variant lists, STAGE_IDS) therefore use
# ';' or '_' separators inside this chain (ga_shard._env_list accepts ';';
# merge scripts accept '_' for stage ids — same convention as the legacy
# chain's STAGE_IDS=0_1_2_3_4_5).

#PBS -m n
#PBS -r y
#PBS -P FPAXJW8067
#PBS -l select=1:ncpus=1:mem=2GB
#PBS -l walltime=00:30:00

set -euo pipefail

RUN_ROOT=${RUN_ROOT:-runs/ga_parallel}
RUN_TAG=${RUN_TAG:-shard_${PBS_JOBID:-$(date +%Y%m%d_%H%M%S)}}
CONDA_ENV=${CONDA_ENV:-zigenv}
STAGES=${STAGES:-0,1,2,3,4,5,51}
DRY_RUN=${DRY_RUN:-0}
# Project accounting (QUT DMP RPID). Nested qsubs do NOT inherit the
# parent's -P, so every child submission carries it explicitly.
# Override per submit: qsub -v "PROJECT_RPID=XXXXXX0000,..." ...
PROJECT_RPID=${PROJECT_RPID:-FPAXJW8067}
_P_FLAG=()
if [ -n "${PROJECT_RPID}" ]; then
  _P_FLAG=(-P "${PROJECT_RPID}")
fi

GA_BUDGET=${GA_BUDGET:-standard}
GA_ESTIMATOR=${GA_ESTIMATOR:-metacount_mv}
GA_ENGINE=${GA_ENGINE:-agds}
GA_N_RESTARTS=${GA_N_RESTARTS:-0}
GA_SHARD_VARIANTS=${GA_SHARD_VARIANTS:-1}
GA_S4_VARIANTS=${GA_S4_VARIANTS:-rrm;tdd}
GA_STAGE4_MXL_SEARCH=${GA_STAGE4_MXL_SEARCH:-0}
GA_STAGE4_GENS=${GA_STAGE4_GENS:-}
GA_STAGE4_RESTARTS=${GA_STAGE4_RESTARTS:-}
GA_STAGE4_EARLY_STOP=${GA_STAGE4_EARLY_STOP:-1}
GA_STAGE4_EARLY_STOP_PATIENCE=${GA_STAGE4_EARLY_STOP_PATIENCE:-120}
GA_STAGE4_EARLY_STOP_MIN_GENS=${GA_STAGE4_EARLY_STOP_MIN_GENS:-120}
GA_SA2_GENS=${GA_SA2_GENS:-}
GA_SA2_RESTARTS=${GA_SA2_RESTARTS:-}
STAGE2_MH=${STAGE2_MH:-0}
STAGE2_MH_BURN=${STAGE2_MH_BURN:-1000}
STAGE2_MH_DRAWS=${STAGE2_MH_DRAWS:-2000}
STAGE2_MH_THIN=${STAGE2_MH_THIN:-2}
STAGE2_MH_SEED=${STAGE2_MH_SEED:-42}
STAGE2_MH_PROPOSAL_SCALE=${STAGE2_MH_PROPOSAL_SCALE:-1.0}
GA_S5_MODE_VARIANTS=${GA_S5_MODE_VARIANTS:-nl;mnl}
GA_S5_DEST_VARIANTS=${GA_S5_DEST_VARIANTS:-mnl;nl_dist}
# Stage-5 overrun controls (12h jobs vs ~1h/generation dest fits):
#   GA_STAGE5_GENS/RESTARTS cap the search so a job fits its walltime and
#     makes incremental progress via resume (best-so-far + sidecars).
#   GA_STAGE5_STAG caps stagnant generations (default patience ~45 would burn
#     ~58h on a flat fallback fitness — see s51's constant 1.3105).
#   GA_WALLTIME_MARGIN_SECONDS reserves finalise time (default 300s is one
#     thin slice of a 1h+ generation — the SIGKILLs came from inside gens).
#   GA_STAGE5_RUN_MODE/RUN_DEST split mode/dest across PBS jobs (default both
#     on = legacy all-in-one). Split jobs share the shard dir; progress crosses
#     via ga_stage5_sidesearch.pkl sidecars; a segment completes only when both
#     sides ran clean.
GA_STAGE5_GENS=${GA_STAGE5_GENS:-}
GA_STAGE5_RESTARTS=${GA_STAGE5_RESTARTS:-}
GA_STAGE51_GENS=${GA_STAGE51_GENS:-}
GA_STAGE51_RESTARTS=${GA_STAGE51_RESTARTS:-}
GA_STAGE5_STAG=${GA_STAGE5_STAG:-}
GA_WALLTIME_MARGIN_SECONDS=${GA_WALLTIME_MARGIN_SECONDS:-300}
GA_STAGE5_RUN_MODE=${GA_STAGE5_RUN_MODE:-1}
GA_STAGE5_RUN_DEST=${GA_STAGE5_RUN_DEST:-1}
# GA_SEED re-seeds searches (fresh-seed refits escape frozen gen-0 optima);
# empty = keep each stage's default seed. GA_L1_L2_ALPHA scales the elastic-net
# penalty (s0 separation: bump to e.g. 5e-3 to shrink separated dummies).
# STAGE5B_CA_FULLGRID_CASES caps the rectangular trip-dest CA grid
# (cases x 371 zones; full sets need no correction).
GA_SEED=${GA_SEED:-}
GA_L1_L2_ALPHA=${GA_L1_L2_ALPHA:-1e-3}
STAGE5B_CA_FULLGRID_CASES=${STAGE5B_CA_FULLGRID_CASES:-1500}
SKIP_MERGE=${SKIP_MERGE:-0}
# Stage-0 CDAP Mixed Logit is report-only (prediction uses the MNL) and OOMs
# at 29-48GB with 100 draws x 5000 subsample (s0retry 25872945: cgroup OOM
# during MXL after a successful MNL). Default it OFF for shards; re-enable
# per-submit with -v "CDAP_MXL=1 ..." if a report-only MXL is wanted.
CDAP_MXL=${CDAP_MXL:-0}
CDAP_MXL_DRAWS=${CDAP_MXL_DRAWS:-50}
CDAP_MXL_MAX_N=${CDAP_MXL_MAX_N:-2000}
# RWMH heterogeneity (CDAP_MXL=mh): burn/draws/thin/seed/prior_sd. 2000 cases
# x 3 alts x ~50 params is single-digit MBs and ~1 min; raise draws for tighter
# posteriors once the first mh run validates.
CDAP_MH_BURN=${CDAP_MH_BURN:-1000}
CDAP_MH_DRAWS=${CDAP_MH_DRAWS:-2000}
CDAP_MH_THIN=${CDAP_MH_THIN:-5}
CDAP_MH_SEED=${CDAP_MH_SEED:-42}
CDAP_MH_PRIOR_SD=${CDAP_MH_PRIOR_SD:-5.0}
EXTRA_ENV=${EXTRA_ENV:-}
PUBLISH_PAPER=${PUBLISH_PAPER:-0}
# Alternate queues are opt-in and selected per shard.  Keep the list explicit:
# cpu_inter has aggregate user limits (8 jobs, 34GB running memory, 8 CPUs),
# so routing every eligible shard at once can make qsub reject later children.
INTER_QUEUE=${INTER_QUEUE:-}
INTER_QUEUE_SHARDS=${INTER_QUEUE_SHARDS:-}

NEW_POP=${NEW_POP:-1}
NEW_POP_MAPPED=${NEW_POP_MAPPED:-0}
NEW_POP_DIR=${NEW_POP_DIR:-../new_pop}
if [ "${NEW_POP}" = "1" ] && [ "${NEW_POP_MAPPED}" != "1" ]; then
    PIPELINE_SKIMS_PATH=${PIPELINE_SKIMS_PATH:-../demand_/skims_371.omx}
else
    PIPELINE_SKIMS_PATH=${PIPELINE_SKIMS_PATH:-}
fi

# -- shard table: "stage:segment:ncpus:mem:walltime" -------------------------
# Right-sized from qld_shard1/2 measurements: s2-s4 used <1GB (smoke) so 8-16GB
# is ample; s1 was OOM-killed at 16GB during search so it gets 32GB (2x the
# kill point); s0 SIGKILLed (137) at 8GB during the JAX 100-draw mixed logit
# -> 48GB + 4 cpus; s5 search used 34-48GB -> 64GB for work/edu and 96GB for the
# nonmand shard that OOM'd at 64GB.
#
# Stage-51 trip search is HHTS-scale.  It was originally provisioned at 32GB on
# the theory that it was lighter than stage-5, but ALL 8 stage-51 shards in run
# cdap_s5_refit_20260928 were cgroup/OOM-killed at 33.4GB peak (jobs 25940308-
# 25940315), while the stage-5 twins at 96GB completed (work peaked 58GB,
# nonmand 112GB).  Stage-51 does the same destination+mode estimation as stage-5
# plus the joint-tour/CA expansion, so it inherits stage-5's footprint rather
# than undercutting it -> 96GB across the board.  Measure again from the next
# run's resources_used and re-tune; do not lower these on a hunch.
# NOTE: stage-4 tdd timing is slow (~28 min/gen); the GA walltime guard is now
# generation-duration-aware (ga_hypothesis_testing._walltime_exceeded) so a slow
# search stops + finalises gracefully within walltime instead of Exit -29.
# Walltimes are sized for the ultrafast budget (stages 1-3 run 2x gens via
# GA_STAGE123_GENS_MULT=2.0).
SHARDS="
0:all:4:48GB:12:00:00
1:work:2:32GB:12:00:00
1:edu:2:32GB:12:00:00
1:nonmand:2:32GB:12:00:00
2:start:2:8GB:12:00:00
2:end:2:8GB:12:00:00
2:budget:2:8GB:12:00:00
3:work:2:16GB:12:00:00
3:edu:2:16GB:12:00:00
3:nonmand:2:16GB:12:00:00
4:work:2:8GB:12:00:00
4:edu:2:8GB:12:00:00
4:nonmand:2:16GB:12:00:00
5:work:4:96GB:12:00:00
5:edu:4:64GB:12:00:00
5:nonmand:4:128GB:12:00:00
51:work:4:96GB:12:00:00
51:edu:4:96GB:12:00:00
51:escort:4:96GB:12:00:00
51:shopping:4:96GB:12:00:00
51:othmaint:4:96GB:12:00:00
51:othdiscr:4:96GB:12:00:00
51:eat:4:96GB:12:00:00
51:social:4:96GB:12:00:00
"

cd "$PBS_O_WORKDIR"

echo "=========================================="
echo "Sharded GA submitter"
echo "Run tag : ${RUN_TAG}"
echo "Stages  : ${STAGES}"
echo "Budget/est/engine: ${GA_BUDGET}/${GA_ESTIMATOR}/${GA_ENGINE}"
echo "Variants: SHARD=${GA_SHARD_VARIANTS} S4=${GA_S4_VARIANTS} S5MODE=${GA_S5_MODE_VARIANTS} S5DEST=${GA_S5_DEST_VARIANTS}"
echo "=========================================="

COMMON_VARS="RUN_ROOT=${RUN_ROOT},RUN_TAG=${RUN_TAG},CONDA_ENV=${CONDA_ENV},GA_BUDGET=${GA_BUDGET},GA_ESTIMATOR=${GA_ESTIMATOR},GA_ENGINE=${GA_ENGINE},GA_N_RESTARTS=${GA_N_RESTARTS},GA_PARALLEL_SEGMENTS=1,GA_SHARD_VARIANTS=${GA_SHARD_VARIANTS},GA_S4_VARIANTS=${GA_S4_VARIANTS},GA_STAGE4_MXL_SEARCH=${GA_STAGE4_MXL_SEARCH},GA_STAGE4_GENS=${GA_STAGE4_GENS},GA_STAGE4_RESTARTS=${GA_STAGE4_RESTARTS},GA_STAGE4_EARLY_STOP=${GA_STAGE4_EARLY_STOP},GA_STAGE4_EARLY_STOP_PATIENCE=${GA_STAGE4_EARLY_STOP_PATIENCE},GA_STAGE4_EARLY_STOP_MIN_GENS=${GA_STAGE4_EARLY_STOP_MIN_GENS},GA_SA2_GENS=${GA_SA2_GENS},GA_SA2_RESTARTS=${GA_SA2_RESTARTS},STAGE2_MH=${STAGE2_MH},STAGE2_MH_BURN=${STAGE2_MH_BURN},STAGE2_MH_DRAWS=${STAGE2_MH_DRAWS},STAGE2_MH_THIN=${STAGE2_MH_THIN},STAGE2_MH_SEED=${STAGE2_MH_SEED},STAGE2_MH_PROPOSAL_SCALE=${STAGE2_MH_PROPOSAL_SCALE},GA_S5_MODE_VARIANTS=${GA_S5_MODE_VARIANTS},GA_S5_DEST_VARIANTS=${GA_S5_DEST_VARIANTS},GA_STAGE5_GENS=${GA_STAGE5_GENS},GA_STAGE5_RESTARTS=${GA_STAGE5_RESTARTS},GA_STAGE51_GENS=${GA_STAGE51_GENS},GA_STAGE51_RESTARTS=${GA_STAGE51_RESTARTS},GA_STAGE5_STAG=${GA_STAGE5_STAG},GA_WALLTIME_MARGIN_SECONDS=${GA_WALLTIME_MARGIN_SECONDS},GA_STAGE5_RUN_MODE=${GA_STAGE5_RUN_MODE},GA_STAGE5_RUN_DEST=${GA_STAGE5_RUN_DEST},GA_SEED=${GA_SEED},GA_L1_L2_ALPHA=${GA_L1_L2_ALPHA},STAGE5B_CA_FULLGRID_CASES=${STAGE5B_CA_FULLGRID_CASES},CDAP_MXL=${CDAP_MXL},CDAP_MXL_DRAWS=${CDAP_MXL_DRAWS},CDAP_MXL_MAX_N=${CDAP_MXL_MAX_N},CDAP_MH_BURN=${CDAP_MH_BURN},CDAP_MH_DRAWS=${CDAP_MH_DRAWS},CDAP_MH_THIN=${CDAP_MH_THIN},CDAP_MH_SEED=${CDAP_MH_SEED},CDAP_MH_PRIOR_SD=${CDAP_MH_PRIOR_SD},NEW_POP=${NEW_POP},NEW_POP_MAPPED=${NEW_POP_MAPPED},NEW_POP_DIR=${NEW_POP_DIR},PIPELINE_SKIMS_PATH=${PIPELINE_SKIMS_PATH}"
if [ -n "${EXTRA_ENV}" ]; then
  COMMON_VARS="${COMMON_VARS},EXTRA_ENV=${EXTRA_ENV}"
fi

submit_shard() {  # stage segment ncpus mem walltime
  local sid="$1" seg="$2" ncpus="$3" mem="$4" wt="$5"
  # GA_WALLTIME_SECONDS lets the stage-5 segment worker stop gracefully before
  # PBS SIGKILLs the job (see _init_walltime_guard in ga_hypothesis_testing).
  local wt_secs
  wt_secs=$(echo "${wt}" | awk -F: '{print ($1*3600)+($2*60)+$3}')
  # JAX compilation-cache growth across GA candidate evals OOM-killed stage-5
  # work/nonmand (Exit 137: 62GB@64GB, 100GB@96GB). _maybe_clear_jax_caches
  # auto-detects the limit from the cgroup, which under `place=excl` sees the
  # whole NODE's RAM (not the job's mem request), so the 80% clear-threshold sat
  # above the PBS ceiling and never fired. Pin the limit to THIS shard's mem so
  # caches clear at ~80% of the real budget, and check more often.
  local mem_gb
  mem_gb=$(echo "${mem}" | grep -oE '[0-9]+' | head -1)
  local inter_selected=0
  local inter_token
  if [ -n "${INTER_QUEUE_SHARDS}" ]; then
    IFS=';' read -ra _inter_tokens <<< "${INTER_QUEUE_SHARDS}"
    for inter_token in "${_inter_tokens[@]}"; do
      if [ "${inter_token}" = "${sid}:${seg}" ]; then
        inter_selected=1
        break
      fi
    done
  fi

  local queue_args=()
  if [ "${inter_selected}" = "1" ]; then
    if [ -z "${INTER_QUEUE}" ]; then
      echo "ERROR: ${sid}:${seg} selected for alternate queue but INTER_QUEUE is empty" >&2
      return 1
    fi
    if [ "${INTER_QUEUE}" != "cpu_inter" ]; then
      echo "ERROR: only the verified cpu_inter route is supported (got ${INTER_QUEUE})" >&2
      return 1
    fi
    local wt_limit_secs=43200
    if [ "${wt_secs}" -gt "${wt_limit_secs}" ] || [ "${mem_gb}" -gt 34 ] || [ "${ncpus}" -gt 8 ]; then
      echo "ERROR: ${sid}:${seg} does not fit ${INTER_QUEUE} (ncpus=${ncpus}, mem=${mem}, walltime=${wt})" >&2
      return 1
    fi
    queue_args=(-q "${INTER_QUEUE}")
    echo "route s${sid}/${seg}: ${INTER_QUEUE} (ncpus=${ncpus} mem=${mem} walltime=${wt})" >&2
  fi

  local cmd=(qsub "${_P_FLAG[@]}" "${queue_args[@]}" -N "ga_s${sid}${seg}_${RUN_TAG}"
    -l "select=1:ncpus=${ncpus}:mem=${mem}" -l "walltime=${wt}"
    -v "${COMMON_VARS},STAGE_ID=${sid},SHARD_SEGMENT=${seg},GA_WALLTIME_SECONDS=${wt_secs},GA_JAX_CACHE_MEM_LIMIT_GB=${mem_gb},GA_JAX_CACHE_CHECK_EVERY=${GA_JAX_CACHE_CHECK_EVERY:-10},STAGE5_DEST_SAMPLE_SIZE=${STAGE5_DEST_SAMPLE_SIZE:-20}"
    job_ga_shard_single.pbs)
  if [ "${DRY_RUN}" = "1" ]; then
    echo "DRY: ${cmd[*]}" >&2
    echo "dry_${sid}_${seg}"
  else
    "${cmd[@]}" | awk '{print $1}'
  fi
}

DEPS=""
while read -r line; do
  [ -z "${line}" ] && continue
  sid=$(echo "$line" | cut -d: -f1)
  seg=$(echo "$line" | cut -d: -f2)
  ncpus=$(echo "$line" | cut -d: -f3)
  mem=$(echo "$line" | cut -d: -f4)
  wt=$(echo "$line" | cut -d: -f5-)
  case ",${STAGES}," in
    *",${sid},"*) ;;
    *) echo "skip stage ${sid}/${seg} (not in STAGES=${STAGES})"; continue ;;
  esac
  jid=""
  if jid=$(submit_shard "$sid" "$seg" "$ncpus" "$mem" "$wt"); then
    echo "shard s${sid}/${seg}: ${jid}"
    DEPS="${DEPS}:${jid}"
  else
    echo "shard s${sid}/${seg}: SUBMIT FAILED (see stderr above) -- continuing"
  fi
done <<< "${SHARDS}"
DEPS=$(echo "${DEPS}" | sed 's/^://')

if [ -z "${DEPS}" ]; then
  echo "No shards submitted (check STAGES filter). Nothing to merge."
  exit 0
fi

# Split-stage resubmits (e.g. Stage-5 mode-only then dest-only) manage their
# own final merge once all sides are done — skip the auto-merge here.
if [ "${SKIP_MERGE}" = "1" ]; then
  _SKIP_MERGE_IDS=$(echo "${STAGES}" | tr ',' '_')
  echo "SKIP_MERGE=1: shards submitted (${DEPS}); no merge submitted."
  echo "Merge later with: qsub -P ${PROJECT_RPID} -N ga_shardmerge_${RUN_TAG} \\"
  echo "  -W depend=afterany:${DEPS} -l select=1:ncpus=1:mem=8GB -l walltime=01:00:00 \\"
  echo "  -v RUN_ROOT=${RUN_ROOT},RUN_TAG=${RUN_TAG},CONDA_ENV=${CONDA_ENV},STAGE_IDS=${_SKIP_MERGE_IDS},STRICT_MERGE=${STRICT_MERGE:-0},PUBLISH_PAPER=${PUBLISH_PAPER} job_merge_ga_shards.pbs"
  exit 0
fi

if [ "${DRY_RUN}" = "1" ]; then
  echo "DRY: merge would depend on: ${DEPS}"
  echo "DRY: qsub -N ga_shardmerge_${RUN_TAG} -W depend=afterany:${DEPS} ... job_merge_ga_shards.pbs"
  exit 0
fi

# STAGE_IDS travels via qsub -v so it must not contain commas: send underscores.
MERGE_STAGE_IDS=$(echo "${STAGES}" | tr ',' '_')
jid_merge=$(qsub "${_P_FLAG[@]}" -N "ga_shardmerge_${RUN_TAG}" \
  -W "depend=afterany:${DEPS}" \
  -l "select=1:ncpus=1:mem=8GB" -l "walltime=01:00:00" \
  -v "RUN_ROOT=${RUN_ROOT},RUN_TAG=${RUN_TAG},CONDA_ENV=${CONDA_ENV},STAGE_IDS=${MERGE_STAGE_IDS},STRICT_MERGE=${STRICT_MERGE:-0},PUBLISH_PAPER=${PUBLISH_PAPER}" \
  job_merge_ga_shards.pbs | awk '{print $1}')
echo "Submitted merge: ${jid_merge} (afterany ${DEPS})"
echo "Merged artifact will be: ${RUN_ROOT}/${RUN_TAG}/merged/ga_results.pkl"
echo "Predict from it with: GA_STAGED_GA_DIR=${RUN_ROOT}/${RUN_TAG}/merged"
