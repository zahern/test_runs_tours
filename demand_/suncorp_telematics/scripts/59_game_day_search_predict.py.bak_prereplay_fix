ECF = DATA / "near_miss_hb_ecf.csv"
FEATS = DATA / "road_geometry_features.csv"
AADT_CSV = DATA / "segment_aadt.csv"
# The current PyPI engine is JAX-first; sparse-agds is legacy and falls back
# automatically. Default to jax.
# Wall-budgeted chunked SA needs ExperimentBuilder.run(max_time=, refit=),
# available from 1.0.155.
ENGINE_DEFAULT = "jax"
TZ = "Australia/Brisbane"
# The response the deployment is actually justified on.
    #
    # WAS trips_mean_gt_10, described here as "at least 10 km/h over the posted
    # limit". That description was wrong: the panel column counts trips whose
    # MEAN speed is BELOW 10 km/h, so it measures congestion, not speeding, and
    # every downstream label ("speeding", pred_speeding, "ranked by speeding")
    # inherited the error. It also falls with traffic volume -- a binomial MLE
    # over 350,946 trials put the flow elasticity at -0.954 -- so the
    # flow-projection offset pushed prediction onto the busiest arterials,
    # which structurally never register slow trips. The consequence was a
    # NEGATIVE correlation between predicted and observed speeding on all six
    # holdout games (Pearson r = -0.06 to -0.14, top-quartile share 0.35-0.49
    # against 0.25 for a coin toss).
    #
    # NOW speeding_trips, built by stage 58 as vehicle_count where the segment's
    # mean speed exceeds a CREDIBLE posted limit (>= 40 km/h; below that this
    # extract posts 5-20 km/h limits on living/service streets, where the
    # comparison is meaningless). It rises with speed, so a flow offset is at
    # least directionally sensible, and it retains 68.7% of the unfiltered
    # target with the top 100 segments carrying 61.1%.
TARGET_DEFAULT = "speeding_trips"
# The measured denominator for the speeding propensity: trips that actually
# got a speed reading. Defined here (not next to search_frame) because the
# panel reader's column list needs it. See CHECKPOINT_COLS for why its
# absence was so costly.
BINOMIAL_DENOM = "trips_with_judged_speed"
# The successes and the trials of a binomial must be counted over the SAME
# thing. `speeding_trips` counts VEHICLES on an over-limit segment-bin, so its
# denominator has to be vehicle_count; pairing it with trips_with_judged_speed
# mixed units, and because one vehicle can make several trips in a bin, k > n
# was reachable. The exact likelihood caught it:
#     [binom] fit failed: BinomialFitError: 4 rows have successes outside [0, n]
# which was the only symptom -- the count fit carried on regardless.
# The trips_* targets are genuinely trip counts, so they keep the judged-trip
# denominator.
BINOMIAL_DENOM_BY_TARGET = {
    "speeding_trips": "vehicle_count",
}


def binomial_denominator(target):
    """Denominator column matching the unit of `target`."""
    return BINOMIAL_DENOM_BY_TARGET.get(target, BINOMIAL_DENOM)
WINDOW_HOURS = (-3.0, 4.0)
BINS_PER_HOUR = 4
REL_BINS = 28
CONT_VARS = ["lanes_z", "maxspeed_z", "curvature_z", "dist_inter_z",
             "node_degree_z", "log_length", "lanes_known"]
CAL_VARS = ["tod_sin", "tod_cos", "dow_sin", "dow_cos", "weekend"]
# Day-of-week dummies (Sunday reference dropped by the search/BIC if unneeded;
# all seven enter the pool so match-day effects are not forced sinusoidal).
DOW_DUMMIES = [f"dow_d{i}" for i in range(7)]
# Weather candidates, populated by load_weather_daily() when
# data/weather_daily.csv exists (date,rain_mm,temp_max_c,...); empty otherwise.
WEATHER_COLS = []
GAME_VARS = ["in_event", "rel_hour", "log_att", "dist_stad", "event_x_dist"]
# Terms that MUST survive selection, because the operational requirement is a
# GAME-SPECIFIC, SEGMENT-LEVEL, TIME-RESOLVED deployment and the model cannot
# express one without them.
#
# WHY THE PREVIOUS LIST WAS NOT ENOUGH. It was
#     [in_event, rel_hour, log_att, event_x_dist]
# and not one of those can reorder segments DIFFERENTLY for different games:
#
#   in_event      is 1 for every game inside its own window, so it is the
#                 same constant for all six fixtures
#   rel_hour      varies by 15-minute bin, not by segment
#   log_att       varies by game but is IDENTICAL across segments -- it shifts
#                 the level of a game, it does not reorder streets
#   event_x_dist  = in_event * dist_stad, and with in_event == 1 in every
#                 window this collapses to dist_stad, i.e. a STATIC segment
#                 effect
#
# Measured consequence on job 26107921, whose fitted spec contained exactly
# those four and none of the interactions below:
#   * 87.8% of the variance of log1p(predicted) was between segments, 3.2%
#     between fixtures
#   * the top-10 and top-20 site sets were 100% IDENTICAL across all six games
#   * the same street was the argmax for every game
# so the "game-day" surface could not produce a game-specific plan, and the
# MIP dutifully returned the same four streets six times.
#
# WHY THESE TWO, AND WHY FORCED RATHER THAN "LET BIC DECIDE". Both were
# offered to the search and both were culled, which is expected: each explains
# only a few per cent of POOLED variance, while BIC on a multi-million-row
# panel charges k*log(n) for every parameter and rewards the static segment
# effects that carry the bulk. Pooled in-sample BIC is structurally blind to a
# term whose entire value is reordering segments WITHIN a game. Since the
# requirement is the reordering, it has to be required by construction:
#
#   att_x_dist = log_att * dist_stad   the stadium footprint GROWS with the
#                                      crowd, so a 45k game puts relatively
#                                      more weight on near-stadium segments
#                                      than a 39k game -> different streets
#                                      for different games
#   rel_x_dist = rel_hour * dist_stad  the temporal shape depends on distance,
#                                      so near-stadium and far segments peak
#                                      at different times -> time-dependence
#                                      that is specific to the segment, not
#                                      just to the game as a whole
#
# The search still chooses the FORMS around them (fixed vs grouped, which
# basis functions, everything else in the library); what it no longer decides
# is whether the model is allowed to have any game- or segment-specific
# time structure at all.
GAME_FORCE = ["in_event", "rel_hour", "log_att", "event_x_dist",
              # REQUIRED for game-specific reordering and segment-specific
              # timing. See the block comment above; do not remove without
              # replacing them with something that does the same job.
              "att_x_dist", "rel_x_dist"]
# Within-window temporal shape (serial persistence is carried by these
# engineered features plus segment-level grouping; metacountregressor
# >=1.0.165 adds a real AR(1)/AR(2) NB2 estimator used in stage 2b below).
TEMPORAL_VARS = ["rel_hour_sq", "rel_sin", "rel_cos", "pre_game", "post_game"]
# Fixture attributes (NOT fixture identity: future games are unseen labels,
# so differentiation must come from attributes — code, crowd tier, kickoff).
# fxt_* code dummies (SuperRugby reference), big_game crowd tier, ko_* kickoff
# time-of-day. Spatiotemporal interactions let shape vary by game:
# rel_x_dist (near-stadium timing), att_x_dist (big-game footprint),
# ev_x_lanes (game traffic uses different road types).
GAME_ATTR_VARS = ["fxt_NRL", "fxt_ALeague", "big_game", "ko_tod_sin",
                  "ko_tod_cos"]
# evu_x_att = seg_event_uplift_z * log_att: the stadium footprint of a
# segment that demonstrably responds to games grows with the crowd, so a
# 45k game weights responsive segments differently from a 39k game -> the
# segment ranking becomes game-specific.
INTERACT_VARS = ["rel_x_dist", "att_x_dist", "ev_x_lanes", "evu_x_att",
                 # Crowd x road interactions: big games use different roads, so
                 # these let the ranking reorder by fixture (jaccard 1.0 fix).
                 "att_x_lanes", "att_x_maxspeed", "att_x_length", "ko_x_dist"]
GAME_WIDE_VARS = GAME_ATTR_VARS + INTERACT_VARS
EVENT_X_VARS = ["evu_x_att"]


def force_terms(work, args=None):
    """GAME_FORCE, plus evu_x_att when it varies and forcing is enabled.

    The event-uplift interaction is the direct mechanism for game-specific
    reordering, and pooled BIC culls exactly this kind of within-game term
    (see the GAME_FORCE comment). It is therefore forced by construction
    unless --force-event-uplift off. A column that is constant (no
    background sums, or no uplift variance) is not forced: the package's
    identifiability screen would reject it and collapse the spec.
    """
    terms = [c for c in GAME_FORCE if c in work.columns]
    if str(getattr(args, "force_event_uplift", "on") or "on").lower() == "on":
        for c in EVENT_X_VARS:
            if c not in work.columns or c in terms:
                continue
            try:
                if pd.to_numeric(work[c], errors="coerce").nunique() > 1:
                    terms.append(c)
            except Exception:  # noqa: BLE001 - forcing is best-effort
                pass
    return terms
SLIM_CONT = ["lanes_z", "maxspeed_z", "dist_inter_z", "lanes_known"]
SLIM_CAL = ["tod_sin", "tod_cos", "weekend"]
SLIM_GAME = ["in_event", "rel_hour", "log_att", "dist_stad", "event_x_dist"]
BEST_JSON = RES / "game_day_search_best.json"
PROGRESS_CSV = RES / "game_day_search_progress.csv"
FAMILY_CSV_NAME = "game_day_search_family.csv"
FAMILY_CSV = RES / FAMILY_CSV_NAME
CHECKPOINT_COLS = ["road_osmid", "bin", TARGET_DEFAULT, "vehicle_count",
                   "mean_vehicle_speed_kmh",
                   # The posted limit the speeding target was derived against.
                   # Carried so that stage 59 can REPORT why a segment is or is
                   # not eligible (a segment under the trusted limit is scored
                   # 0 by construction, which is different from a segment that
                   # was measured and genuinely had no speeding). Without this
                   # column a reader cannot tell those two apart.
                   "speed_limit",
                   # The measured denominator for the speeding propensity.
                   # The response is a COUNT of speeding TRIPS, so its true
                   # denominator is the number of trips that actually got a
                   # speed reading -- not trip_count, because a trip with no
                   # speed cannot be classified as speeding (trip_exceed is
                   # NaN and NaN > margin is False, so unjudged trips bias
                   # the rate down exactly where judging is worst).
                   #
                   # This column was MISSING from the list, so the panel was
                   # read without it. That silently disabled three features
                   # at once on cluster job 26077240: the exposure
                   # calibration reported "requested-but-unavailable" in all
                   # five arms, the per-class uplift found 0 classes, and the
                   # binomial would have been unavailable too. The failure was
                   # invisible because the first check bailed without a
                   # print. Load it explicitly.
                   BINOMIAL_DENOM]
# Memory-safety caps for the full (non-pilot) run. The search frame is
# <= train_cap rows; the profile comes from a random background sample.
EVENT_CAP = 100000
BG_CAP = 150000
TRAIN_CAP = 100000
PROFILE_ROWS = 500000
# Bump whenever the candidate set / constraints change shape: older
# checkpoints (different dim) can neither warm-start nor be trusted as-is.
# GEN 6: --group-by event (fixture-grouped per-event split); fixture/code
# columns carried through search_frame; wide + temporal-x block unchanged.
# GEN 7: seg_id proxy column (constant-per-segment) added to the search frame
# so the SEGMENT ITSELF can carry the grouped (role 4) effect. Previously the
# only grouped-eligible variables were geometry covariates, so "group by
# segment" could only ever mean "let lanes_z vary by segment" -- the segment
# identity itself was never a candidate. Candidate set grows by 1, so the
# decision dimension changes and old checkpoints must not warm-start.
# GEN 9: seg_event_uplift_z (per-segment game uplift) and its attendance
# interaction evu_x_att join the candidate set; evu_x_att is force-included
# by default. Two new columns change the decision dimension, so pre-GEN-9
# checkpoints must not warm-start.
SEARCH_GEN = 9
# Transferable temporal structure (all train-anchored, all known for future
# fixtures — unlike autoregression, which needs unobserved future lags):
#   seg_risk_z: EB-shrunk per-segment speeding propensity from train history
#   exp_lag1:   within-window lagged exposure (buildup/dissipation)
#   clock_prof: fixture-type x rel_bin empirical event-clock shape
SPLIT_CODES = ["NRL", "ALeague", "SuperRugby"]
RISK_VARS = ["seg_risk_z"]
LAG_VARS = ["exp_lag1"]
CLOCK_VARS = ["clock_prof"]
# Per-segment GAME uplift: does this segment's own rate rise on game days
# relative to its own background? Estimated EB-shrunk from train event vs
# background sums, standardised, and transferable to future fixtures (no
# future lags). This is the direct "which streets respond to games" signal;
# seg_risk_z only carries the overall level.
EVENT_UPLIFT_VARS = ["seg_event_uplift_z"]
TIME_X_VARS = RISK_VARS + LAG_VARS + CLOCK_VARS + EVENT_UPLIFT_VARS + ["flow_anom"]
FAMILY_ORDER = ["telematics", "weather", "game", "temporal", "geometry",
                "calendar", "other"]


def term_family(term):
    """Characteristic family of a spec term (for convergence attribution).

    Answers "which kind of information entered when": telematics outputs
    (flows/exposure/uplifts), weather, game info, temporal shape, road
    geometry, calendar. Suffixes (":normal") stripped before matching.
    """
    t = str(term).split(":")[0]
    if t in tuple(WEATHER_COLS) or t.startswith(("rain", "temp", "weather")):
        return "weather"
    if t in tuple(TEMPORAL_VARS):
        return "temporal"
    if t in tuple(GAME_VARS) or t in tuple(GAME_WIDE_VARS) or t.startswith(
            ("fxt_", "ko_", "big_game", "clock", "in_event", "rel_hour",
             "log_att", "attendance", "event_x_dist", "dist_stad")):
        return "game"
    if t in tuple(CAL_VARS) or t in tuple(DOW_DUMMIES) or t.startswith(
            ("tod_", "dow_", "weekend")):
        return "calendar"
    if (t in tuple(TIME_X_VARS) or "flow" in t or "exp" in t or "trips" in t
            or "vehicle" in t or "uplift" in t or t.startswith("aadt")
            or t == "logexp" or t.startswith("seg_")):
        return "telematics"
    if t.startswith(("hw_", "lanes", "maxspeed", "curv", "length", "log_length",
                     "node_degree", "dist_inter")):
        return "geometry"
    return "other"
# Segment-identity term for the grouped (role 4) effect.
#
# This started as a CONSTANT 1.0 column, on the reasoning that a
# within-group-constant covariate makes the grouped coefficient a pure
# per-segment random intercept. That is right about the algebra and wrong
# about this package: build_spec() screens every variable for
# identifiability and rejects any with a single unique value --
#   "variable 'seg_group_id' was flagged unidentifiable (only one unique
#    value) but assigned role 4"
# so the whole structure came back None, fitness() returned the 1e12
# sentinel, and the probe reported the segment identity as untestable.
#
# A varying column is required. Any covariate that is constant WITHIN a
# group achieves the same thing: its grouped coefficient is estimated
# from how the groups differ in that covariate, which for a per-segment
# grouping is precisely a segment-level propensity contrast. log_length
# is constant within a segment and is therefore the natural carrier.
SEG_GROUP_VAR = "log_length"


def _utcnow_iso():
    return time.strftime("%Y-%m-%dT%H:%M:%S")


def _write_json_atomic(path, payload):
    path = Path(path)
    tmp = path.with_suffix(path.suffix + ".tmp")
    tmp.write_text(json.dumps(payload, indent=2, default=str))
    os.replace(tmp, path)
    return path


def _clear_jax_caches():
    if jax is not None:
        try:
            jax.clear_caches()
        except Exception:  # noqa: BLE001
            pass
    gc.collect()


def _spearman(a, b):
    a = np.asarray(a, dtype=float)
    b = np.asarray(b, dtype=float)
    mask = np.isfinite(a) & np.isfinite(b)
    a, b = a[mask], b[mask]
    if len(a) < 10:
        return float("nan")
    ra = np.array(pd.Series(a).rank(), dtype=float)
    rb = np.array(pd.Series(b).rank(), dtype=float)
    ra -= ra.mean()
    rb -= rb.mean()
    denom = np.sqrt((ra ** 2).sum() * (rb ** 2).sum())
    return float((ra * rb).sum() / max(denom, 1e-12))


def _jaccard_topk(obs, pred, k):
    obs = np.asarray(obs, dtype=float)
    pred = np.asarray(pred, dtype=float)
    k = int(min(k, len(obs)))
    if k <= 0:
        return float("nan")
    top_obs = set(np.argsort(-obs, kind="stable")[:k].tolist())
    top_pred = set(np.argsort(-pred, kind="stable")[:k].tolist())
    return float(len(top_obs & top_pred) / max(len(top_obs | top_pred), 1))


def _calibration(obs, pred):
    obs = np.asarray(obs, dtype=float)
    pred = np.asarray(pred, dtype=float)
    mask = np.isfinite(obs) & np.isfinite(pred)
    obs, pred = obs[mask], pred[mask]
    if len(obs) < 10 or np.var(pred) <= 0:
        return float("nan"), float("nan")
    slope, intercept = np.polyfit(pred, obs, 1)
    return float(slope), float(intercept)


def load_panel(path, target=None):
    """Read the panel with the columns this run actually needs.

    The requested target is added to CHECKPOINT_COLS rather than assumed to be
    in it. CHECKPOINT_COLS carries TARGET_DEFAULT, so a run given any other
    --target used to read a frame without its own response column and then die
    far downstream inside the search with a bare KeyError. That is a trap worth
    removing now that the target is a deliberate, changeable decision.
    """
    cols = list(CHECKPOINT_COLS)
    if target and target not in cols:
        cols.append(target)
    cols = list(dict.fromkeys(cols))
    if Path(path).exists():
        available = set(_pq_names(path))
        missing = [c for c in cols if c not in available]
        if missing:
            raise SystemExit(
                "panel %s is missing %s. Rebuild it with\n"
                "  python scripts/58_build_15min_panel.py --all\n"
                "(delete the existing results/segment_15min_panel_????-??.parquet "
                "first -- finalize skips months that are already present)."
                % (path, ", ".join(missing)))
        return pd.read_parquet(path, columns=cols)
    parts = sorted(RES.glob("segment_15min_panel_????-??.parquet"))
    if not parts:
        raise SystemExit("no 15-min panel found (run 58 first)")
    return pd.concat([pd.read_parquet(p, columns=cols)
                      for p in parts], ignore_index=True)


def _pq_names(path):
    import pyarrow.parquet as pq
    return set(pq.ParquetFile(path).schema_arrow.names)


def _assert_split(cal, future_ids, train_ids):
    """Fail loudly if the holdout is not actually held out.

    Three invariants, each of which was violated by the old label-based
    split: fixture_ids must be unique; train and future must partition the
    calendar exactly; and no future row may sit earlier in time than any
    train row (a future label matching a 2025 twin is exactly this bug).
    """
    ids = cal["fixture_id"]
    if bool(ids.duplicated().any()):
        dupes = sorted(ids[ids.duplicated(keep=False)].unique())
        raise SystemExit(f"FATAL: fixture_id is not unique: {dupes[:5]}")
    overlap = future_ids & train_ids
    if overlap:
        raise SystemExit(f"FATAL: {len(overlap)} fixtures are in BOTH train "
                         f"and future: {sorted(overlap)[:5]}")
    if (future_ids | train_ids) != set(ids):
        raise SystemExit("FATAL: train/future do not partition the calendar")
    fut = cal[cal["fixture_id"].isin(future_ids)]
    trn = cal[cal["fixture_id"].isin(train_ids)]
    if len(fut) and len(trn):
        latest_train = trn["ko"].max()
        earliest_future = fut["ko"].min()
        if earliest_future < latest_train:
            raise SystemExit(
                f"FATAL: holdout is interleaved with train. latest train "
                f"kickoff {latest_train} >= earliest future kickoff "
                f"{earliest_future}; the 'future' fixtures must all postdate "
                "every training fixture")


def load_fixtures():
    cal = pd.read_csv(CAL)
    cal["ko"] = pd.to_datetime(cal["kickoff_iso"]).dt.tz_localize(TZ)
    cal["attendance"] = pd.to_numeric(cal["attendance"], errors="coerce")
    cal = cal.sort_values("ko").reset_index(drop=True)
    # `label` is NOT unique: the same fixture appears in both the 2025 and
    # 2026 seasons (NRL Broncos-Eels, NRL Broncos-Dolphins and SuperRugby
    # Reds-Waratahs each have two rows). Every downstream selection keyed on
    # the label alone therefore matched both seasons, so the "future" holdout
    # pulled in three 2025 games WITH observed counts, and those same games
    # were dropped from training too (train = all labels - future labels).
    #
    # fixture_id is the unique per-row key (label + kickoff date). All
    # train/future selection now goes through it; `label` is kept for display.
    cal["fixture_id"] = (cal["label"].astype(str)
                         + " @ " + cal["ko"].dt.strftime("%Y-%m-%d %H:%M"))
    dup = cal["label"].duplicated(keep=False)
    if bool(dup.any()):
        print(f"   NOTE: {int(dup.sum())} calendar rows share a label with "
              f"another row across {cal.loc[dup, 'label'].nunique()} names; "
              "using fixture_id for the train/future split")
    return cal


def static_context():
    feats = pd.read_csv(FEATS)
    feats["road_osmid"] = pd.to_numeric(feats["road_osmid"], errors="coerce")
    feats = feats.dropna(subset=["road_osmid"]).copy()
    feats["road_osmid"] = feats["road_osmid"].astype(np.int64)
    feats = feats.groupby("road_osmid").first().reset_index()
    ecf = pd.read_csv(ECF, usecols=["road_osmid", "highway", "dist_stadium_km"])
    ecf["road_osmid"] = pd.to_numeric(ecf["road_osmid"], errors="coerce")
    ecf = ecf.dropna(subset=["road_osmid"]).copy()
    ecf["road_osmid"] = ecf["road_osmid"].astype(np.int64)
    ecf = ecf.groupby("road_osmid").first().reset_index()
    ctx = feats.merge(ecf, on="road_osmid", how="left")
    # lanes: 3,810 of 7,825 segments (48.7%) have no OSM lanes tag, and the
    # gap is structural rather than random -- coverage runs from 8.9% on
    # service roads to 100% on motorway. Filling the gap with 1 (as
    # requested) asserts every untagged road is single-lane, which is
    # backwards for service roads (kerbside, usually multi-lane) and would
    # bias lanes_z exactly where the search is trying to estimate it. So:
    # fill with 1 as asked, and carry lanes_known so the model can correct
    # for the fill instead of inheriting it. The indicator is searchable
    # (CONT_VARS), so BIC decides whether the gap carries information.
    _lanes_raw = pd.to_numeric(ctx["lanes"], errors="coerce")
    for col in ("maxspeed_kmh", "lanes", "curvature_deg_km",
                "dist_to_intersection_m", "node_degree", "length_m"):
        ctx[col] = pd.to_numeric(ctx[col], errors="coerce")
        ctx[col] = ctx[col].fillna(float(ctx[col].median()))
    # Applied AFTER the median fill above so the 1 wins for untagged rows.
    ctx["lanes"] = _lanes_raw.fillna(1.0)
    ctx["lanes_known"] = (~_lanes_raw.isna()).astype(float)
    # Missing OSM `highway` tag -> "unclassified", not a synthetic "unknown".
    # 2,744 of 7,825 segments (35%) have no tag, and "unknown" was being
    # searched as its own dummy: hw_unknown came back Fixed in the 61b spec,
    # so a third of the network carried a private coefficient. OSM's own
    # convention is that untagged ways are unclassified, and the real
    # unclassified class is tiny (232 segments), so this merges a large
    # spurious group into a small real one instead of the reverse.
    _hw = ctx["highway"].astype("string").str.strip().str.lower()
    _hw = _hw.replace("", pd.NA).fillna("unclassified")
    ctx["highway"] = _hw.astype(str)
    ctx["dist_stadium_km"] = pd.to_numeric(ctx["dist_stadium_km"],
                                           errors="coerce")
    ctx["dist_stadium_km"] = ctx["dist_stadium_km"].fillna(
        float(ctx["dist_stadium_km"].median()))
    for base, out in (("lanes", "lanes_z"), ("maxspeed_kmh", "maxspeed_z"),
                      ("curvature_deg_km", "curvature_z"),
                      ("dist_to_intersection_m", "dist_inter_z"),
                      ("node_degree", "node_degree_z")):
        std = float(ctx[base].std())
        ctx[out] = (ctx[base] - float(ctx[base].mean())) / (std if std > 0 else 1.0)
    ctx["log_length"] = np.log1p(ctx["length_m"].clip(lower=0.0))
    # AADT hook: prefer TMR-joined data/segment_aadt.csv (road_osmid, aadt)
    # when present; otherwise the probe-flow proxy is built later per frame
    # (log_flow_z from seg_flow / vehicle_count) and searched alongside
    # geometry. Either way AADT enters as a candidate and survives only if
    # BIC-significant (random-parameter allowed).
    try:
        if AADT_CSV.exists():
            _a = pd.read_csv(AADT_CSV)
            _a["road_osmid"] = pd.to_numeric(_a["road_osmid"], errors="coerce")
            _a = _a.dropna(subset=["road_osmid"]).copy()
            _a["road_osmid"] = _a["road_osmid"].astype(np.int64)
            _col = "aadt" if "aadt" in _a.columns else ("AADT" if "AADT" in _a.columns else None)
            if _col is not None:
                _a[_col] = pd.to_numeric(_a[_col], errors="coerce")
                ctx = ctx.merge(_a[["road_osmid", _col]].rename(columns={_col: "aadt"}),
                                on="road_osmid", how="left")
                _m, _s = float(ctx["aadt"].median()), float(ctx["aadt"].std())
                ctx["aadt"] = ctx["aadt"].fillna(_m)
                ctx["aadt_z"] = (ctx["aadt"] - float(ctx["aadt"].mean())) / (_s if _s > 0 else 1.0)
    except Exception:
        pass
    # Winsorize standardized candidates: one degenerate segment (e.g. 45 m
    # with imputed lanes + top-capped AADT, see o25899100 where a single
    # osmid hogged 84% of predicted speeding) must not drive the
    # correlated random slopes to 250x explosions.
    for _zc in [c for c in ctx.columns if c.endswith("_z")]:
        _zv = pd.to_numeric(ctx[_zc], errors="coerce")
        ctx[_zc] = _zv.replace([np.inf, -np.inf], np.nan).fillna(0.0).clip(-3.0, 3.0)
    return ctx


def bin_ns_array(panel):
    """UTC epoch nanoseconds for the panel bin column (int64, no tz copies)."""
    return (panel["bin"].dt.tz_convert("UTC").dt.tz_localize(None)
            .to_numpy(dtype="datetime64[ns]").view("int64"))


def _window_bounds_ns(ko):
    start = ko + pd.Timedelta(hours=WINDOW_HOURS[0])
    end = ko + pd.Timedelta(hours=WINDOW_HOURS[1])
    s_ns = int(pd.Timestamp(start).tz_convert("UTC").value)
    e_ns = int(pd.Timestamp(end).tz_convert("UTC").value)
    return start, s_ns, e_ns


def covered_mask(bin_ns, cal):
    """Boolean mask of rows inside any fixture's [-3h, +4h) window."""
    mask = np.zeros(len(bin_ns), dtype=bool)
    for ko in cal["ko"]:
        _, s_ns, e_ns = _window_bounds_ns(ko)
        mask |= (bin_ns >= s_ns) & (bin_ns < e_ns)
    return mask


def sample_background(panel, bin_ns, covered, rng, sample_n):
    """Random off-window rows, sampled BEFORE any frame copy/enrichment.

    The previous version did panel.loc[~mask].copy() over ~60M rows for every
    call, then sampled -- which alone needed ~15-20GB before the search even
    started. Sampling integer positions first keeps this at ~sample_n rows.
    """
    cand = np.flatnonzero(~covered)
    if cand.size == 0:
        return panel.iloc[[]].copy()
    n = int(sample_n)
    if n and cand.size > n:
        picks = rng.choice(cand, n, replace=False)
        picks.sort()
    else:
        picks = cand
    return panel.iloc[picks].copy()


def window_rows(panel, bin_ns, ko, fixture_id):
    start, s_ns, e_ns = _window_bounds_ns(ko)
    idx = np.flatnonzero((bin_ns >= s_ns) & (bin_ns < e_ns))
    if idx.size == 0:
        return panel.iloc[[]].copy()
    sub = panel.iloc[idx].copy()
    # `fixture` is the UNIQUE fixture_id. Every downstream groupby/unique()
    # (metrics, MIP per-fixture loop, top-20 table) keys on this column, so
    # it must never be a label that repeats across seasons.
    sub["fixture"] = fixture_id
    sub["rel_bin"] = ((sub["bin"] - start) / pd.Timedelta(minutes=15)
                      ).astype(int).clip(0, REL_BINS - 1)
    return sub


def add_calendar(frame):
    dt = pd.to_datetime(frame["bin"], utc=True).dt.tz_convert(TZ)
    tod = dt.dt.hour + dt.dt.minute / 60.0
    dow = dt.dt.dayofweek
    frame["tod_sin"] = np.sin(2 * np.pi * tod / 24.0)
    frame["tod_cos"] = np.cos(2 * np.pi * tod / 24.0)
    frame["dow_sin"] = np.sin(2 * np.pi * dow / 7.0)
    frame["dow_cos"] = np.cos(2 * np.pi * dow / 7.0)
    frame["weekend"] = (dow >= 5).astype(float)
    frame["tod_quarter"] = dt.dt.hour * BINS_PER_HOUR + dt.dt.minute // 15
    frame["dow"] = dow
    for i in range(7):
        frame[f"dow_d{i}"] = (dow == i).astype(float)
    return frame


def build_profile(background):
    overall = float(background["vehicle_count"].mean())
    prof = (background.groupby(["dow", "tod_quarter"])["vehicle_count"].mean()
            / max(overall, 1e-9))
    return prof.to_dict()


def add_exposure(frame, ctx, seg_flow, profile):
    # Idempotent: drop previously derived columns first. A second call on an
    # already-exposed frame (e.g. the no-game twin, copied from the game
    # grid) would otherwise merge bin_factor onto itself -> bin_factor_x/_y
    # and KeyError downstream (o26642598: counterfactual failed on all 6
    # fixtures, killing game_lift and the SD comparison with it).
    frame = frame.drop(columns=["bin_factor", "exp", "logexp", "log_flow_z"],
                       errors="ignore")
    if profile:
        prof = pd.DataFrame(
            [(dow, quarter, factor) for (dow, quarter), factor
             in profile.items()],
            columns=["dow", "tod_quarter", "bin_factor"])
        frame = frame.merge(prof, on=["dow", "tod_quarter"], how="left")
        frame["bin_factor"] = frame["bin_factor"].fillna(1.0)
    else:
        frame["bin_factor"] = 1.0
    frame["exp"] = (frame["road_osmid"].map(seg_flow).fillna(0.0)
                    * frame["bin_factor"])
    frame["logexp"] = np.log1p(frame["exp"])
    # Probe AADT proxy (sample mean flow per segment): standardised for search.
    # If TMR AADT (aadt_z) already came via ctx, both compete and BIC decides.
    try:
        _lf = np.log1p(frame["road_osmid"].map(seg_flow).fillna(0.0).to_numpy(float))
        _m, _s = float(np.mean(_lf)), float(np.std(_lf))
        frame["log_flow_z"] = np.clip((_lf - _m) / (_s if _s > 0 else 1.0), -3.0, 3.0)
    except Exception:
        frame["log_flow_z"] = 0.0
    return frame


def _shrunk_ratio(y_sum, e_sum, prior, k):
    """(Y + k*prior) / (E + k). Shrink thin cells toward the global ratio.

    A raw Y/E blows up wherever the exposure sum is small (a rare segment
    with one busy 15-min bin), which would inject enormous fake variation
    into the offset. The pseudo-count k is in exposure units, so it plays
    the same role for both segments and time cells.
    """
    y = np.asarray(y_sum, dtype=float)
    e = np.asarray(e_sum, dtype=float)
    with np.errstate(divide="ignore", invalid="ignore"):
        r = (y + k * prior) / np.maximum(e + k, 1e-9)
    return np.where(np.isfinite(r) & (r > 0), r, prior)


def fit_exposure_calibration(frame, denom_col="trips_with_judged_speed",
                             k_seg=8.0, k_cell=40.0, min_rows=500):
    """Calibrate the flow proxy onto the OBSERVED trip denominator.

    WHY: the response is a count of speeding TRIPS, so its true
    denominator is the number of trips that actually got a speed reading.
    The offset in use is exp = seg_flow * bin_factor * uplift -- a TMR flow
    projection standing in for a denominator that stage 58 already
    measured. beta_exposure drifts off 1 because that proxy does not
    reproduce real trip counts, which is what the exposure LRT is picking
    up when it rejects the pinned offset at chi2(1)=364.

    Note the denominator is trips_with_judged_speed and NOT trip_count: a
    trip with no speed reading cannot be classified as speeding
    (trip_exceed is NaN and NaN > 10 is False), so unjudged trips would
    bias the rate down exactly where judging is worst -- motorways and
    night bins.

    Two-step shrunk multiplicative calibration:
      1. per-segment ratio  r_i    = (Y_i + k*g) / (E_i + k)
      2. per dow x tod ratio c_j   = (Y_j + k*g) / (E_j + k)
    with g the global Y/E ratio. Both are ratios on the SAME exp column the
    model already uses, so the calibrated exposure preserves the existing
    shape (and therefore still works in the future, where only exp exists)
    while fixing the level per segment and per time cell.

    This is a property of the network, not of the response, so it is
    estimated once on the training rows and then FROZEN for prediction.
    """
    if denom_col not in frame.columns or "exp" not in frame.columns:
        # Never bail silently. This exact silent return made the calibration
        # look "unavailable" in all five arms of job 26077240 when the real
        # cause was that the panel reader never loaded the column.
        _miss = [c for c in (denom_col, "exp") if c not in frame.columns]
        print(f"   [calib] cannot fit: missing {', '.join(_miss)} from the "
              f"frame. If {denom_col} is missing, check that "
              "CHECKPOINT_COLS includes it (the panel is read with a fixed "
              "column subset).")
        return None
    y = pd.to_numeric(frame[denom_col], errors="coerce")
    e = pd.to_numeric(frame["exp"], errors="coerce")
    ok = y.notna() & e.notna() & np.isfinite(e) & (e > 0)
    if int(ok.sum()) < min_rows:
        print(f"   [calib] only {int(ok.sum())} usable rows for "
              f"{denom_col}; skipping calibration")
        return None
    f = frame.loc[ok, ["road_osmid", "dow", "tod_quarter"]].copy() \
        if "dow" in frame.columns and "tod_quarter" in frame.columns \
        else frame.loc[ok, ["road_osmid"]].copy()
    f["_y"] = y[ok].to_numpy(float)
    f["_e"] = e[ok].to_numpy(float)

    g = float(f["_y"].sum() / max(f["_e"].sum(), 1e-9))
    if not np.isfinite(g) or g <= 0:
        print("   [calib] global Y/E ratio is not positive; skipping")
        return None

    seg = f.groupby("road_osmid")[["_y", "_e"]].sum()
    seg_ratio = _shrunk_ratio(seg["_y"].to_numpy(), seg["_e"].to_numpy(),
                              g, k_seg)
    cal = {"seg": {str(k): float(v) for k, v
                   in zip(seg.index, seg_ratio)},
           "seg_default": float(g), "k_seg": k_seg,
           "k_cell": k_cell, "n_rows": int(len(f)),
           "n_segments": int(len(seg)), "denom_col": denom_col}

    # Step 2 operates on the SEGMENT-ADJUSTED exposure, so the two steps
    # compose instead of fighting: cell ratios are estimated against
    # e * r_seg, not against the raw proxy. Estimating both against the raw
    # proxy and multiplying the results double-counts the global level --
    # each step is shrunk toward g, so the product lands near g^2 and the
    # offset ends up ~2x too small when g is near 0.5.
    _r_seg = np.array([cal["seg"].get(str(s), g)
                       for s in f["road_osmid"]], dtype=float)
    e1 = f["_e"].to_numpy(float) * _r_seg
    f["_e1"] = e1

    if "dow" in f.columns and "tod_quarter" in f.columns:
        cell = f.groupby(["dow", "tod_quarter"])[["_y", "_e1"]].sum()
        cell_ratio = _shrunk_ratio(cell["_y"].to_numpy(),
                                   cell["_e1"].to_numpy(), g, k_cell)
        cal["cell"] = {(str(a), str(b)): float(v) for (a, b), v
                       in zip(cell.index, cell_ratio)}
    else:
        cal["cell"] = {}

    # Final level from the FULL composition, so that
    # e * r_seg * r_cell * level reproduces sum(observed) exactly. The
    # offset is pinned at coefficient 1, so this level is not free: getting
    # it wrong biases the fitted exposure directly.
    _r_cell = np.array([cal["cell"].get((str(a), str(b)), 1.0)
                        for a, b in zip(f["dow"], f["tod_quarter"])],
                       dtype=float) if cal["cell"] else np.ones(len(f))
    e2 = e1 * _r_cell
    cal["level"] = float(f["_y"].sum() / max(e2.sum(), 1e-9))

    _r = np.array([v for v in cal["seg"].values() if np.isfinite(v)])
    if _r.size:
        print(f"   [calib] {denom_col}: {len(f):,} rows / "
              f"{cal['n_segments']:,} segments, global Y/E={g:.3f}, "
              f"final level={cal['level']:.3f}, seg ratio "
              f"p10/50/90={np.percentile(_r, 10):.2f}/"
              f"{np.percentile(_r, 50):.2f}/{np.percentile(_r, 90):.2f}")
    return cal


def calibrate_exposure(frame, cal):
    """Rewrite frame['exp'] onto the calibrated scale, in place.

    Writes `exp` rather than a new column so that logexp, the offset, and
    pred_flow all follow automatically -- prepare_metacount_frame derives
    logexp = log1p(exp), and the future path reads the same exp.
    """
    if not cal:
        return frame
    e = pd.to_numeric(frame["exp"], errors="coerce").fillna(0.0).to_numpy(float)
    seg = cal.get("seg") or {}
    if seg:
        _s = frame["road_osmid"].astype(str) if "road_osmid" in frame.columns \
            else None
        if _s is not None:
            dflt = cal.get("seg_default", 1.0)
            r = _s.map(seg).fillna(dflt).to_numpy(float)
        else:
            r = np.full(len(frame), cal.get("seg_default", 1.0), dtype=float)
    else:
        r = np.full(len(frame), 1.0, dtype=float)
    cell = cal.get("cell") or {}
    if cell and "dow" in frame.columns and "tod_quarter" in frame.columns:
        keys = list(zip(frame["dow"].astype(str), frame["tod_quarter"].astype(str)))
        c = np.array([cell.get(kk, 1.0) for kk in keys], dtype=float)
    else:
        c = np.full(len(frame), 1.0, dtype=float)
    out = np.maximum(e * r * c * float(cal.get("level", 1.0)), 1e-6)
    frame["exp"] = out
    frame["logexp"] = np.log1p(out)
    return frame


def add_exposure_shape(frame, params=None, hinge=False, interact_hw=False):
    """Curvature and road-class interaction on the log exposure.

    logexp is force-fixed, so with the offset pinned at 1 the model has no
    way to bend the flow->speeding curve. The exposure LRT is a test of
    exactly that curve. Two opt-in enrichments:

    hinge      : linear-hinge (piecewise linear) basis on logexp at two
                 frozen quantile knots, ORTHOGONALISED against
                 [1, logexp]. Without that projection the hinges correlate
                 ~0.65 with the forced linear term, which inflates their
                 standard errors and makes the BIC comparison against the
                 plain model unfair. The projection coefficients are
                 estimated once on TRAIN and stored in `params`, then
                 reapplied to the future path, so both use an identical
                 basis. A full natural cubic spline would be the textbook
                 choice, but the deviation form needs no spline machinery
                 that could behave differently between fit and prediction.
    interact_hw: logexp times each highway dummy, letting the flow
                 ELASTICITY differ by road class -- the standard
                 difference-in-slopes parameterisation. Deliberately NOT
                 centred: centring makes the model unable to represent a
                 pure slope difference, because non-reference rows then
                 force the intercept to zero while the centring constant
                 must simultaneously vanish. A more robust alternative to
                 trusting the per-class uplift u, since it changes the
                 elasticity rather than trying to fix the exposure scale
                 per class.

    Returns (frame, params). `params` is None unless something was added.
    """
    if not hinge and not interact_hw:
        return frame, params
    out = frame
    params = dict(params) if params else {}
    le = pd.to_numeric(out["logexp"], errors="coerce")
    le = le.replace([np.inf, -np.inf], np.nan)
    le_v = le.fillna(0.0).to_numpy(float)
    finite = np.isfinite(le_v) & np.isfinite(le.to_numpy(float))

    if hinge:
        knots = params.get("knots")
        if not knots:
            q = le.dropna()
            knots = ([float(np.quantile(q, 0.50)),
                      float(np.quantile(q, 0.80))] if len(q) >= 100 else None)
        if knots:
            params["knots"] = [float(k) for k in knots]
            hs = [np.maximum(0.0, le_v - k) for k in knots]
            # Orthogonalise against the forced linear term. Coefficients are
            # estimated on the first call (train) and reused afterwards.
            ortho = params.get("ortho")
            if not ortho:
                base = np.column_stack([np.ones(len(le_v)), le_v])[finite]
                ortho = []
                for h in hs:
                    bh, *_ = np.linalg.lstsq(base, h[finite], rcond=None)
                    ortho.append([float(bh[0]), float(bh[1])])
                params["ortho"] = ortho
            for i, (h, c) in enumerate(zip(hs, ortho), 1):
                out[f"logexp_h{i}"] = h - (c[0] + c[1] * le_v)
            print(f"   exposure shape: hinge knots at "
                  f"{[round(k, 3) for k in knots]}, orthogonalised")

    if interact_hw:
        _hw = [c for c in out.columns if c.startswith("hw_")]
        for c in _hw:
            _d = pd.to_numeric(out[c], errors="coerce").fillna(0.0)
            out[f"logexp_x_{c}"] = le_v * _d.to_numpy(float)
        if _hw:
            print(f"   exposure shape: logexp x {len(_hw)} highway classes")
    return out, (params if params else None)


def add_static(frame, ctx):
    merged = frame.merge(ctx, on="road_osmid", how="left")
    for col in CONT_VARS:
        merged[col] = merged[col].fillna(0.0)
    if "aadt_z" in merged.columns:
        merged["aadt_z"] = pd.to_numeric(merged["aadt_z"], errors="coerce").fillna(0.0)
    merged["dist_stad"] = merged["dist_stadium_km"].fillna(
        float(ctx["dist_stadium_km"].median()))
    # Keep in step with static_context(): a left-join miss on highway means
    # the segment was absent from the ECF entirely, which is the same
    # untagged case, so it takes "unclassified" rather than reviving the
    # "unknown" dummy that static_context() no longer emits.
    merged["highway"] = (merged["highway"].astype("string")
                         .fillna("unclassified").astype(str))
    return merged


def add_game_temporal(frame):
    """Within-window temporal shape (AR(1) substitute).

    metacountregressor has no autoregressive term, so the rise/peak/decay
    around kickoff is encoded explicitly: quadratic + Fourier pair over the
    28-bin window plus pre/post-kickoff steps. KO is at rel_bin 12
    (rel_hour 0); full-time ~ rel_hour +2.
    """
    rh = pd.to_numeric(frame["rel_bin"], errors="coerce").fillna(0.0).to_numpy(float)
    rel_hour = rh / BINS_PER_HOUR + WINDOW_HOURS[0]
    frame["rel_hour_sq"] = rel_hour ** 2
    frame["rel_sin"] = np.sin(2 * np.pi * rh / REL_BINS)
    frame["rel_cos"] = np.cos(2 * np.pi * rh / REL_BINS)
    frame["pre_game"] = (rel_hour < 0).astype(float)
    frame["post_game"] = (rel_hour > 2.0).astype(float)
    return frame


def add_game_wide(frame, crowd_med=None):
    """Fixture-attribute + spatiotemporal interaction candidates.

    Expects columns: fixture_type, ko_hour, attendance, log_att, rel_hour,
    dist_stad, lanes_z, in_event (background rows carry zeros/empty and
    degrade gracefully). crowd_med anchors the big_game tier to the TRAIN
    attendance distribution so future tiers are model-consistent.
    """
    n = len(frame)
    fxt = frame["fixture_type"].fillna("").astype(str) if "fixture_type" in frame.columns else pd.Series([""] * n, index=frame.index)
    frame["fxt_NRL"] = (fxt == "NRL").astype(float)
    frame["fxt_ALeague"] = (fxt == "ALeague").astype(float)
    att = pd.to_numeric(frame["attendance"], errors="coerce").fillna(0.0).to_numpy(float) if "attendance" in frame.columns else np.zeros(n)
    med = float(crowd_med) if crowd_med is not None and np.isfinite(float(crowd_med)) and float(crowd_med) > 0 else float(np.median(att)) if n else 0.0
    frame["big_game"] = (att >= max(med, 1.0)).astype(float)
    koh = pd.to_numeric(frame["ko_hour"], errors="coerce").fillna(0.0).to_numpy(float) if "ko_hour" in frame.columns else np.zeros(n)
    frame["ko_tod_sin"] = np.sin(2 * np.pi * koh / 24.0)
    frame["ko_tod_cos"] = np.cos(2 * np.pi * koh / 24.0)
    rh = pd.to_numeric(frame["rel_hour"], errors="coerce").fillna(0.0).to_numpy(float) if "rel_hour" in frame.columns else np.zeros(n)
    la = pd.to_numeric(frame["log_att"], errors="coerce").fillna(0.0).to_numpy(float) if "log_att" in frame.columns else np.zeros(n)
    ds = pd.to_numeric(frame["dist_stad"], errors="coerce").fillna(0.0).to_numpy(float) if "dist_stad" in frame.columns else np.zeros(n)
    lz = pd.to_numeric(frame["lanes_z"], errors="coerce").fillna(0.0).to_numpy(float) if "lanes_z" in frame.columns else np.zeros(n)
    ie = pd.to_numeric(frame["in_event"], errors="coerce").fillna(0.0).to_numpy(float) if "in_event" in frame.columns else np.zeros(n)
    frame["rel_x_dist"] = rh * ds
    frame["att_x_dist"] = la * ds
    frame["ev_x_lanes"] = ie * lz
    mz = pd.to_numeric(frame["maxspeed_z"], errors="coerce").fillna(0.0).to_numpy(float) if "maxspeed_z" in frame.columns else np.zeros(n)
    ll = pd.to_numeric(frame["log_length"], errors="coerce").fillna(0.0).to_numpy(float) if "log_length" in frame.columns else np.zeros(n)
    frame["att_x_lanes"] = la * lz
    frame["att_x_maxspeed"] = la * mz
    frame["att_x_length"] = la * ll
    frame["ko_x_dist"] = koh * ds
    # NOTE: evu_x_att is NOT computed here. seg_event_uplift_z is attached by
    # apply_temporal_x, which runs AFTER this function in every frame path
    # (build_game_frame -> ... -> apply_temporal_x), so computing it here
    # silently produced an all-zero column and the search could never use it.
    # apply_temporal_x owns the interaction.
    return frame


def estimate_seg_risk(train_events, target, pseudo_exp=20.0):
    """EB-shrunk per-segment speeding propensity from TRAIN windows only.

    risk_s = (Y_s + k*r0) / (E_s + k): segments with little exposure shrink
    to the global rate r0. Standardised across segments; unseen segments map
    to 0. Call BEFORE row-sampling (needs full-window sums, not samples).
    """
    g = train_events.groupby("road_osmid").agg(
        Y=(target, "sum"), E=("exp", "sum"))
    r0 = float(g["Y"].sum() / max(g["E"].sum(), 1e-9))
    risk = (g["Y"] + pseudo_exp * r0) / (g["E"] + pseudo_exp)
    mu, sd = float(risk.mean()), float(risk.std())
    return (((risk - mu) / (sd if sd > 0 else 1.0)).to_dict(), r0)


def estimate_seg_event_uplift(train_events, bg_sums, target, denom_col,
                              pseudo_exp=20.0):
    """EB-shrunk per-segment GAME uplift: event rate vs its own background.

        u_s = log((Y_ev+k*p0)/(E_ev+k)) - log((Y_bg+k*p0)/(E_bg+k))

    where Y/E are target and measured-denominator sums over train event
    windows and over all background (non-fixture) bins, p0 is the pooled
    rate, and k shrinks thin segments toward "no uplift". Standardised
    across segments; unseen segments map to 0.

    WHY THIS AND NOT seg_risk_z. seg_risk_z is the segment's overall level
    (busy streets are busy in and out of games). This contrast is the part
    that is SPECIFIC to game days, which is the only thing that can reorder
    segments for a deployment plan. It is train-anchored, so it transfers
    to future fixtures (unlike an autoregressive term).
    """
    if (train_events is None or len(train_events) == 0
            or bg_sums is None or len(bg_sums) == 0):
        return {}
    if target not in train_events.columns or denom_col not in train_events.columns:
        return {}
    ev = (train_events.groupby("road_osmid")[[target, denom_col]]
          .sum().rename(columns={target: "Y_ev", denom_col: "E_ev"}))
    bg = bg_sums.rename(columns={target: "Y_bg", denom_col: "E_bg"})
    j = ev.join(bg, how="inner")
    if j.empty:
        return {}
    p0 = float(j["Y_ev"].sum() + j["Y_bg"].sum()) / max(
        float(j["E_ev"].sum() + j["E_bg"].sum()), 1e-9)
    k = float(pseudo_exp)
    r_ev = (j["Y_ev"] + k * p0) / (j["E_ev"] + k)
    r_bg = (j["Y_bg"] + k * p0) / (j["E_bg"] + k)
    u = np.log(np.maximum(r_ev, 1e-12)) - np.log(np.maximum(r_bg, 1e-12))
    mu, sd = float(u.mean()), float(u.std())
    if not np.isfinite(mu) or not np.isfinite(sd) or sd <= 0:
        return {}
    return ((u - mu) / sd).to_dict()


def estimate_clock_prof(train_events, target):
    """Fixture-type x rel_bin empirical event-clock shape (TRAIN only).

    Mean target rate per (fixture_type, rel_bin), normalised per code and
    smoothed. A nonparametric shape the sparse 15-min search keeps rejecting
    as parametric curvature — estimated pooled, so it survives aggregation.
    """
    if "fixture_type" not in train_events.columns:
        return {}
    g = train_events.groupby(["fixture_type", "rel_bin"])[target].mean()
    prof = {}
    for ft in g.index.get_level_values(0).unique():
        v = g.loc[str(ft)].reindex(range(REL_BINS))
        v = v.fillna(v.mean()).fillna(0.0)
        m = float(v.mean())
        v = (v / max(m, 1e-9)).rolling(3, center=True,
                                       min_periods=1).mean()
        prof[str(ft)] = v.to_numpy(float)
    return prof


def estimate_flow_anomaly(panel, cal, train_ids, future_ids, seed=7):
    """Per-segment trailing same-DOW flow anomaly (memory-safe).

    WHY (collapsed telematics): exposure enters as static seg_flow x one
    global uplift curve, so no predictor varies by segment x game and the
    ranking cannot reorder streets. This builds the missing segment x game
    telematics WITHOUT materialising history per row: one (road_osmid, date)
    aggregate (~3M rows transient), then per-fixture / per-week lookups.
    NOT a static mean: the baseline is the same-DOW mean 5-11 weeks back,
    the signal the trailing 4 same-DOW occurrences (1-4 weeks back), both
    strictly past-only and known before kickoff. log-ratio, winsorized +-3.
    Returns (anom_by_fixture, anom_by_weekkey, audit) where week keys are
    (week_monday, dow) -> Series(seg -> anom).
    """
    audit = {"estimated": False}
    try:
        _bin = pd.to_datetime(panel["bin"], utc=True).dt.tz_convert(TZ)
        # tz-naive Brisbane wall time everywhere below: mixing aware/naive
        # datetimes raises "Invalid comparison ..." (o26613390) and zeroes
        # the whole anomaly.
        _date = _bin.dt.normalize().dt.tz_localize(None)
        _dow = _bin.dt.dayofweek.to_numpy()
        _seg = pd.to_numeric(panel["road_osmid"], errors="coerce").to_numpy()
        _v = pd.to_numeric(panel["vehicle_count"], errors="coerce").fillna(0.0).to_numpy(float)
        del _bin
        _fut_ko = pd.to_datetime(
            cal[cal["fixture_id"].isin(set(future_ids))]["ko"],
            utc=True).dt.tz_convert(TZ).dt.tz_localize(None)
        _cutoff = _fut_ko.min().normalize() if len(_fut_ko) else _date.max()
        if getattr(_cutoff, "tzinfo", None) is not None:
            _cutoff = _cutoff.tz_localize(None)
        _daily = pd.DataFrame({"seg": _seg, "date": _date.to_numpy(),
                               "dow": _dow, "v": _v})
        del _seg, _v, _date, _dow
        _daily = (_daily[_daily["date"] < _cutoff.to_numpy()]
                  .groupby(["seg", "date", "dow"], observed=True)["v"].sum())
        # NB: _daily is already the ("v") Series from the groupby above, so
        # aggregate its values directly (["v"]] here raised "Column not
        # found: v", zeroing the whole anomaly in o26650291).
        _mat = _daily.groupby(["seg", "date"]).sum().unstack(fill_value=0.0)
        del _daily
        _dates = pd.to_datetime(_mat.columns)
        _cols = {pd.Timestamp(d).normalize(): d for d in _dates}
        _dows = _dates.dayofweek.to_numpy()

        def _window_mean(ref, lags):
            _cc = [_cols.get((ref - pd.Timedelta(days=int(k))).normalize())
                   for k in lags]
            _cc = [c for c in _cc if c is not None]
            if not _cc:
                return None
            return _mat[_cc].mean(axis=1)

        def _anom(trail, base):
            _a = (np.log1p(trail.fillna(0.0).to_numpy(float))
                  - np.log1p(base.reindex(trail.index).fillna(0.0).to_numpy(float)))
            return pd.Series(np.clip(_a, -3.0, 3.0), index=trail.index)

        _ko = dict(zip(cal["fixture_id"].astype(str),
                         pd.to_datetime(cal["ko"], utc=True).dt.tz_convert(TZ).dt.tz_localize(None)))
        _all_fx = [str(f) for f in list(train_ids) + list(future_ids)]
        anom_fx, _cov = {}, []
        for _fx in _all_fx:
            _k = _ko.get(_fx, None)
            if _k is None:
                continue
            _kd = _k.normalize()
            _trail = _window_mean(_kd, range(1, 29))
            _bd = _kd.dayofweek
            # Same-DOW baseline occurrences 5-11 weeks back (no overlap with
            # the trailing 1-4 week signal window).
            _same = [(_kd - pd.Timedelta(days=35 + _d * 7)).normalize()
                     for _d in range(7)]
            _same = [c for c in _same if c in _cols]
            if _trail is None or not _same:
                continue
            _base = _mat[[_cols[c] for c in _same]].mean(axis=1)
            _s = _anom(_trail, _base)
            anom_fx[_fx] = _s
            _cov.append(float((_trail > 0).mean()))
        # Background weeks: every Monday in span x DOW -> Series(seg).
        _mind = _mat.columns.min().normalize()
        _mons = pd.date_range(start=_mind - pd.Timedelta(days=_mind.dayofweek),
                              end=_cutoff, freq="W-MON")
        anom_wk = {}
        for _w in _mons:
            _w0 = _w.normalize()
            for _d in range(7):
                _ref = _w0 + pd.Timedelta(days=int(_d))
                _trail = _window_mean(_ref, range(1, 29))
                _same = [(_ref - pd.Timedelta(days=28 + _d * 7 + _k2)).normalize()
                         for _k2 in range(7)]
                _same = [c for c in _same if c in _cols]
                if _trail is None or not _same:
                    continue
                _base = _mat[[_cols[c] for c in _same]].mean(axis=1)
                anom_wk[(_w0, _d)] = _anom(_trail, _base)
        del _mat
        gc.collect()
        _all = np.concatenate([s.to_numpy(float) for s in anom_fx.values()]) \
            if anom_fx else np.array([0.0])
        audit = {"estimated": True, "n_fixtures": len(anom_fx),
                 "n_weekkeys": len(anom_wk),
                 "mean_coverage": round(float(np.mean(_cov)), 3) if _cov else 0.0,
                 "sd": round(float(_all.std()), 4)}
        print(f"   flow anomaly: {len(anom_fx)} fixtures, {len(anom_wk)} "
              f"week-keys, coverage={audit['mean_coverage']}, sd={audit['sd']}")
    except Exception as exc:  # noqa: BLE001 - candidate degrades to zero
        print(f"   WARN: flow-anomaly estimate failed ({exc})")
        return {}, {}, audit
    return anom_fx, anom_wk, audit


def apply_flow_anomaly(frame, anom_fx=None, anom_wk=None, by="fixture",
                       disabled=False):
    """Attach flow_anom (0.0 default when maps missing/disabled).

    by="fixture": keyed on frame["fixture"] (event + future grids).
    by="week": keyed on (row-week Monday, row DOW) (background rows).
    """
    if disabled or (not anom_fx and not anom_wk):
        if "flow_anom" not in frame.columns:
            frame["flow_anom"] = 0.0
        return frame
    out = pd.Series(0.0, index=frame.index)
    try:
        if by == "week":
            _dt = pd.to_datetime(frame["bin"], utc=True).dt.tz_convert(TZ).dt.tz_localize(None)
            _wk = (_dt.dt.normalize()
                   - pd.to_timedelta(_dt.dt.dayofweek, unit="D"))
            _dw = _dt.dt.dayofweek.to_numpy()
            for (_w, _d), _idx in frame.groupby([_wk, pd.Series(_dw, index=frame.index)]).groups.items():
                _s = (anom_wk or {}).get((pd.Timestamp(_w).normalize(), int(_d)), None)
                if _s is None:
                    continue
                out.loc[_idx] = frame.loc[_idx, "road_osmid"].map(_s).fillna(0.0)
        else:
            for _fx, _idx in frame.groupby("fixture").groups.items():
                _s = (anom_fx or {}).get(str(_fx), None)
                if _s is None:
                    continue
                out.loc[_idx] = frame.loc[_idx, "road_osmid"].map(_s).fillna(0.0)
    except Exception:  # noqa: BLE001 - partial attach keeps zeros
        pass
    frame["flow_anom"] = pd.to_numeric(out, errors="coerce").fillna(0.0).clip(-3.0, 3.0)
    return frame


def load_weather_daily():
    """Drop-in weather hook: data/weather_daily.csv (date,rain_mm,temp_max_c,...).

    Absent today (no weather in panel, hard-braking CSV or data/) -> ({}, [])
    and the search pool is unchanged. Add the file (one row per date,
    numeric columns) and its columns enter the fixed-only candidate pool,
    z-scored on pre-cutoff dates (no leakage), merged by date in every frame.
    Returns (weather_by_date dict, stats dict).
    """
    global WEATHER_COLS
    WEATHER_COLS = []
    _p = DATA / "weather_daily.csv"
    if not _p.is_file():
        return {}, {}
    try:
        _w = pd.read_csv(_p)
        _w["date"] = pd.to_datetime(_w["date"]).dt.normalize()
        _num = [c for c in _w.columns
                if c != "date"
                and pd.api.types.is_numeric_dtype(pd.to_numeric(_w[c], errors="coerce"))]
        if not _num:
            return {}, {}
        WEATHER_COLS = list(_num)
        _out, _stats = {}, {}
        for _c in _num:
            _s = pd.to_numeric(_w[_c], errors="coerce")
            _stats[_c] = (float(_s.mean()), float(_s.std()) if float(_s.std()) > 0 else 1.0)
            _out[_c] = dict(zip(_w["date"], _s))
        print(f"   weather: {len(_w)} days, cols={WEATHER_COLS}")
        return _out, _stats
    except Exception as exc:  # noqa: BLE001
        print(f"   WARN: weather load failed ({exc})")
        WEATHER_COLS = []
        return {}, {}


def apply_weather(frame, wmap=None, wstats=None, disabled=False):
    """Merge daily weather by row date; z-scored, 0.0 when missing."""
    if disabled or not wmap:
        return frame
    try:
        _dt = pd.to_datetime(frame["bin"], utc=True).dt.tz_convert(TZ).dt.normalize()
        for _c, _d in wmap.items():
            _m, _s = (wstats or {}).get(_c, (0.0, 1.0))
            frame[_c] = ((_dt.map(_d).astype(float) - _m) / _s).fillna(0.0).clip(-3.0, 3.0)
    except Exception:  # noqa: BLE001
        pass
    return frame


def apply_temporal_x(frame, seg_risk_map=None, clock_prof=None,
                     seg_event_uplift_map=None):
    """Attach seg_risk_z / clock_prof / exp_lag1 / seg_event_uplift_z."""
    n = len(frame)
    if seg_risk_map and "road_osmid" in frame.columns:
        frame["seg_risk_z"] = (frame["road_osmid"].map(seg_risk_map)
                               .fillna(0.0).astype(float))
    elif "seg_risk_z" not in frame.columns:
        frame["seg_risk_z"] = 0.0
    if seg_event_uplift_map and "road_osmid" in frame.columns:
        frame["seg_event_uplift_z"] = (
            frame["road_osmid"].map(seg_event_uplift_map)
            .fillna(0.0).astype(float))
    elif "seg_event_uplift_z" not in frame.columns:
        frame["seg_event_uplift_z"] = 0.0
    # Game-uplift x attendance, computed HERE because the uplift column only
    # exists after the block above. Responsive segments weigh more for bigger
    # crowds, so the ranking can differ between a 45k and a 39k game.
    _la = (pd.to_numeric(frame["log_att"], errors="coerce").fillna(0.0)
           .to_numpy(float) if "log_att" in frame.columns
           else np.zeros(len(frame)))
    frame["evu_x_att"] = (pd.to_numeric(frame["seg_event_uplift_z"],
                                        errors="coerce").fillna(0.0)
                          .to_numpy(float) * _la)
    if (clock_prof and "rel_bin" in frame.columns
            and "fixture_type" in frame.columns):
        rb = pd.to_numeric(frame["rel_bin"], errors="coerce").fillna(0).to_numpy(int).clip(0, REL_BINS - 1)
        ft = frame["fixture_type"].fillna("").astype(str).to_numpy()
        ones = np.ones(REL_BINS)
        frame["clock_prof"] = np.array(
            [np.asarray(clock_prof.get(f, ones), dtype=float)[b]
             for f, b in zip(ft, rb)], dtype=float)
    elif "clock_prof" not in frame.columns:
        frame["clock_prof"] = 1.0
    if ("exp" in frame.columns and "rel_bin" in frame.columns
            and "fixture" in frame.columns and "road_osmid" in frame.columns):
        order = frame.sort_values(["fixture", "road_osmid", "rel_bin"]).index
        lagged = frame.loc[order].groupby(["fixture", "road_osmid"])["exp"].shift(1)
        frame["exp_lag1"] = (lagged.reindex(frame.index)
                             .fillna(frame["exp"]).astype(float))
    elif "exp_lag1" not in frame.columns:
        frame["exp_lag1"] = (pd.to_numeric(frame["exp"], errors="coerce")
                             .fillna(0.0).astype(float)
                             if "exp" in frame.columns else 0.0)
    return frame


SD_EDGES = np.linspace(-30.0, 60.0, 19)


def _crc(s):
    import zlib
    return zlib.crc32(str(s).encode())


def _sd_limit(frame):
    """Speed limit per row: panel speed_limit, else ctx maxspeed_kmh."""
    for col in ("speed_limit", "maxspeed_kmh"):
        if col in frame.columns:
            v = pd.to_numeric(frame[col], errors="coerce")
            if v.notna().any():
                return v.fillna(v.median()).to_numpy(float)
    return np.full(len(frame), 50.0)


def fit_speed_density(df, min_rows=200, penetration=0.05, bin_hours=0.25,
                      kj_prior_real=120.0, kj_mode="theory", shrink_rows=2000.0):
    """Greenshields v = vf*(1 - k/kj) per highway class.

    JAM DENSITY IS NOT A STATISTICAL PARAMETER -- so it is not estimated.
    kj is set by road geometry: at standstill each vehicle occupies its
    length plus a gap, ~6-8 m, so kj_real ~ 120-165 veh/km/lane whatever
    the traffic. That is why kj_mode defaults to "theory": the knee is
    known physics, and letting the data choose it is what produced the
    noise-dominated spread (trunk_link 0.6 vs tertiary_link 1.0 on the same
    count scale, two classes with near-identical free-flow speed). Fitting
    it was fitting an extrapolation through data that never approaches jam.

    Only vf (free-flow speed) is estimated, because free-flow IS densely
    observed. So the model is pure prediction on one parameter and a
    physical constant on the other -- no EB, no shrinkage, no prior
    weighting.

    THE UNITS ARE NOT A BUG. k = q/v uses per-bin probe COUNTS, so it is a
    count-scale density:  k_real = k_cnt / (bin_hours * penetration). The
    theory knee on the count scale is kj_real*bin_hours*penetration
    (~120*0.25*0.05 = 1.5), which is exactly where the OLS estimates landed
    (0.6-3.0) -- so the count convention is consistent between fit and
    predict and only the ESTIMATOR was noisy.

    kj_mode:
      theory (default) - kj from geometry, vf fitted. Pure prediction.
      ols     - kj from the OLS slope (noisy; kept for the sensitivity arm).
      eb      - kj shrunk toward theory by near-jam support (superseded).

    Returns {class: (vf, kj)} plus '_diag' and the theory anchors for the
    audit.
    """
    d = pd.DataFrame({
        "cls": df["highway"].fillna("unclassified").astype(str)
        if "highway" in df.columns else "unclassified",
        "q": pd.to_numeric(df["vehicle_count"], errors="coerce").fillna(0.0)
        if "vehicle_count" in df.columns else 0.0,
        "v": pd.to_numeric(df["mean_vehicle_speed_kmh"], errors="coerce")
        if "mean_vehicle_speed_kmh" in df.columns else np.nan,
    })
    d = d[np.isfinite(d["v"].to_numpy()) & (d["v"].to_numpy() > 0)].copy()
    scales = 1.0 / max(float(bin_hours) * max(float(penetration), 1e-9),
                       1e-12)
    kj_thy = float(kj_prior_real) / scales    # count units
    mode = str(kj_mode or "theory").lower()

    def _one(g):
        """Return (vf, kj, diag). vf from data; kj per `mode`."""
        if len(g) < min_rows:
            return None
        k = (g["q"] / g["v"]).to_numpy(float)
        v = g["v"].to_numpy(float)
        cap = float(np.quantile(k, 0.99)) if len(k) else 0.0
        m = k <= max(cap, 1e-9)
        k, v = k[m], v[m]
        if len(k) < min_rows:
            return None
        # vf: intercept of v on k at k->0 is well identified (free-flow is
        # densely observed), so fit it on the LOW-density core only.
        klo = k <= np.quantile(k, 0.5)
        kk, vv = (k[klo], v[klo]) if klo.sum() >= min_rows else (k, v)
        A = np.vstack([np.ones_like(kk), kk]).T
        (a, b), _, _, _ = np.linalg.lstsq(A, vv, rcond=None)
        vf = float(np.clip(a, 5.0, 130.0))
        n_near = float((k >= 0.5 * kj_thy).sum())
        kj_ols = float(-vf / b) if b < -1e-9 else float("nan")
        if mode == "ols":
            kj = kj_ols if np.isfinite(kj_ols) else kj_thy
            kj = float(max(kj, 0.9 * kj_thy))
        elif mode == "eb":
            w = n_near / (n_near + max(float(shrink_rows), 1.0))
            kj = (w * kj_ols + (1.0 - w) * kj_thy) \
                if np.isfinite(kj_ols) else kj_thy
            kj = float(max(kj, 0.9 * kj_thy))
        else:
            kj = kj_thy
        diag = {"vf": round(vf, 2), "kj": round(float(kj), 3),
                "kj_mode": mode,
                "kj_ols": (round(float(kj_ols), 3)
                           if np.isfinite(kj_ols) else None),
                "n_near_jam": int(n_near), "n_rows": int(len(g)),
                "vf_fit_rows": int(len(kk))}
        return vf, kj, diag

    out, diag = {}, {}
    for cls, g in list(d.groupby("cls")) + [("_global", d)]:
        r = _one(g)
        if r is not None:
            out[str(cls)] = (r[0], r[1])
            diag[str(cls)] = r[2]
    out["_diag"] = diag
    out["_theory_kj_cnt"] = kj_thy
    out["_theory_kj_real"] = float(kj_prior_real)
    out["_density_scale"] = scales
    out["_kj_mode"] = mode
    return out


def fit_propensity_lookup(df, target):
    """Empirical speeding rate per (highway class, exceedance bin).

    exceedance e = observed speed - limit; rate = Y.sum()/veh.sum() per
    cell, smoothed. This is the SD loop's behavioural link: density ->
    speed -> exceedance -> rate. Fit on TRAIN windows only.
    """
    d = pd.DataFrame({
        "cls": df["highway"].fillna("unclassified").astype(str)
        if "highway" in df.columns else "unclassified",
        "q": pd.to_numeric(df["vehicle_count"], errors="coerce").fillna(0.0)
        if "vehicle_count" in df.columns else 0.0,
        "v": pd.to_numeric(df["mean_vehicle_speed_kmh"], errors="coerce")
        if "mean_vehicle_speed_kmh" in df.columns else np.nan,
        "y": pd.to_numeric(df[target], errors="coerce").fillna(0.0)
        if target in df.columns else 0.0,
    })
    d["lim"] = _sd_limit(df)
    d = d[np.isfinite(d["v"].to_numpy()) & (d["v"].to_numpy() > 0)].copy()
    d["e"] = d["v"] - d["lim"]
    d["bin"] = np.clip(np.digitize(d["e"].to_numpy(float), SD_EDGES) - 1,
                       0, len(SD_EDGES) - 2)
    nb = len(SD_EDGES) - 1
    out = {}
    for cls, g in list(d.groupby("cls")) + [("_global", d)]:
        agg = g.groupby("bin").agg(ys=("y", "sum"), qs=("q", "sum"))
        rate = (agg["ys"] / agg["qs"].clip(lower=1e-9)).reindex(
            range(nb), fill_value=np.nan)
        rate = rate.fillna(rate.mean()).fillna(0.0)
        rate = rate.rolling(3, center=True, min_periods=1).mean()
        out[str(cls)] = rate.to_numpy(float)
    return out


# ------------------------------------------------------------------ symbolic
# Genetic-programming form discovery for the SD loop (zero new deps).
# Trees are nested tuples: ('x',) | ('c',) | (op, left, right?) with ops
# +,-,*,pdiv (protected), neg, sq, sqrt(abs), nexp=exp(-abs), log1p(abs),
# squash=1/(1+exp(-x)). Shape is what GP searches: each tree is scored as
# y = a*f(x)+b with OLS (a,b) per evaluation, BIC = n*log(RSS/n)+k*log(n)
# with k = node count. Seeded with theory forms + elitism, so discovery can
# only tie-or-beat Greenshields/logistic; bounded by time budget with silent
# fallback to the fixed forms. Operates on BINNED data (tens of points), so
# a full run is seconds, not hours.
_GP_BINOPS = ("+", "-", "*", "/")
_GP_UNOPS = ("neg", "sq", "sqrt", "nexp", "log", "squash")


def _gp_eval(tree, x):
    with np.errstate(all="ignore"):
        if tree[0] == "x":
            return np.asarray(x, dtype=float)
        if tree[0] == "c":
            return np.ones_like(np.asarray(x, dtype=float))
        op = tree[0]
        if op in _GP_BINOPS:
            a = _gp_eval(tree[1], x)
            b = _gp_eval(tree[2], x)
            if op == "+":
                r = a + b
            elif op == "-":
                r = a - b
            elif op == "*":
                r = a * b
            else:
                r = a / np.where(np.abs(b) < 1e-6, np.sign(b) * 1e-6
                                 if np.any(b) else 1e-6, b)
            return r
        a = _gp_eval(tree[1], x)
        if op == "neg":
            return -a
        if op == "sq":
            return a * a
        if op == "sqrt":
            return np.sqrt(np.abs(a))
        if op == "nexp":
            return np.exp(-np.abs(np.clip(a, -50.0, 50.0)))
        if op == "log":
            return np.log1p(np.abs(a))
        # squash
        return 1.0 / (1.0 + np.exp(-np.clip(a, -50.0, 50.0)))


def _gp_nodes(tree):
    if tree[0] in ("x", "c"):
        return 1
    return 1 + sum(_gp_nodes(t) for t in tree[1:])


def _gp_random(rng, depth, full):
    if depth <= 0 or (not full and rng.random() < 0.35):
        return ("x",) if rng.random() < 0.7 else ("c",)
    if rng.random() < 0.6 or depth == 1:
        op = rng.choice(_GP_BINOPS)
        return (op, _gp_random(rng, depth - 1, full),
                _gp_random(rng, depth - 1, full))
    return (rng.choice(_GP_UNOPS), _gp_random(rng, depth - 1, full))


def _gp_subtrees(tree):
    yield tree
    for t in tree[1:]:
        if isinstance(t, tuple):
            yield from _gp_subtrees(t)


def _gp_replace(tree, target_id, new, _cid=None):
    if _cid is None:
        _cid = [0]
    if _cid[0] == target_id:
        return new
    if tree[0] in ("x", "c"):
        _cid[0] += 1
        return tree
    _cid[0] += 1
    return (tree[0],) + tuple(
        _gp_replace(t, target_id, new, _cid) if isinstance(t, tuple) else t
        for t in tree[1:])


def _gp_fitness(tree, x, y, w):
    try:
        f = np.asarray(_gp_eval(tree, x), dtype=float)
        m = np.isfinite(f)
        if m.sum() < 3 or np.std(f[m]) <= 1e-12:
            return np.inf, (0.0, 0.0)
        ff, yy, ww = f[m], y[m], w[m]
        A = np.vstack([ff, np.ones_like(ff)]).T * np.sqrt(ww)[:, None]
        yw = yy * np.sqrt(ww)
        (a, b), _, _, _ = np.linalg.lstsq(A, yw, rcond=None)
        resid = yy - (a * ff + b)
        rss = float(np.sum(ww * resid * resid))
        n = float(np.sum(ww > 0))
        if not np.isfinite(rss) or rss <= 0:
            return np.inf, (0.0, 0.0)
        bic = n * np.log(rss / max(n, 1e-9)) + _gp_nodes(tree) * np.log(max(n, 2.0))
        return float(bic), (float(a), float(b))
    except Exception:
        return np.inf, (0.0, 0.0)


def _gp_to_str(tree):
    if tree[0] == "x":
        return "x"
    if tree[0] == "c":
        return "1"
    sym = {"+": "+", "-": "-", "*": "*", "/": "/"} .get(tree[0], tree[0])
    if tree[0] in _GP_BINOPS:
        return f"({_gp_to_str(tree[1])} {sym} {_gp_to_str(tree[2])})"
    return f"{tree[0]}({_gp_to_str(tree[1])})"


def _gp_to_latex(tree):
    """Render a discovered tree as LaTeX math (infix, operator names)."""
    if tree[0] == "x":
        return "x"
    if tree[0] == "c":
        return "1"
    if tree[0] in _GP_BINOPS:
        a, b = _gp_to_latex(tree[1]), _gp_to_latex(tree[2])
        if tree[0] == "+":
            return f"{a} + {b}"
        if tree[0] == "-":
            return f"{a} - {b}"
        if tree[0] == "*":
            return f"{a} \\cdot {b}"
        return f"\\frac{{{a}}}{{{b}}}"
    a = _gp_to_latex(tree[1])
    if tree[0] == "neg":
        return f"-{a}"
    if tree[0] == "sq":
        return f"{a}^{{2}}"
    if tree[0] == "sqrt":
        return f"\\sqrt{{|{a}|}}"
    if tree[0] == "nexp":
        return f"e^{{-|{a}|}}"
    if tree[0] == "log":
        return f"\\log(1 + |{a}|)"
    return f"\\sigma({a})"


def _tex_num(v, nd=2, default="--"):
    try:
        f = float(v)
        if not np.isfinite(f):
            return default
        return f"{f:.{nd}f}"
    except Exception:
        return default


def write_math_program(out_dir, audit, metrics, sd_fig=None):
    """Auto-generate game_day_mathprog.tex: the PURELY STATISTICAL programme
    for per-segment crash-count prediction, with FITTED numbers.

    Y_{ist} ~ NB/Mallows count regression (searched fixed + random terms,
    Laplace posterior mean) x binomial propensity, EB-shrunk per segment,
    calibrated, aggregated per segment and rescaled to network scale. No
    simulation dynamics enter: every line below is the fitted statistical
    model that ships the P6 roster surface. Self-contained paragraph +
    equations + fitted-coefficients table; the manuscript \\input's it (see
    63_paper_assets.pbs copy step). sd_fig is accepted for compatibility
    and ignored: the statistical programme carries no simulation figure.
    """
    out_dir = Path(out_dir)
    audit = audit or {}
    m = metrics or {}
    refit = audit.get("refit") or {}
    prop = audit.get("propensity") or {}
    ts = audit.get("two_stage") or {}
    target = audit.get("target", "trips_mean_gt_10")
    # Fitted count-model fixed effects from the shipped coefs table (written
    # just before this call). Random-parameter rows (mean()/sd()/group_)
    # are reported separately below, not as fixed effects.
    fixed_rows = []
    rdm_rows = []
    try:
        _cdf = pd.read_csv(out_dir / "game_day_model_coefs.csv")
        for _, _r in _cdf.iterrows():
            _v = str(_r["variable"])
            _t = (float(_r["coefficient"]), float(_r["std_err"]),
                  float(_r["p_value"]))
            if _v == "__INTERCEPT__":
                continue
            if re.match(r"^(mean\(|sd\(|group_)", _v):
                rdm_rows.append((_v,) + _t)
            else:
                fixed_rows.append((_v,) + _t)
    except Exception:
        fixed_rows, rdm_rows = [], []
    _b0 = None
    try:
        _b0 = float(_cdf.set_index("variable").loc[
            "__INTERCEPT__", "coefficient"])
    except Exception:
        pass
    alpha = refit.get("alpha", None)
    try:
        alpha = None if alpha is None else float(alpha)
    except Exception:
        alpha = None
    # Both branches are consumed inside \begin{equation} (see the
    # Y_{stg} \mid \lambda_{stg} \sim ... line below), so no "$" wrappers:
    # a "$" there closes the display math and corrupts the whole equation.
    fam = ("Poisson" if (alpha is None or alpha == 0.0)
           else f"NB2(\\alpha={_tex_num(alpha, 3)})")
    prop_terms = prop.get("terms") or {}
    _pg = [(k, float(v[0]), float(v[1])) for k, v in prop_terms.items()]
    nfx = audit.get("n_future_fixtures", 6)
    pen = audit.get("penetration", 0.05)
    try:
        pen = float(pen)
    except Exception:
        pen = 0.05
    slope = m.get("calibration_slope", None)
    icept = m.get("calibration_intercept", None)
    segspec = m.get("segment_spearman", None)
    top20 = m.get("segment_top20", None)
    lift = m.get("game_lift_share", None)
    lift_fx = m.get("game_lift_share_by_fixture", None) or {}

    def _tt(v):
        return "\\texttt{" + str(v).replace("_", "\\_") + "}"

    def _frow(v, b, se, p):
        _sig = "***" if p < 0.001 else ("**" if p < 0.01 else
                                        ("*" if p < 0.05 else ""))
        return (f"{_tt(v)} & ${_tex_num(b, 3)}$ & ${_tex_num(se, 4)}$ & "
                f"${_tex_num(p, 4)}${_sig} \\\\")

    fixed_body = ("\n".join(_frow(*r) for r in fixed_rows) if fixed_rows
                  else "% no fixed effects recovered from coefs table")
    rdm_body = ("\n".join(_frow(*r) for r in rdm_rows) if rdm_rows
                else "% no random-parameter rows recovered")
    prop_body = ("\n".join(
        f"{_tt(k)} & ${_tex_num(b, 4)}$ & ${_tex_num(se, 4)}$ \\\\"
        for k, b, se in _pg) if _pg else "% no propensity terms in audit")
    lift_fx_str = (", ".join(
        f"{str(k)[:24]}: ${_tex_num(v, 3)}$"
        for k, v in list(lift_fx.items())[:6]) if lift_fx
        else "not computed")
    n_fixed = len(fixed_rows)
    n_rdm = len(rdm_rows)
    # _b0_str is interpolated INSIDE \begin{equation} ... \end{equation}
    # (see the \\beta_0 \\;({_b0_str}) line below). Wrapping it in "$...$"
    # closes the surrounding math at the first "$", so the rest of the
    # display is typeset as text and TeX then reports "Missing $ inserted",
    # "\hat allowed only in math mode" and "You can't use `\eqno' in math
    # mode" -- all far from this line. Emit the number bare.
    _b0_str = (f"{_tex_num(_b0, 3)}" if _b0 is not None
               else "\\text{[n/a]}")
    _aic = _tex_num(refit.get("aic", None), 1)
    _bic = _tex_num(refit.get("bic", None), 1)
    _spec = str(refit.get("spec_label", ""))
    _slope = _tex_num(slope, 3) if slope is not None else "not computed"
    _icept = _tex_num(icept, 4) if icept is not None else "not computed"
    _segspec = (_tex_num(segspec, 3) if segspec is not None
                else "not computed")
    _top20 = (_tex_num(top20, 3) if top20 is not None else "not computed")
    _lift = (_tex_num(lift, 3) if lift is not None else "not computed")
    _denom = str((ts.get("denominator", None)
                  or prop.get("denominator", "")) or "trips")
    _paic = _tex_num(prop.get("aic", None), 1)
    _pbic = _tex_num(prop.get("bic", None), 1)
    _rate = _tex_num(prop.get("mean_rate", None), 5)
    _pen_pct = _tex_num(1.0 / max(pen, 1e-12), 1)

    tex = (
        "% game_day_mathprog.tex - generated by 59_game_day_search_predict.py\n"
        "% PURELY STATISTICAL per-segment crash-count programme: every line\n"
        "% is the fitted count/propensity model that ships the roster surface.\n"
        "\\paragraph{Statistical programme for per-segment crash-count "
        "prediction.} For segment $s$, 15-minute bin $t$ and fixture $g$, "
        # target is a column name (e.g. "trips_mean_gt_10") interpolated
        # into running TEXT, where a raw "_" makes TeX emit "Missing $
        # inserted" and desynchronise math mode for everything after it.
        f"let $Y_{{stg}}$ be the observed {str(target).replace('_', chr(92) + '_')} "
        f"count and $E_{{stg}}$ "
        "the probe-trip exposure. The count regression is "
        f"{fam} with {_spec} structure "
        f"({n_fixed} fixed terms, {n_rdm} random-parameter rows; "
        f"AIC ${_aic}, BIC ${_bic}):\n"
        "\\begin{equation}\n"
        "Y_{stg}\\mid\\lambda_{stg} \\sim "
        f"{'\\mathrm{{Poisson}}' if fam == 'Poisson' else fam}"
        "(\\lambda_{stg}),"
        "\\qquad \\log\\lambda_{stg} = "
        f"\\beta_0 \\;({_b0_str})"
        " + \\beta_E\\,\\log(E_{stg}{+}1) + "
        "\\mathbf{x}_{stg}'\\boldsymbol{\\beta} + "
        "\\mathbf{z}_{stg}'\\mathbf{b}_s, "
        "\\quad \\mathbf{b}_s\\sim N(\\mathbf{0},\\Sigma),"
        " \\label{eq:stat-count}\n"
        "\\end{equation}\n"
        "with $\\mathbf{x}$ the searched fixed design "
        f"(\\Cref{{tab:statfixed}}, {n_fixed} terms) and $\\mathbf{{z}}$ the "
        "random-parameter design (\\Cref{tab:statrandom}). Conditional on the measured denominator "
        f"$n={_denom}$, the speeding propensity is binomial:\n"
        "\\begin{equation}\n"
        "k_{stg}\\mid n_{stg},p_{stg} \\sim \\mathrm{Binomial}"
        "(n_{stg},p_{stg}),"
        "\\qquad \\mathrm{logit}\\,p_{stg} = "
        "\\gamma_0 + \\mathbf{w}_{stg}'\\boldsymbol{\\gamma},"
        " \\label{eq:stat-prop}\n"
        "\\end{equation}\n"
        "with $\\mathbf{w}$ the fitted propensity design "
        f"(\\Cref{{tab:statprop}}; AIC ${_paic}$, BIC ${_pbic}$, mean rate "
        f"${_rate}$). The shipped per-cell mean is the posterior-mean "
        "product $\\mu_{stg}=\\mathrm{E}[n_{stg}]\\cdot p_{stg}$, "
        "EB-shrunk per segment, calibrated as "
        f"$\\mathrm{{observed}}={_slope}\\cdot\\mathrm{{predicted}}"
        # Two separate inline math spans: closing the first "$" before the
        # comma. Without it TeX reads "0.197, top-20 " as one math run and
        # everything after it desynchronises.
        f"+{_icept}$ (holdout segment Spearman ${_segspec}$, top-20 "
        f"${_top20}$), and aggregated per segment and fixture as "
        "$\\hat\\Lambda^{(g)}_s=\\sum_t\\mu_{stg}$, rescaled to network "
        f"scale by $1/{_tex_num(pen, 2)}$ (penetration; $\\times{_pen_pct}$). "
        "The game-attributable share is "
        f"${_lift}$ pooled ({lift_fx_str}). The maximal-covering roster "
        "(Programme~P6) solves on $\\hat\\Lambda^{(g)}_s$.\n"
        "\\begin{table}[htbp]\n\\centering\n\\begin{scriptsize}\n"
        "\\begin{tabular}{lrrr}\n\\toprule\n"
        "Count-model fixed term & $\\hat\\beta$ & SE & $p$ \\\\\n"
        "\\midrule\n" + fixed_body + "\n\\bottomrule\n"
        "\\end{tabular}\\end{scriptsize}\n"
        "\\caption{Fitted count-model fixed effects "
        f"({_spec}; {_tex_num(refit.get('aic', None), 1)} AIC; "
        "*** $p<0.001$, ** $p<0.01$, * $p<0.05$). Random-parameter rows "
        "below are the searched heterogeneity structure, not fixed effects.}\n"
        "\\label{tab:statfixed}\\end{table}\n"
        "\\begin{table}[htbp]\n\\centering\n\\begin{scriptsize}\n"
        "\\begin{tabular}{lrrr}\n\\toprule\n"
        "Random-parameter row & estimate & SE & $p$ \\\\\n"
        "\\midrule\n" + rdm_body + "\n\\bottomrule\n"
        "\\end{tabular}\\end{scriptsize}\n"
        "\\caption{Searched random-parameter structure "
        "(means/sds of segment- or group-varying slopes).}\n"
        "\\label{tab:statrandom}\\end{table}\n"
        "\\begin{table}[htbp]\n\\centering\n\\begin{scriptsize}\n"
        "\\begin{tabular}{lrr}\n\\toprule\n"
        "Propensity term & $\\hat\\gamma$ & SE \\\\\n"
        "\\midrule\n" + prop_body + "\n\\bottomrule\n"
        "\\end{tabular}\\end{scriptsize}\n"
        "\\caption{Fitted binomial propensity "
        f"(AIC ${_paic}, BIC ${_pbic}).}}\n"
        "\\label{tab:statprop}\\end{table}\n")
    # NOTE: sd_fig is accepted for call compatibility but intentionally
    # unused: this fragment is the purely statistical programme (no
    # simulation figure). The SD showcase figure ships separately.
    (out_dir / "game_day_mathprog.tex").write_text(tex)
    return out_dir / "game_day_mathprog.tex"


def make_sd_figure(out, sd_curves, prop_lookup, sd_forms, flow_uplift,
                   demand_eta, crowd_med, metrics, fig_path):
    """Showcase figure for the SD system: loop schematic, fitted v(k) and
    R(e) per class, and the game-vs-not lift it produces. Raises on missing
    inputs (caller guards); never touches the shipped surface.
    """
    import matplotlib
    matplotlib.use("Agg")
    import matplotlib.pyplot as plt
    from matplotlib.patches import FancyBboxPatch

    if out is None or len(out) == 0:
        raise ValueError("no prediction rows")
    need = {"pred_sd_game", "pred_sd_nogame", "sd_lift", "fixture", "rel_bin"}
    if not need <= set(out.columns):
        raise ValueError(f"missing SD columns: {sorted(need - set(out.columns))}")
    if not sd_curves:
        raise ValueError("no speed-density curves")
    # curve classes only: skip the shrinkage diagnostic/_theory_* entries
    classes = [c for c in sd_curves
               if c != "_global" and not str(c).startswith("_")
               and isinstance(sd_curves[c], tuple) and len(sd_curves[c]) == 2]
    forms = sd_forms or {}
    fig, axes = plt.subplots(2, 2, figsize=(13, 9))
    (ax0, ax1), (ax2, ax3) = axes
    # -- panel 1: stock-flow schematic ------------------------------------
    ax0.set_xlim(0, 10)
    ax0.set_ylim(0, 10)
    ax0.axis("off")
    ax0.set_title("Stock-flow loop (game on/off = demand experiment)",
                  fontsize=10)
    _boxes = [
        (5.0, 9.0, "GAME $G_g$\non / off", "#D9E6F2"),
        (5.0, 7.5, "DEMAND  $q = q^0\\cdot u[b]\\cdot C(A)$", "#FCE4CC"),
        (5.0, 6.0, "DENSITY  $k = q/v$  (stock)", "#E2EFDA"),
        (5.0, 4.5, "SPEED  $v = F_c(k)$", "#E2EFDA"),
        (5.0, 3.0, "EXCEEDANCE  $e = v-L$", "#FFF2CC"),
        (5.0, 1.5, "PROPENSITY  $p = R_c(e)$", "#FFF2CC"),
        (5.0, 0.2, "COUNTS  $y = q\\cdot p$  $\\rightarrow$  "
         "LIFT $\\Delta=y^{game}-y^0$", "#F2DCDB"),
    ]
    for i, (x, y, txt, fc) in enumerate(_boxes):
        ax0.add_patch(FancyBboxPatch(
            (x - 3.4, y - 0.45), 6.8, 0.9,
            boxstyle="round,pad=0.05", fc=fc, ec="#333333", lw=0.8))
        ax0.text(x, y, txt, ha="center", va="center", fontsize=8)
        if i:
            ax0.annotate("", xy=(x, y + 0.45), xytext=(x, y + 1.05),
                         arrowprops=dict(arrowstyle="-|>", color="#333333",
                                         lw=1.2))
    ax0.text(9.9, 9.6,
             f"uplift $\\bar u$={float(np.mean(flow_uplift)):.2f}\n"
             f"$\\eta$={float(demand_eta):.2f}\n"
             f"$A_{{ref}}$={float(crowd_med):.0f}",
             fontsize=7, va="top", ha="right")
    # -- panel 2: fitted speed-density curves ------------------------------
    kgrid = np.linspace(0.0, 120.0, 200)
    for cls in classes:
        vf, kj = sd_curves.get(cls, (50.0, np.inf))
        v = (np.asarray(vf) * (1.0 - kgrid / kj)
             if np.isfinite(kj) else np.full_like(kgrid, vf))
        ax1.plot(kgrid, np.clip(v, 0, None), lw=1.4, label=str(cls))
        fe = (forms.get(cls) or {}).get("speed")
        if fe is not None:
            tree, (a, b) = fe[0], fe[1]
            with np.errstate(all="ignore"):
                fv = a * np.asarray(_gp_eval(tree, kgrid)) + b
            ax1.plot(kgrid, np.clip(np.where(np.isfinite(fv), fv, np.nan),
                                     0, None), lw=1.0, ls="--")
    ax1.set_xlabel("density k (veh/km)")
    ax1.set_ylabel("speed v (km/h)")
    ax1.set_title("Fitted speed-density $v=F_c(k)$ (solid) + GP form (dashed)",
                  fontsize=10)
    ax1.legend(fontsize=6, ncol=2)
    ax1.set_ylim(bottom=0)
    # -- panel 3: propensity on exceedance ----------------------------------
    _ctr = (SD_EDGES[:-1] + SD_EDGES[1:]) / 2.0
    for cls in classes:
        rates = np.asarray(prop_lookup.get(
            cls, prop_lookup.get("_global", np.zeros(len(_ctr)))),
            dtype=float)
        ax2.plot(_ctr, rates, lw=1.4, label=str(cls))
    ax2.set_xlabel("exceedance e = v - L (km/h)")
    ax2.set_ylabel("per-trip speeding rate")
    ax2.set_yscale("log")
    ax2.set_title("Propensity $R_c(e)$ (binned table; log scale)",
                  fontsize=10)
    ax2.legend(fontsize=6, ncol=2)
    # -- panel 4: what the loop produces ------------------------------------
    _g = out.groupby("fixture")[["pred_sd_game", "pred_sd_nogame",
                                 "sd_lift"]].sum()
    _g["share"] = _g["sd_lift"] / _g["pred_sd_game"].clip(lower=1e-12)
    _labels = [str(f)[:26] for f in _g.index]
    _cols = ["#0B6E4F" if v >= 0 else "#B03A2E" for v in _g["share"]]
    ax3.barh(_labels[::-1], (_g["share"] * 100.0).to_numpy()[::-1],
             color=_cols[::-1])
    ax3.set_xlabel("SD game lift share (%)")
    ax3.set_title("Game-day increase / decrease by fixture", fontsize=10)
    ax3.axvline(0.0, color="k", lw=0.8)
    _pool = float(_g["sd_lift"].sum() / max(_g["pred_sd_game"].sum(), 1e-12))
    _corr = metrics.get("sd_vs_reg_lift_corr", None) if metrics else None
    ax3.text(0.98, 0.02, f"pooled {_pool:+.1%}  "
             f"corr(SD, regression)={_corr}",
             transform=ax3.transAxes, ha="right", va="bottom", fontsize=8,
             bbox=dict(fc="white", ec="#999999", pad=2))
    fig.tight_layout()
    fig.savefig(fig_path, dpi=130)
    plt.close(fig)
    return fig_path


def gp_discover_form(x, y, w=None, seed_trees=(("x",), ("c",)),
                     pop=16, gens=20, seed=0, budget_s=60.0, max_depth=4):
    """Bounded symbolic regression. Returns (tree, (a,b), bic, form_str).

    Seeds guarantee theory is in the gene pool; elitism keeps the best, so
    the returned form never loses to the seeds. Any failure -> (None,...).
    """
    import time as _t
    t0 = _t.time()
    x = np.asarray(x, dtype=float)
    y = np.asarray(y, dtype=float)
    w = np.ones_like(y) if w is None else np.asarray(w, dtype=float)
    m = np.isfinite(x) & np.isfinite(y) & np.isfinite(w) & (w > 0)
    x, y, w = x[m], y[m], w[m]
    if len(x) < 8 or np.std(y) <= 0:
        return None, (0.0, 0.0), np.inf, "insufficient-data"
    rng = np.random.default_rng(int(seed))
    population = list(seed_trees)
    while len(population) < pop:
        population.append(_gp_random(rng, rng.integers(1, 4), bool(rng.integers(0, 2))))
    scored = [(_gp_fitness(t, x, y, w), t) for t in population]
    scored.sort(key=lambda s: s[0][0])
    elite = [scored[0][1], scored[1][1]] if len(scored) > 1 else [scored[0][1]]
    for _ in range(int(gens)):
        if _t.time() - t0 > float(budget_s):
            break
        children = list(elite)
        while len(children) < pop:
            r = rng.random()
            p1 = scored[int(rng.integers(0, max(2, pop // 2)))][1]
            if r < 0.55:
                p2 = scored[int(rng.integers(0, max(2, pop // 2)))][1]
                s1 = list(_gp_subtrees(p1))
                s2 = list(_gp_subtrees(p2))
                child = _gp_replace(p1, int(rng.integers(0, len(s1))),
                                    s2[int(rng.integers(0, len(s2)))])
            elif r < 0.8:
                s1 = list(_gp_subtrees(p1))
                child = _gp_replace(p1, int(rng.integers(0, len(s1))),
                                    _gp_random(rng, 2, False))
            else:
                child = _gp_random(rng, 3, False)
            nodes = _gp_nodes(child)
            if nodes > 25:
                child = p1
            children.append(child)
        scored = [(_gp_fitness(t, x, y, w), t) for t in children]
        scored.sort(key=lambda s: s[0][0])
        elite = [scored[0][1]]
    (bic, (a, b)), best = scored[0]
    if not np.isfinite(bic):
        return None, (0.0, 0.0), np.inf, "no-finite-form"
    return best, (a, b), bic, f"{a:.4g}*({_gp_to_str(best)})+{b:.4g}"


def fit_sd_forms(df, target, sd_curves, budget_s=240.0, seed=0):
    """Per-class GP form discovery for the SD loop (bounded, seeded).

    Speed shape on binned (k, v); propensity shape on binned log-rates over
    exceedance. Seeds: linear (=Greenshields in k) + constant for speed;
    linear + squash for propensity. Returns {cls: {"speed": (tree,a,b,str)
    |None, "prop": ...|None, "bic_fixed":.., "bic_gp":..}}. Any failure or
    timeout -> None entries (param/table path stands).
    """
    import time as _t
    t0 = _t.time()
    d = pd.DataFrame({
        "cls": df["highway"].fillna("unclassified").astype(str)
        if "highway" in df.columns else "unclassified",
        "q": pd.to_numeric(df["vehicle_count"], errors="coerce").fillna(0.0)
        if "vehicle_count" in df.columns else 0.0,
        "v": pd.to_numeric(df["mean_vehicle_speed_kmh"], errors="coerce")
        if "mean_vehicle_speed_kmh" in df.columns else np.nan,
        "y": pd.to_numeric(df[target], errors="coerce").fillna(0.0)
        if target in df.columns else 0.0,
    })
    d["lim"] = _sd_limit(df)
    d = d[np.isfinite(d["v"].to_numpy()) & (d["v"].to_numpy() > 0)].copy()
    d["k"] = d["q"] / d["v"].clip(lower=1.0)
    d["e"] = d["v"] - d["lim"]
    out = {}
    for cls, g in d.groupby("cls"):
        if _t.time() - t0 > float(budget_s):
            break
        entry = {"speed": None, "prop": None}
        try:
            # Speed-density shape: quantile-binned (k, v).
            qb = pd.qcut(g["k"], 12, duplicates="drop")
            b = g.groupby(qb, observed=True).agg(k=("k", "mean"),
                                                 v=("v", "mean"),
                                                 n=("v", "size")).dropna()
            if len(b) >= 8:
                tree, ab, bic, fs = gp_discover_form(
                    b["k"].to_numpy(), b["v"].to_numpy(),
                    w=b["n"].to_numpy(),
                    seed_trees=(("x",), ("c",),
                                ("-", ("x",), ("c",))),
                    pop=12, gens=12, seed=seed + (_crc(str(cls)) % 1000),
                    budget_s=15.0)
                if tree is not None:
                    entry["speed"] = (tree, ab, fs, round(float(bic), 1))
            # Propensity shape: binned log-rates over exceedance.
            eb = np.clip(np.digitize(g["e"].to_numpy(float), SD_EDGES) - 1,
                         0, len(SD_EDGES) - 2)
            gg = g.assign(_eb=eb).groupby("_eb").agg(
                ys=("y", "sum"), qs=("q", "sum"),
                e=("e", "mean"))
            gg = gg[gg["qs"] > 0].copy()
            gg["lr"] = np.log((gg["ys"] / gg["qs"]).clip(lower=1e-9))
            if len(gg) >= 8 and np.std(gg["lr"].to_numpy()) > 1e-9:
                tree, ab, bic, fs = gp_discover_form(
                    gg["e"].to_numpy(), gg["lr"].to_numpy(),
                    w=gg["qs"].to_numpy(),
                    seed_trees=(("x",), ("c",),
                                ("squash", ("x",))),
                    pop=12, gens=12,
                    seed=seed + 54321 + (_crc(str(cls)) % 1000),
                    budget_s=15.0)
                if tree is not None:
                    entry["prop"] = (tree, ab, fs, round(float(bic), 1))
        except Exception:
            pass
        out[str(cls)] = entry
    return out


def sd_regime(q, cls_arr, sd_curves):
    """Operating regime of the twin: where does the flow actually put density?

    Returns the share of rows in each band of rho = k/kj (rho<0.2 free flow,
    0.2-0.5 transition, 0.5-0.9 CONGESTION-ACTIVE, >=0.9 jam). If the
    congestion-active share is ~0, the structurally-identified twin CANNOT
    produce a congestion suppression in this data, and any negative game
    lift has to be identified by the regression instead. That is a finding
    about the data, not a bug in the twin - and it should be reported as
    such rather than papered over with a huge calibration slope.
    """
    q = np.maximum(np.asarray(q, dtype=float), 0.0)
    cls_arr = np.asarray(cls_arr, dtype=str)
    glob = sd_curves.get("_global", (50.0, 1.5))
    vf = np.array([sd_curves.get(c, glob)[0] for c in cls_arr], float)
    kj = np.array([sd_curves.get(c, glob)[1] for c in cls_arr], float)
    with np.errstate(all="ignore"):
        k = q / np.clip(vf, 1.0, None)
        rho = k / np.clip(kj, 1e-9, None)
    rho = np.clip(np.where(np.isfinite(rho), rho, 0.0), 0.0, 2.0)
    n = max(len(rho), 1)
    return {
        "free_flow_rho_lt_.2": round(float((rho < 0.2).sum()) / n, 4),
        "transition_.2_.5": round(
            float(((rho >= 0.2) & (rho < 0.5)).sum()) / n, 4),
        "congestion_active_.5_.9": round(
            float(((rho >= 0.5) & (rho < 0.9)).sum()) / n, 4),
        "jam_ge_.9": round(float((rho >= 0.9).sum()) / n, 4),
        "rho_median": round(float(np.median(rho)), 4),
        "rho_p95": round(float(np.percentile(rho, 95)), 4),
        "n_rows": int(len(rho)),
    }


def sd_predict(q, cls_arr, lim_arr, sd_curves, prop_lookup, sd_forms=None):
    """Forward-simulate the stock-flow loop: q -> k=q/v -> v -> e -> rate.

    Param path: Greenshields v(vf,kj) + binned rate table. GP path (per
    class, when discovery found a form): v = a*f(k)+b and log-rate =
    a*g(e)+b through the same fixed-point. Fixed-point capped at 3 rounds;
    everything clipped, so a wild form degrades to bounds, never NaN.
    """
    q = np.maximum(np.asarray(q, dtype=float), 0.0)
    cls_arr = np.asarray(cls_arr, dtype=str)
    glob = sd_curves.get("_global", (50.0, np.inf))
    vf = np.array([sd_curves.get(c, glob)[0] for c in cls_arr], float)
    kj = np.array([sd_curves.get(c, glob)[1] for c in cls_arr], float)
    forms = sd_forms or {}
    has_speed = np.array([bool((forms.get(c) or {}).get("speed"))
                          for c in cls_arr])
    v = vf.copy()
    for _ in range(3):
        k = q / np.clip(v, 1.0, None)
        v_par = np.where(np.isfinite(kj), vf * (1.0 - k / kj), vf)
        if has_speed.any():
            v_gp = v.copy()
            for c in np.unique(cls_arr[has_speed]):
                m = (cls_arr == c) & has_speed
                tree, (a, b) = (forms[c]["speed"][0],
                                forms[c]["speed"][1])
                with np.errstate(all="ignore"):
                    fv = a * np.asarray(_gp_eval(tree, k[m]),
                                        dtype=float) + b
                fv = np.clip(np.where(np.isfinite(fv), fv, vf[m]),
                             1.0, np.maximum(vf[m], 1.0) * 1.5)
                v_gp[m] = fv
            v = np.where(has_speed, v_gp, v_par)
        else:
            v = v_par
        v = np.clip(v, 1.0, np.maximum(vf, 1.0) * 1.5)
    e = v - np.asarray(lim_arr, dtype=float)
    bi = np.clip(np.digitize(e, SD_EDGES) - 1, 0, len(SD_EDGES) - 2)
    nb = len(SD_EDGES) - 1
    g_rates = prop_lookup.get("_global", np.zeros(nb))
    rates = np.array([
        np.asarray(prop_lookup.get(c, g_rates), dtype=float)[b]
        for c, b in zip(cls_arr, bi)], float)
    has_prop = np.array([bool((forms.get(c) or {}).get("prop"))
                         for c in cls_arr])
    if has_prop.any():
        r_gp = rates.copy()
        for c in np.unique(cls_arr[has_prop]):
            m = (cls_arr == c) & has_prop
            tree, (a, b) = (forms[c]["prop"][0], forms[c]["prop"][1])
            with np.errstate(all="ignore"):
                lr = (a * np.asarray(_gp_eval(tree, e[m]), dtype=float)
                      + b)
            rr = np.exp(np.clip(np.where(np.isfinite(lr), lr, -20.0),
                                -20.0, 1.0))
            r_gp[m] = rr
        rates = np.where(has_prop, r_gp, rates)
    counts = q * np.clip(rates, 0.0, 2.0)
    return counts, v, q / np.clip(v, 1.0, None)


def estimate_flow_uplift_by_class(train_events, background, bg_by_class,
                                  class_col="highway", fallback=None):
    """Per-highway-class game-day flow uplift u[b, class].

    WHY: a single u[b] for the whole network is the most likely reason the
    exposure LRT rejects the flow channel at chi2(1)=364. One scalar per
    rel_bin collapses 35 fixtures x ~1,500 segments into 28 numbers, so it
    cannot represent that a residential street and a 4-lane arterial
    respond differently to a game. A 20 km/h arterial and a 20 km/h side
    street are given the same multiplier.

    Returns {class_value: np.ndarray(REL_BINS)}. Classes are estimated
    from the train event windows; anything with too little support falls
    back to the pooled `fallback` vector, and the pooled vector is used for
    the background divisor per class so the ratio stays self-consistent
    (a class's own background level is the right denominator when asking
    "how much does THIS class of road speed up on game day").
    """
    out = {}
    pooled = fallback if fallback is not None else np.ones(REL_BINS)
    try:
        if class_col not in train_events.columns:
            return {}
        _ev = train_events.copy()
        _ev[class_col] = _ev[class_col].astype("string").fillna("unclassified")
        _ev[class_col] = _ev[class_col].astype(str)
        ev_by = _ev.groupby([class_col, "rel_bin"])["vehicle_count"].mean()
        for cls in sorted(_ev[class_col].unique()):
            sub = ev_by.loc[cls] if cls in ev_by.index.get_level_values(0) \
                else None
            if sub is None or sub.empty:
                continue
            denom = bg_by_class.get(cls)
            if denom is None or not np.isfinite(denom) or denom <= 0:
                continue
            u = (sub / denom).reindex(range(REL_BINS)).fillna(1.0)
            u = u.replace([np.inf, -np.inf], 1.0).fillna(1.0).clip(0.25, 4.0)
            out[str(cls)] = u.to_numpy(float)
    except Exception:  # noqa: BLE001
        return {}
    return out


def estimate_flow_uplift(train_events, background, bg_mean=None):
    """Stage 1 of the joint flow->speeding model: game-day flow uplift.

    u[b] = mean probe flow inside train event windows at rel_bin b, divided
    by the background mean. Future flow = seg_flow * bin_factor * u[rel_bin],
    so predicted exposure — and hence predicted speeding — inherits game-day
    attendance dynamics instead of reusing the static background profile.
    Falls back to 1.0 (static exposure) where a bin has no train support.

    bg_mean: pass a DETERMINISTIC background mean (e.g. the full-panel
    aggregate) to make u reproducible. When omitted it is taken from
    `background`, which is a random subsample, so u then varies run to run
    from sampling noise alone — which is what made three measurements of
    the same quantity disagree (0.97/0.96/0.88, 0.955/0.963/0.869,
    0.96/1.05/0.95) while the pipeline was unchanged.
    """
    try:
        ev = train_events.groupby("rel_bin")["vehicle_count"].mean()
        if bg_mean is None:
            bg_mean = float(background["vehicle_count"].mean())
        if not np.isfinite(bg_mean) or bg_mean <= 0:
            return np.ones(REL_BINS)
        u = (ev / bg_mean).reindex(range(REL_BINS)).fillna(1.0)
        u = u.replace([np.inf, -np.inf], 1.0).fillna(1.0).clip(0.25, 4.0)
        return u.to_numpy(float)
    except Exception:
        return np.ones(REL_BINS)


def estimate_seg_crowd_elasticity(train_events, pooled_eta,
                                  min_fixtures=8, pseudo=0.0):
    """Per-segment crowd elasticity of game-day flow: dlog E[q] / dlog A.

    WHY A SCALAR IS NOT ENOUGH. One crowd multiplier per game scales every
    segment by the same factor: game totals move 1.67x while the RANKING is
    mathematically preserved (measured: top-20 Jaccard 0.90-1.00, 4/250
    segments ever moving). A game-varying plan needs the crowd to enter
    PER SEGMENT.

    COUNT MODEL, PER SEGMENT. Each segment gets its own Poisson (or NB, on
    Pearson overdispersion) GLM,
        q_i,g ~ Poisson(mu_i,g),  log mu_i,g = b0_i + b1_i log(A_g+1)
                                    - log(n_bins_i,g)
    i.e. the same estimator as the pooled fit, so the two are directly
    comparable and the response stays a non-negative integer count with a
    Poisson variance. This is deliberately NOT log(count)-OLS, which
    dropped every zero-count fixture -- precisely the thin, low-speeding
    segments whose behaviour the plan needs.

    A GLM per segment (not one random-parameters metacount fit) because the
    quantity wanted is INDIVIDUAL elasticities to reorder segments, and
    that needs per-segment coefficients, not draws from a fitted
    distribution.

    `pseudo` > 0 shrinks b1_i toward the pooled eta with weight
    n/(n+pseudo) (EB fallback arm). Default 0 = PURE PREDICTION: each
    segment's own Poisson coefficient, nothing borrowed. Segments with too
    few fixtures or a degenerate design fall back to the pooled eta (a
    support requirement, not shrinkage).
    """
    out, diag = {}, {}
    try:
        if train_events is None or len(train_events) == 0:
            return {}, {}
        if "attendance" not in train_events.columns:
            return {}, {}
        _t = train_events.copy()
        _t["_a"] = pd.to_numeric(_t["attendance"], errors="coerce")
        _t["_q"] = pd.to_numeric(_t.get("vehicle_count", np.nan),
                                 errors="coerce")
        _t = _t[np.isfinite(_t["_a"].to_numpy()) & (_t["_a"] > 0)
                & np.isfinite(_t["_q"].to_numpy()) & (_t["_q"] >= 0)]
        if len(_t) < 50:
            return {}, {}
        _la = np.log(_t["_a"].to_numpy(float) + 1.0)
        _t["_la"] = _la
        res = {}
        for sid, sub in _t.groupby("road_osmid"):
            q = sub["_q"].to_numpy(float)
            la = sub["_la"].to_numpy(float)
            # offset = log(position within fixture): the target is a
            # per-bin rate, so each fixture contributes its bin count
            _off = np.log(np.maximum(
                sub.groupby("fixture").cumcount().to_numpy(float) + 1.0, 1.0))
            nf = int(sub["fixture"].nunique())
            if nf < int(min_fixtures) or float(np.var(la)) <= 1e-10:
                res[sid] = (float(pooled_eta), 0.0, nf)
                continue
            b, se, _z, _p, _phi, _n, _fam = _fit_elasticity_nb(
                q, la, offset=_off)
            if not np.isfinite(b):
                res[sid] = (float(pooled_eta), 0.0, nf)
                continue
            if float(pseudo) > 0.0:
                w = float(nf) / (float(nf) + float(pseudo))
                b = w * b + (1.0 - w) * float(pooled_eta)
            res[sid] = (float(b), 1.0, nf)
        for sid, (e, w, nf) in res.items():
            out[int(sid)] = float(e)
        if out:
            _e = np.array(list(out.values()))
            diag = {"n_segments": int(len(out)),
                    "n_own_estimate": int(sum(
                        1 for _, (_, w, _) in res.items() if w > 0.05)),
                    "pseudo": float(pseudo),
                    "estimator": "per-segment Poisson/NB GLM, "
                                 "offset=log(bins), response=counts",
                    "eta_mean": round(float(_e.mean()), 4),
                    "eta_sd": round(float(_e.std()), 4),
                    "eta_p05": round(float(np.percentile(_e, 5)), 4),
                    "eta_p95": round(float(np.percentile(_e, 95)), 4),
                    "pooled_eta": round(float(pooled_eta), 4)}
        return out, diag
    except Exception as exc:  # noqa: BLE001 - pooled fallback
        return {}, {"error": str(exc)[:200]}


def _ols_slope(x, y):
    """OLS slope + SE + two-sided p (t, df=n-2). Returns (b, se, p, n)."""
    x = np.asarray(x, dtype=float)
    y = np.asarray(y, dtype=float)
    m = np.isfinite(x) & np.isfinite(y)
    x, y = x[m], y[m]
    n = len(x)
    if n < 4 or float(np.var(x)) <= 1e-12:
        return float("nan"), float("nan"), float("nan"), int(n)
    b = float(np.cov(x, y, bias=True)[0, 1] / max(float(np.var(x)), 1e-12))
    resid = y - (y.mean() + b * (x - x.mean()))
    s2 = float((resid ** 2).sum() / max(n - 2, 1))
    se = float(np.sqrt(s2 / max(float(((x - x.mean()) ** 2).sum()), 1e-12)))
    t = b / max(se, 1e-12)
    try:
        from scipy.stats import t as _t
        p = float(2.0 * _t.sf(abs(t), max(n - 2, 1)))
    except Exception:  # noqa: BLE001 - normal approximation fallback
        import math
        p = float(math.erfc(abs(t) / math.sqrt(2.0)))
    return b, se, p, int(n)


def _phase_of_bin(rel_bin):
    """Event phase (pre/during/post) from 15-min rel_bin (28 bins, KO-3h..+4h).

    pre: bins 0-9 (KO-3h..KO-0.5h); during: 10-17; post: 18-27.
    """
    b = np.asarray(rel_bin, dtype=float)
    out = np.full(b.shape, "post", dtype=object)
    out[b < 18] = "during"
    out[b < 10] = "pre"
    return out if out.shape else "post"


def _fit_elasticity_nb(y, log_att, offset=None, names=("const", "log_att")):
    """Poisson/NB GLM for log(E[y]) = b0 + b1*log_att (+ offset).

    b1 is the crowd elasticity. Uses the COUNT likelihood throughout:
    the response is a non-negative integer count, so a Poisson (or NB when
    the overdispersion warrants it) GLM with a log link is the correct
    functional form. OLS on log(counts) is NOT: it (a) drops zero-count
    segments, biasing the slope upward exactly where speeding is thinnest,
    (b) treats variance as constant, and (c) has no natural way to take the
    exposure offset. Same estimator family as the rest of the pipeline
    (count models), which is why it is a GLM here rather than in the
    random-parameters search.

    Returns (b1, se, z, p, phi, n, family) with phi the Pearson
    overdispersion (mean 1 = Poisson).
    """
    import statsmodels.api as sm
    y = np.asarray(y, dtype=float)
    la = np.asarray(log_att, dtype=float)
    m = np.isfinite(y) & np.isfinite(la) & (y >= 0)
    y, la = y[m], la[m]
    n = int(len(y))
    if n < 4 or float(np.var(la)) <= 1e-12:
        return (float("nan"),) * 4 + (float("nan"), 0, "none")
    X = np.column_stack([np.ones(n), la])
    off = None if offset is None else np.asarray(offset, dtype=float)[m]
    fam, label = sm.families.Poisson(), "Poisson"
    res = sm.GLM(y, X, family=fam, offset=off).fit()
    phi = float(res.pearson_chi2 / max(res.df_resid, 1))
    # Overdispersion -> NB with that alpha (standard Pearson-moment choice).
    if phi > 1.5:
        try:
            res = sm.GLM(y, X, family=sm.families.NegativeBinomial(
                alpha=max(phi, 1e-6)), offset=off).fit()
            label = "NB2"
        except Exception:  # noqa: BLE001 - keep Poisson
            label = "Poisson(overdispersed)"
    b1 = float(res.params[1])
    se = float(res.bse[1]) if np.isfinite(res.bse[1]) else float("nan")
    z = b1 / se if se > 0 else float("nan")
    try:
        from scipy.stats import norm
        p = float(2.0 * norm.sf(abs(z))) if np.isfinite(z) else float("nan")
    except Exception:  # noqa: BLE001
        import math
        p = float(math.erfc(abs(z) / math.sqrt(2.0))) if np.isfinite(z) \
            else float("nan")
    return b1, se, z, p, phi, n, label


def estimate_demand_elasticity(train_events):
    """Crowd elasticity of game-day probe flow from a COUNT model.

    eta = d log E[q] / d log A: how much more traffic a bigger crowd draws.
    The SD simulation multiplies game flow by (A/att_ref)^eta so same-code,
    same-kickoff fixtures with different crowds get different surfaces
    (o26642598: identical SD lifts for two NRL 19:00 games). eta=0 disables
    crowd scaling.

    ESTIMATOR. Poisson/NB GLM on the summed per-fixture counts with the
    number of contributing bins as an offset, so the response is a rate:
        q_g ~ Poisson(mu_g),  log mu_g = b0 + eta*log(A_g+1) - log(n_bins_g)
    NOT OLS on log(counts), which is what this used to do: it silently
    dropped the many fixtures whose counts are zero and whose speeding is
    exactly what we are trying to model, and it assumed constant variance
    on a count scale. The raw (unclipped) eta is reported with SE/z/p, plus
    per-phase etas, because a clipped 0.00 previously hid a genuinely
    negative slope.
    """
    rep = {"n_fixtures": 0}
    try:
        g = (train_events.groupby("fixture")
             .agg(q=("vehicle_count", "sum"),
                  n=("vehicle_count", "size"),
                  a=("attendance", "first")))
        g = g[np.isfinite(g["a"]) & (g["a"] > 0)].copy()
        rep["n_fixtures"] = int(len(g))
        rep["att_range"] = ([round(float(g["a"].min()), 1),
                             round(float(g["a"].max()), 1)] if len(g) else [])
        if len(g) < 4:
            rep["note"] = "too few fixtures"
            return 0.0, rep
        _off = np.log(np.maximum(g["n"].to_numpy(float), 1.0))
        b, se, z, p, phi, n, fam = _fit_elasticity_nb(
            g["q"].to_numpy(float), np.log(g["a"].to_numpy(float) + 1.0),
            offset=_off)
        rep.update({"eta_raw": round(float(b), 4),
                    "eta_se": round(float(se), 4) if np.isfinite(se) else None,
                    "eta_z": round(float(z), 3) if np.isfinite(z) else None,
                    "eta_p": round(float(p), 4) if np.isfinite(p) else None,
                    "phi": round(float(phi), 3) if np.isfinite(phi) else None,
                    "eta_n": int(n), "family": fam,
                    "estimator": "poisson/nb glm on counts, offset=log(bins)"})
        eta = float(np.clip(b, 0.0, 1.5)) if np.isfinite(b) else 0.0
        rep["eta"] = round(eta, 3)
        rep["by_phase"] = {}
        if "rel_bin" in train_events.columns:
            _te = train_events.copy()
            _te["__phase"] = _phase_of_bin(
                pd.to_numeric(_te["rel_bin"], errors="coerce").fillna(-1))
            for _ph, _gp in _te.groupby("__phase"):
                _gg = (_gp.groupby("fixture")
                       .agg(q=("vehicle_count", "sum"),
                            n=("vehicle_count", "size"),
                            a=("attendance", "first")))
                _gg = _gg[np.isfinite(_gg["a"]) & (_gg["a"] > 0)]
                if len(_gg) < 4:
                    continue
                _b, _se, _z, _p, _phi, _n, _fam = _fit_elasticity_nb(
                    _gg["q"].to_numpy(float),
                    np.log(_gg["a"].to_numpy(float) + 1.0),
                    offset=np.log(np.maximum(_gg["n"].to_numpy(float), 1.0)))
                rep["by_phase"][str(_ph)] = {
                    "eta_raw": round(float(_b), 4),
                    "eta": round(float(np.clip(_b, 0.0, 1.5)), 3),
                    "se": round(float(_se), 4) if np.isfinite(_se) else None,
                    "p": round(float(_p), 4) if np.isfinite(_p) else None,
                    "n_fixtures": int(_n), "family": _fam}
        return eta, rep
    except Exception as exc:  # noqa: BLE001 - SD auxiliary
        rep["error"] = str(exc)
        return 0.0, rep


def calibrate_sd_lift(train_events, background, target, sd_curves,
                      prop_lookup, sd_forms, flow_uplift, demand_etas,
                      att_ref):
    """Calibrate the SD twin to observed train lift (share-on-share WLS).

    Observed lift per train fixture is a SHARE: obs/window-counts over the
    background expectation minus 1. The SD lift must enter the regression on
    the same scale, i.e. also a share (sum of row lifts over sum of row
    no-game counts) -- regressing a share on raw lift COUNTS mixes units
    across fixtures of different sizes and inflates the intercept into
    every future row (o26674777: calibrated share 0.959 from a +0.28/row
    intercept). Returns (a, b, se_b, p_b, table_df); on any problem returns
    (0.0, 1.0, nan, nan, empty) i.e. the uncalibrated twin stands.
    Never fatal by itself -- the caller decides.
    """
    empty = pd.DataFrame()
    try:
        if (train_events is None or background is None
                or sd_curves is None or prop_lookup is None):
            return 0.0, 1.0, float("nan"), float("nan"), empty, "missing inputs"
        if target not in train_events.columns:
            return 0.0, 1.0, float("nan"), float("nan"), empty, "no target"
        _bg_rate = float(pd.to_numeric(
            background[target] if target in background.columns
            else background.get("vehicle_count", pd.Series(dtype=float)),
            errors="coerce").fillna(0.0).mean())
        _obs = train_events.groupby("fixture").agg(
            obs=(target, "sum"), n=("fixture", "size"),
            att=("attendance", "first"))
        _obs["exp_bg"] = _bg_rate * _obs["n"].astype(float)
        _obs["lift_obs"] = (_obs["obs"] / _obs["exp_bg"].clip(lower=1e-9)
                            - 1.0)
        # SD twin on train rows (observed flow = game flow).
        _te = train_events.copy()
        _q = pd.to_numeric(_te.get("vehicle_count", 0.0),
                           errors="coerce").fillna(0.0).to_numpy(float)
        _rb = pd.to_numeric(_te.get("rel_bin", 0),
                            errors="coerce").fillna(0).to_numpy(int).clip(
                                0, REL_BINS - 1)
        _fu = (np.asarray(flow_uplift, dtype=float)
               if flow_uplift is not None and len(flow_uplift) == REL_BINS
               else np.ones(REL_BINS))
        _qs = _q / np.clip(_fu[_rb], 1e-9, None)
        _att_map = _obs["att"].to_dict()
        _at = _te["fixture"].map(_att_map).fillna(0.0).to_numpy(float)
        _ebyp = demand_etas if isinstance(demand_etas, dict) else {}
        _ph = _phase_of_bin(
            pd.to_numeric(_te.get("rel_bin", 0),
                          errors="coerce").fillna(-1).to_numpy())
        _ev = np.array([float(_ebyp.get(str(p), 0.0)) for p in _ph])
        _cm = np.where((_at > 0) & (float(att_ref or 0) > 0),
                       np.clip((_at / max(float(att_ref), 1e-9))
                               ** np.clip(_ev, -1.0, 1.5), 0.25, 4.0), 1.0)
        _qg = _q * _cm
        _cls = (_te["highway"].fillna("unclassified").astype(str).to_numpy()
                if "highway" in _te.columns
                else np.array(["unclassified"] * len(_te)))
        _lim = _sd_limit(_te)
        _g, _, _ = sd_predict(_qg, _cls, _lim, sd_curves,
                              prop_lookup, sd_forms)
        _n, _, _ = sd_predict(_qs, _cls, _lim, sd_curves,
                              prop_lookup, sd_forms)
        _te["_sdg"] = np.maximum(_g, 1e-12)
        _te["_sdn"] = np.maximum(_n, 1e-12)
        _te["_sdlift"] = _te["_sdg"] - _te["_sdn"]
        _agg = _te.groupby("fixture").agg(_sdlift=("_sdlift", "sum"),
                                          _sdn=("_sdn", "sum"))
        # SHARE on SHARE: fixture SD lift share vs observed lift share.
        _tab = pd.DataFrame({"lift_obs": _obs["lift_obs"],
                             "lift_sd": (_agg["_sdlift"]
                                         / _agg["_sdn"].clip(lower=1e-12)),
                             "w": _obs["obs"] + 1.0}).dropna()
        _tab = _tab[np.isfinite(_tab["lift_sd"].to_numpy())]
        if len(_tab) < 4:
            return 0.0, 1.0, float("nan"), float("nan"), _tab, "too few fixtures"
        _x = _tab["lift_sd"].to_numpy(float)
        _y = _tab["lift_obs"].to_numpy(float)
        _w = _tab["w"].to_numpy(float)
        _w = _w / _w.sum() * len(_w)
        _X = np.column_stack([np.ones_like(_x), _x])
        _XtX = (_X * _w[:, None]).T @ _X
        _Xty = (_X * _w[:, None]).T @ _y
        try:
            _beta = np.linalg.solve(_XtX, _Xty)
        except Exception:  # noqa: BLE001 - singular; stand pat
            return 0.0, 1.0, float("nan"), float("nan"), _tab, "singular"
        _res = _y - _X @ _beta
        _df = max(len(_y) - 2, 1)
        _s2 = float((_w * _res ** 2).sum() / _df)
        try:
            _cov = _s2 * np.linalg.inv(_XtX)
            _se_b = float(np.sqrt(max(_cov[1, 1], 0.0)))
        except Exception:  # noqa: BLE001
            _se_b = float("nan")
        _b = float(_beta[1])
        _t = _b / max(_se_b, 1e-12) if np.isfinite(_se_b) else float("nan")
        try:
            from scipy.stats import t as _t_dist
            _p = float(2.0 * _t_dist.sf(abs(_t), _df)) \
                if np.isfinite(_t) else float("nan")
        except Exception:  # noqa: BLE001
            import math
            _p = float(math.erfc(abs(_t) / math.sqrt(2.0))) \
                if np.isfinite(_t) else float("nan")
        return float(_beta[0]), _b, _se_b, _p, _tab, "ok"
    except Exception as exc:  # noqa: BLE001 - uncalibrated twin stands
        return 0.0, 1.0, float("nan"), float("nan"), empty, str(exc)[:200]


def build_game_frame(panel, bin_ns, cal, ctx, seg_flow, profile, fixture_ids,
                     crowd_med=None):
    """Rows for the fixtures in `fixture_ids` (unique per calendar row).

    The frame's `fixture` column carries fixture_id, not `label`: labels
    repeat across seasons, so keying on them merged two different games
    into one surface. `label` is carried alongside for reporting.
    """
    parts = []
    for _, row in cal.iterrows():
        if row["fixture_id"] not in fixture_ids:
            continue
        sub = window_rows(panel, bin_ns, row["ko"], row["fixture_id"])
        if sub.empty:
            continue
        sub["fixture_label"] = str(row["label"])
        sub["attendance"] = float(row["attendance"]) if np.isfinite(
            row["attendance"]) else 0.0
        sub["fixture_type"] = str(row.get("fixture_type", "") or "")
        try:
            sub["ko_hour"] = float(row["ko"].hour) + float(row["ko"].minute) / 60.0
        except Exception:
            sub["ko_hour"] = 0.0
        parts.append(sub)
    if not parts:
        return pd.DataFrame()
    frame = pd.concat(parts, ignore_index=True)
    frame["code"] = frame["fixture_type"].fillna("").astype(str)
    frame = add_calendar(frame)
    frame["in_event"] = 1.0
    frame["rel_hour"] = frame["rel_bin"] / BINS_PER_HOUR + WINDOW_HOURS[0]
    frame["log_att"] = np.log1p(frame["attendance"])
    frame = add_game_temporal(frame)
    frame = add_static(frame, ctx)
    frame["event_x_dist"] = frame["in_event"] * frame["dist_stad"]
    frame = add_game_wide(frame, crowd_med=crowd_med)
    frame = add_exposure(frame, ctx, seg_flow, profile)
    return frame


def enrich_background(bg, ctx, seg_flow, profile):
    bg = add_calendar(bg)
    bg["code"] = "BG"
    bg["fixture"] = "BG"
    bg["in_event"] = 0.0
    bg["rel_hour"] = 0.0
    bg["attendance"] = 0.0
    bg["log_att"] = 0.0
    bg["fixture_type"] = ""
    bg["ko_hour"] = 0.0
    bg["rel_hour_sq"] = 0.0
    bg["rel_sin"] = 0.0
    bg["rel_cos"] = 1.0
    bg["pre_game"] = 0.0
    bg["post_game"] = 0.0
    bg = add_static(bg, ctx)
    bg["event_x_dist"] = 0.0
    bg = add_game_wide(bg, crowd_med=1e18)
    bg = add_exposure(bg, ctx, seg_flow, profile)
    return bg


def search_frame(frame, target):
    cols = (["road_osmid", "bin", target, "code", "fixture"] + CAL_VARS
            + DOW_DUMMIES + WEATHER_COLS
            + GAME_VARS + GAME_WIDE_VARS + TEMPORAL_VARS + TIME_X_VARS
            + CONT_VARS + [
                "exp", "logexp", "highway", "aadt_z", "log_flow_z",
                # The measured denominator. The response is a count of
                # speeding TRIPS, so its true denominator is the number of
                # trips that got a speed reading -- NOT trip_count, because
                # a trip with no speed cannot be classified as speeding
                # (trip_exceed is NaN and NaN > margin is False, so
                # unjudged trips would bias the rate down exactly where
                # judging is worst). Stage 58 measures it; the count
                # refit never used it, which is the whole reason the
                # exposure LRT keeps rejecting the flow proxy.
                BINOMIAL_DENOM])
    # Every denominator a known target could resolve to, so search_frame keeps
    # whichever one this run actually needs. The filter below keeps only
    # columns present in the frame, so listing them all is safe.
    cols = cols + [c for c in sorted(set(
        list(BINOMIAL_DENOM_BY_TARGET.values()) + [BINOMIAL_DENOM]))
        if c not in cols]
    work = frame[[c for c in cols if c in frame.columns]].copy()
    if target in work.columns:
        work = work.rename(columns={target: "Y"})
    else:
        work["Y"] = 0.0
    # SEG_GROUP_VAR is log_length, which is already present and already
    # forced fixed -- it is the within-group-constant carrier for the
    # grouped (role 4) effect. An earlier version added a constant
    # seg_group_id column instead; the package's identifiability screen
    # rejects single-valued variables, so that structure never built.
    if SEG_GROUP_VAR not in work.columns and "road_osmid" in work.columns:
        # Fallback only if log_length was not carried through upstream.
        work[SEG_GROUP_VAR] = 0.0
    work["row_id"] = np.arange(len(work))
    for col in (CAL_VARS + DOW_DUMMIES + WEATHER_COLS + GAME_VARS
                + GAME_WIDE_VARS + TEMPORAL_VARS
                + TIME_X_VARS + CONT_VARS
                + ["logexp", "Y", "aadt_z", "log_flow_z"]):
        if col in work.columns:
            work[col] = pd.to_numeric(work[col], errors="coerce")
            work[col] = work[col].replace([np.inf, -np.inf], 0.0).fillna(0.0)
    return work


def _build_evaluator(builder, variables, constraints, roles, R, engine,
                     max_latent_classes=1):
    try:
        ev = builder.build_evaluator(
            variables=variables, constraints=constraints,
            default_roles=roles, max_latent_classes=int(max_latent_classes),
            R=int(R), engine=engine)
        return ev, engine
    except (TypeError, ValueError) as exc:
        print(f"   WARN: engine={engine} unsupported ({exc}); using default")
        ev = builder.build_evaluator(
            variables=variables, constraints=constraints,
            default_roles=roles, max_latent_classes=int(max_latent_classes),
            R=int(R))
        return ev, "default-jax"


def _grouped_eligible(evaluator):
    """Variables whose allowed roles include 4 (Grouped)."""
    out = []
    try:
        allowed = getattr(evaluator, "allowed_roles", {}) or {}
        for var in (getattr(evaluator, "vars", []) or []):
            if 4 in (allowed.get(var) or []):
                out.append(var)
    except Exception:  # noqa: BLE001
        pass
    return out


def _base_seed_decision(evaluator, dispersion=0, term=None, term_role=0):
    """A MINIMAL valid decision vector for the grouped probe.

    Only the forced terms are active; everything else is Excluded (role 0).
    The probe term is set to `term_role` (1 = Fixed for the control, 4 =
    Grouped for the treatment), so the ONLY difference between the two fits
    is that single gene -- which is what makes the BIC delta attributable
    to grouping rather than to structure.

    An earlier version set every variable Fixed. That is structurally
    guaranteed to fail: 15 mutually-exclusive highway dummies plus the
    calendar/game/interaction blocks are collinear, build_spec() returns
    None, and fitness() hands back the 1e12 failure sentinel. Both arms
    then read 1e12, the delta came out exactly 0.0, and the probe
    reported a confident "grouped loses" for every term while having
    fitted nothing at all.
    """
    try:
        vars_ = list(getattr(evaluator, "vars", []) or [])
        allowed = getattr(evaluator, "allowed_roles", {}) or {}
    except Exception:  # noqa: BLE001
        return None
    if not vars_:
        return None
    D = len(vars_)
    decision = np.zeros(2 * D + 1, dtype=int)
    for i, var in enumerate(vars_):
        ok = list(allowed.get(var) or [0])
        # A variable is "forced" when Excluded is not among its options.
        if 0 not in ok:
            decision[i] = 1 if 1 in ok else (2 if 2 in ok else 0)
    if term is not None and term in vars_:
        i = vars_.index(term)
        if term_role in (allowed.get(term) or [0]):
            decision[i] = int(term_role)
    # dist genes: index 0 of each variable's allowed list is the package
    # default, so 0 is always a decodable choice.
    decision[D:2 * D] = 0
    decision[2 * D] = int(dispersion) % 2
    return decision


def _probe_grouped(evaluator, group_col, audit, args):
    """Evaluate a Grouped structure so the grouped path is actually tested.

    Why this is necessary: build_jax_data only activates the group machinery
    when `grouped_cols` is non-empty, and the SA can only propose role 4 for
    a candidate that already carries it. With ~40 role genes and 40
    iterations the chance of the random walk landing on a grouped structure
    is negligible, so grouped_terms came back [] in both 61 and 61b and the
    grouping axis was silently untested.

    Each arm is a MINIMAL scaffold (forced terms only): the control has the
    term Fixed, the treatment has it Grouped, everything else Excluded. The
    BIC delta between the two arms is therefore attributable to grouping
    alone. Role 4 costs log(n)*2 BIC, so a grouped arm only "wins" if the
    delta is better than that -- the verdict below states the break-even
    rather than just the sign.
    """
    if not _use_group_probe(args):
        return None
    elig = _grouped_eligible(evaluator)
    audit["grouped_eligible"] = list(elig)
    if not elig:
        audit["grouped_probe"] = {"attempted": True, "skipped":
                                  "no variable allows role 4"}
        print("   [grouped] probe skipped: no variable allows role 4")
        return None
    # SEG_GROUP_VAR (log_length) is the segment-identity carrier: it is
    # constant within a segment, so its grouped coefficient is a
    # per-segment propensity contrast. Probed first because that is the
    # question "group by segment" is really asking. Then the geometry
    # covariates, which answer the different question of whether e.g.
    # lanes_z should vary by segment.
    order = [v for v in (SEG_GROUP_VAR, "lanes_z", "aadt_z",
                         "maxspeed_z", "dist_inter_z") if v in elig]
    if str(group_col) != "segment":
        # Grouping is by highway/event, so the segment-identity carrier is
        # not the question being asked; keep it out of the report.
        order = [v for v in order if v != SEG_GROUP_VAR]
    order += [v for v in elig if v not in order]
    results = {}

    def _bic(decision):
        """Evaluate, mapping the 1e12 failure sentinel to None.

        A failed arm must never become a number. Returning 1e12 on both
        sides previously produced delta == 0.0 and a confident-looking
        'grouped loses' for every term, having fitted nothing.
        """
        raw = float(np.min(np.asarray(
            evaluator.fitness(decision), dtype=float)))
        return None if not np.isfinite(raw) or raw >= 1e11 else raw

    try:
        n_obs = int(getattr(getattr(evaluator, "df_train", None),
                            "shape", [0])[0]) or 0
        # Role 4 spends 2 parameters (group_mean + group_sd) vs role 1's one.
        breakeven = float(np.log(max(n_obs, 2)) * 2.0)
        audit["grouped_probe_breakeven"] = round(breakeven, 3)
        for term in order:
            for disp in (0, 1):
                control = _base_seed_decision(evaluator, dispersion=disp,
                                              term=term, term_role=1)
                treat = _base_seed_decision(evaluator, dispersion=disp,
                                            term=term, term_role=4)
                if control is None or treat is None:
                    return None
                b_base = _bic(control)
                b_grp = _bic(treat)
                rec = {"term": term, "dispersion": disp,
                       "base_bic": b_base, "grouped_bic": b_grp,
                       "breakeven_bic": round(breakeven, 3)}
                if b_base is None or b_grp is None:
                    rec.update({"ok": False,
                                "reason": "arm failed to fit (1e12 sentinel)",
                                "delta": None, "grouped_wins": None})
                else:
                    rec["ok"] = True
                    rec["delta"] = round(b_grp - b_base, 3)
                    rec["grouped_wins"] = bool(rec["delta"] < -breakeven)
                results[f"{term}|disp{disp}"] = rec
    except Exception as exc:  # noqa: BLE001
        audit["grouped_probe"] = {"attempted": True, "error": str(exc)[:200]}
        print(f"   [grouped] probe raised ({type(exc).__name__}: {exc}); "
              "continuing without it")
        return None
    audit["grouped_probe"] = {"attempted": True, "group_col": group_col,
                              "terms_probed": list(order), "results": results}
    n_bad = sum(1 for r in results.values() if not r.get("ok"))
    for r in results.values():
        marker = "  <-- segment identity" if r["term"] == SEG_GROUP_VAR else ""
        if not r.get("ok"):
            print(f"   [grouped] term={r['term']:<14} disp={r['dispersion']} "
                  f"INCONCLUSIVE: {r['reason']}{marker}")
            continue
        verdict = ("GROUPED WINS" if r["grouped_wins"]
                   else "grouped loses (over BIC penalty)")
        print(f"   [grouped] term={r['term']:<14} disp={r['dispersion']} "
              f"base={r['base_bic']:.1f} grouped={r['grouped_bic']:.1f} "
              f"delta={r['delta']:+.1f} (breakeven {-breakeven:.1f}) "
              f"-> {verdict}{marker}")
    if n_bad:
        print(f"   [grouped] WARNING: {n_bad}/{len(results)} probes were "
              "INCONCLUSIVE (an arm returned the failure sentinel). "
              "Treat those terms as untested, not as rejected.")
    return results


def _use_group_probe(args):
    return str(getattr(args, "group_probe", "on") or "on").lower() != "off"


def _extract_search_best(evaluator):
    """Best (score, spec, n_eval, decision) from the evaluator cache."""
    n_eval = 0
    try:
        items = list(getattr(evaluator, "cache", {}).items())
    except Exception:  # noqa: BLE001
        items = []
    n_eval = len(items)
    want = None
    try:
        want = len(getattr(evaluator, "vars", []) or [])
    except Exception:  # noqa: BLE001
        want = None
    candidates = []
    for key, val in items:
        if not isinstance(key, (tuple, list)):
            continue
        if want and len(key) not in (2 * want + 1, 3 * want + 2):
            continue
        try:
            score = float(np.min(np.asarray(val, dtype=float)))
        except Exception:  # noqa: BLE001
            continue
        if np.isfinite(score) and score < 1e12:
            candidates.append((score, key))
    candidates.sort(key=lambda item: item[0])
    for score, key in candidates[:200]:
        # Genes are integer codes; decode from a rounded int vector so list
        # indexing inside build_spec never sees float role/dist codes.
        decision = np.rint(np.asarray(key, dtype=float)).astype(int)
        try:
            spec = evaluator.build_spec(decision)
        except Exception:  # noqa: BLE001 - unsupported role; try next best
            continue
        if spec is not None:
            return float(score), spec, n_eval, decision
    return float("nan"), None, n_eval, None


def _append_progress(row):
    header = not PROGRESS_CSV.exists()
    pd.DataFrame([row]).to_csv(PROGRESS_CSV, mode="a", header=header,
                               index=False)


def run_search(work, args, audit, out_dir, resume_state=None):
    from metacountregressor import ExperimentBuilder, ModelConstraints

    if args.search_vars == "slim":
        cont_list, cal_list, game_list = SLIM_CONT, SLIM_CAL, SLIM_GAME
    else:
        cont_list, cal_list, game_list = CONT_VARS, CAL_VARS, GAME_VARS
    # AADT candidates: external TMR join (aadt_z) if present, else probe
    # AADT proxy (log_flow_z) built from seg_flow exposure downstream.
    # Both are searched and kept only if BIC-significant.
    aadt_cands = [c for c in ("aadt_z", "log_flow_z") if c in work.columns]
    # SEG_GROUP_VAR is appended unconditionally: it is the segment identity
    # and must be allowed to take the grouped (role 4) effect. It is NOT
    # force_fixed -- forcing it would ban roles 2/3/4 and make grouping
    # impossible, which is exactly the bug that left grouped_terms empty.
    cand_cont = [c for c in cont_list + ["log_length"] + aadt_cands
                 + [SEG_GROUP_VAR] if c in work.columns]
    cand_cal = [c for c in cal_list + DOW_DUMMIES + WEATHER_COLS
                if c in work.columns]
    cand_game = [c for c in game_list if c in work.columns]
    # Temporal shape vars are searchable fixed-only terms; --no-temporal-vars
    # drops them from the candidate pool (peak shape then comes only from
    # rel_hour/game dummies + the optional stage-2b AR).
    cand_temp = [c for c in TEMPORAL_VARS
                 if c in work.columns
                 and not getattr(args, "no_temporal_vars", False)]
    # Fixture-attribute + interaction block: always searchable (slim or
    # full) — this is what lets future fixtures differ by shape, not scale.
    cand_wide = [c for c in GAME_WIDE_VARS if c in work.columns]
    # Transferable-temporal candidates: deterministic transforms of history
    # and the event clock — fixed-only, never random parameters.
    cand_timex = [c for c in TIME_X_VARS if c in work.columns]
    hw = [c for c in work.columns if c.startswith("hw_")]
    # Exposure-shape terms (hinge curvature and/or logexp x highway). Searchable
    # but fixed-only: they describe the shape of the flow->speeding curve, not
    # per-segment taste, so a random coefficient on them would be unidentified
    # noise. BIC decides whether any of them earn their place.
    shape_cols = [c for c in work.columns
                  if c.startswith("logexp_h") or c.startswith("logexp_x_")]
    variables = (["logexp"] + hw + cand_cont + cand_cal + cand_game
                 + cand_temp + cand_wide + cand_timex + shape_cols)
    # Game-day dynamics are FORCED (never droppable): exposure + the game
    # block enter every spec. Temporal-shape vars stay searchable but
    # fixed-only (stable within-window curvature, no random taste variation).
    # Random parameters are restricted to continuous geometry/flow terms —
    # the old code re-allowed cal/game into allow_random, letting the search
    # waste draws on binary game dummies.
    force_game = force_terms(work, args) if not args.no_force_game else []
    # Segment length is exposure scale (like logexp): counts must scale
    # with metres, otherwise 4 m driveways get the same baseline as
    # 400 m arterials (o25908597: 45 m osmid hogged 72% of predictions).
    force_len = ["log_length"] if "log_length" in work.columns else []
    # Role 6 (zero inflation) candidates, resolved BEFORE the constraint chain
    # because no_zi() is destructive and accumulates: it does
    # `allowed.discard(6)` per variable, so a later call with a SHORTER ban
    # list cannot restore the role. Calling it twice -- once for everything,
    # then again for the non-candidates -- silently left every variable
    # banned and made --zero-inflation on a no-op that looked like "ZI was
    # tried and did not help". So the ban list is computed once, here.
    zi_cands = ([c for c in cand_cont + cand_cal if c in work.columns]
                if str(getattr(args, "zero_inflation", "off")) == "on" else [])
    zi_banned = [c for c in variables if c not in zi_cands]
    constraints = (ModelConstraints()
                   .force_include("logexp", *force_len, *force_game)
                   .force_fixed("logexp", *force_len, *force_game)
                   .no_random("logexp", *force_len, *hw, *cand_cal,
                              *cand_game, *cand_temp, *cand_wide,
                              *cand_timex, *shape_cols)
                   .no_zi("logexp", *zi_banned))
    allow = [c for c in cand_cont if c not in hw]
    _fixed_only = bool(getattr(args, "fixed_only", False))
    if allow and not _fixed_only:
        constraints = constraints.allow_random(*allow, distributions=["normal"])
    if _fixed_only:
        print("   fixed-only: random-parameter roles banned (fixed/excluded "
              "search + fixed refit, no RP draws)")
    # --- per-segment temporal response (opt-in) -------------------------
    # With --group-temporal on, the temporal basis may take role 4 (grouped)
    # as well as fixed, so the WITHIN-WINDOW SHAPE can differ by segment
    # instead of being one curve for the whole network scaled by static
    # coefficients. Roles 2/3 (random independent/correlated) stay banned:
    # those draw huge numbers of free parameters on a panel this size and are
    # not what is wanted here; role 4 shrinks each segment's slope toward the
    # group mean. set_roles OVERWRITES the allowed set (it does not intersect),
    # so {1, 4} here also removes role 0 -- the term must appear.
    gt_vars = ([c for c in ("rel_sin", "rel_cos") if c in work.columns]
               if str(getattr(args, "group_temporal", "off")).lower() == "on"
               and not _fixed_only
               else [])
    for _v in gt_vars:
        constraints = (constraints.set_roles(_v, [1, 4])
                       .set_distributions(_v, ["normal"]))
    if gt_vars:
        print(f"   [temporal] grouped temporal slope enabled on: {gt_vars} "
              f"(group = {getattr(args, 'group_by', 'highway')})")
    audit["group_temporal"] = {
        "enabled": bool(gt_vars), "vars": list(gt_vars),
        "group_col": str(getattr(args, "group_by", "highway"))}
    audit["forced_game_terms"] = list(force_game)
    # Grouped panel structure. --group-by event splits by fixture: each
    # event gets its own grouped coefficients (the per-event split), shrunk
    # toward means driven by heterogeneity vars (game attributes), so unseen
    # future events predict from attributes. Background rows form the "BG"
    # control group. Segment/highway groupings are place-effect variants.
    _group_col = str(args.group_by or "highway")
    if _group_col == "segment":
        _g = work["road_osmid"].astype(str) if "road_osmid" in work.columns else None
        _gid = "road_osmid" if "road_osmid" in work.columns else None
    elif _group_col == "event":
        _g = (work["fixture"].fillna("BG").astype(str)
              if "fixture" in work.columns else None)
        _gid = "fixture" if "fixture" in work.columns else None
    else:
        _group_col, _gid = "highway", "highway"
        _g = (work["highway"].astype("string").fillna("unclassified").astype(str)
              if "highway" in work.columns else None)
    _use_g = False
    if _g is not None:
        _vc = _g.value_counts()
        _use_g = bool(len(_vc) >= 2 and int((_vc >= 20).sum()) >= 2)
    # SEG_GROUP_VAR is log_length: constant within a segment, so its grouped
    # (role 4) coefficient is a per-segment propensity contrast. It is
    # already a forced fixed term and needs no candidate-pool change; the
    # probe simply skips it when the grouping is not by segment, because a
    # highway-level length coefficient is a re-parameterised length effect
    # rather than a segment propensity.
    audit["seg_group_term"] = (
        SEG_GROUP_VAR if _group_col == "segment"
        else f"{SEG_GROUP_VAR} (probe skipped: --group-by {_group_col} is "
             "not a segment grouping)")
    if _fixed_only:
        builder = ExperimentBuilder(work, id_col="row_id", y_col="Y")
        roles = [0, 1]
    elif _use_g and _gid is not None:
        builder = ExperimentBuilder(work, id_col="row_id", y_col="Y",
                                    group_id_col=_gid)
        roles = [0, 1, 2, 3, 4, 5]
    else:
        builder = ExperimentBuilder(work, id_col="row_id", y_col="Y")
        roles = [0, 1, 2, 3, 5]
    # Role 6 is offered to the search only when ZI was requested. The package
    # derives zero_inflated from len(zi_cols) > 0, so with no candidate
    # actually assigned the fitted model stays an ordinary count model.
    if zi_cands:
        roles = roles + [6]
    audit["zi_requested"] = (str(getattr(args, "zero_inflation", "off"))
                             == "on")
    audit["zi_candidates"] = list(zi_cands)
    if zi_cands:
        print(f"   zero inflation: role 6 offered for {len(zi_cands)} "
              f"candidate terms")
    audit["group_by"] = _group_col if _use_g else "none"
    audit["grouped_gse"] = bool(_use_g)
    audit["default_roles"] = list(roles)
    evaluator, engine_used = _build_evaluator(
        builder, variables, constraints, roles, int(args.search_R),
        str(args.engine), max_latent_classes=int(args.max_latent_classes))
    audit["engine_used"] = engine_used
    # Fail loudly if ZI was requested but is not actually reachable. The
    # failure mode is silent: role 6 missing from every allowed set means the
    # search simply never proposes a zero-inflated spec, and the run looks
    # exactly like "ZI was tried and BIC rejected it".
    zi_reachable = []
    try:
        _ar = getattr(evaluator, "allowed_roles", {}) or {}
        zi_reachable = [v for v in zi_cands if 6 in (_ar.get(v) or [])]
    except Exception:  # noqa: BLE001
        pass
    audit["zi_reachable"] = list(zi_reachable)
    if audit["zi_requested"] and not zi_reachable:
        print("   [zi] *** REQUESTED BUT NOT REACHABLE: no candidate can take "
              "role 6, so this run is NOT a zero-inflation test ***")
    elif zi_reachable:
        print(f"   [zi] role 6 reachable for {len(zi_reachable)}/{len(zi_cands)} "
              f"candidates")
    audit["n_variables"] = len(variables)
    # Probe the grouped axis BEFORE the SA loop. The search cannot reach a
    # role-4 structure on its own (see _probe_grouped), and without this the
    # grouping decision is made by default rather than by evidence.
    if not _fixed_only:
        _probe_grouped(evaluator, _group_col if _use_g else None, audit, args)
    else:
        audit["grouped_probe"] = {"skipped": "fixed-only"}
    search_dir = out_dir / "search59"
    search_dir.mkdir(parents=True, exist_ok=True)
    try:
        from metacountregressor import SearchOutputConfig
        out_cfg = SearchOutputConfig(
            output_dir=str(search_dir), experiment_name="game_day",
            search_description="15-min speeding structure search (BIC)",
            checkpoint_every=int(args.checkpoint_every))
    except Exception:
        out_cfg = None

    total_iters = int(args.search_iters)
    chunk = max(1, int(args.search_chunk))
    done = int((resume_state or {}).get("iters_completed", 0) or 0)
    best_bic = (resume_state or {}).get("best_bic")
    best_spec = (resume_state or {}).get("best_spec")
    best_decision = (resume_state or {}).get("best_decision")
    if best_decision is not None:
        best_decision = np.asarray(best_decision, dtype=float)
    if best_spec is not None and not isinstance(best_spec, dict):
        best_spec = None

    t0 = time.time()
    search_error = None
    chunk_failures = 0
    stalled = 0
    cwd = os.getcwd()
    try:
        os.chdir(search_dir)
        while done < total_iters:
            elapsed_total = time.time() - t0
            if args.wall_budget and elapsed_total >= float(args.wall_budget):
                print(f"   [search] wall budget reached "
                      f"({args.wall_budget:.0f}s); stopping at "
                      f"{done}/{total_iters} iters (resubmit --resume to "
                      "continue)")
                break
            n = min(chunk, total_iters - done)
            chunk_idx = int(done // max(1, int(chunk)))
            # Fresh RNG stream per chunk: same seed + same warm start replays
            # the byte-identical proposal sequence as pure cache hits (0.0s
            # chunks that learn nothing — o26613390 chunks 3-8). Jittering
            # the seed sends every chunk into a NEW neighborhood.
            chunk_seed = int(args.seed) + 7919 * chunk_idx
            # Stall-triggered cold restart: two chunks with no improvement
            # means the warm neighborhood is exhausted; restart from random
            # inits to jump elsewhere (the evaluator cache stays warm, so
            # overlap with tried specs is still free).
            if stalled >= 2:
                print(f"   [search] no improvement for {stalled} chunks; "
                      f"cold-restarting chunk {chunk_idx + 1} "
                      f"(seed={chunk_seed})")
                warm = False
                stalled = 0
            else:
                warm = best_decision is not None
            n_starts = int(args.n_starts) if not warm else 1
            # Bound the chunk wall time: --chunk-time bounds a whole chunk,
            # the wall budget bounds the search stage, and SA's max_time is
            # per restart -- so divide by the number of restarts.
            chunk_budget = float(args.chunk_time) if args.chunk_time else None
            if args.wall_budget:
                remaining = float(args.wall_budget) - elapsed_total
                chunk_budget = (remaining if chunk_budget is None
                                else min(chunk_budget, remaining))
            max_time = (chunk_budget / n_starts
                        if chunk_budget and chunk_budget > 0 else None)
            run_kwargs = dict(
                algo=args.search_algo,
                max_iter=int(n),
                n_starts=n_starts,
                seed=int(chunk_seed),
                n_jobs=max(1, int(getattr(args, "search_n_jobs", 1))),
                output_config=out_cfg,
                max_time=max_time,
                refit=False,
                warm_start_cache=True,
            )
            if warm:
                run_kwargs["init_solutions"] = [best_decision]
            print(f"   [search] chunk {done // chunk + 1}: iters "
                  f"{done + 1}..{done + n} of {total_iters} "
                  f"(starts={run_kwargs['n_starts']}, warm={warm}, "
                  f"seed={chunk_seed})")
            error = None
            result = None
            try:
                result = builder.run(evaluator, **run_kwargs)
            except Exception as exc:  # noqa: BLE001 - keep the best cached spec
                error = f"{type(exc).__name__}: {exc}"
                print(f"   WARN: chunk raised ({error}); keeping best "
                      "cached spec")
                traceback.print_exc()
            score, spec, n_eval, decision = _extract_search_best(evaluator)
            _prev_best = best_bic
            if np.isfinite(score) and (best_bic is None
                                       or score < float(best_bic)):
                best_bic = float(score)
                best_spec = spec
                best_decision = decision
            if best_bic is not None and (
                    _prev_best is None or best_bic < _prev_best - 1e-9):
                stalled = 0
            elif best_bic is not None:
                stalled += 1
            search_error = error or search_error
            # Count the generations that actually ran: a chunk stopped by
            # --chunk-time (max_time) completes fewer than its nominal n, and
            # the shortfall is picked up by the next chunk.
            ran = n
            if result is not None:
                try:
                    gens = sum(len(s) for s in (result.get("search_stats") or [])
                               if s is not None)
                    if gens > 0:
                        ran = max(1, min(int(n), int(gens)))
                except Exception:  # noqa: BLE001 - non-list stats
                    ran = n
            elif n_eval == 0:
                ran = 0
            done += int(ran)
            _write_json_atomic(BEST_JSON, {
                "best_spec": best_spec, "best_bic": best_bic,
                "best_decision": None if best_decision is None
                else np.asarray(best_decision, dtype=float).tolist(),
                "algo": args.search_algo, "iters": total_iters,
                "iters_completed": int(done), "chunk_size": int(chunk),
                "R": int(args.search_R), "seed": int(args.seed),
                  "target": args.target, "search_gen": SEARCH_GEN,
                  # Recorded so a resume can tell whether the temporal terms
                  # were allowed the grouped role: that changes the search
                  # space, so a checkpoint from the other setting must not be
                  # reused (see the resume validation in main).
                  "group_temporal": bool(gt_vars),
                  "engine": engine_used, "variables": variables,
                "search_error": search_error,
                "updated_iso": _utcnow_iso()})
            _append_progress({
                "chunk": int(done // chunk), "iters_completed": int(done),
                "total_iters": int(total_iters),
                "elapsed_s": round(time.time() - t0, 1),
                "best_bic": None if best_bic is None
                else round(float(best_bic), 2),
                "n_cache_evals": int(n_eval),
                "timestamp_iso": _utcnow_iso()})
            # Characteristic attribution: which families make up the best
            # spec now, what entered/left vs the previous chunk, and the
            # BIC gain. Proves convergence *by characteristic* (telematics
            # vs weather vs game info vs geometry...), not just a falling
            # scalar.
            try:
                _terms = []
                if isinstance(best_spec, dict):
                    for _k in ("fixed_terms", "rdm_terms", "rdm_cor_terms",
                               "grouped_terms", "hetro_in_means",
                               "hetro_in_variances"):
                        _terms += [str(t).split(":")[0]
                                   for t in (best_spec.get(_k) or [])]
                _fam = {}
                for _t in _terms:
                    _f = term_family(_t)
                    _fam[_f] = _fam.get(_f, 0) + 1
                _prev = getattr(run_search, "_prev_fam", None)
                _added = sorted(set(_fam) - set(_prev or {}))
                _dropped = sorted(set(_prev or {}) - set(_fam))
                run_search._prev_fam = dict(_fam)
                _prev_bic = getattr(run_search, "_prev_bic", None)
                _dbic = ("" if _prev_bic is None or best_bic is None
                         else round(float(best_bic) - float(_prev_bic), 2))
                run_search._prev_bic = best_bic
                _frow = {"chunk": int(done // chunk),
                         "iters_completed": int(done),
                         "best_bic": ("" if best_bic is None
                                      else round(float(best_bic), 2)),
                         "delta_bic": _dbic,
                         "added_families": "|".join(_added),
                         "dropped_families": "|".join(_dropped)}
                for _f in FAMILY_ORDER:
                    _frow[f"n_{_f}"] = int(_fam.get(_f, 0))
                _fhdr = not FAMILY_CSV.exists()
                pd.DataFrame([_frow]).to_csv(FAMILY_CSV, mode="a",
                                             header=_fhdr, index=False)
            except Exception as exc:  # noqa: BLE001 - diagnostic only
                print(f"   WARN: family attribution failed ({exc})")
            if error and n_eval == 0:
                chunk_failures += 1
                if chunk_failures >= 2:
                    print("   [search] two consecutive empty/failed chunks;"
                          " stopping")
                    break
            else:
                chunk_failures = 0
            _clear_jax_caches()
    finally:
        os.chdir(cwd)

    complete = done >= total_iters
    # Rejection diagnostics. Every 1e12 the search saw used to be anonymous,
    # so a structural axis that failed silently looked identical to one that
    # was never tried. Report the breakdown.
    try:
        _rej = evaluator.reject_summary()
    except Exception:  # noqa: BLE001
        _rej = {"counts": {}, "recent": []}
    audit["search"] = {
        "resumed": bool(resume_state),
        "best_bic": best_bic,
        "done_iters": int(done),
        "total_iters": int(total_iters),
        "complete": bool(complete),
        "engine": engine_used,
        "variables": variables,
        "search_error": search_error,
        "rejections": _rej,
    }
    _tot_rej = sum(int(v.get("count", 0)) for v in _rej.get("counts", {}).values())
    if _tot_rej:
        print(f"   [search] rejected structures: {_tot_rej} total")
        for _why, _v in sorted(_rej.get("counts", {}).items(),
                               key=lambda kv: -int(kv[1].get("count", 0))):
            _d = str(_v.get("detail", ""))[:90]
            print(f"      {int(_v.get('count', 0)):>6}  {_why}"
                  + (f"  -- {_d}" if _d else ""))
    if best_spec is not None:
        print(f"   [search] best_BIC={best_bic:.1f} "
              f"iters={done}/{total_iters} complete={complete}")
    else:
        print("   WARN: search produced no spec; using fallback")
    return best_spec, best_bic, variables, engine_used, done, complete


DEFAULT_FIXED = ["logexp", "in_event", "rel_hour", "log_att", "dist_stad",
                 "event_x_dist", "rel_hour_sq", "rel_sin", "rel_cos",
                 "clock_prof", "seg_risk_z", "exp_lag1",
                 "tod_sin", "tod_cos", "weekend", "lanes_z", "maxspeed_z"]


def ensure_spec(spec, work, audit, force_game=True, keep_temporal=True,
                args=None):
    """Guarantee a usable spec: exposure + game-day block always in.

    The SA search on sparse 15-min counts can select an all-excluded solution
    (and evaluator.build_spec does not re-apply force_include). Exposure is
    forced in; the GAME_FORCE block (in_event/rel_hour/log_att/event_x_dist)
    is re-attached unless --no-force-game was passed, so a game-day plan can
    never be driven by a static-only model again. Near-empty specs fall back
    to DEFAULT_FIXED (which now carries the game + temporal block).
    With keep_temporal=False (--no-temporal-vars), temporal-shape terms are
    stripped so the peak can be compared with/without them.
    """
    if spec is None:
        spec = {}
    fixed = [c for c in spec.get("fixed_terms", []) if c in work.columns]
    if not keep_temporal:
        fixed = [c for c in fixed if c not in TEMPORAL_VARS]
    if "logexp" not in fixed:
        fixed = ["logexp"] + fixed
    missing_game = []
    if force_game:
        for c in force_terms(work, args):
            if c not in fixed:
                fixed.append(c)
                missing_game.append(c)
    audit["game_terms_patched"] = list(missing_game)
    if len(fixed) <= 1:
        fallback = [c for c in DEFAULT_FIXED
                    if c in work.columns
                    and (keep_temporal or c not in TEMPORAL_VARS)]
        audit["spec_fallback"] = True
        fixed = fallback
    else:
        audit["spec_fallback"] = False
    spec = dict(spec)
    spec["fixed_terms"] = fixed
    spec["rdm_terms"] = [t for t in spec.get("rdm_terms", [])
                         if str(t).split(":")[0] in work.columns]
    return spec


def _rss_gb(tag=""):
    try:
        import psutil
        rss = psutil.Process().memory_info().rss / 1024**3
        print(f"   [mem] {tag}: RSS={rss:.2f} GB")
        return rss
    except Exception:
        return float("nan")


def _spec_fields(spec, work):
    """Full searched structure filtered to columns present in work.

    Previously only fixed+rdm_terms were passed, silently dropping the
    searched correlated/grouped/heterogeneity structure (and refitting a
    fixed-only model that then diverged).
    """
    from metacount_nb import _norm_spec_terms
    fixed = [c for c in spec.get("fixed_terms", [])
             if c.split(":")[0] in work.columns]
    fields = {
        "fixed_terms": fixed,
        "rdm_terms": _norm_spec_terms(spec.get("rdm_terms"), work),
        "rdm_cor_terms": _norm_spec_terms(spec.get("rdm_cor_terms"), work),
        "grouped_terms": _norm_spec_terms(spec.get("grouped_terms"), work),
        "hetro_in_means": [str(t).split(":")[0]
                           for t in (spec.get("hetro_in_means") or [])
                           if str(t).split(":")[0] in work.columns],
        "hetro_in_variances": [str(t).split(":")[0]
                               for t in (spec.get("hetro_in_variances") or [])
                               if str(t).split(":")[0] in work.columns],
        "group_id_col": spec.get("group_id_col") or "highway",
    }
    if "highway" not in work.columns:
        fields["grouped_terms"] = []
        fields["group_id_col"] = None
    return fields


def refit_only(work, spec, args, audit):
    """JAX refit on the 100k-row search frame only (no future data alive).

    Panel/future frames must already be freed or reduced to light keys
    before calling — peak is then work + draws + eta, not panel + work.
    Carries the FULL searched spec (correlated/grouped/hetero); staged
    fallback inside fit_metacount_nb guarantees a sane accepted fit.

    The likelihood follows the SEARCH rather than being hardcoded. The
    structural search scores each candidate with a real fit and the
    dispersion gene picks Poisson (0) vs NB2 (1) on BIC, so refitting a
    forced "nb" ships a model the search never selected and reports a BIC
    that does not describe it. --refit-model overrides (nb|poisson); the
    default "searched" honours spec["dispersion"].
    """
    fields = _spec_fields(spec, work)
    _mode = str(getattr(args, "refit_model", "searched") or "searched").lower()
    if _mode in ("searched", "auto", ""):
        # build_spec emits dispersion 0/1 from the search's dispersion gene.
        _mode = "nb" if int(spec.get("dispersion", 1) or 0) == 1 else "poisson"
    if _mode not in ("nb", "poisson"):
        raise SystemExit(f"--refit-model must be searched|nb|poisson, got {_mode!r}")
    # Exposure parameterisation. 'offset' pins the exposure coefficient at 1
    # (the hazard/rate form): logexp moves from a free fixed effect into the
    # likelihood's fixed offset. The two are nested, so this is a genuine
    # testable restriction rather than a different model -- see the LRT below.
    _exp = str(getattr(args, "exposure", "free") or "free").lower()
    if _exp not in ("free", "offset", "hazard"):
        raise SystemExit(f"--exposure must be free|offset, got {_exp!r}")
    _offset_col = None
    if _exp in ("offset", "hazard"):
        if "logexp" not in work.columns:
            raise SystemExit("--exposure offset needs a 'logexp' column "
                             "(log-scale exposure) in the search frame")
        _offset_col = "logexp"
    audit["exposure_mode"] = _exp
    audit["refit_model_requested"] = _mode
    audit["refit_dispersion_gene"] = int(spec.get("dispersion", -1))
    print(f"   refit likelihood: {_mode} "
          f"(search dispersion gene={spec.get('dispersion')}); "
          f"exposure: {_exp}"
          + (f" pinned at coef 1.0 via offset[{_offset_col}]"
             if _offset_col else " free coefficient"))
    _rss_gb("refit-start")
    info = fit_metacount_nb(work, y_col="Y", id_col="row_id",
                            model=_mode, R=int(args.refit_R),
                            offset_col=_offset_col,
                            de_maxiter=int(args.de_maxiter),
                            de_popsize=int(args.de_popsize),
                            verbose=True,
                            continuous_de_warm_start=(not args.no_de_warm),
                            use_slsqp=(not args.no_slsqp), **fields)
    if str(info.get("spec_label", "")).startswith("statsmodels-"):
        # JAX stages all diverged (typical: LBFGS-only from a cold init on
        # sparse 15-min counts stalls on the flat eta plateau). One
        # warm-started retry preserves the searched random structure when
        # the cold start was the problem; the GLM fallback above stays as
        # the safety net. R capped: 100k x 60 draws fits the 96GB node.
        print("  [metacount] JAX refit diverged; retrying once warm-started "
              "(DE + SLSQP) to preserve searched structure")
        try:
            warm = fit_metacount_nb(
                work, y_col="Y", id_col="row_id",
                model=_mode, R=min(int(args.refit_R), 60),
                offset_col=_offset_col,
                de_maxiter=int(args.de_maxiter),
                de_popsize=int(args.de_popsize),
                verbose=True, continuous_de_warm_start=True,
                use_slsqp=True, seed=int(args.seed), **fields)
            if not str(warm.get("spec_label", "")).startswith("statsmodels-"):
                info = warm
                print(f"  [metacount] warm retry accepted "
                      f"({warm.get('spec_label')})")
            else:
                print("  [metacount] warm retry also fell back; keeping "
                      "GLM fallback")
        except RuntimeError as exc:
            print(f"  [metacount] warm retry failed ({exc}); keeping "
                  "GLM fallback")
    _rss_gb("refit-done")
    audit["refit"] = {"spec_label": info["spec_label"],
                      "searched_spec": {k: spec.get(k) for k in
                                        ("fixed_terms", "rdm_terms",
                                         "rdm_cor_terms", "grouped_terms",
                                         "hetro_in_means")},
                      "fitted": {k: info.get(k) for k in
                                 ("fixed_terms", "rdm_terms",
                                  "rdm_cor_terms", "grouped_terms")},
                      "aic": info["aic"], "bic": info["bic"],
                      "alpha": info["alpha"],
                      # Likelihood actually fitted, so the reported BIC is
                      # attributable. alpha is None for Poisson (no dispersion
                      # parameter) rather than 0.0, which read as "degenerate".
                      "model": info.get("model", _mode),
                      "refit_model": _mode,
                      "exposure_mode": info.get("exposure_mode", _exp),
                      "exposure_coef": info.get("exposure_coef")}
    _clear_jax_caches()
    return info


def refit_denominator(work, denom, spec, args, audit):
    """Stage A of the two-stage model: predict the MEASURED denominator.

    The count refit needs an exposure to scale a count with, and the only
    one it has is a TMR flow projection -- the channel the exposure LRT
    rejects at chi2(1)=364. The two-stage decomposition removes the
    projection from the shipped surface entirely:

        pred_speeding = pred_denominator  x  P(speeding | denominator)

    where the denominator is a panel MEASURED column (vehicle_count for
    speeding_trips, trips_with_judged_speed for the trips_* targets) and the
    probability is the binomial propensity from refit_binomial. Stage A is
    therefore an ordinary NB2 count model for the denominator with the same
    searched structure; it is the "future demand" surface.

    Returns the fit info dict (same contract as refit_only) or None.
    """
    out = {"denominator": denom, "available": False}
    audit.setdefault("two_stage", {})
    if denom not in work.columns:
        out["reason"] = f"denominator {denom!r} not in the search frame"
        audit["two_stage"]["flow_refit"] = out
        print(f"   [two-stage] flow unavailable: {out['reason']}")
        return None
    work_a = work.copy()
    work_a["Y"] = pd.to_numeric(work_a[denom], errors="coerce") \
        .replace([np.inf, -np.inf], 0.0).fillna(0.0).astype(float)
    fields = _spec_fields(spec, work_a)
    R = max(20, int(getattr(args, "two_stage_flow_R", 60)))
    try:
        info = fit_metacount_nb(
            work_a, y_col="Y", id_col="row_id", model="nb", R=R,
            de_maxiter=int(args.de_maxiter),
            de_popsize=int(args.de_popsize), verbose=True,
            continuous_de_warm_start=(not args.no_de_warm),
            use_slsqp=(not args.no_slsqp), seed=int(args.seed), **fields)
    except Exception as exc:  # noqa: BLE001
        out["reason"] = f"{type(exc).__name__}: {exc}"
        audit["two_stage"]["flow_refit"] = out
        print(f"   [two-stage] flow refit failed: {out['reason']}")
        return None
    out.update({"available": True, "spec_label": info.get("spec_label"),
                "bic": info.get("bic"), "aic": info.get("aic"),
                "model": info.get("model", "nb"), "R": R,
                "fixed_terms": list(info.get("fixed_terms", []))})
    audit["two_stage"]["flow_refit"] = out
    print(f"   [two-stage] flow NB2 on {denom}: {info.get('spec_label')} "
          f"BIC={info.get('bic'):.1f} R={R}")
    del work_a
    _clear_jax_caches()
    return info


def _fixture_variation(out, top_n=(10, 20)):
    """How much of the predicted surface actually differs between games?

    Pure measurement -- nothing here changes the fit. Returns the same kind of
    structure stage 60 reports, computed here so a run records whether its OWN
    surface could support a game-specific plan before the MIP is ever pointed
    at it.

    Reported:
      variance_between_segments_pct / variance_between_fixtures_pct
          split of var(log1p(pred)) per segment x fixture
      site_overlap_jaccard
          mean pairwise Jaccard of the top-N site sets across fixtures;
          1.0 means every game ranks the same streets highest
      unique_argmax_sites
          how many distinct streets are the single best site across fixtures
      game_specific_ranking
          True when the top-20 sets are not all identical
    """
    need = {"fixture", "road_osmid", "pred_speeding"}
    if out is None or not need.issubset(out.columns):
        return {"error": "predictions lack %s" % sorted(need - set(out.columns))}
    d = out[["fixture", "road_osmid", "pred_speeding"]].dropna(
        subset=["fixture", "road_osmid"])
    if not len(d):
        return {"error": "no prediction rows"}
    wide = d.pivot_table(index="road_osmid", columns="fixture",
                         values="pred_speeding", aggfunc="sum").fillna(0.0)
    if wide.shape[1] < 2:
        return {"error": "need >= 2 fixtures, got %d" % wide.shape[1]}
    L = np.log1p(wide.to_numpy(float))
    grand = L.mean()
    seg = L.mean(axis=1)
    fxm = L.mean(axis=0)
    total = float(((L - grand) ** 2).sum())
    out_d = {"n_fixtures": int(wide.shape[1]),
             "n_segments": int(wide.shape[0])}
    if total > 0:
        out_d["variance_between_segments_pct"] = round(
            100 * float(((seg - grand) ** 2).sum()) * L.shape[1] / total, 1)
        out_d["variance_between_fixtures_pct"] = round(
            100 * float(((fxm - grand) ** 2).sum()) * L.shape[0] / total, 1)
    cols = list(wide.columns)
    jac = {}
    for n in top_n:
        tops = [set(wide[c].nlargest(n).index) for c in cols]
        vals = []
        for i in range(len(tops)):
            for j in range(i + 1, len(tops)):
                vals.append(len(tops[i] & tops[j]) / max(len(tops[i] | tops[j]), 1))
        jac["top%d" % n] = round(float(np.mean(vals)), 3) if vals else None
    out_d["site_overlap_jaccard"] = jac
    out_d["unique_argmax_sites"] = int(len({wide[c].idxmax() for c in cols}))
    out_d["game_specific_ranking"] = bool(jac.get("top20") != 1.0)
    return out_d


def _pearson(a, b):
    a = np.asarray(a, dtype=float)
    b = np.asarray(b, dtype=float)
    mask = np.isfinite(a) & np.isfinite(b)
    a, b = a[mask], b[mask]
    if len(a) < 8 or np.var(a) <= 0 or np.var(b) <= 0:
        return float("nan")
    return float(np.corrcoef(a, b)[0, 1])


def compute_handoff(merged, out, metrics, top_n=20):
    """Can this surface be handed to the MIP? Three checks, all measured.

    The MIP solves a maximal-covering problem on pred_speeding, so what
    matters is not pooled RMSE but whether the ranking is right WITHIN each
    fixture and whether the ranking DIFFERS between fixtures. Job 26107921
    passed every existing metric and still produced one site set for all six
    games, because nothing here was checked.

    Reported per fixture:
      pearson_r        predicted vs observed segment totals on OBSERVED
                       segments only (5% penetration means many predicted
                       segments have no observation; pooling those in makes
                       r negative by construction -- see diag_proof.py)
      top20_coverage   share of the observed top-20 mass that falls inside
                       the predicted top-20, against the 20/n random floor
    and across fixtures: the top-20 site-set Jaccard from _fixture_variation.

    pass = ranking is positive on every fixture, the plan is game-specific,
    and the surface is calibrated. A surface that fails can still be run with
    ALLOW_WEAK_SURFACE=1 in the chain, but it is never silently shipped.
    """
    res = {"n_fixtures": 0, "per_fixture": {}}
    need = {"fixture", "road_osmid", "observed", "pred_speeding"}
    if merged is None or not need.issubset(merged.columns):
        res["error"] = "merged frame lacks %s" % sorted(need - set(
            merged.columns if merged is not None else []))
        return res
    rs, covs = [], []
    for fx, g in merged.groupby("fixture"):
        seg = g.groupby("road_osmid").agg(
            obs=("observed", "sum"), pred=("pred_speeding", "sum"))
        if len(seg) < top_n + 1:
            continue
        r = _pearson(seg["obs"], seg["pred"])
        obs_top = seg["obs"].nlargest(top_n).index
        pred_top = set(seg["pred"].nlargest(top_n).index)
        obs_mass = float(seg.loc[obs_top, "obs"].sum())
        captured = float(seg.loc[seg.index.isin(pred_top)
                                & seg.index.isin(obs_top), "obs"].sum())
        coverage = captured / max(obs_mass, 1e-9)
        floor = top_n / max(len(seg), 1)
        res["per_fixture"][str(fx)] = {
            "n_observed_segments": int(len(seg)),
            "pearson_r": round(float(r), 4) if np.isfinite(r) else None,
            "top20_coverage": round(float(coverage), 4),
            "random_floor": round(float(floor), 4)}
        if np.isfinite(r):
            rs.append(float(r))
        covs.append(float(coverage))
    res["n_fixtures"] = len(res["per_fixture"])
    res["pearson_min"] = round(min(rs), 4) if rs else None
    res["pearson_mean"] = round(float(np.mean(rs)), 4) if rs else None
    res["top20_coverage_mean"] = (round(float(np.mean(covs)), 4)
                                  if covs else None)
    try:
        fv = _fixture_variation(out)
        res["top20_jaccard"] = (fv.get("site_overlap_jaccard") or {}).get("top20")
    except Exception:  # noqa: BLE001
        res["top20_jaccard"] = None
    slope = metrics.get("calibration_slope")
    res["calibration_slope"] = slope
    res["positive_ranking"] = bool(rs and res["pearson_min"] > 0.0)
    res["game_specific"] = bool(res["top20_jaccard"] is not None
                                and res["top20_jaccard"] < 1.0)
    res["calibrated"] = bool(slope is not None and np.isfinite(slope)
                             and 0.2 <= float(slope) <= 5.0)
    res["pass"] = bool(res["positive_ranking"] and res["game_specific"]
                       and res["calibrated"] and res["n_fixtures"] >= 1)
    return res


def predict_propensity(frame, prop_model):
    """sigmoid(X b) from a fitted binomial model on a future frame.

    prop_model is the dict stashed from refit_binomial: names (intercept
    first) and coef. Columns dropped as degenerate at fit time are absent
    from names and therefore contribute nothing -- the same restriction the
    fit used.
    """
    names = list(prop_model.get("names") or [])
    coef = np.asarray(prop_model.get("coef"), dtype=float)
    if not names or coef.size != len(names):
        raise ValueError("propensity model has no usable coefficients")
    eta = np.full(len(frame), float(coef[0]))
    for j, c in enumerate(names[1:], start=1):
        if c in frame.columns:
            eta = eta + pd.to_numeric(frame[c], errors="coerce") \
                .fillna(0.0).to_numpy(float) * float(coef[j])
    return 1.0 / (1.0 + np.exp(-np.clip(eta, -35.0, 35.0)))


# Game-context terms that get their own prior scale in the approximate-Bayes
# propensity. These are the coefficients that are only identified from the
# handful of fixture windows (35 train games), so they are the ones at risk
# of overfitting the holdout; geometry/exposure terms are pooled over
# millions of rows and can stay weakly regularised.
GAME_PRIOR_TERMS = frozenset(GAME_VARS + GAME_WIDE_VARS)


def bayes_prior_dict(design_cols, game_sd=None, base_sd=10.0):
    """Independent Gaussian prior sds keyed by final design column name.

    base_sd is deliberately weak (10): it makes every fit a PROPER prior so
    Laplace evidences are comparable, while leaving pooled terms essentially
    unregularised. game_sd (when not None) replaces it on GAME_PRIOR_TERMS.
    """
    prior = {"(intercept)": float(base_sd)}
    for c in design_cols:
        prior[c] = (float(game_sd)
                    if (game_sd is not None and c in GAME_PRIOR_TERMS)
                    else float(base_sd))
    return prior


def select_propensity_prior(work, args, audit, spec, design_cols):
    """Choose the game-interaction prior sd by Laplace evidence on TRAIN.

    Evidence-based selection is the Bayesian alternative to tuning on the
    holdout: it never touches future rows. Grid includes None (the same weak
    base prior as everything else, i.e. "no game shrinkage"), then a ladder
    of increasingly tight scales. Returns (best_sd, best_r, table).
    """
    grid = [None, 2.0, 1.0, 0.5, 0.25]
    table, best = [], None
    for sd in grid:
        prior = bayes_prior_dict(design_cols, game_sd=sd,
                                 base_sd=float(getattr(args,
                                                       "bayes_base_sd", 10.0)))
        r, out = refit_binomial(work, args, audit, spec=spec,
                                design_cols=design_cols, prior_sd=prior,
                                audit_key=None, quiet=True)
        ev = None if r is None else r.get("laplace_evidence")
        row = {"game_sd": sd,
               "evidence": (round(float(ev), 3)
                            if ev is not None and np.isfinite(ev) else None),
               "available": bool(out.get("available")),
               "separated": bool(out.get("separated")),
               "loglik": (round(float(out.get("loglik")), 2)
                          if out.get("available") else None)}
        table.append(row)
        if (ev is not None and np.isfinite(ev)
                and (best is None or float(ev) > best[1])):
            best = (sd, float(ev), r)
    return best, table


def laplace_coef_draws(r, S, seed=0):
    """S draws of beta from the Laplace posterior N(coef, cov)."""
    beta = np.asarray(r["coef"], dtype=float)
    cov = np.asarray(r["cov"], dtype=float)
    cov = 0.5 * (cov + cov.T)
    try:
        L = np.linalg.cholesky(cov + 1e-12 * np.eye(len(beta)))
    except np.linalg.LinAlgError:
        w, V = np.linalg.eigh(cov)
        w = np.clip(w, 1e-12, None)
        L = V * np.sqrt(w)
    rng = np.random.default_rng(int(seed))
    z = rng.standard_normal((int(S), len(beta)))
    return beta[None, :] + z @ L.T


def predict_propensity_draws(frame, r, draws):
    """S x n matrix of sigmoid(X beta_s) for a fitted binomial."""
    names = list(r["names"])
    S = np.asarray(draws).shape[0]
    eta = np.tile(np.asarray(draws)[:, 0:1], (1, len(frame)))
    for j, c in enumerate(names[1:], start=1):
        if c in frame.columns:
            x = pd.to_numeric(frame[c], errors="coerce").fillna(0.0) \
                .to_numpy(float)
            eta = eta + np.asarray(draws)[:, j:j + 1] * x[None, :]
    return 1.0 / (1.0 + np.exp(-np.clip(eta, -35.0, 35.0)))


def laplace_fixed_factors(frame, info, S, seed=0):
    """S x n multiplicative factors exp(X_fixed (beta_s - beta_hat)).

    Stage A's random parameters are already integrated by
    predict_metacount_sim, so the remaining parameter uncertainty is the
    FIXED effects. Their sds come from the package's coefficient table
    (std_err). Sampling the fixed part and multiplying the random-effect
    mean is exact under the Laplace approximation for the fixed block:
    exp(eta_fixed) factors out of E_b[exp(eta)]. Coefficients without a
    finite se contribute zero uncertainty (recorded as coverage).
    """
    beta = info.get("beta") or {}
    coef = info.get("coef")
    se_map = {}
    try:
        if coef is not None and "std_err" in getattr(coef, "columns", []):
            se_map = {str(v): float(s) for v, s in
                      zip(coef["variable"], coef["std_err"])
                      if np.isfinite(s)}
    except Exception:  # noqa: BLE001
        se_map = {}
    terms, sds = [], []
    b_int = float(beta.get("__INTERCEPT__", 0.0))
    terms.append(None)
    sds.append(float(se_map.get("__INTERCEPT__", 0.0)))
    for c in info.get("fixed_terms", []):
        base = str(c).split(":")[0]
        if base in frame.columns and base in beta:
            terms.append(base)
            sds.append(float(se_map.get(base, 0.0)))
    for r_ in info.get("rdm_terms", []):
        base = str(r_).split(":")[0]
        key = f"__mean__{base}"
        if base in frame.columns and key in beta:
            terms.append(base)
            sds.append(float(se_map.get(f"mean({base})", 0.0)))
    sds = np.asarray(sds, dtype=float)
    X = np.ones((len(frame), len(terms)))
    for j, c in enumerate(terms[1:], start=1):
        X[:, j] = pd.to_numeric(frame[c], errors="coerce") \
            .fillna(0.0).to_numpy(float)
    rng = np.random.default_rng(int(seed))
    z = rng.standard_normal((int(S), len(sds)))
    delta = (z * sds[None, :]) @ X.T
    coverage = {"n_terms": int(len(sds)),
                "n_with_se": int(np.sum(sds > 0)),
                "mean_se": float(sds.mean()) if len(sds) else 0.0}
    return np.exp(np.clip(delta, -30.0, 30.0)), coverage


def _z_to_p(z):
    from math import erfc
    return float(erfc(abs(float(z)) / np.sqrt(2.0)))


def prune_propensity(work, args, spec, design_cols, r0, p_thresh,
                     prior_sd=None):
    """Backward-eliminate insignificant UNFORCED terms from the propensity.

    GAME_FORCE terms are never candidates: with ~3k successes the binomial
    SEs dwarf game coefs, so unguarded pruning deletes the whole game block
    and ships a static surface (o26537982). Weak forced terms are handled by
    shrinkage (prior_sd), not deletion. The handoff gate remains the arbiter
    over the final surface.

    Returns (final_fit, report). final_fit falls back to r0 if every
    refit fails.
    """
    names = list(r0["names"])
    coef = np.asarray(r0["coef"], dtype=float)
    se = np.asarray(r0["se"], dtype=float)
    dropped = []
    r = r0
    # GAME_FORCE terms are never elimination candidates: with ~3k successes
    # the binomial SEs dwarf game coefs, so unguarded pruning deletes the
    # whole game block and ships a static surface (o26537982). Shrinkage
    # (prior_sd) handles weak terms; pruning only removes unforced terms.
    _protected = set(GAME_FORCE)
    while len(names) > 2:
        p = np.array([_z_to_p(c / max(s, 1e-12))
                      for c, s in zip(coef, se)])
        cand, worst = None, 0.0
        for j in range(1, len(names)):
            if names[j] in _protected:
                continue
            if p[j] > worst:
                cand, worst = j, float(p[j])
        if cand is None or worst <= float(p_thresh):
            break
        dropped.append(names[cand])
        keep = [n for j, n in enumerate(names) if j != cand]
        design = [c for c in design_cols if c in keep]
        if not design:
            break
        r2, out2 = refit_binomial(work, args, {}, spec=spec,
                                  design_cols=design, prior_sd=prior_sd,
                                  audit_key=None, quiet=True)
        if r2 is None:
            break
        r = r2
        names = list(r["names"])
        coef = np.asarray(r["coef"], dtype=float)
        se = np.asarray(r["se"], dtype=float)
    p_final = {n: round(_z_to_p(c / max(s, 1e-12)), 5)
               for n, c, s in zip(r["names"], np.asarray(r["coef"], float),
                                  np.asarray(r["se"], float))}
    return r, {"dropped": dropped, "kept": list(r["names"]),
               "p_threshold": float(p_thresh), "p_values": p_final,
               # The SHIPPED propensity coefficients: without these the
               # audit would still report the pre-prune full-design fit.
               "terms": {n: [float(c), float(s)] for n, c, s in
                         zip(r["names"], np.asarray(r["coef"], float),
                             np.asarray(r["se"], float))},
               "loglik": float(r["loglik"]), "bic": float(r["bic"])}


def bayes_predictive_draws(denom_draws, p_draws, alpha=None, seed=0):
    """S x n posterior-predictive counts for the two-stage surface.

    n_s ~ NB2(mean=denom_s, dispersion=alpha)  (or Poisson when alpha is
    None), then k_s ~ Binomial(n_s, p_s). Quantiles of this matrix are
    OBSERVATION bounds; quantiles of denom_s x p_s are parameter bounds and
    had ~0% holdout coverage (pilot, job pilot_bayes).
    """
    S = int(np.asarray(denom_draws).shape[0])
    rng = np.random.default_rng(int(seed))
    out = np.empty_like(np.asarray(denom_draws, dtype=float))
    for s in range(S):
        mu = np.maximum(np.asarray(denom_draws[s], dtype=float), 0.0)
        if alpha is not None and np.isfinite(alpha) and float(alpha) > 0:
            n_s = rng.negative_binomial(
                1.0 / float(alpha), 1.0 / (1.0 + float(alpha) * mu))
        else:
            n_s = rng.poisson(mu)
        out[s] = rng.binomial(
            np.maximum(n_s, 0).astype(np.int64),
            np.clip(np.asarray(p_draws[s], dtype=float), 0.0, 1.0))
    return out


def refit_binomial(work, args, audit, spec=None, label="binomial refit",
                   design_cols=None, audit_key="binomial", prior_sd=None,
                   quiet=False):
    """Fit the speeding propensity as a BINOMIAL and report it beside the
    count refit.

        k_i ~ Binomial(n_i, sigmoid(x_i'b)),  n_i = trips_with_judged_speed

    Why this is not the same as the count model. The count refit needs an
    EXPOSURE to scale a count with, and the only one available is a
    TMR-derived flow projection -- which is why the exposure LRT keeps
    rejecting it. Here the denominator is MEASURED, so there is no
    projection to get wrong, no offset to pin, and no chi2 to explain: the
    elasticity of speeding to flow is just another coefficient, estimated
    by the same Newton step as everything else.

    The design is the searched fixed-term set, so this is a like-for-like
    refit of the SAME structure under a different likelihood, not a new
    search. It does not replace the count path: it is reported alongside
    it so the two can be compared on the same holdout.
    """
    audit = audit if audit is not None else {}
    out = {"label": label, "available": False}
    # Resolve the denominator from the unit of the response. For speeding_trips
    # that is vehicle_count, not trips_with_judged_speed; using the trip count
    # against vehicle successes allowed k > n and the exact likelihood refused
    # the data with "successes outside [0, n]" (1,491 offending rows on the
    # real panel).
    #
    # Preference order: the target's own mapping, then whichever candidate is
    # actually present in the frame. The second step matters for frames built
    # without a target (synthetic and legacy callers): assuming the global
    # default there silently switched them to a column they do not have and
    # reported "unavailable" instead of fitting.
    _target = getattr(args, "target", None)
    _cands = []
    if _target:
        _cands.append(binomial_denominator(_target))
    _cands.append(binomial_denominator(TARGET_DEFAULT))
    _cands.append(BINOMIAL_DENOM)
    _seen, _ordered = set(), []
    for _c in _cands:
        if _c not in _seen:
            _seen.add(_c)
            _ordered.append(_c)
    denom = next((c for c in _ordered if c in work.columns), None)
    out["denominator_candidates"] = _ordered
    if denom is None:
        out["reason"] = ("no usable denominator in the frame; wanted one of "
                         + ", ".join(_ordered))
        if audit_key:
            audit[audit_key] = out
        print(f"   [binom] unavailable: {out['reason']}")
        return None, out
    out["denominator"] = denom

    k = pd.to_numeric(work["Y"], errors="coerce")
    n = pd.to_numeric(work[denom], errors="coerce")
    ok = (k.notna() & n.notna() & np.isfinite(k.to_numpy(float))
          & np.isfinite(n.to_numpy(float)))
    ok &= n.to_numpy(float) > 0
    k, n = k[ok], n[ok]
    if len(k) < 100:
        out["reason"] = f"only {len(k)} rows with a positive denominator"
        if audit_key:
            audit[audit_key] = out
        print(f"   [binom] unavailable: {out['reason']}")
        return None, out

    # Design: an explicit design_cols (the two-stage path passes the SEARCHED
    # fixed terms, so the propensity inherits the same game/segment structure
    # the structural search selected) wins; otherwise fall back to the fixed
    # comparison list used by --binomial-refit.
    if design_cols:
        cands = [c for c in design_cols if c in work.columns]
    else:
        cands = []
        for c in ["logexp", "in_event", "rel_hour", "log_att", "dist_stad",
                  SEG_GROUP_VAR]:
            if c in work.columns:
                cands.append(c)
        cands += [c for c in ("lanes", "lanes_known", "aadt_z", "log_flow_z")
                  if c in work.columns and c not in cands]
    # Duplicate names break the coef/name zip; de-dup preserving order.
    _seen, _dedup = set(), []
    for c in cands:
        if c not in _seen:
            _seen.add(c)
            _dedup.append(c)
    cands = _dedup
    if not cands:
        out["reason"] = "no candidate design columns present"
        if audit_key:
            audit[audit_key] = out
        print(f"   [binom] unavailable: {out['reason']}")
        return None, out

    Xw = work.loc[ok, cands].apply(pd.to_numeric, errors="coerce")
    Xw = Xw.replace([np.inf, -np.inf], np.nan).fillna(0.0)
    # NO standardisation. An earlier version standardised every column to
    # guard against spurious separation flags, which forced a separate
    # magnitude test. That was a mistake: standardising rescales the
    # coefficients (coef_std = coef_raw * sd), and the one number this whole
    # comparison exists to produce is the flow elasticity on logexp, which
    # is only interpretable -- and only comparable with the count model's
    # pinned 1.0 -- on the RAW scale. Standardising reported 0.445 where the
    # truth was 0.55 purely because sd(logexp) = 0.8. Separation is now
    # detected scale-free (perfect-prediction test), so no rescaling is
    # needed to keep the fit honest.
    Xs = Xw.to_numpy(float)

    from binomial_mle import fit_binomial_logit
    try:
        r = fit_binomial_logit(
            k.to_numpy(float), n.to_numpy(float), Xs, names=cands,
            prior_sd=prior_sd)
    except Exception as exc:  # noqa: BLE001
        out["reason"] = f"{type(exc).__name__}: {exc}"
        if audit_key:
            audit[audit_key] = out
        if not quiet:
            print(f"   [binom] fit failed: {out['reason']}")
        return None, out

    out.update({
        "available": True,
        "loglik": r["loglik"], "aic": r["aic"], "bic": r["bic"],
        "n_obs": r["n_obs"], "n_trials": r["n_trials"],
        "n_successes": r["n_successes"],
        "mean_rate": r["n_successes"] / max(r["n_trials"], 1.0),
        "converged": r["converged"], "separated": r["separated"],
        "dropped": r["dropped"], "n_params": r["design_columns"],
        "terms": {c: [float(b), float(s)] for c, b, s
                  in zip(r["names"], r["coef"], r["se"])},
        # Ship-ready coefficients (intercept first). Kept in the audit so a
        # run's propensity is reconstructible from its JSON alone; the
        # in-memory fit is returned to the caller for prediction.
        "model": {"names": list(r["names"]),
                  "coef": [float(x) for x in r["coef"]]},
        # Laplace/Bayes diagnostics. Evidence is only comparable between
        # fits that both use proper priors on the same design/data.
        "laplace_evidence": r.get("laplace_evidence"),
        "loglik_pen": r.get("loglik_pen"),
        "prior_sd_used": ({k: float(v) for k, v in prior_sd.items()}
                          if prior_sd else None),
    })
    if audit_key:
        if audit_key:
            audit[audit_key] = out
    out["n_trials_total"] = int(r["n_trials"])
    if not quiet:
        print(f"   [binom] k~Binomial(n={out['mean_rate']*r['n_trials']:.0f} "
              f"successes / {r['n_trials']:.0f} {denom}, "
              f"rate={out['mean_rate']:.4f})")
        print(f"   [binom] loglik={r['loglik']:.2f}  AIC={r['aic']:.2f}  "
              f"BIC={r['bic']:.2f}  params={r['design_columns']}")
        if r["separated"]:
            print("   [binom] *** SEPARATED: the MLE does not exist (a "
                  "coefficient runs to infinity). Coefficients below are NOT "
                  "interpretable.")
        if r["dropped"]:
            print(f"   [binom] dropped degenerate columns: {r['dropped']}")
        for c, b, s in zip(r["names"], r["coef"], r["se"]):
            print(f"           {c:<18} {b:+9.4f}  (se {s:.4f})")
    # The headline comparison: in the count model the exposure elasticity is
    # pinned at 1 by the offset and the LRT fights it. Here it is free.
    if "logexp" in r["names"]:
        i = r["names"].index("logexp")
        out["logexp_coef"] = float(r["coef"][i])
        out["logexp_se"] = float(r["se"][i])
        if not quiet:
            print(f"   [binom] flow elasticity (logexp) = {r['coef'][i]:.4f} "
                  f"+/- {r['se'][i]:.4f}   (count model pins this at 1.0 by"
                  " construction)")
    return r, out


def plot_pred_vs_actual(out, merged, fig_dir, out_dir, top_n=20):
    """PROOF OF CONCEPT: does the predicted ranking hold up against ACTUAL
    observed speeding for the same games?

    The surfaces figure shows what the model predicted. This shows whether
    the prediction was any good, which is the only thing that justifies
    deploying on it. Two views per game:

      * predicted vs observed per top-N segment, with a 1:1 line
      * the share of OBSERVED speeding falling in each quartile of the
        PREDICTED ranking -- a model that ranks well puts most of the real
        events in its top quartile

    Honest framing, stated in the caption: this is a top-N comparison, not
    a network-wide coverage claim. The deployment figure is the share of
    observed speeding on the staffed sites, reported separately by stage 60.
    """
    try:
        import matplotlib
        matplotlib.use("Agg")
        import matplotlib.pyplot as plt
    except Exception as exc:  # noqa: BLE001
        print(f"   WARN: pred-vs-actual figure unavailable ({exc})")
        return None

    if merged is None or not len(merged):
        print("   WARN: no observed rows; skipping pred-vs-actual figure")
        return None

    _fx = list(out["fixture"].unique())
    ncol = min(2, max(len(_fx), 1))
    nrow = int(np.ceil(len(_fx) / ncol))
    fig, axes = plt.subplots(nrow, ncol, figsize=(6.4 * ncol, 5.2 * nrow),
                             squeeze=False)
    rows = []
    for i, fx in enumerate(_fx):
        ax = axes[i // ncol][i % ncol]
        _p = (out[out["fixture"] == fx]
              .groupby("road_osmid")["pred_speeding"].sum()
              .sort_values(ascending=False).head(int(top_n)))
        try:
            _o = (merged[merged["fixture"] == fx]
                  .groupby("road_osmid")["observed"].sum())
        except Exception:  # noqa: BLE001
            _o = pd.Series(dtype=float)
        _j = pd.concat([_p.rename("pred"), _o.rename("obs")], axis=1)
        _j = _j.dropna()
        if len(_j) < 4:
            ax.axis("off")
            continue
        r = float(np.corrcoef(_j["pred"], _j["obs"])[0, 1])
        ax.scatter(_j["obs"], _j["pred"], s=26, alpha=0.75,
                   color="#0B6E4F", edgecolors="k", linewidths=0.4)
        _mx = float(max(_j["obs"].max(), _j["pred"].max())) * 1.08
        ax.plot([0, _mx], [0, _mx], ls="--", lw=1.0, color="#888888",
                label="1:1")
        ax.set_xlim(0, _mx)
        ax.set_ylim(0, _mx)
        ax.set_xlabel("OBSERVED speeding (actual)")
        ax.set_ylabel("PREDICTED speeding")
        # share of observed by quartile of the PREDICTED ranking
        _s = _j.sort_values("pred", ascending=False)
        _nq = min(4, max(len(_s) // 2, 2))
        _q = np.array_split(_s["obs"].to_numpy(), _nq)
        _sh = [float(x.sum()) for x in _q]
        _tot = max(sum(_sh), 1e-9)
        _pct = [100.0 * x / _tot for x in _sh]
        _ax2 = ax.inset_axes([0.63, 0.63, 0.34, 0.33])
        _ax2.bar(range(_nq), _pct, color="#0B6E4F", width=0.7)
        _ax2.set_xticks(range(_nq))
        _ax2.set_xticklabels([f"Q{i + 1}" for i in range(_nq)], fontsize=5)
        _ax2.tick_params(labelsize=5)
        _ax2.set_title("obs %% by pred rank", fontsize=5.5)
        for _k, _v in enumerate(_pct):
            _ax2.text(_k, _v, f"{_v:.0f}", ha="center", va="bottom",
                      fontsize=5)
        ax.set_title(f"{str(fx)[:44]}\nr={r:.2f}  n={len(_j)}  "
                     f"top quartile holds {_pct[0]:.0f}% of observed",
                     fontsize=9)
        ax.legend(fontsize=6, loc="upper left")
        rows.append({"fixture": str(fx), "n_segments": int(len(_j)),
                     "pearson_r": round(r, 4),
                     "top_quartile_obs_share": round(_pct[0] / 100.0, 4),
                     "obs_total": round(float(_j["obs"].sum()), 2),
                     "pred_total": round(float(_j["pred"].sum()), 2)})
    for j in range(len(_fx), nrow * ncol):
        axes[j // ncol][j % ncol].axis("off")
    fig.suptitle(
        "PROOF OF CONCEPT: predicted ranking vs ACTUAL observed speeding, "
        "per future game\n(top-%d segments by prediction; inset = share of "
        "observed speeding in each predicted-rank quartile.\n"
        "A ranking that works puts most real events in Q1. Top-N only -- not "
        "a network-wide coverage claim.)" % int(top_n), fontsize=10)
    fig.tight_layout(rect=(0, 0, 1, 0.93))
    _p_out = Path(fig_dir) / "game_day_pred_vs_actual.png"
    fig.savefig(_p_out, dpi=130)
    plt.close(fig)
    try:
        pd.DataFrame(rows).to_csv(
            Path(out_dir) / "game_day_pred_vs_actual.csv", index=False)
    except Exception as exc:  # noqa: BLE001
        print(f"   WARN: pred-vs-actual table failed ({exc})")
    for rr in rows:
        print(f"   [value] {str(rr['fixture'])[:34]:34s} r={rr['pearson_r']:.2f}"
              f"  Q1 holds {100 * rr['top_quartile_obs_share']:.0f}% of observed"
              f"  obs_total={rr['obs_total']:.0f}")
    print(f"   pred-vs-actual -> {_p_out.name}, "
          f"game_day_pred_vs_actual.csv")
    return rows


def report_exposure_coefficient(info, audit, label="shipped refit"):
    """Print the free exposure coefficient with its uncertainty.

    WHY: the exposure LRT only says the pinned offset (coefficient 1) is
    rejected. On a panel of ~1e5 rows the SE on that coefficient is around
    2e-3, so a large chi2 can correspond to a deviation of only a few per
    cent -- statistically decisive, practically negligible. The decision to
    keep or abandon the calibrated exposure has to be made on the MAGNITUDE
    of the deviation, not on the chi2, so the number belongs in the log
    and the audit.

    In offset/hazard mode logexp is moved into the likelihood's offset and
    dropped from the design, so there is no coefficient to report; that is
    stated explicitly rather than silently skipped.
    """
    audit = audit if audit is not None else {}
    out = {"label": label, "available": False}
    try:
        coefs = info.get("coef") if isinstance(info, dict) else None
    except Exception:  # noqa: BLE001
        coefs = None
    if coefs is None or len(coefs) == 0 or "variable" not in coefs.columns:
        out["reason"] = "no coefficient table returned"
        audit["exposure_coef_report"] = out
        print(f"   [exposure] coefficient unavailable ({out['reason']})")
        return out

    row = coefs[coefs["variable"].astype(str).str.strip().str.lower()
                == "logexp"]
    if row.empty:
        cand = [v for v in coefs["variable"].astype(str)
                if "logexp" in v.lower()]
        out["reason"] = ("logexp absent from the design (expected when the "
                         "exposure is pinned as an offset)")
        out["candidates"] = cand
        audit["exposure_coef_report"] = out
        print("   [exposure] no free logexp coefficient (pinned offset mode"
              + (f"; near matches: {cand}" if cand else "") + ")")
        return out

    r = row.iloc[0]
    beta = float(r.get("coef_mle", r.get("coefficient", np.nan)))
    try:
        se = float(r.get("std_err", np.nan))
    except (TypeError, ValueError):
        se = np.nan
    out.update({"available": True, "beta": beta, "std_err": se})
    if not np.isfinite(beta):
        out["available"] = False
        out["reason"] = "coefficient is not finite"
        out["beta_raw"] = beta
        audit["exposure_coef_report"] = out
        print("   [exposure] logexp coefficient is not finite "
              f"({beta!r}) -- no magnitude verdict")
        return out

    print(f"   [exposure] free logexp coefficient ({label}):")
    print(f"       beta_hat = {beta:.5f}   SE = {se:.5f}")
    if np.isfinite(se):
        lo, hi = beta - 1.96 * se, beta + 1.96 * se
        out["ci95"] = [float(lo), float(hi)]
        print(f"       95% CI = [{lo:.5f}, {hi:.5f}]")
    if np.isfinite(se) and se > 0:
        z1 = (beta - 1.0) / se
        dev = abs(beta - 1.0)
        out["z_vs_1"] = float(z1)
        out["abs_deviation"] = float(dev)
        out["rel_deviation_pct"] = float(100.0 * dev)
        # Compare against a lever already in play: the per-class game-day
        # uplift alone spans roughly 20%, and the exposure calibration
        # rescales by the measured Y/E ratio.
        scale = 0.20
        out["deviation_vs_uplift_span"] = float(dev / scale)
        verdict = ("PRACTICALLY NEGLIGIBLE" if dev < 0.05 else
                   "SMALL" if dev < 0.10 else
                   "MATERIAL" if dev < 0.25 else "LARGE")
        out["verdict"] = verdict
        print(f"       deviation from 1.0 = {dev:.5f} "
              f"({100.0 * dev:.2f}%), z vs 1 = {z1:+.1f}")
        print(f"       as a fraction of the per-class uplift span (~20%): "
              f"{100.0 * dev / scale:.1f}%  -> {verdict}")
        print("       Decide on this magnitude, not on the LRT chi2: a large"
              " chi2 on a big panel can still be a per-cent effect.")
    audit["exposure_coef_report"] = out
    return out


def _exposure_lrt(work, spec, args, audit, refit_info):
    """Likelihood-ratio test: free exposure coefficient vs pinned at 1.

    The two parameterisations are NESTED -- pinning the coefficient at 1
    is a one-parameter restriction of estimating it -- so the comparison
    is a legitimate LRT and not a BIC race between incomparable models.

    It answers a question the pipeline currently cannot: is the exposure
    channel (seg_flow * bin_factor * uplift) correctly specified? A free
    coefficient far from 1 means the projected flow is misspecified in a
    way a free coefficient was silently absorbing. That is the real
    argument for the hazard form -- not that it is a different model, but
    that it stops hiding flow-projection error.
    """
    if str(getattr(args, "exposure_lrt", "off") or "off").lower() != "on":
        return None
    want = str(getattr(args, "exposure", "free") or "free").lower()
    # Fit the OPPOSITE arm from whatever was shipped.
    other = "free" if want in ("offset", "hazard") else "offset"
    try:
        from metacount_nb import fit_metacount_nb
        fields = _spec_fields(spec, work)
        _mode = refit_info.get("model", "nb")
        print(f"   [exposure] LRT: fitting the {other} arm for comparison...")
        alt = fit_metacount_nb(
            work, y_col="Y", id_col="row_id", model=_mode,
            R=min(int(args.refit_R), 60),
            offset_col=("logexp" if other == "offset" else None),
            de_maxiter=int(args.de_maxiter), de_popsize=int(args.de_popsize),
            verbose=False, continuous_de_warm_start=True, use_slsqp=True,
            seed=int(args.seed), **fields)
    except Exception as exc:  # noqa: BLE001
        audit["exposure_lrt"] = {"error": f"{type(exc).__name__}: {exc}"}
        print(f"   [exposure] LRT arm failed ({type(exc).__name__}: {exc})")
        return None
    ll_free = float(refit_info["loglik"]) if other == "offset" \
        else float(alt["loglik"])
    ll_off = float(alt["loglik"]) if other == "offset" \
        else float(refit_info["loglik"])
    # 2*loglik difference for 1 restriction; chi2_1 95% critical = 3.84.
    lr = 2.0 * (ll_free - ll_off)
    p = float(np.exp(-0.5 * max(lr, 0.0))) if lr > 0 else 1.0
    verdict = ("free coefficient is significantly better "
               "(exposure channel looks misspecified)"
               if lr > 3.84 else
               "no evidence against pinning the exposure coefficient at 1")
    coef = alt.get("exposure_coef")
    res = {"shipped": want, "compared": other,
           "loglik_free": ll_free, "loglik_offset": ll_off,
           "lr_stat": round(lr, 4), "p_value": round(p, 6),
           "df": 1, "critical_95": 3.84, "verdict": verdict,
           "free_exposure_coef": (None if coef is None
                                  else round(float(coef), 5)),
           "bic_free": float(alt["bic"]) if other == "free" else None,
           "bic_offset": float(refit_info["bic"]) if want != "free" else None}
    audit["exposure_lrt"] = res
    print(f"   [exposure] LRT chi2(1)={lr:+.3f} (95% crit 3.84) -> {verdict}")
    if coef is not None and np.isfinite(coef):
        print(f"   [exposure] free exposure coefficient = {float(coef):.4f} "
              "(1.0 = exposure channel consistent with the count model)")
    # The free arm is the SHIPPED refit whenever --exposure free (the
    # default), in which case `alt` is the pinned arm and carries no
    # coefficient -- so resolve the free arm explicitly. Without this the
    # coefficient is never printed in the default configuration, which is
    # how a chi2 of 364 was able to travel without its magnitude ever being
    # looked at.
    free_info = refit_info if other == "offset" else alt
    try:
        rep = report_exposure_coefficient(
            free_info, audit, label=f"free arm ({'shipped' if other == 'offset' else 'LRT'})")
    except Exception as exc:  # noqa: BLE001
        rep = None
        print(f"   WARN: LRT coefficient report failed ({exc})")
    if rep and rep.get("available"):
        dev = float(rep.get("abs_deviation", float("nan")))
        pct = float(rep.get("rel_deviation_pct", float("nan")))
        v = rep.get("verdict", "")
        print(f"   [exposure] LRT VERDICT: chi2={lr:+.1f} but the free "
              f"coefficient is {pct:.2f}% from 1.0 ({v}).")
        if v in ("PRACTICALLY NEGLIGIBLE", "SMALL"):
            print("   [exposure] -> the exposure channel is NOT materially "
                  "misspecified. Prefer the simpler model unless holdout "
                  "metrics improve.")
        else:
            print("   [exposure] -> the departure is large enough to matter; "
                  "the exposure specification is doing real work.")
        res["coef_magnitude_verdict"] = v
        res["coef_rel_deviation_pct"] = pct
    return res


def refit_and_predict(work, future_work, spec, args, audit):
    # Legacy batched path (main now uses refit_only + per-fixture predict).
    # Kept consistent: full spec + sanity-gated staged fallback.
    info = refit_only(work, spec, args, audit)
    preds = predict_metacount_sim(future_work, info, id_col="row_id",
                                  y_col="Y",
                                  R=max(1000, int(args.refit_R)))
    return info, np.maximum(preds, 1e-9)


def predict_future_chunked(info, future_cal, segs, ctx, seg_flow, profile,
                           work, args, flow_uplift=None, crowd_med=None,
                           temporal_fit=None, seg_risk_map=None,
                           clock_prof=None, flow_uplift_by_hw=None,
                           exp_cal=None, flow_info=None, prop_fit=None,
                           prop_bayes=None, stage_a_bayes=None,
                            seg_event_uplift_map=None,
                            flow_anom_by_fixture=None,                              wmap=None,
                             wstats=None, sd_curves=None,
                             prop_lookup=None, sd_forms=None,
                             demand_eta=None, demand_att_ref=None,
                             demand_eta_by_phase=None,
                             demand_eta_raw_by_phase=None,
                             demand_eta_raw=None,
                             sd_lift_cal=None,
                             seg_event_uplift=None,
                             seg_eta_ratio=None,
                             audit=None):
    """Per-fixture future prediction (numpy only, no JAX).

    Joint flow->speeding stage 2: future exposure uses PREDICTED flow
    (seg_flow * bin_factor * game-day uplift) rather than the static
    background profile, so attendance dynamics propagate into speeding via
    the exposure channel as well as the forced fixed game effects.
    Builds one fixture's segment x 28-bin grid at a time (~211k rows, not
    1.27M), so peak is one chunk. Numerics identical to the batched path
    (row-wise exp(Xb)); ~6x lower peak for n_future=6.
    When temporal_fit (stage 2b AR(1) NB2) is given, its population-mean
    surface is ALSO computed (cheap exp(Xb)) into pred_speeding_temporal;
    the shipped pred_speeding stays JAX unless --temporal-predict is set.
    """
    out_parts = []
    # Failures collected across fixtures so a broken channel cannot be
    # mistaken for a working one (see the SD block below).
    _sd_fail = []
    hw_cols = [c for c in work.columns if c.startswith("hw_")]
    _u = (np.asarray(flow_uplift, dtype=float)
          if flow_uplift is not None else np.ones(REL_BINS))
    for _, row in future_cal.iterrows():
        start = row["ko"] + pd.Timedelta(hours=WINDOW_HOURS[0])
        bins = pd.date_range(start, periods=REL_BINS, freq="15min", tz=TZ)
        grid = pd.DataFrame({"road_osmid": np.repeat(segs, REL_BINS),
                             "bin": np.tile(bins, len(segs))})
        # Unique per row, matching the `fixture` values in the observed
        # frame; the display label travels separately.
        grid["fixture"] = row["fixture_id"]
        grid["fixture_label"] = str(row["label"])
        grid["code"] = str(row.get("fixture_type", "") or "")
        grid["attendance"] = float(row["attendance"]) if np.isfinite(
            row["attendance"]) else 0.0
        grid["fixture_type"] = str(row.get("fixture_type", "") or "")
        try:
            grid["ko_hour"] = float(row["ko"].hour) + float(row["ko"].minute) / 60.0
        except Exception:
            grid["ko_hour"] = 0.0
        grid["rel_bin"] = np.tile(np.arange(REL_BINS), len(segs))
        grid = add_calendar(grid)
        grid["in_event"] = 1.0
        grid["rel_hour"] = grid["rel_bin"] / BINS_PER_HOUR + WINDOW_HOURS[0]
        grid["log_att"] = np.log1p(grid["attendance"])
        grid = add_game_temporal(grid)
        grid = add_static(grid, ctx)
        grid["event_x_dist"] = grid["dist_stad"]
        grid = add_game_wide(grid, crowd_med=crowd_med)
        grid = add_exposure(grid, ctx, seg_flow, profile)
        grid = apply_flow_anomaly(grid, flow_anom_by_fixture, by="fixture")
        grid = apply_weather(grid, wmap, wstats)
        # Per-class u takes precedence over the pooled vector. A single
        # u[b] for the whole network cannot let a residential street and a
        # 4-lane arterial respond differently to a game, which is the most
        # likely reason the exposure LRT rejects the channel.
        if flow_uplift_by_hw and "highway" in grid.columns:
            _hw = (grid["highway"].astype("string")
                   .fillna("unclassified").astype(str).to_numpy())
            _rel = np.asarray(grid["rel_bin"].to_numpy(int)).clip(0, REL_BINS - 1)
            _pu = np.ones(len(grid), dtype=float)
            _hit = np.zeros(len(grid), dtype=bool)
            for _cls, _vec in flow_uplift_by_hw.items():
                _m = _hw == _cls
                if _m.any():
                    _pu[_m] = _vec[_rel[_m]]
                    _hit |= _m
            # classes with no train support keep the pooled multiplier
            if (~_hit).any() and _u is not None and len(_u) == REL_BINS:
                _pu[~_hit] = _u[_rel[~_hit]]
            grid["flow_uplift"] = _pu
            grid["pred_flow"] = grid["exp"] * _pu
            grid["exp"] = grid["pred_flow"].clip(lower=1e-6)
            grid["logexp"] = np.log1p(grid["exp"])
        elif _u is not None and len(_u) == REL_BINS:
            grid["flow_uplift"] = _u[np.asarray(grid["rel_bin"].to_numpy(int)).clip(0, REL_BINS - 1)]
            grid["pred_flow"] = grid["exp"] * grid["flow_uplift"]
            grid["exp"] = grid["pred_flow"].clip(lower=1e-6)
            grid["logexp"] = np.log1p(grid["exp"])
        else:
            grid["flow_uplift"] = 1.0
            grid["pred_flow"] = grid["exp"]
        # Same frozen calibration as training, applied AFTER the game-day
        # uplift so the future exposure sits on the same scale the model was
        # fitted on. Frozen ratios only -- no future counts exist to refit.
        if exp_cal:
            grid = calibrate_exposure(grid, exp_cal)
        # Temporal-x AFTER exposure is final: exp_lag1 rides predicted flow
        # (free lags for the whole window); risk/clock map by segment/code.
        grid = apply_temporal_x(grid, seg_risk_map, clock_prof,
                                seg_event_uplift_map)
        fw = search_frame(grid.assign(Y=0.0), args.target)
        fw, _ = prepare_metacount_frame(fw, exposure_col="exp",
                                        highway_col="highway")
        # Same shape basis as training, reusing the frozen params.
        fw, _ = add_exposure_shape(
            fw, params=getattr(args, "_exp_shape_params", None),
            hinge=str(getattr(args, "exposure_basis", "none")) in
            ("hinge", "hinge+hw"),
            interact_hw=str(getattr(args, "exposure_basis", "none"))
            in ("hinge+hw", "linear+hw", "hw"))
        for col in hw_cols:
            if col not in fw.columns:
                fw[col] = 0.0
        # Draw-averaged predictive mean (matches the fitted expected; the
        # plug-in at mean random coefficients under-predicts by the
        # log-normal variance inflation). R>=1000 keeps per-row MC error
        # small for the heavy-tailed random coefficients.
        pred = np.maximum(predict_metacount_sim(
            fw, info, id_col="row_id", y_col="Y",
            R=max(1000, int(args.refit_R)), chunk=25000), 1e-9)
        keys = grid[["fixture", "code", "road_osmid", "bin", "rel_bin",
                       "pred_flow", "flow_uplift"]].copy()
        # The count surface is always computed and kept, so a two-stage
        # shipment can be compared against it on the same rows.
        keys["pred_speeding_count"] = np.asarray(pred, dtype=float)
        keys["pred_speeding"] = keys["pred_speeding_count"]
        keys["pred_speeding_network"] = (
            keys["pred_speeding"] / max(args.penetration, 1e-9))
        keys["exp"] = fw["logexp"].to_numpy()
        # ------------------------------------------------------- two-stage
        # pred_speeding = E[denominator | game] x P(speeding | game).
        # The denominator model (stage A) is a measured-quantity NB2; the
        # propensity (stage B) is the binomial on the searched design. This
        # replaces the TMR flow projection in the shipped surface, which is
        # the channel the exposure LRT rejects. Any failure falls back to the
        # count surface loudly -- never silently.
        if flow_info is not None and prop_fit is not None:
            try:
                denom_pred = np.maximum(predict_metacount_sim(
                    fw, flow_info, id_col="row_id", y_col="Y",
                    R=max(200, int(getattr(args, "two_stage_flow_R", 60))),
                    chunk=25000), 1e-9)
                p_hat = predict_propensity(fw, prop_fit)
                two_plugin = np.maximum(denom_pred * p_hat, 1e-12)
                keys["pred_denom"] = denom_pred
                keys["pred_propensity"] = p_hat
                keys["pred_speeding_plugin"] = two_plugin
                keys["pred_speeding"] = two_plugin
                keys["pred_speeding_network"] = (
                    two_plugin / max(args.penetration, 1e-9))
                # Approximate-Bayes surface: posterior mean of
                # denom_s x p_s with independent Laplace draws for the
                # stage-A fixed effects and the stage-B propensity.
                if prop_bayes is not None:
                    S = max(4, int(prop_bayes.get("draws", 50)))
                    bdraws = laplace_coef_draws(
                        prop_bayes["model"], S,
                        seed=int(prop_bayes.get("seed", 0)))
                    p_draws = predict_propensity_draws(
                        fw, prop_bayes["model"], bdraws)
                    if stage_a_bayes is not None:
                        fac, cov = laplace_fixed_factors(
                            fw, stage_a_bayes["info"], S,
                            seed=int(stage_a_bayes.get("seed", 1)))
                    else:
                        fac = np.ones((S, len(fw)))
                        cov = {"n_terms": 0, "n_with_se": 0, "mean_se": 0.0}
                    denom_draws = denom_pred[None, :] * fac
                    samples = denom_draws * p_draws
                    post = samples.mean(axis=0)
                    keys["pred_speeding"] = np.maximum(post, 1e-12)
                    # POSTERIOR PREDICTIVE bounds, not parameter-only ones.
                    # Quantiles of the conditional mean had ~0% holdout
                    # coverage on the pilot (they describe where the mean
                    # is, not where an observation falls). An observation
                    # bound needs the two-stage sampling noise:
                    #   n_s ~ NB2/Poisson(denom_s)   (stage-A predictive)
                    #   k_s ~ Binomial(n_s, p_s)     (propensity noise)
                    _alpha_a = None
                    if stage_a_bayes is not None:
                        _alpha_a = (stage_a_bayes.get("info") or {}).get(
                            "alpha")
                    _pred = bayes_predictive_draws(
                        denom_draws, p_draws, alpha=_alpha_a,
                        seed=(int(stage_a_bayes.get("seed", 1)) + 977
                              if stage_a_bayes is not None else 977))
                    keys["pred_speeding_lo"] = np.maximum(
                        np.quantile(_pred, 0.05, axis=0), 0.0)
                    keys["pred_speeding_hi"] = np.maximum(
                        np.quantile(_pred, 0.95, axis=0), 0.0)
                    del _pred
                    keys["pred_propensity_sd"] = p_draws.std(axis=0)
                    keys["pred_speeding_network"] = (
                        keys["pred_speeding"] / max(args.penetration, 1e-9))
                    if not getattr(args, "_bayes_logged", False):
                        args._bayes_logged = True
                        args._bayes_stage_a_cov = cov
                        print(f"   [bayes] posterior surface: S={S} draws, "
                              f"stage-A fixed terms with se "
                              f"{cov['n_with_se']}/{cov['n_terms']}")
            except Exception as exc:  # noqa: BLE001
                print(f"   WARN: two-stage predict failed ({exc}); "
                      "shipping the count surface")
        # ------------------------------------------------- counterfactual
        # No-game twin: same segments x bins with the game switched off.
        # Answers how counts differ game-day vs not from the FITTED model
        # (no refit): event/time/game attrs zeroed, static-profile exposure
        # (no uplift, no game anomaly), place effects kept. Plug-in
        # propensity (no Bayes draws) keeps the cost to one extra
        # R=two_stage_flow_R denominator sim.
        if (flow_info is not None and prop_fit is not None
                and not getattr(args, "no_counterfactual", False)):
            try:
                g0 = grid.copy()
                g0["in_event"] = 0.0
                g0["rel_hour"] = 0.0
                g0["rel_hour_sq"] = 0.0
                g0["rel_sin"] = 0.0
                g0["rel_cos"] = 1.0
                g0["pre_game"] = 0.0
                g0["post_game"] = 0.0
                g0["event_x_dist"] = 0.0
                g0["attendance"] = 0.0
                g0["log_att"] = 0.0
                g0["fixture_type"] = ""
                g0["ko_hour"] = 0.0
                g0["ko_tod_sin"] = 0.0
                g0["ko_tod_cos"] = 0.0
                g0["fxt_NRL"] = 0.0
                g0["fxt_ALeague"] = 0.0
                g0["big_game"] = 0.0
                g0["rel_x_dist"] = 0.0
                g0["att_x_dist"] = 0.0
                g0["ev_x_lanes"] = 0.0
                g0["seg_event_uplift_z"] = 0.0
                # Static exposure: profile only (no game uplift/anomaly);
                # weather and frozen calibration are measurement scale,
                # not game effects, so they apply to both surfaces.
                g0 = add_exposure(g0, ctx, seg_flow, profile)
                g0 = apply_weather(g0, wmap, wstats)
                if exp_cal:
                    g0 = calibrate_exposure(g0, exp_cal)
                g0 = apply_temporal_x(g0, seg_risk_map, clock_prof, None)
                fw0 = search_frame(g0.assign(Y=0.0), args.target)
                fw0, _ = prepare_metacount_frame(fw0, exposure_col="exp",
                                                 highway_col="highway")
                fw0, _ = add_exposure_shape(
                    fw0, params=getattr(args, "_exp_shape_params", None),
                    hinge=str(getattr(args, "exposure_basis", "none")) in
                    ("hinge", "hinge+hw"),
                    interact_hw=str(getattr(args, "exposure_basis", "none"))
                    in ("hinge+hw", "linear+hw", "hw"))
                for col in hw_cols:
                    if col not in fw0.columns:
                        fw0[col] = 0.0
                denom0 = np.maximum(predict_metacount_sim(
                    fw0, flow_info, id_col="row_id", y_col="Y",
                    R=max(200, int(getattr(args, "two_stage_flow_R", 60))),
                    chunk=25000), 1e-9)
                p0 = np.clip(np.asarray(
                    predict_propensity(fw0, prop_fit), dtype=float),
                    1e-12, 1.0 - 1e-12)
                keys["pred_nogame"] = np.maximum(denom0 * p0, 1e-12)
                keys["game_lift"] = (keys["pred_speeding"].to_numpy(float)
                                     - keys["pred_nogame"].to_numpy(float))
                del g0, fw0, denom0, p0
            except Exception as exc:  # noqa: BLE001 - game surface stands
                print(f"   WARN: counterfactual failed ({exc}); "
                      "shipping game surface only")
        # ------------------------------------------------- system dynamics
        # Stock-flow twin: q -> k=q/v -> v(vf,kj) -> exceedance -> rate,
        # simulated on predicted game flow AND static flow. The SD lift is
        # an independent, structurally-identified estimate of the regression
        # game_lift: same demand experiment, different identification.
        # Crowd channel: game flow is scaled by (A/att_ref)^eta so same-code,
        # same-kickoff fixtures with different crowds get different SD
        # surfaces (unguarded eta=0 reproduces the unscaled surface).
        if (sd_curves is not None and prop_lookup is not None
                and not getattr(args, "no_sd", False)):
            try:
                _qg = pd.to_numeric(grid["pred_flow"],
                                    errors="coerce").fillna(0.0).to_numpy(float)
                _fu = pd.to_numeric(grid["flow_uplift"],
                                    errors="coerce").fillna(1.0).to_numpy(float)
                _qs = _qg / np.clip(_fu, 1e-9, None)
                _att = float(grid["attendance"].iloc[0]) \
                    if "attendance" in grid.columns and len(grid) else 0.0
                _eta = float(demand_eta) if demand_eta is not None else 0.0
                _aref = float(demand_att_ref) \
                    if demand_att_ref is not None else 0.0
                # Per-phase crowd scaling with RAW etas (negative = bigger
                # crowds draw less flow: saturation/diversion, as observed).
                # Exponent clipped to [-1, 1.5]; multiplier to [0.25, 4].
                # Falls back to clipped etas, then the overall raw eta.
                _ebyp = (demand_eta_raw_by_phase
                         if isinstance(demand_eta_raw_by_phase, dict)
                         and demand_eta_raw_by_phase
                         else (demand_eta_by_phase
                               if isinstance(demand_eta_by_phase, dict)
                               else {}))
                if _att > 0 and _aref > 0 and _ebyp:
                    _rb = np.asarray(grid["rel_bin"].to_numpy(int)).clip(
                        0, REL_BINS - 1) if "rel_bin" in grid.columns \
                        else np.zeros(len(grid), dtype=int)
                    _ph = _phase_of_bin(_rb)
                    _raw0 = float(demand_eta_raw) \
                        if demand_eta_raw is not None else float(_eta)
                    _ev = np.array([float(_ebyp.get(str(p), _raw0))
                                    for p in _ph], dtype=float)
                    # SEGMENT-SPECIFIC crowd elasticity, ESTIMATED (not a
                    # constant): eta_i = EB-shrunk per-segment dlog q/dlog A
                    # over the train fixtures, relative to the pooled eta.
                    # A scalar multiplier scales every segment equally, which
                    # changes game TOTALS but preserves the ranking (the
                    # measured failure: top-20 Jaccard 0.90-1.00, 4/250
                    # segments ever moving). Weighting by the segment's own
                    # estimated elasticity is what can reorder sites.
                    _w = np.ones(len(grid), dtype=float)
                    if seg_eta_ratio:
                        _z = pd.to_numeric(
                            grid["road_osmid"].map(seg_eta_ratio),
                            errors="coerce").fillna(1.0).to_numpy(float)
                        _w = np.clip(_z, 0.1, 4.0)
                    _cm = np.clip((_att / _aref)
                                  ** np.clip(_ev * _w, -1.0, 1.5), 0.25, 4.0)
                elif _att > 0 and _aref > 0 and _eta != 0.0:
                    _cm = float(np.clip((_att / _aref) ** _eta, 0.25, 4.0))
                else:
                    _cm = 1.0
                _qg = _qg * _cm
                if "highway" in grid.columns:
                    _cls = (grid["highway"].fillna("unclassified")
                            .astype(str).to_numpy())
                else:
                    _cls = np.array(["unclassified"] * len(grid))
                _lim = _sd_limit(grid)
                _sd_g, _, _ = sd_predict(_qg, _cls, _lim, sd_curves,
                                         prop_lookup, sd_forms)
                _sd_n, _, _ = sd_predict(_qs, _cls, _lim, sd_curves,
                                         prop_lookup, sd_forms)
                # Operating regime: can the twin bite at all on THIS fixture?
                # NOTE: `audit` is an OPTIONAL sink. It MUST NOT be
                # referenced unconditionally: an earlier revision raised
                # NameError('audit') inside this try-block, which the broad
                # `except Exception` swallowed into a one-line WARN -- so
                # every SD simulation silently failed, the parquet shipped
                # with no SD columns, the flow-driven temporal surface had
                # nothing to fall back on, and the run still exited 0 with
                # "59 OK". Diagnostics must never be able to break a path
                # they are only observing.
                _reg = sd_regime(_qg, _cls, sd_curves)
                if isinstance(audit, dict):
                    audit.setdefault("sd_regime_by_fixture", {})[
                        str(grid["fixture"].iloc[0])] = _reg
                keys["sd_regime_rho_p95"] = float(_reg["rho_p95"])
                keys["sd_regime_congestion_share"] = float(
                    _reg["congestion_active_.5_.9"])
                keys["pred_sd_game"] = np.maximum(_sd_g, 1e-12)
                keys["pred_sd_nogame"] = np.maximum(_sd_n, 1e-12)
                keys["sd_lift"] = keys["pred_sd_game"] - keys["pred_sd_nogame"]
                keys["sd_crowd_mult"] = float(np.mean(_cm)) \
                    if np.size(_cm) > 1 else float(_cm)
                # Calibrated twin. UNITS-FIXED: the calibration is a FIXTURE
                # share map (lift share -> observed lift share), so it is
                # applied to the fixture's ROW-WISE SD lift, rescaled so the
                # fixture total lands on the calibrated share. Scaling the
                # rows (rather than adding a fixture scalar to a different
                # surface) keeps the twin's segment-level variation, which is
                # the only thing that can produce a game-varying site list.
                #
                # The earlier form, pred_nogame + share*pred_sd_nogame,
                # added a regression-scale surface to an SD-scale one: the
                # blend's ranking ROTATED as the share changed by fixture,
                # which produced top-20 Jaccard 0.00 across three games.
                try:
                    _ca, _cb = sd_lift_cal \
                        if sd_lift_cal is not None else (0.0, 1.0)
                    _ca, _cb = float(_ca), float(_cb)
                except Exception:  # noqa: BLE001
                    _ca, _cb = 0.0, 1.0
                _ng = keys["pred_sd_nogame"].to_numpy(float)
                _sl = keys["sd_lift"].to_numpy(float)
                _base = float(_ng.sum())
                _share_sd = float(_sl.sum() / max(_base, 1e-12))
                _share_target = _ca + _cb * _share_sd
                # Row-wise rescale factor (>=0 keeps the twin's spatial sign
                # pattern while hitting the calibrated fixture share).
                _k = (_share_target / _share_sd) if abs(_share_sd) > 1e-9 \
                    else 1.0
                _k = float(np.clip(_k, 0.0, 5.0))
                keys["sd_lift_share_sd"] = _share_sd
                keys["sd_lift_share_cal"] = float(_share_target)
                keys["sd_lift_cal_scale"] = _k
                keys["sd_lift_cal"] = _k * _sl
                keys["pred_sd_game_cal"] = np.maximum(
                    _ng + keys["sd_lift_cal"].to_numpy(float), 1e-12)
                if "pred_nogame" in keys.columns:
                    # Blended deployment surface: regression counterfactual
                    # plus the (calibrated) structural increment, so the
                    # segment-level variation of the twin survives into the
                    # ranking instead of being averaged away by a scalar.
                    _inc = keys["sd_lift_cal"].to_numpy(float)
                    keys["pred_speeding_calsd"] = np.maximum(
                        _ng + _inc, 1e-12)
                del _qg, _fu, _qs, _cls, _lim, _sd_g, _sd_n
            except Exception as exc:  # noqa: BLE001 - regression stands
                # A swallowed failure here used to ship a parquet with no SD
                # columns, no flow-temporal surface, and "59 OK" -- the run
                # looked successful while a whole channel was missing. Count
                # it and make it LOUD; the post-run gate turns a total
                # failure into a non-zero exit.
                _sd_fail.append(f"{type(exc).__name__}: {exc}"[:200])
                print(f"   ERROR: SD simulation failed ({exc}) ["
                      f"{len(_sd_fail)} fixture(s) affected]")
        if temporal_fit is not None:
            try:
                tpred = np.maximum(
                    np.asarray(temporal_fit.predict(fw), dtype=float), 1e-9)
                # Magnitude guard at the WRITE site, not just at fit time.
                # A near-unit-root AR integrates noise into astronomical
                # counts: 61b (o25938148) shipped a parquet whose
                # pred_speeding_temporal reached 5.18e21 across 1,676,836
                # rows, because the phi_max guard did not exist yet. The
                # fit-time guard now catches that, but a parquet column
                # that large is a live hazard for anything reading it by
                # name, so refuse to write it at all and say so.
                _tmax = float(np.max(tpred)) if tpred.size else 0.0
                _ref = float(np.max(keys["pred_speeding"])) \
                    if "pred_speeding" in keys.keys() and len(keys["pred_speeding"]) \
                    else 0.0
                _cap = max(1e3, 1e6 * max(_ref, 1.0))
                if not np.isfinite(_tmax) or _tmax > _cap:
                    print(f"   [temporal] REFUSING to write "
                          f"pred_speeding_temporal: max={_tmax:.3g} exceeds "
                          f"cap={_cap:.3g} (ref max={_ref:.3g}). The AR "
                          "surface is non-finite or near-unit-root; keeping "
                          "the JAX surface only.")
                    if getattr(args, "temporal_predict", False):
                        print("   [temporal] --temporal-predict requested but "
                              "refused; shipping the JAX surface instead")
                else:
                    keys["pred_speeding_temporal"] = tpred
                    if getattr(args, "temporal_predict", False):
                        keys["pred_speeding"] = tpred
                        keys["pred_speeding_network"] = (
                            tpred / max(args.penetration, 1e-9))
            except Exception as exc:  # noqa: BLE001 - JAX surface stands
                print(f"   WARN: temporal predict failed ({exc}); "
                      "keeping JAX surface")
        _tmode = str(getattr(args, "temporal_mode", "flow") or "flow").lower()
        if _tmode == "flow":
            # Flow-driven dynamics replace the AR surface: the calibrated-SD
            # game surface (density-mediated, time-varying via predicted
            # flow) is the temporal surface. Same magnitude guard as AR.
            try:
                _src = ("pred_speeding_calsd"
                        if "pred_speeding_calsd" in keys.columns
                        else ("pred_sd_game_cal"
                              if "pred_sd_game_cal" in keys.columns
                              else ("pred_sd_game"
                                    if "pred_sd_game" in keys.columns
                                    else None)))
                if _src is None:
                    print("   [temporal-flow] no SD surface on this fixture; "
                          "keeping JAX surface")
                else:
                    tpred = np.maximum(
                        np.asarray(keys[_src].to_numpy(float),
                                   dtype=float), 1e-9)
                    _tmax = float(np.max(tpred)) if tpred.size else 0.0
                    _ref = float(np.max(keys["pred_speeding"])) \
                        if "pred_speeding" in keys.keys() \
                        and len(keys["pred_speeding"]) else 0.0
                    _cap = max(1e3, 1e6 * max(_ref, 1.0))
                    if not np.isfinite(_tmax) or _tmax > _cap:
                        print(f"   [temporal-flow] REFUSING to write "
                              f"pred_speeding_temporal: max={_tmax:.3g} "
                              f"exceeds cap={_cap:.3g}; keeping JAX surface")
                    else:
                        keys["pred_speeding_temporal"] = tpred
                        keys["temporal_source"] = _src
                        if getattr(args, "temporal_predict", False):
                            keys["pred_speeding"] = tpred
                            keys["pred_speeding_network"] = (
                                tpred / max(args.penetration, 1e-9))
            except Exception as exc:  # noqa: BLE001 - JAX surface stands
                print(f"   WARN: flow-temporal predict failed ({exc}); "
                      "keeping JAX surface")
        # Per-game diagnostic: how much does THIS game's surface reorder
        # segments relative to the game-average? Logged per fixture so the
        # first game where the crowd channel goes uniform again is visible
        # in the log instead of being inferred from a frozen MIP site set.
        try:
            _p = np.asarray(keys["pred_speeding"].to_numpy(float))
            if len(_p) and isinstance(audit, dict):
                audit.setdefault("per_game_pred_total", {})[
                    str(keys["fixture"].iloc[0])] = round(float(_p.sum()), 1)
                audit.setdefault("per_game_crowd_mult_range", {})[
                    str(keys["fixture"].iloc[0])] = [
                        round(float(np.min(_cm)), 3),
                        round(float(np.max(_cm)), 3)]
        except Exception:  # noqa: BLE001 - diagnostic only
            pass
        out_parts.append(keys)
        del grid, fw, pred, keys
        gc.collect()
    if _sd_fail and isinstance(audit, dict):
        audit["sd_simulation_failures"] = _sd_fail
        audit["sd_simulation_ok"] = False
    elif isinstance(audit, dict):
        audit["sd_simulation_ok"] = True
    return pd.concat(out_parts, ignore_index=True)


def fit_temporal_stage(train_events, spec, work, args, audit, target):
    """Stage 2b: NB2 + AR(1)/AR(2) refit on contiguous train windows.

    Requires metacountregressor>=1.0.165 (temporal_models). Panels are whole
    segment x fixture windows (id=fixture|road_osmid, time=rel_bin) sampled
    BEFORE row-level caps break contiguity. Fixed terms come from the
    searched spec; random terms are the searched RP bases that also appear
    in fixed (capped at 3 for speed). Returns the fit or None (JAX path
    continues regardless).
    """
    audit["temporal_stage"] = {"attempted": True}
    try:
        from metacountregressor.temporal_models import (
            fit_temporal_random_parameter_model)
    except Exception as exc:
        print(f"   [temporal] skipped (needs metacountregressor>=1.0.165: {exc})")
        audit["temporal_stage"] = {"attempted": True, "skipped": str(exc)}
        return None
    if str(args.temporal_refit or "none").lower() == "none":
        audit["temporal_stage"] = {"attempted": False, "disabled": True}
        return None
    if train_events is None or len(train_events) == 0:
        audit["temporal_stage"]["error"] = "no train events"
        return None
    keep = ["fixture", "road_osmid", "rel_bin", target, "vehicle_count",
            "attendance"] + list(spec.get("fixed_terms", []))
    keep = [c for c in keep if c in train_events.columns]
    panel = train_events[keep].copy()
    panel["panel_id"] = (panel["fixture"].astype(str) + "|" +
                         panel["road_osmid"].astype(str))
    # FULL windows only: AR on gappy series hallucinates unit roots
    # (o25938147: 11.5/28 bins avg -> phi1=0.9976). Drop partial panels,
    # then whole-window sample to cap.
    full_ids = panel.groupby("panel_id")["rel_bin"].nunique()
    full_ids = full_ids[full_ids >= REL_BINS].index.to_numpy()
    _min_win = int(getattr(args, "temporal_min_windows", 30) or 30)
    if len(full_ids) < _min_win:
        audit["temporal_stage"]["error"] = (
            f"only {len(full_ids)} full windows (<{_min_win}); AR needs "
            "contiguous series — use the transferable temporal-x features "
            "instead")
        print(f"   [temporal] skipped: {len(full_ids)} full windows "
              f"(need >={_min_win})")
        return None
    cap = max(100, int(args.temporal_panels))
    ids = full_ids
    if len(ids) > cap:
        rng = np.random.default_rng(int(args.seed))
        ids = rng.choice(ids, cap, replace=False)
        panel = panel[panel["panel_id"].isin(ids)].copy()
    panel = panel.sort_values(["panel_id", "rel_bin"]).reset_index(drop=True)
    panel["__row"] = np.arange(len(panel))
    fixed = [c for c in spec.get("fixed_terms", []) if c in panel.columns]
    rdm_bases = {str(t).split(":")[0] for t in
                 list(spec.get("rdm_terms", [])) +
                 list(spec.get("rdm_cor_terms", []))}
    rands = [c for c in fixed if c in rdm_bases][:3]
    if not fixed:
        audit["temporal_stage"]["error"] = "no fixed terms overlap panel"
        return None
    print(f"   [temporal] fitting NB2+{args.temporal_refit} on "
          f"{len(panel):,} rows / {panel['panel_id'].nunique():,} panels "
          f"(fixed={len(fixed)}, rdm={len(rands)})...")
    t0 = time.time()
    fit = fit_temporal_random_parameter_model(
        panel, id_col="panel_id", time_col="rel_bin", y_col=target,
        fixed_terms=fixed, random_terms=rands, likelihood="nb",
        temporal_model=str(args.temporal_refit), n_draws=32, maxiter=150)
    phi = {k: float(v) for k, v in dict(fit.temporal_parameters).items()}
    phi_max = max([abs(v) for v in phi.values()] + [0.0])
    if phi_max > float(getattr(args, "temporal_phi_max", 0.95)):
        # Near-unit-root: the AR integrates noise into astronomical counts
        # (o25938147: phi1=0.9976, rmse=1.7e21). Reject; JAX surface ships.
        print(f"   [temporal] REJECTED: non-stationary AR "
              f"(max|phi|={phi_max:.4f} > {args.temporal_phi_max}); "
              "keeping JAX surface")
        audit["temporal_stage"] = {
            "attempted": True, "model": fit.temporal_model,
            "converged": bool(fit.converged),
            "phi": {k: round(v, 4) for k, v in phi.items()},
            "rejected": f"max|phi|={phi_max:.4f} non-stationary",
            "bic": round(float(fit.bic), 1), "aic": round(float(fit.aic), 1),
            "loglik": round(float(fit.loglik), 1),
        }
        return None
    audit["temporal_stage"] = {
        "attempted": True, "model": fit.temporal_model,
        "converged": bool(fit.converged), "message": str(fit.message)[:200],
        "phi": {k: round(float(v), 4) for k, v in phi.items()},
        "bic": round(float(fit.bic), 1), "aic": round(float(fit.aic), 1),
        "loglik": round(float(fit.loglik), 1),
        "n_panels": int(fit.n_panels), "n_obs": int(fit.n_obs),
        "elapsed_s": round(time.time() - t0, 1),
        "fixed_terms": list(fixed), "random_terms": list(rands),
    }
    print(f"   [temporal] {fit.temporal_model} converged={fit.converged} "
          f"phi={audit['temporal_stage']['phi']} BIC={fit.bic:.1f} "
          f"({audit['temporal_stage']['elapsed_s']}s)")
    # In-sample overflow check: population means must live on the observed
    # scale. A "converged" fit with exp-blown predictions (o25938147:
    # rmse 1.7e21) is unusable for --temporal-predict — discard now.
    try:
        _in = np.asarray(fit.predict(panel), dtype=float)
        _ob = pd.to_numeric(panel[target], errors="coerce").fillna(0.0).to_numpy(float)
        if (not np.all(np.isfinite(_in)) or float(np.mean(_in))
                > 100.0 * max(float(np.mean(_ob)), 1e-9)):
            print(f"   [temporal] REJECTED: in-sample mean "
                  f"{float(np.mean(_in[np.isfinite(_in)])):.3g} vs observed "
                  f"{float(np.mean(_ob)):.3g}; keeping JAX surface")
            audit["temporal_stage"]["rejected"] = "in-sample overflow"
            return None
    except Exception as exc:  # noqa: BLE001
        print(f"   [temporal] REJECTED: predict check failed ({exc})")
        audit["temporal_stage"]["rejected"] = f"predict check: {exc}"
        return None
    return fit


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--panel", default=str(PANEL))
    ap.add_argument("--target", default=TARGET_DEFAULT)
    ap.add_argument("--pilot", action="store_true")
    ap.add_argument("--future-from", default=None)
    ap.add_argument("--n-future", type=int, default=6)
    ap.add_argument("--penetration", type=float, default=0.05)
    ap.add_argument("--search-algo", default="sa")
    ap.add_argument("--search-iters", type=int, default=120)
    ap.add_argument("--search-chunk", type=int, default=25,
                    help="SA iterations per chunk (checkpoint after each)")
    ap.add_argument("--chunk-time", type=float, default=0.0,
                    help="max seconds per chunk (0 = unlimited)")
    ap.add_argument("--wall-budget", type=float, default=0.0,
                    help="max seconds for the whole search stage "
                         "(refit/predict run after); 0 = unlimited")
    ap.add_argument("--checkpoint-every", type=int, default=10,
                    help="package-side checkpoint every N SA gens (0 = off)")
    ap.add_argument("--n-starts", type=int, default=2,
                    help="SA restarts on the first chunk (1 on warm chunks)")
    ap.add_argument("--search-R", type=int, default=40)
    ap.add_argument("--refit-R", type=int, default=200)
    ap.add_argument("--search-n-jobs", type=int, default=1,
                    help="parallel fitness workers per chunk (embarrassingly "
                         "parallel; ~1.5-1.8x per extra worker). Match with "
                         "OMP threads = ncpus // n-jobs (see 61); each worker "
                         "holds its own compiled executables (~10-30GB).")
    ap.add_argument("--train-cap", type=int, default=100000,
                    help="rows for the search frame (refit always uses the "
                         "full frame). Cost scales ~linearly; 64k ≈ 1.5x "
                         "faster per eval with noisier BIC.")
    ap.add_argument("--de-maxiter", type=int, default=8)
    ap.add_argument("--de-popsize", type=int, default=8)
    ap.add_argument("--no-de-warm", action="store_true",
                    help="skip JAX vmap DE warm-start in refit (LBFGS polish "
                         "only; ~16x less peak for N*R large, same optimum)")
    ap.add_argument("--no-slsqp", action="store_true",
                    help="use LBFGS instead of SLSQP in refit (halves grad "
                         "buffers for N*R large)")
    ap.add_argument("--engine", default=ENGINE_DEFAULT)
    ap.add_argument("--surface-scale", default="linear",
                    choices=["linear", "log"],
                    help="colour scale for the per-game predicted surfaces. "
                         "Linear by default: per-15-min-bin values run "
                         "10^0-10^1, and a log axis compressed that range and "
                         "printed counts as '6 x 10^0'. Use log only if a "
                         "game's surface really is multiplicative across bins")
    ap.add_argument("--binomial-refit", default="off", choices=["on", "off"],
                    help="also fit the speeding propensity as a BINOMIAL, "
                         "k ~ Binomial(trips_with_judged_speed, p), and report "
                         "it beside the count refit. The count model needs an "
                         "exposure to scale a count with and the only one "
                         "available is a TMR flow projection, which is what "
                         "the exposure LRT keeps rejecting. Here the "
                         "denominator is MEASURED, so there is no projection "
                         "to get wrong and the flow elasticity becomes a "
                         "coefficient instead of a pinned offset. Reported "
                         "alongside, not instead of, the count path")
    ap.add_argument("--two-stage", default="on", choices=["on", "off"],
                    help="ship pred_speeding = E[measured denominator | game] "
                         "x P(speeding | game) instead of the count model on "
                         "the TMR flow projection. Stage A is an NB2 model "
                         "for the panel's measured denominator (vehicle_count "
                         "for speeding_trips, trips_with_judged_speed for the "
                         "trips_* targets); stage B is the binomial propensity "
                         "on the SEARCHED fixed design, so game x segment "
                         "interactions act on the rate. Both must fit; any "
                         "failure falls back to the count surface and the "
                         "handoff gate records it. On by default")
    ap.add_argument("--prune-p", type=float, default=0.0,
                    help="refit with significance pruning: after the first "
                         "count refit, drop fixed terms with p > this value "
                         "(exposure logexp is never dropped) and refit once; "
                         "the two-stage propensity is then backward-"
                         "eliminated on the same rule. The forced game block "
                         "is what guarantees game-specific reordering, so "
                         "pruning can remove it -- the handoff gate decides "
                         "whether the pruned surface still ships. 0 = off")
    ap.add_argument("--two-stage-flow-R", type=int, default=60,
                    help="Monte-Carlo draws for the stage-A denominator "
                         "surface (only used when the searched structure has "
                         "random terms; 60 is enough for a mean surface)")
    ap.add_argument("--bayes", default="off", choices=["on", "off"],
                    help="approximate-Bayes two-stage: Laplace posterior for "
                         "the propensity (optional evidence-selected Gaussian "
                         "prior on game interactions) and diagonal Laplace "
                         "for the stage-A fixed effects; ships the posterior "
                         "mean and writes 5/95%% predictive bounds. The "
                         "holdout metrics report the plug-in surface side by "
                         "side, so the gain is measurable on the same rows. "
                         "Off by default")
    ap.add_argument("--bayes-draws", type=int, default=50,
                    help="posterior draws for the Bayes surface (50 keeps "
                         "the S x n sample matrix at ~100 MB per fixture)")
    ap.add_argument("--bayes-base-sd", type=float, default=10.0,
                    help="weak Gaussian prior sd for pooled coefficients; "
                         "makes every evidence fit a proper prior so the "
                         "Laplace evidences are comparable")
    ap.add_argument("--bayes-game-prior", default="on", choices=["on", "off"],
                    help="select the game-interaction prior sd (None/2/1/"
                         "0.5/0.25) by Laplace evidence on TRAIN; the "
                         "Bayesian alternative to tuning shrinkage on the "
                         "holdout. Off = weak prior everywhere")
    ap.add_argument("--exposure-basis", default="none",
                    choices=["none", "hinge", "hinge+hw", "linear+hw", "hw"],
                    help="shape of the flow->speeding exposure curve. "
                         "'hinge' adds a linear-hinge (piecewise linear) "
                         "deviation basis on logexp at two frozen train "
                         "quantiles, letting the curve bend while the forced "
                         "linear logexp term stays. '+hw' additionally adds "
                         "logexp x highway-class interactions, so the flow "
                         "elasticity differs by road class -- a more robust "
                         "alternative to trusting the per-class uplift u, "
                         "since it changes the ELASTICITY rather than trying "
                         "to fix the exposure scale per class. Off by default")
    ap.add_argument("--zero-inflation", default="off", choices=["on", "off"],
                    help="offer role 6 (zero inflation) to the continuous "
                         "and calendar candidate terms, letting the search fit "
                         "a structural-zero process alongside the count. The "
                         "package derives zero_inflated from len(zi_cols) > 0, "
                         "so with no candidate assigned the model stays "
                         "ordinary. Off by default")
    ap.add_argument("--max-latent-classes", type=int, default=1,
                    help="latent classes for the SEARCH (was hardcoded to 1). "
                         "This is NOT a refit-only knob: with a value > 1 the "
                         "evaluator appends an LC gene plus per-class outcome "
                         "and membership masks, growing the decision vector "
                         "from 2D+1 to 3D+2, activates membership roles 7/8, "
                         "and forces struct_lc to at least this value in "
                         "EVERY spec -- so it is a hard constraint, not a "
                         "soft option. It also inflates the search space, so "
                         "a 3-iteration smoke budget will not find a good "
                         "class structure; raise --search-iters "
                         "substantially before trusting it")
    ap.add_argument("--exposure-calibration", default="off",
                    choices=["off", "on"],
                    help="calibrate the flow proxy onto the OBSERVED trip "
                         "denominator (trips_with_judged_speed) with a "
                         "shrunk per-segment and per-dow/tod ratio, then use "
                         "the calibrated value as the exposure. The response "
                         "is a count of speeding TRIPS, so its true "
                         "denominator is measured, not modelled; the offset "
                         "in use is a TMR flow projection, and that mismatch "
                         "is the leading suspect for the exposure LRT "
                         "rejecting the pinned offset at chi2(1)=364. "
                         "OFF by default so the current channel stays the "
                         "baseline in any comparison")
    ap.add_argument("--calib-k-seg", type=float, default=8.0,
                    help="shrinkage pseudo-count (exposure units) for the "
                         "per-segment calibration ratio")
    ap.add_argument("--calib-k-cell", type=float, default=40.0,
                    help="shrinkage pseudo-count (exposure units) for the "
                         "per dow x time-of-day calibration ratio")
    ap.add_argument("--flow-uplift-by-class", default="off",
                    choices=["on", "off"],
                    help="estimate the game-day flow uplift PER HIGHWAY CLASS "
                         "instead of one pooled scalar per rel_bin. A pooled "
                         "u cannot let a residential street and a 4-lane "
                         "arterial respond differently to a game, and is the "
                         "leading suspect for the exposure LRT rejecting the "
                         "flow channel (chi2(1)=364). OFF by default: it "
                         "changes the shipped exposure channel, so validate "
                         "it against the holdout before relying on it")
    ap.add_argument("--exposure", default="free",
                    choices=["free", "offset", "hazard"],
                    help="exposure parameterisation. 'free' (default) "
                         "estimates the logexp coefficient; 'offset'/'hazard' "
                         "pins it at 1.0 by moving logexp into the "
                         "likelihood's fixed offset (eta += logexp). Nested, "
                         "so --exposure-lrt gives a valid 1-df test of whether "
                         "the projected flow is misspecified")
    ap.add_argument("--exposure-lrt", default="off", choices=["on", "off"],
                    help="after the shipped refit, fit the opposite exposure "
                         "arm and report the 1-df likelihood-ratio test "
                         "(doubles refit time)")
    ap.add_argument("--refit-model", default="searched",
                    choices=["searched", "nb", "poisson"],
                    help="likelihood for the refit. 'searched' (default) "
                         "follows the structural search's dispersion gene, so "
                         "the shipped model is the one BIC chose; 'nb'/'poisson' "
                         "force it")
    ap.add_argument("--search-vars", default="slim", choices=["slim", "full"])
    ap.add_argument("--group-by", default="highway",
                    choices=["highway", "segment", "event"],
                    help="grouped-RP panel dimension: highway class (stable), "
                         "road_osmid segment propensity, or fixture event "
                         "split (per-event coefficients with "
                         "attribute-driven means for future games)")
    ap.add_argument("--group-temporal", default="off", choices=["on", "off"],
                    help="allow the temporal basis (rel_sin/rel_cos) to take "
                         "the GROUPED role (4), so each segment gets its own "
                         "within-window time curve instead of one shape shared "
                         "by the whole network. Off by default: it enlarges the "
                         "search space, and the existing --group-by setting "
                         "decides what a 'group' is (segment/fixture/...). "
                         "With the flag off, temporal terms stay fixed-only, "
                         "so --group-temporal on|off is a genuine A/B of "
                         "per-segment time dependence")
    ap.add_argument("--no-force-game", action="store_true",
                    help="allow the search to drop game-day terms (default: "
                         "in_event/rel_hour/log_att/event_x_dist are forced)")
    ap.add_argument("--force-event-uplift", default="on",
                    choices=["on", "off"],
                    help="force evu_x_att = seg_event_uplift_z * log_att into "
                         "every spec when the column varies. This is the "
                         "direct game-specific reordering term (responsive "
                         "segments weigh more for bigger crowds); pooled BIC "
                         "culls such within-game terms, so it is forced by "
                         "construction, like the GAME_FORCE block")
    ap.add_argument("--no-flow-uplift", action="store_true",
                    help="predict future exposure from the static background "
                         "profile only (default: joint flow->speeding with "
                         "game-day flow uplift)")
    ap.add_argument("--temporal-mode", default="flow",
                    choices=["ar1", "flow", "off"],
                    help="stage-2b dynamics source. 'ar1': NB2+AR refit on "
                         "contiguous windows (needs metacountregressor>=1.0.165; "
                         "adds zero holdout skill to date: temporal_bin_spearman "
                         "= 0.0). 'flow' (default): skip the AR fit and use the "
                         "flow-driven calibrated-SD game surface as the temporal "
                         "surface instead (density-mediated dynamics from "
                         "predicted time-varying flow). 'off': no temporal "
                         "surface at all.")
    ap.add_argument("--temporal-refit", default="ar1",
                    choices=["none", "ar1", "ar2"],
                    help="stage 2b: refit searched spec as NB2 + AR model on "
                         "contiguous train windows (needs "
                         "metacountregressor>=1.0.165; skipped otherwise; "
                         "ignored unless --temporal-mode ar1)")
    ap.add_argument("--temporal-panels", type=int, default=500,
                    help="max segment x fixture windows for stage 2b "
                         "(whole windows kept contiguous; ~45 min at 500)")
    ap.add_argument("--temporal-predict", action="store_true",
                    help="ship the AR population-mean surface to the MIP "
                         "instead of the JAX draw-averaged surface")
    ap.add_argument("--temporal-min-windows", type=int, default=30,
                    help="minimum full 28-bin windows for stage-2b AR "
                         "(44 exist today; the old 50 floor always skipped)")
    ap.add_argument("--no-temporal-vars", action="store_true",
                    help="drop within-window temporal-shape terms "
                         "(rel_hour_sq/sin/cos, pre/post_game) from the "
                         "search pool (peak shape then comes only from "
                         "game dummies + optional stage-2b AR)")
    # Single definition: this flag was declared twice during concurrent
    # edits, which made argparse raise at import. Kept one copy with the
    # fuller help text.
    ap.add_argument("--temporal-phi-max", type=float, default=0.95,
                    help="stage-2b AR stationarity bound: reject the AR fit "
                         "if any |phi| exceeds this (phi~=1 integrates "
                         "noise into astronomical counts, e.g. the "
                         "phi1=0.9976 / rmse=1.7e21 fit)")
    ap.add_argument("--no-counterfactual", action="store_true",
                    help="skip the no-game twin surface (pred_nogame / "
                         "game_lift); saves one extra denominator sim "
                         "per fixture")
    ap.add_argument("--no-sd", action="store_true",
                    help="skip the system-dynamics stock-flow twin "
                         "(pred_sd_game / pred_sd_nogame / sd_lift)")
    ap.add_argument("--seg-eta-pseudo", type=float, default=0.0,
                    help="EB pseudo-count for the per-segment crowd "
                         "elasticity. 0 (default) = PURE PREDICTION: each "
                         "segment uses its own OLS dlog q/dlog A with no "
                         "shrinkage. >0 shrinks toward the pooled eta with "
                         "weight n/(n+pseudo) as a fallback arm; the holdout "
                         "Spearman of both is reported so the choice is made "
                         "on out-of-sample skill")
    ap.add_argument("--sd-kj-mode", default="theory",
                    choices=["theory", "ols", "eb"],
                    help="jam density in the Greenshields twin. 'theory' "
                         "(default, pure prediction): kj is fixed by road "
                         "geometry (~120 veh/km/lane), only vf is estimated - "
                         "fitting kj from data was fitting an extrapolation "
                         "through never-jam observations. 'ols': fit kj too "
                         "(noisy; sensitivity arm). 'eb': EB shrink of the "
                         "OLS kj toward theory (superseded by 'theory')")
    ap.add_argument("--sd-regime-report", action="store_true", default=True,
                    help="record the share of predicted rows in each density "
                         "band (free-flow/transition/congestion-active/jam) "
                         "so it is visible whether the twin can suppress "
                         "speeding at all")
    ap.add_argument("--sd-form", default="search",
                    choices=["fixed", "search"],
                    help="SD functional forms: fixed theory "
                         "(Greenshields + binned table) or bounded GP search "
                         "seeded with theory (never worse than fixed)")
    ap.add_argument("--sd-gp-budget", type=float, default=240.0,
                    help="total seconds for GP form discovery across "
                         "classes (bounded; fixed forms stand on timeout)")
    ap.add_argument("--no-flow-anom", action="store_true",
                    help="skip the trailing same-DOW flow anomaly "
                         "(segment x game telematics); compare with/without "
                         "to test whether it reorders streets")
    ap.add_argument("--fixed-only", action="store_true",
                    help="skip random parameters entirely (no RP search or "
                         "refit draws): roles fixed/excluded only. Keeps "
                         "everything else (temporal AR, flow uplift, "
                         "two-stage, propensity, MIP). Much faster per eval.")
    # NOTE: --temporal-min-windows is defined once above (line ~4893); a
    # duplicate definition here previously made argparse raise
    # "conflicting option string" at startup (job 26678809).
    ap.add_argument("--seed", type=int, default=7)
    ap.add_argument("--resume", action="store_true",
                    help="continue the search from results/game_day_search_best.json")
    ap.add_argument("--out-dir", default=str(RES))
    ap.add_argument("--fig-dir", default=str(FIG))
    args = ap.parse_args()
    global BEST_JSON, PROGRESS_CSV, FAMILY_CSV
    out_dir = Path(args.out_dir)
    fig_dir = Path(args.fig_dir)
    BEST_JSON = out_dir / "game_day_search_best.json"
    PROGRESS_CSV = out_dir / "game_day_search_progress.csv"
    FAMILY_CSV = out_dir / FAMILY_CSV_NAME
    if args.pilot:
        args.search_iters = min(args.search_iters, 6)
        args.search_chunk = min(args.search_chunk, 5)
        args.search_R = min(args.search_R, 15)
        args.refit_R = min(args.refit_R, 60)
        args.n_future = min(args.n_future, 2)
        args.n_starts = min(args.n_starts, 1)
    out_dir.mkdir(parents=True, exist_ok=True)
    fig_dir.mkdir(parents=True, exist_ok=True)
    tag = "pilot" if args.pilot else "full"

    print("[59/1] loading panel + fixtures...")
    panel = load_panel(args.panel, target=args.target)
    panel["bin"] = pd.to_datetime(panel["bin"], utc=True).dt.tz_convert(TZ)
    bin_ns = bin_ns_array(panel)
    cal = load_fixtures()
    ctx = static_context()
    # Split on fixture_id (unique per calendar ROW), never on `label`
    # (which repeats across seasons). Selecting the last n rows rather than
    # the last n names is what makes the holdout actually held out.
    if args.future_from:
        cutoff = pd.Timestamp(args.future_from, tz=TZ)
        _fut = cal.loc[cal["ko"] >= cutoff]
    else:
        _fut = cal.tail(int(args.n_future))
    future_ids = set(_fut["fixture_id"])
    future_labels = set(_fut["label"])
    train_ids = set(cal["fixture_id"]) - future_ids
    _assert_split(cal, future_ids, train_ids)
    audit = {"tag": tag, "target": args.target,
             "penetration": args.penetration,
             "n_train_fixtures": len(train_ids),
             "n_future_fixtures": len(future_ids),
             "train_fixture_rows": int(cal["fixture_id"].isin(train_ids).sum()),
             "future_fixture_rows": int(cal["fixture_id"].isin(future_ids).sum()),
             "future_fixtures": sorted(future_labels),
             "future_fixture_ids": sorted(future_ids)}
    print(f"   train fixtures={len(train_ids)} rows="
          f"{audit['train_fixture_rows']} future fixtures={len(future_ids)} "
          f"rows={audit['future_fixture_rows']}")
    print(f"   future={sorted(future_labels)}")
    # Downstream callers select on fixture_id from here on.
    # Alias kept only so the build_game_frame call site below reads clearly;
    # the values are fixture_ids, NOT labels.

    print("[59/2] building features (sampled background + train windows)...")
    rng = np.random.default_rng(args.seed)
    covered = covered_mask(bin_ns, cal)
    prof_rows = PROFILE_ROWS if not args.pilot else 100000
    prof_sample = sample_background(panel, bin_ns, covered, rng, prof_rows)
    profile = build_profile(add_calendar(prof_sample))
    del prof_sample
    gc.collect()
    # Per-segment mean flow from the WHOLE panel (stable for rare segments);
    # the profile above captures the dow x time-of-day shape from the sample.
    seg_flow = (panel.groupby("road_osmid")["vehicle_count"].mean()).to_dict()
    # Segment x game telematics: trailing same-DOW anomaly vs a dynamic
    # baseline (past-only; known before kickoff). Skipped with --no-flow-anom.
    flow_anom_fx, flow_anom_wk, _fanom_audit = {}, {}, {"estimated": False}
    if not getattr(args, "no_flow_anom", False):
        flow_anom_fx, flow_anom_wk, _fanom_audit = estimate_flow_anomaly(
            panel, cal, train_ids, future_ids, seed=int(args.seed))
    audit["flow_anomaly"] = _fanom_audit
    wmap, wstats = load_weather_daily()
    event_cap = 20000 if args.pilot else EVENT_CAP
    bg_cap = 40000 if args.pilot else BG_CAP
    train_cap = 25000 if args.pilot else int(getattr(args, "train_cap", 100000))
    train_events = build_game_frame(panel, bin_ns, cal, ctx, seg_flow, profile,
                                     train_ids)
    if train_events.empty:
        raise SystemExit("no train event rows; check panel coverage")
    # Crowd-tier anchor from TRAIN attendance (model-consistent future tiers).
    try:
        _tr_att = pd.to_numeric(
            cal[cal["fixture_id"].isin(train_ids)]["attendance"],
            errors="coerce").dropna()
        crowd_med = float(_tr_att.median()) if len(_tr_att) else 0.0
    except Exception:
        crowd_med = 0.0
    audit["crowd_med"] = round(crowd_med, 1)
    # Transferable temporal structure, estimated on FULL train windows
    # (pre-sample) and anchored to train scope — no future leakage:
    # future fixtures/segments map to global-mean fallbacks.
    seg_risk_map, _seg_r0 = estimate_seg_risk(train_events, args.target)
    clock_prof = estimate_clock_prof(train_events, args.target)
    audit["seg_risk"] = {"n_segments": len(seg_risk_map),
                         "global_rate": round(float(_seg_r0), 6)}
    audit["clock_prof"] = {k: [round(float(v), 3) for v in arr]
                           for k, arr in clock_prof.items()}
    # Per-segment GAME uplift: event-window rate vs the segment's own
    # background rate, from TRAIN events and the full background panel.
    # This is the transferable "which streets respond to games" signal.
    seg_event_uplift_map = {}
    _denom_ev = binomial_denominator(args.target)
    try:
        if (_denom_ev in panel.columns and args.target in panel.columns):
            _bg_sums = (panel.loc[~covered, ["road_osmid", args.target,
                                             _denom_ev]]
                        .groupby("road_osmid").sum())
            seg_event_uplift_map = estimate_seg_event_uplift(
                train_events, _bg_sums, args.target, _denom_ev)
            del _bg_sums
    except Exception as exc:  # noqa: BLE001 - candidate degrades to zero
        print(f"   WARN: event-uplift estimate failed ({exc})")
    _evu = np.asarray(list(seg_event_uplift_map.values()), dtype=float)
    audit["seg_event_uplift"] = {
        "n_segments": int(len(seg_event_uplift_map)),
        "sd": round(float(_evu.std()), 4) if len(_evu) else 0.0,
        "min": round(float(_evu.min()), 3) if len(_evu) else None,
        "max": round(float(_evu.max()), 3) if len(_evu) else None}
    print(f"   event uplift: {len(seg_event_uplift_map)} segments, "
          f"sd={audit['seg_event_uplift']['sd']}")
    train_events = apply_temporal_x(train_events, seg_risk_map, clock_prof,
                                    seg_event_uplift_map)
    train_events = apply_flow_anomaly(train_events, flow_anom_fx, by="fixture",
                                      disabled=getattr(args, "no_flow_anom", False))
    train_events = apply_weather(train_events, wmap, wstats)
    print(f"   temporal-x: {len(seg_risk_map)} segment risks, "
          f"clock codes={sorted(clock_prof)})")
    # Stage 2b snapshot: whole-window sample BEFORE row caps break the
    # contiguous 28-bin series the AR estimator needs.
    temporal_snapshot = None
    if str(args.temporal_refit or "none").lower() != "none":
        try:
            _ids = train_events[["fixture", "road_osmid"]].drop_duplicates()
            _cap = max(100, int(args.temporal_panels))
            if len(_ids) > _cap:
                _ids = _ids.sample(_cap, random_state=args.seed)
            temporal_snapshot = train_events.merge(_ids, on=["fixture", "road_osmid"], how="inner").copy()
            print(f"   temporal snapshot: {len(temporal_snapshot):,} rows / "
                  f"{len(_ids):,} windows")
            del _ids
        except Exception as exc:  # noqa: BLE001 - JAX path unaffected
            print(f"   WARN: temporal snapshot failed ({exc})")
            temporal_snapshot = None
    if len(train_events) > event_cap:
        train_events = train_events.sample(event_cap, random_state=args.seed)
    bg_sample = sample_background(panel, bin_ns, covered, rng,
                                  min(len(train_events) * 2, bg_cap))
    background = enrich_background(bg_sample, ctx, seg_flow, profile)
    del bg_sample
    background = apply_temporal_x(background, seg_risk_map, clock_prof,
                                  seg_event_uplift_map)
    background = apply_flow_anomaly(background, None, flow_anom_wk, by="week",
                                    disabled=getattr(args, "no_flow_anom", False))
    background = apply_weather(background, wmap, wstats)
    del flow_anom_wk
    gc.collect()
    # Stage 1 (joint model): game-day flow uplift per rel_bin, estimated
    # while both frames are alive. Disabled with --no-flow-uplift.
    flow_uplift_by_hw = {}
    if args.no_flow_uplift:
        flow_uplift = np.ones(REL_BINS)
    else:
        # Deterministic denominator. estimate_flow_uplift divides by the
        # background mean, and `background` is a random subsample, so the
        # divisor (and therefore every u) moved between runs of identical
        # code. Pass the full-panel aggregate instead; the panel is already
        # in memory here and a scalar mean costs nothing.
        # `panel` has no `highway` column -- road class lives in the static
        # context (road_geometry_features), and the panel is read with a fixed
        # column subset that does not include it. Reading it off the panel
        # therefore always produced an empty dict, so
        # --flow-uplift-by-class silently estimated ZERO classes on job
        # 26077240. Join the class labels on from ctx instead, over the FULL
        # panel (not the background subsample, which would reintroduce the
        # sampling noise the pooled path just removed).
        bg_by_class = {}
        if ctx is not None and "highway" in getattr(ctx, "columns", []):
            try:
                _hw = ctx[["road_osmid", "highway"]].drop_duplicates(
                    subset=["road_osmid"])
                _bgp = (panel.loc[~covered, ["road_osmid", "vehicle_count"]]
                        .merge(_hw, on="road_osmid", how="left"))
                _bgp["highway"] = (_bgp["highway"].astype("string")
                                   .fillna("unclassified").astype(str))
                bg_by_class = (_bgp.groupby("highway")["vehicle_count"]
                               .mean().to_dict())
            except Exception as exc:  # noqa: BLE001
                print(f"   WARN: per-class background failed ({exc})")
                bg_by_class = {}
        _bg_full = float(panel.loc[~covered, "vehicle_count"].mean())
        flow_uplift = estimate_flow_uplift(
            train_events, background, bg_mean=_bg_full)
        # Per-class u. Off by default because it changes the shipped exposure
        # channel; opt in with --flow-uplift-by-class.
        if str(getattr(args, "flow_uplift_by_class", "off")) == "on":
            flow_uplift_by_hw = estimate_flow_uplift_by_class(
                train_events, background, bg_by_class,
                class_col="highway", fallback=flow_uplift)
            # Guard: a requested option that produces nothing must never look
            # like a tested-and-rejected result. Same pattern as the ZI
            # reachability check.
            if not flow_uplift_by_hw:
                print("   [uplift] *** REQUESTED BUT NOT REACHABLE: zero "
                      "highway classes estimated, so this run is NOT a "
                      "per-class-uplift test ***")
            else:
                print(f"   flow uplift by highway class: "
                      f"{len(flow_uplift_by_hw)} classes")
    audit["flow_uplift"] = [round(float(u), 3) for u in flow_uplift]
    audit["flow_joint"] = not args.no_flow_uplift
    print(f"   flow uplift rel_bin 0/12/27: {flow_uplift[0]:.2f}/"
          f"{flow_uplift[12]:.2f}/{flow_uplift[27]:.2f}")
    # Crowd elasticity for the SD demand channel: bigger crowds draw more
    # traffic (log-log OLS across train fixtures). Anchored at crowd_med so
    # the median game reproduces the unscaled surface exactly.
    demand_eta, _eta_rep = estimate_demand_elasticity(train_events)
    audit["demand_elasticity"] = {"eta": round(demand_eta, 3),
                                  "att_ref": round(float(crowd_med), 1),
                                  **{k: v for k, v in _eta_rep.items()
                                     if k != "eta"}}
    print(f"   demand elasticity eta={demand_eta:.3f} "
          f"(raw={_eta_rep.get('eta_raw', float('nan')):.3f} "
          f"se={_eta_rep.get('eta_se', float('nan')):.3f} "
          f"p={_eta_rep.get('eta_p', float('nan')):.3g} "
          f"att_ref={float(crowd_med):.0f})")
    if _eta_rep.get("by_phase"):
        print(f"   per-phase eta: " + ", ".join(
            f"{k}={v['eta']:.2f}(raw {v['eta_raw']:+.2f},p={v['p']:.2g})"
            for k, v in sorted(_eta_rep["by_phase"].items())))
    # Per-phase crowd multipliers for the SD demand channel (RAW etas keyed
    # by phase; missing phase -> overall raw eta). Raw (negative) etas are
    # used deliberately: the data say bigger crowds draw LESS probe flow
    # (saturation/diversion), and the multiplier clip [0.25, 4] bounds the
    # effect. Clipped [0, 1.5] etas are retained for reporting/back-compat.
    demand_eta_by_phase = {
        str(k): float(v["eta"])
        for k, v in (_eta_rep.get("by_phase") or {}).items()
        if np.isfinite(v.get("eta", float("nan")))}
    demand_eta_raw_by_phase = {
        str(k): float(v["eta_raw"])
        for k, v in (_eta_rep.get("by_phase") or {}).items()
        if np.isfinite(v.get("eta_raw", float("nan")))}
    demand_eta_raw = float(_eta_rep.get("eta_raw", 0.0)) \
        if np.isfinite(_eta_rep.get("eta_raw", float("nan"))) else 0.0
    # Per-SEGMENT crowd elasticity (estimated, EB-shrunk to the pooled eta)
    # expressed as a ratio eta_i/eta_pooled. This is the channel that lets a
    # bigger crowd REORDER segments instead of scaling them all equally.
    seg_eta_ratio, _seg_eta_diag = estimate_seg_crowd_elasticity(
        train_events, demand_eta_raw if abs(demand_eta_raw) > 1e-6 else 0.0,
        pseudo=float(getattr(args, "seg_eta_pseudo", 0.0)))
    if seg_eta_ratio and abs(demand_eta_raw) > 1e-6:
        seg_eta_ratio = {k: float(np.clip(v / demand_eta_raw, 0.1, 4.0))
                         for k, v in seg_eta_ratio.items()}
        print(f"   per-segment crowd elasticity: "
              f"{_seg_eta_diag.get('n_segments')} segments, "
              f"{_seg_eta_diag.get('n_own_estimate')} with own estimate, "
              f"eta sd {_seg_eta_diag.get('eta_sd')} "
              f"(pooled {demand_eta_raw:.3f}, "
              f"pseudo={_seg_eta_diag.get('pseudo')})")
    else:
        seg_eta_ratio = {}
        print("   per-segment crowd elasticity: unavailable "
              "(pooled eta ~ 0); pooled multiplier only")
    audit["seg_crowd_elasticity"] = _seg_eta_diag
    # System-dynamics calibration: speed-density curves per highway class +
    # speeding-rate lookup on exceedance, from observed (q, v) pairs. The
    # GAME enters the simulation through q (predicted flow), never through
    # the curves — so game-vs-not is a pure demand experiment. Train windows
    # only for the rate lookup (no future leakage); curves use both frames.
    sd_curves, prop_lookup = None, None
    if not getattr(args, "no_sd", False):
        try:
            _sd_cols = ["highway", "vehicle_count",
                        "mean_vehicle_speed_kmh"]
            _sd = pd.concat(
                [train_events[[c for c in _sd_cols
                               if c in train_events.columns]],
                 background[[c for c in _sd_cols
                             if c in background.columns]]],
                ignore_index=True)
            if len(_sd) > 400000:
                _sd = _sd.sample(400000, random_state=args.seed)
            sd_curves = fit_speed_density(
                _sd, penetration=float(getattr(args, "penetration", 0.05)),
                bin_hours=BINS_PER_HOUR and (60.0 / BINS_PER_HOUR) / 60.0,
                kj_mode=str(getattr(args, "sd_kj_mode", "theory")))
            prop_lookup = fit_propensity_lookup(train_events, args.target)
            del _sd
            # GP form discovery (bounded, seeded theory): per-class shapes
            # for v(k) and log-rate(e). Skipped with --sd-form fixed.
            sd_forms = {}
            if str(getattr(args, "sd_form", "search")) == "search":
                try:
                    sd_forms = fit_sd_forms(
                        train_events, args.target, sd_curves,
                        budget_s=float(getattr(args, "sd_gp_budget", 240.0)),
                        seed=int(args.seed)) or {}
                except Exception as exc:  # noqa: BLE001 - fixed forms stand
                    print(f"   WARN: GP form discovery failed ({exc})")
                    sd_forms = {}
            audit["sd"] = {
                "curves": {k: [round(float(v[0]), 2),
                               (round(float(v[1]), 1)
                                if np.isfinite(v[1]) else None)]
                           for k, v in sd_curves.items()
                           if isinstance(v, tuple) and len(v) == 2},
                "jam_density": {
                    "theory_kj_count": round(
                        float(sd_curves.get("_theory_kj_cnt", float("nan"))), 4),
                    "theory_kj_veh_km_lane": round(
                        float(sd_curves.get("_theory_kj_real", float("nan"))), 1),
                    "density_scale_count_to_real": round(
                        float(sd_curves.get("_density_scale", float("nan"))), 1),
                    "per_class": sd_curves.get("_diag", {}),
                },
                "lookup_classes": sorted(prop_lookup.keys()),
                "forms": {k: {
                    kk: (vv[2] if vv is not None else None)
                    for kk, vv in v.items() if kk in ("speed", "prop")}
                    for k, v in (sd_forms or {}).items()},
            }
            print(f"   [sd] speed-density classes: "
                  f"{sorted(sd_curves)} | "
                  f"propensity classes: {sorted(prop_lookup)}")
        except Exception as exc:  # noqa: BLE001 - SD is auxiliary
            print(f"   WARN: SD calibration failed ({exc}); "
                  "continuing without it")
            sd_curves, prop_lookup, sd_forms = None, None, {}
            audit["sd"] = {"error": str(exc)}
    # SD lift calibration: fit lift_obs = a + b*lift_sd on TRAIN fixtures
    # (observed window counts vs background expectation; twin rerun on
    # observed flow) BEFORE train_events/background are merged and freed.
    # Applied to future SD columns in predict_future_chunked; on any failure
    # (a,b) = (0,1) i.e. the uncalibrated twin stands.
    _sd_a, _sd_b, _sd_se, _sd_p, _sd_tab, _sd_note = \
        (0.0, 1.0, float("nan"), float("nan"), pd.DataFrame(), "skipped")
    if (sd_curves is not None and prop_lookup is not None
            and not getattr(args, "no_sd", False)):
        try:
            _sd_a, _sd_b, _sd_se, _sd_p, _sd_tab, _sd_note = calibrate_sd_lift(
                train_events, background, args.target, sd_curves,
                prop_lookup, sd_forms,
                flow_uplift, demand_eta_raw_by_phase, crowd_med)
        except Exception as exc:  # noqa: BLE001
            _sd_note = f"call failed: {exc}"
    audit["sd_lift_calibration"] = {
        "a": round(float(_sd_a), 4), "b": round(float(_sd_b), 4),
        "se_b": round(float(_sd_se), 4) if np.isfinite(_sd_se) else None,
        "p_b": round(float(_sd_p), 4) if np.isfinite(_sd_p) else None,
        "n_fixtures": int(len(_sd_tab)), "note": str(_sd_note)[:200],
        "train_lift": {str(k): {"obs": round(float(v["lift_obs"]), 4),
                                "sd": round(float(v["lift_sd"]), 4)}
                       for k, v in _sd_tab.iterrows()} if len(_sd_tab) else {}}
    print(f"   SD lift calibration: lift_obs = {_sd_a:.3f} + {_sd_b:.3f}*lift_sd "
          f"(se={_sd_se:.3f} p={_sd_p:.3g} n={len(_sd_tab)}; {_sd_note})")
    # A huge |b| is the tell that the twin carries no cross-game signal: we
    # are regressing observed variation on near-noise, so the intercept eats
    # the mean and the slope does the work. Report it explicitly and let the
    # caller decide; do NOT silently apply an amplified slope.
    if np.isfinite(_sd_se) and np.isfinite(_sd_b) and abs(_sd_se) > 0:
        _tstat = abs(_sd_b / max(_sd_se, 1e-12))
        _informative = bool(_tstat >= 2.0 and abs(_sd_b) <= 2.0
                            and len(_sd_tab) >= 5)
        audit["sd_lift_calibration"]["slope_t"] = round(float(_tstat), 3)
        audit["sd_lift_calibration"]["usable"] = _informative
        if not _informative:
            print(f"   SD calibration NOT applied (slope { _sd_b:+.2f} on "
                  f"|t|={_tstat:.1f}: the twin's cross-game lift is "
                  f"uninformative, so scaling it would inject noise). "
                  f"Keeping the uncalibrated twin.")
            audit["sd_lift_calibration"]["applied"] = False
            _sd_a, _sd_b = 0.0, 1.0
        else:
            audit["sd_lift_calibration"]["applied"] = True
    else:
        audit["sd_lift_calibration"]["usable"] = False
        audit["sd_lift_calibration"]["applied"] = False
        _sd_a, _sd_b = 0.0, 1.0
    train_frame = pd.concat([train_events, background], ignore_index=True)
    del train_events, background
    # Calibrate the flow proxy onto the observed trip denominator BEFORE the
    # row cap, so the per-segment ratios see the full event+background set.
    # Estimated on the same rows and then frozen; the future path applies the
    # same ratios to its predicted exp.
    exp_cal = None
    if str(getattr(args, "exposure_calibration", "off")) != "off":
        exp_cal = fit_exposure_calibration(
            train_frame, k_seg=float(getattr(args, "calib_k_seg", 8.0)),
            k_cell=float(getattr(args, "calib_k_cell", 40.0)))
        if exp_cal is not None:
            train_frame = calibrate_exposure(train_frame, exp_cal)
        audit["exposure_calibration"] = (
            "on" if exp_cal is not None else "requested-but-unavailable")
        audit["exposure_calib_segments"] = (
            int(exp_cal["n_segments"]) if exp_cal else 0)
    else:
        audit["exposure_calibration"] = "off"
        audit["exposure_calib_segments"] = 0
    # Printed in BOTH cases, not only when the flag is on: the audit dict is
    # only ever written to game_day_holdout_metrics.json and never reaches
    # stdout, so a log-based test harness cannot see the status otherwise.
    print(f"   exposure calibration: {audit['exposure_calibration']} "
          f"({audit['exposure_calib_segments']:,} segments)")
    if len(train_frame) > train_cap:
        train_frame = train_frame.sample(train_cap, random_state=args.seed)
    work = search_frame(train_frame, args.target)
    del train_frame
    from metacount_nb import prepare_metacount_frame
    work, _ = prepare_metacount_frame(work, exposure_col="exp",
                                      highway_col="highway")
    # Exposure shape is added AFTER prepare_metacount_frame because the
    # road-class interactions need the hw_ dummies it creates. Knots are
    # frozen here and stashed on args for the future path, so both use the
    # identical basis.
    _shape = str(getattr(args, "exposure_basis", "none"))
    work, exp_shape_params = add_exposure_shape(
        work, params=None,
        hinge=_shape in ("hinge", "hinge+hw"),
        interact_hw=_shape in ("hinge+hw", "linear+hw", "hw"))
    if exp_shape_params:
        args._exp_shape_params = exp_shape_params
    audit["exposure_basis"] = _shape
    audit["exposure_hinge_knots"] = (
        [round(float(k), 4) for k in exp_shape_params["knots"]]
        if exp_shape_params and exp_shape_params.get("knots") else [])
    audit["exposure_shape_cols"] = [
        c for c in work.columns
        if c.startswith("logexp_h") or c.startswith("logexp_x_")]
    print(f"   exposure basis: {_shape}  shape cols="
          f"{len(audit['exposure_shape_cols'])}")
    audit["n_train_rows"] = int(len(work))
    print(f"   train rows={len(work):,} (panel kept for future frames; "
          "background sampled, never materialised in full)")
    _clear_jax_caches()

    print("[59/3] metacountregressor structural search...")
    resume_state = None
    if args.resume and BEST_JSON.exists():
        try:
            resume_state = json.loads(BEST_JSON.read_text())
            if resume_state.get("target") != args.target:
                print(f"   WARN: ignoring stale search checkpoint target="
                      f"{resume_state.get('target')!r}; requested {args.target!r}")
                resume_state = None
            elif int(resume_state.get("search_gen", 0)) != int(SEARCH_GEN):
                # Candidate set / constraints changed shape (e.g. wide game
                # block, AR stage): old warm starts and specs are unusable.
                print(f"   WARN: checkpoint search_gen="
                      f"{resume_state.get('search_gen')} != {SEARCH_GEN}; "
                      "starting fresh")
                resume_state = None
            elif not args.no_force_game:
                # Pre-forced-game checkpoints (e.g. BIC=18327 static spec)
                # lack the game block: re-search rather than re-freeze them.
                _rs_fixed = ((resume_state.get("best_spec") or {})
                             .get("fixed_terms", []))
                if not set(force_terms(work, args)) <= set(_rs_fixed):
                    print("   WARN: checkpoint predates forced game dynamics "
                          f"(fixed={_rs_fixed}); discarding resume so the "
                          "search re-runs with the game block forced")
                    resume_state = None
                # --group-temporal changes the ROLE SET a temporal term may
                # take, so a checkpoint made under the other setting is a
                # different search space. Reusing it would silently compare
                # incomparable BICs.
                _rs_gt = bool(resume_state.get("group_temporal"))
                _want_gt = (str(getattr(args, "group_temporal", "off"))
                            .lower() == "on")
                if _rs_gt != _want_gt:
                    print("   WARN: checkpoint was searched with "
                          f"group_temporal={_rs_gt}, now {_want_gt}; "
                          "starting fresh")
                    resume_state = None
        except Exception as exc:  # noqa: BLE001
            print(f"   WARN: could not parse {BEST_JSON.name} ({exc}); "
                  "starting fresh")
            resume_state = None
    if resume_state is None and PROGRESS_CSV.exists():
        # Fresh (non-resumed) run: rotate the stale progress trace so the
        # convergence plot can't zigzag across runs (x would jump 80->20).
        try:
            import time as _t
            _bak = PROGRESS_CSV.with_name(
                "game_day_search_progress.bak_"
                f"{_t.strftime('%Y%m%d_%H%M%S')}.csv")
            PROGRESS_CSV.rename(_bak)
            print(f"   rotated stale progress trace -> {_bak.name}")
        except Exception as exc:  # noqa: BLE001
            print(f"   WARN: progress rotation failed ({exc})")
    total_iters = int(args.search_iters)
    done_iters = int((resume_state or {}).get("iters_completed", 0) or 0)
    if resume_state and done_iters >= total_iters and resume_state.get("best_spec"):
        spec = resume_state.get("best_spec")
        best_bic = resume_state.get("best_bic")
        variables = resume_state.get("variables", [])
        audit["search"] = {"resumed": True, "best_bic": best_bic,
                           "done_iters": done_iters,
                           "total_iters": total_iters, "complete": True}
        print(f"   resumed spec (BIC={best_bic}, "
              f"iters {done_iters}/{total_iters} complete)")
    else:
        spec, best_bic, variables, engine_used, done_iters, complete = \
            run_search(work, args, audit, out_dir, resume_state)
        print(f"   best BIC={best_bic} ({done_iters}/{total_iters} iters, "
              f"complete={complete})")

    spec = ensure_spec(spec, work, audit,
                       force_game=not args.no_force_game,
                       keep_temporal=not getattr(args, "no_temporal_vars",
                                                 False),
                       args=args)
    print(f"   spec: fixed={len(spec.get('fixed_terms', []))} "
          f"rdm={len(spec.get('rdm_terms', []))} "
          f"fallback={audit.get('spec_fallback')}")
    print("[59/4] refit best spec + predict future games...")
    _rss_gb("pre-future-events")
    # Segment list first: after this the 64M-row panel is no longer needed
    # for the grid (grid = segs x 28 bins per fixture from ctx/seg_flow).
    segs = np.sort(panel["road_osmid"].unique())
    future_events = build_game_frame(panel, bin_ns, cal, ctx, seg_flow, profile,
                                     future_ids, crowd_med=crowd_med)
    if future_events.empty:
        raise SystemExit("no future event rows; check panel coverage")
    # Trust the frame, not the calendar: some future windows may have no
    # panel coverage and drop out, and the metrics/MIP iterate this set.
    future_ids = set(future_events["fixture"].unique())
    audit["n_future_fixtures"] = len(future_ids)
    audit["future_fixture_ids"] = sorted(future_ids)
    if not future_ids:
        raise SystemExit("no future fixtures survived panel coverage")
    # Light observed frame for metrics; drop the heavy enriched frame AND
    # the full panel before any JAX allocation or grid build.
    _obs_cols = ["fixture", "road_osmid", "bin", args.target]
    if "vehicle_count" in future_events.columns:
        _obs_cols.append("vehicle_count")
    obs_light = future_events[_obs_cols].copy()
    obs_light = obs_light.rename(columns={args.target: "observed"})
    if "vehicle_count" in obs_light.columns:
        obs_light = obs_light.rename(columns={"vehicle_count": "obs_flow"})
    del future_events
    del panel, bin_ns, covered
    gc.collect()
    _clear_jax_caches()
    _rss_gb("post-panel-free")
    # Keyed on fixture_id so a 2025 twin of a "future" label cannot be
    # dragged back in as a prediction row.
    future_cal = cal[cal["fixture_id"].isin(future_ids)].sort_values(
        "ko").reset_index(drop=True)
    if len(future_cal) != len(future_ids):
        raise SystemExit(
            f"FATAL: future_cal has {len(future_cal)} rows for "
            f"{len(future_ids)} fixture_ids; label collision persists")
    info = refit_only(work, spec, args, audit)
    _rss_gb("post-refit")
    # Optional significance pruning. The forced game block guarantees the
    # model CAN reorder segments by fixture, but it also guarantees that
    # terms the data does not support stay in. This drops count-model fixed
    # terms with p > --prune-p (exposure never dropped), refits once, and
    # the two-stage block below then prunes the propensity on the same rule.
    # The handoff gate is the arbiter: if pruning removes the game-specific
    # signal the gate fails and the run reports it.
    _prune_p = float(getattr(args, "prune_p", 0.0) or 0.0)
    audit["prune_p"] = _prune_p
    # The propensity is a DIFFERENT model from the count refit and must be
    # pruned on its own p-values: collinearity among the game terms means a
    # term can be insignificant in the count fit and significant in the
    # propensity (event_x_dist does exactly this). Keep the full design here
    # and let prune_propensity() backward-eliminate below.
    _fixed_full = list(spec.get("fixed_terms", []))
    if _prune_p > 0:
        try:
            _dropped_all = []
            _pvals = {}
            for _round in range(5):
                _co = info.get("coef")
                _pmap = {}
                if _co is not None and "p_value" in getattr(_co, "columns", []):
                    _pmap = {str(v): float(p) for v, p in
                             zip(_co["variable"], _co["p_value"])
                             if np.isfinite(p)}
                _fixed = list(spec.get("fixed_terms", []))
                # GAME_FORCE + exposure are never pruned (same reason as in
                # prune_propensity: rare-event SEs would delete the game
                # block and ship a static surface).
                _kept = [c for c in _fixed
                         if c == "logexp" or c in GAME_FORCE
                         or _pmap.get(c) is None
                         or _pmap.get(c) <= _prune_p]
                _dropped = [c for c in _fixed if c not in _kept]
                _pvals.update({c: _pmap.get(c) for c in _fixed})
                if not _dropped or not _kept:
                    break
                if _round == 0:
                    audit["refit_full"] = audit.get("refit")
                _dropped_all.extend(_dropped)
                spec = dict(spec)
                spec["fixed_terms"] = _kept
                info = refit_only(work, spec, args, audit)
            audit["pruned_refit"] = {
                "dropped": _dropped_all,
                "kept": list(spec.get("fixed_terms", [])),
                "p_threshold": _prune_p, "p_values": _pvals}
            if _dropped_all:
                print(f"   [prune] count model: dropped "
                      f"{len(_dropped_all)} insignificant term(s) "
                      f"{_dropped_all}; kept {len(spec['fixed_terms'])}")
            else:
                print("   [prune] count model: nothing to drop")
        except Exception as exc:  # noqa: BLE001
            print(f"   WARN: count-model pruning failed ({exc})")
    # Report the free exposure coefficient with its SE BEFORE the LRT, so the
    # log shows the magnitude of the departure from 1.0 alongside the chi2.
    # In free mode this is the coefficient the LRT is testing; in offset mode
    # logexp is pinned and the report says so explicitly.
    try:
        report_exposure_coefficient(info, audit, label="shipped refit")
    except Exception as exc:  # noqa: BLE001 - reporting must not kill a run
        print(f"   WARN: exposure coefficient report failed ({exc})")
    # Binomial refit of the same design under a different likelihood, so the
    # two can be compared on the same holdout. Reported, never shipped in
    # place of the count path.
    if str(getattr(args, "binomial_refit", "off") or "off").lower() == "on":
        try:
            _rb, _bo = refit_binomial(work, args, audit, spec=spec)
        except Exception as exc:  # noqa: BLE001
            print(f"   WARN: binomial refit failed ({exc})")
            _bo = {"available": False, "reason": str(exc)}
    # ------------------------------------------------------------ two-stage
    # Ship pred_speeding = E[denominator] x P(speeding) instead of the count
    # model on the TMR-projected exposure. Both stages must fit; any failure
    # falls back to the count surface and the handoff gate below reports the
    # consequence rather than the run silently degrading.
    two_stage_on = str(getattr(args, "two_stage", "on") or "on").lower() == "on"
    bayes_on = str(getattr(args, "bayes", "off") or "off").lower() == "on"
    flow_info, prop_fit = None, None
    prop_bayes, stage_a_bayes = None, None
    audit.setdefault("two_stage", {})["requested"] = bool(two_stage_on)
    audit["bayes"] = {"requested": bool(bayes_on),
                      "base_sd": float(getattr(args, "bayes_base_sd", 10.0)),
                      "draws": int(getattr(args, "bayes_draws", 50))}
    if two_stage_on:
        denom_col = binomial_denominator(args.target)
        flow_info = refit_denominator(work, denom_col, spec, args, audit)
        # Full pre-prune design: the propensity has its own significance and
        # is backward-eliminated on it (see _fixed_full above).
        _design = [c for c in _fixed_full if c in work.columns]
        prior = None
        if bayes_on:
            selected_sd = None
            if str(getattr(args, "bayes_game_prior", "on")).lower() == "on":
                best, table = select_propensity_prior(
                    work, args, audit, spec, _design)
                audit["bayes"]["prior_selection"] = table
                if best is not None:
                    selected_sd = best[0]
            prior = bayes_prior_dict(
                _design, game_sd=selected_sd,
                base_sd=float(getattr(args, "bayes_base_sd", 10.0)))
            audit["bayes"]["selected_game_sd"] = selected_sd
            print(f"   [bayes] game-interaction prior sd by Laplace "
                  f"evidence: {selected_sd}")
        try:
            prop_fit, _po = refit_binomial(
                work, args, audit, spec=spec,
                label="two-stage propensity", design_cols=_design,
                audit_key="propensity", prior_sd=prior)
        except Exception as exc:  # noqa: BLE001
            print(f"   WARN: propensity fit failed ({exc})")
            prop_fit = None
        if _prune_p > 0 and prop_fit is not None:
            try:
                prop_fit, _pr = prune_propensity(
                    work, args, spec, _design, prop_fit, _prune_p,
                    prior_sd=prior)
                audit["two_stage"]["pruned_propensity"] = _pr
                if _pr["dropped"]:
                    print(f"   [prune] propensity: dropped "
                          f"{len(_pr['dropped'])} term(s) {_pr['dropped']}; "
                          f"kept {_pr['kept']}")
                else:
                    print("   [prune] propensity: nothing to drop")
            except Exception as exc:  # noqa: BLE001
                print(f"   WARN: propensity pruning failed ({exc})")
        if bayes_on and prop_fit is not None:
            _S = max(4, int(getattr(args, "bayes_draws", 50)))
            prop_bayes = {"model": prop_fit, "draws": _S,
                          "seed": int(args.seed)}
            if flow_info is not None:
                stage_a_bayes = {"info": flow_info, "draws": _S,
                                 "seed": int(args.seed) + 1}
            audit["bayes"]["shipped"] = True
            audit["bayes"]["propensity_posterior_sd"] = {
                c: round(float(sd), 5) for c, sd
                in zip(prop_fit["names"], prop_fit["se"])
                if c in ("(intercept)", "logexp", "in_event", "rel_hour",
                         "log_att", "event_x_dist", "att_x_dist",
                         "rel_x_dist", "ev_x_lanes")}
            print(f"   [bayes] posterior draws: S={_S}, shipped surface is "
                  "the posterior mean; lo/hi at 5/95%")
        audit["two_stage"].update({
            "shipped": bool(flow_info is not None and prop_fit is not None),
            "denominator": denom_col,
            "propensity_design": _design,
            "bayes": bool(bayes_on and prop_fit is not None),
        })
        if flow_info is None or prop_fit is None:
            print("   [two-stage] *** FALLBACK: shipping the count surface; "
                  "the handoff gate records the consequence ***")
        else:
            print(f"   [two-stage] shipping pred = {denom_col} x propensity "
                  f"({len(_design)} design terms)")
    # Nested LRT on the exposure parameterisation. Runs AFTER the shipped
    # refit so the panel is already freed and the work frame is the only
    # thing alive. Doubles the refit cost, hence opt-in.
    if str(getattr(args, "exposure_lrt", "off") or "off").lower() == "on":
        _exposure_lrt(work, spec, args, audit, info)
        _clear_jax_caches()
    # Stage 2b dynamics source (--temporal-mode). 'ar1': NB2 + AR refit
    # (needs metacountregressor>=1.0.165; JAX path continues regardless).
    # 'flow' (default): skip the AR fit -- it adds zero holdout skill to
    # date -- and use the flow-driven calibrated-SD game surface as the
    # temporal surface instead. 'off': no temporal surface at all.
    _tmode = str(getattr(args, "temporal_mode", "flow") or "flow").lower()
    audit["temporal_mode"] = _tmode
    print(f"[59/4b] temporal mode: {_tmode}...")
    temporal_fit = None
    if _tmode == "ar1":
        temporal_fit = fit_temporal_stage(temporal_snapshot, spec, work,
                                          args, audit, args.target)
    else:
        audit["temporal_stage"] = {
            "attempted": False,
            "disabled": True,
            "mode": _tmode,
            "note": ("AR fit skipped: flow-driven calibrated-SD surface "
                     "used as temporal surface"
                     if _tmode == "flow" else "no temporal surface"),
        }
        print(f"   [temporal] AR refit skipped (mode={_tmode})")
    del temporal_snapshot
    gc.collect()
    out = predict_future_chunked(info, future_cal, segs, ctx, seg_flow,
                                 profile, work, args,
                                 flow_uplift=flow_uplift,
                                 flow_uplift_by_hw=flow_uplift_by_hw,
                                 crowd_med=crowd_med,
                                 temporal_fit=temporal_fit,
                                 seg_risk_map=seg_risk_map,
                                 clock_prof=clock_prof,
                                 exp_cal=exp_cal,
                                 flow_info=flow_info,
                                 prop_fit=prop_fit,
                                 prop_bayes=prop_bayes,
                                 stage_a_bayes=stage_a_bayes,
                                 seg_event_uplift_map=seg_event_uplift_map,
                                 flow_anom_by_fixture=flow_anom_fx,
                                 wmap=wmap, wstats=wstats,
                                 sd_curves=sd_curves,
                                 prop_lookup=prop_lookup,
                                 sd_forms=sd_forms,
                                 demand_eta=demand_eta,
                                 demand_att_ref=crowd_med,
                                 demand_eta_by_phase=demand_eta_by_phase,
                                 demand_eta_raw_by_phase=demand_eta_raw_by_phase,
                                 demand_eta_raw=demand_eta_raw,
                                 sd_lift_cal=(float(_sd_a), float(_sd_b)),
                                 seg_event_uplift=seg_event_uplift_map,
                                 seg_eta_ratio=seg_eta_ratio,
                                 audit=audit)
    if getattr(args, "_bayes_stage_a_cov", None) is not None:
        audit["bayes"]["stage_a_fixed_se_coverage"] = args._bayes_stage_a_cov
    del segs, future_cal
    gc.collect()
    out.to_parquet(out_dir / "game_day_pred_15min.parquet", index=False)
    # Print the path that was ACTUALLY written. This message used to claim
    # "results/game_day_pred_15min.parquet" while the only file touched was
    # the per-run out_dir copy, which led to stage 60 being pointed at a
    # stale shared parquet (dated 29 Aug) instead of the run just finished.
    print(f"   predictions: {len(out):,} rows -> "
          f"{out_dir / 'game_day_pred_15min.parquet'}")

    print("[59/5] future-game metrics + figures...")
    obs = obs_light
    del obs_light
    merged = out.merge(obs, on=["fixture", "road_osmid", "bin"], how="inner")
    del obs
    metrics = {"n_future_rows": int(len(out)),
               "n_observed_rows": int(len(merged))}
    if len(merged) > 10:
        metrics["bin_spearman"] = _spearman(merged["observed"],
                                            merged["pred_speeding"])
        metrics["rmse"] = float(np.sqrt(np.mean(
            (merged["observed"] - merged["pred_speeding"]) ** 2)))
        metrics["mae"] = float(np.mean(np.abs(
            merged["observed"] - merged["pred_speeding"])))
        slope, intercept = _calibration(merged["observed"],
                                        merged["pred_speeding"])
        metrics["calibration_slope"] = slope
        metrics["calibration_intercept"] = intercept
        seg_pred = merged.groupby(["fixture", "road_osmid"])["pred_speeding"].sum()
        seg_obs = merged.groupby(["fixture", "road_osmid"])["observed"].sum()
        seg = pd.concat([seg_pred.rename("pred"), seg_obs.rename("obs")], axis=1)
        metrics["segment_spearman"] = _spearman(seg["obs"], seg["pred"])
        metrics["segment_top20"] = _jaccard_topk(seg["obs"], seg["pred"], 20)
        metrics["segment_top50"] = _jaccard_topk(seg["obs"], seg["pred"], 50)
        # Head-to-head against the count surface when the two-stage shipped,
        # so the replacement is judged on the same rows it replaced.
        if "pred_speeding_count" in merged.columns:
            try:
                _cp = merged.groupby(["fixture", "road_osmid"])[
                    "pred_speeding_count"].sum()
                _co = merged.groupby(["fixture", "road_osmid"])["observed"].sum()
                metrics["count_bin_spearman"] = _spearman(
                    merged["observed"], merged["pred_speeding_count"])
                metrics["count_segment_spearman"] = _spearman(_co, _cp)
                metrics["count_segment_top20"] = _jaccard_topk(
                    _co, _cp, 20)
            except Exception as exc:  # noqa: BLE001
                print(f"   WARN: count-surface comparison failed ({exc})")
        # Plug-in vs approximate-Bayes posterior, on the same holdout rows.
        if "pred_speeding_plugin" in merged.columns:
            try:
                _pp = merged.groupby(["fixture", "road_osmid"])[
                    "pred_speeding_plugin"].sum()
                _po2 = merged.groupby(["fixture", "road_osmid"])[
                    "observed"].sum()
                metrics["plugin_bin_spearman"] = _spearman(
                    merged["observed"], merged["pred_speeding_plugin"])
                metrics["plugin_segment_spearman"] = _spearman(_po2, _pp)
                metrics["plugin_segment_top20"] = _jaccard_topk(
                    _po2, _pp, 20)
                _s_p, _i_p = _calibration(
                    merged["observed"], merged["pred_speeding_plugin"])
                metrics["plugin_calibration_slope"] = _s_p
            except Exception as exc:  # noqa: BLE001
                print(f"   WARN: plugin comparison failed ({exc})")
        if "pred_propensity_sd" in merged.columns:
            metrics["bayes_propensity_sd_mean"] = float(pd.to_numeric(
                merged["pred_propensity_sd"], errors="coerce").mean())
        if ("pred_speeding_lo" in merged.columns
                and "pred_speeding_hi" in merged.columns):
            _lo = pd.to_numeric(merged["pred_speeding_lo"], errors="coerce")
            _hi = pd.to_numeric(merged["pred_speeding_hi"], errors="coerce")
            _ob = pd.to_numeric(merged["observed"], errors="coerce")
            metrics["bayes_interval_90_coverage"] = float(
                ((_ob >= _lo) & (_ob <= _hi)).mean())
        # Joint-model diagnostics: flow stage + residual serial correlation.
        # The NB panel has no AR(1) term; |resid_lag1| >> 0 means temporal
        # persistence is left on the table (segment grouping only gives
        # compound symmetry, not decay).
        if "obs_flow" in merged.columns and "pred_flow" in merged.columns:
            metrics["flow_spearman"] = _spearman(merged["obs_flow"],
                                                merged["pred_flow"])
            metrics["flow_mae"] = float(np.mean(np.abs(
                merged["obs_flow"] - merged["pred_flow"])))
        try:
            _m = merged.sort_values(["fixture", "road_osmid", "rel_bin"])
            _r = (_m["observed"] - _m["pred_speeding"]).to_numpy(float)
            _g = (_m["fixture"].astype(str) + "|" +
                  _m["road_osmid"].astype(str)).to_numpy()
            _num, _den, _n = 0.0, 0.0, 0
            for _k in np.unique(_g):
                _rr = _r[_g == _k]
                if len(_rr) >= 4 and np.isfinite(_rr).all():
                    _z = _rr - _rr.mean()
                    _num += float((_z[:-1] * _z[1:]).sum())
                    _den += float((_z ** 2).sum())
                    _n += 1
            metrics["resid_lag1"] = float(_num / max(_den, 1e-12))
            metrics["resid_lag1_groups"] = int(_n)
        except Exception:
            metrics["resid_lag1"] = float("nan")
    try:
        # Concentration guard: one segment must not hog predicted mass
        # (o25899100: a single 45 m osmid held 84% -> degenerate MIP).
        _seg_tot = (out.groupby("road_osmid")["pred_speeding"].sum()
                    .sort_values(ascending=False))
        _top1 = float(_seg_tot.iloc[0] / max(_seg_tot.sum(), 1e-12))
        metrics["top1_share"] = round(_top1, 4)
        metrics["top1_osmid"] = int(_seg_tot.index[0])
        metrics["top5_share"] = round(
            float(_seg_tot.iloc[:5].sum() / max(_seg_tot.sum(), 1e-12)), 4)
        audit["concentration"] = {"top1_share": metrics["top1_share"],
                                  "top1_osmid": metrics["top1_osmid"],
                                  "top5_share": metrics["top5_share"]}
        if _top1 > 0.25:
            print(f"   WARN: concentrated predictions: segment "
                  f"{metrics['top1_osmid']} holds {_top1:.1%} of predicted "
                  "speeding; MIP coverage will be degenerate (60 gate refuses "
                  "above 50% without --allow-concentrated)")
    except Exception as exc:  # noqa: BLE001
        print(f"   WARN: concentration check failed ({exc})")
    if "pred_speeding_temporal" in merged.columns:
        # Stage 2b head-to-head on the same holdout bins.
        try:
            tp = merged["pred_speeding_temporal"].to_numpy(float)
            ob = merged["observed"].to_numpy(float)
            metrics["temporal_bin_spearman"] = _spearman(ob, tp)
            metrics["temporal_rmse"] = float(
                np.sqrt(np.mean((ob - tp) ** 2)))
            _sp = merged.groupby(["fixture", "road_osmid"])[
                "pred_speeding_temporal"].sum()
            _so = merged.groupby(["fixture", "road_osmid"])["observed"].sum()
            _sg = pd.concat([_sp.rename("pred"), _so.rename("obs")], axis=1)
            metrics["temporal_segment_spearman"] = _spearman(
                _sg["obs"], _sg["pred"])
            metrics["temporal_segment_top20"] = _jaccard_topk(
                _sg["obs"], _sg["pred"], 20)
            print(f"   temporal surface: spearman="
                  f"{metrics['temporal_bin_spearman']:.3f} rmse="
                  f"{metrics['temporal_rmse']:.3f} seg_top20="
                  f"{metrics['temporal_segment_top20']:.3f}")
        except Exception as exc:  # noqa: BLE001
            print(f"   WARN: temporal metrics failed ({exc})")
    if "game_lift" in merged.columns and "pred_nogame" in merged.columns:
        # Game-vs-not accounting from the counterfactual twin: share of
        # predicted speeding attributable to the game being on.
        try:
            _lift = pd.to_numeric(merged["game_lift"],
                                  errors="coerce").fillna(0.0)
            _pred = pd.to_numeric(merged["pred_speeding"],
                                  errors="coerce").fillna(0.0)
            metrics["game_lift_share"] = round(
                float(_lift.sum() / max(_pred.sum(), 1e-12)), 4)
            _fx = merged.groupby("fixture")[["game_lift",
                                             "pred_speeding"]].sum()
            _fx["lift_share"] = (_fx["game_lift"]
                                 / _fx["pred_speeding"].clip(lower=1e-12))
            metrics["game_lift_share_by_fixture"] = {
                str(k): round(float(v), 4)
                for k, v in _fx["lift_share"].items()}
            print(f"   game lift: pooled share="
                  f"{metrics['game_lift_share']:.3f} by-fixture="
                  f"{metrics['game_lift_share_by_fixture']}")
        except Exception as exc:  # noqa: BLE001
            print(f"   WARN: game-lift metrics failed ({exc})")
    if "sd_lift" in merged.columns:
        # SD twin head-to-head: same demand experiment, structural
        # identification (density-mediated) vs regression identification.
        try:
            _sl = pd.to_numeric(merged["sd_lift"],
                                errors="coerce").fillna(0.0)
            _sp = pd.to_numeric(merged["pred_sd_game"],
                                errors="coerce").fillna(0.0)
            metrics["sd_lift_share"] = round(
                float(_sl.sum() / max(_sp.sum(), 1e-12)), 4)
            _gl = pd.to_numeric(merged["game_lift"],
                                errors="coerce").fillna(0.0)
            _m = np.isfinite(_sl.to_numpy()) & np.isfinite(_gl.to_numpy())
            metrics["sd_vs_reg_lift_corr"] = round(float(
                np.corrcoef(_sl.to_numpy()[_m],
                            _gl.to_numpy()[_m])[0, 1])
                if _m.sum() > 10 else float("nan"), 4)
            print(f"   SD lift: pooled share="
                  f"{metrics['sd_lift_share']:.3f} corr(SD, regression)="
                  f"{metrics['sd_vs_reg_lift_corr']:.3f}")
            if "sd_lift_cal" in merged.columns:
                # Calibrated twin head-to-head (same demand experiment).
                # Correlation at FIXTURE level (share vs share): row-level
                # corr mixes within-fixture scale with between-fixture lift.
                try:
                    _slc = pd.to_numeric(merged["sd_lift_cal"],
                                         errors="coerce").fillna(0.0)
                    _spc = pd.to_numeric(
                        merged.get("pred_sd_game_cal",
                                   merged["pred_sd_game"]),
                        errors="coerce").fillna(0.0)
                    metrics["sd_lift_share_cal"] = round(
                        float(_slc.sum() / max(_spc.sum(), 1e-12)), 4)
                    _fc = merged.groupby("fixture").agg(
                        _s=("sd_lift_cal", "sum"),
                        _g=("pred_sd_game_cal"
                            if "pred_sd_game_cal" in merged.columns
                            else "pred_sd_game", "sum"),
                        _r=("game_lift", "sum"),
                        _p=("pred_speeding", "sum"))
                    _fsh = (_fc["_s"] / _fc["_g"].clip(lower=1e-12)).to_numpy()
                    _frh = (_fc["_r"] / _fc["_p"].clip(lower=1e-12)).to_numpy()
                    _mm = np.isfinite(_fsh) & np.isfinite(_frh)
                    metrics["corr_sd_cal_vs_reg"] = round(float(
                        np.corrcoef(_fsh[_mm], _frh[_mm])[0, 1])
                        if _mm.sum() > 3 else float("nan"), 4)
                    print(f"   SD lift (calibrated): pooled share="
                          f"{metrics['sd_lift_share_cal']:.3f} "
                          f"corr(cal SD, regression)="
                          f"{metrics['corr_sd_cal_vs_reg']:.3f} "
                          f"(fixture-level, n={int(_mm.sum())})")
                except Exception as exc:  # noqa: BLE001
                    print(f"   WARN: calibrated-SD metrics failed ({exc})")
        except Exception as exc:  # noqa: BLE001
            print(f"   WARN: SD metrics failed ({exc})")
    audit["metrics"] = metrics

    # ---------------------------------------------------------------- structure
    # Can this fitted surface produce a GAME-SPECIFIC plan, or is its site
    # ranking identical for every fixture?
    #
    # WHY THIS IS MEASURED EVERY RUN. Job 26107921 produced a surface whose
    # top-10 and top-20 site sets were 100% identical across all six games,
    # with 87.8% of the variance between segments and only 3.2% between
    # fixtures, so the MIP could only ever return the same streets. Nothing in
    # the pipeline reported that: the run exited 0 and every artefact existed.
    # A "game-day" deployment that does not vary by game is not game-day, so
    # the property is now recorded and gated rather than assumed.
    try:
        audit["fixture_variation"] = _fixture_variation(out)
        fv = audit["fixture_variation"]
        print("   surface structure: %s" % json.dumps(
            {k: fv.get(k) for k in ("n_fixtures", "variance_between_fixtures_pct",
                                    "site_overlap_jaccard",
                                    "unique_argmax_sites",
                                    "game_specific_ranking")},
            default=str))
        if fv.get("site_overlap_jaccard", {}).get("top20") == 1.0:
            print("   WARN: the top-20 site set is IDENTICAL for every fixture;"
                  " the deployment would be a static street list. The model"
                  " cannot reorder segments by game (see GAME_FORCE).")
    except Exception as exc:  # noqa: BLE001
        print(f"   WARN: fixture-variation audit failed ({exc})")
        audit["fixture_variation"] = {"error": f"{type(exc).__name__}: {exc}"}

    # ------------------------------------------------------------ handoff
    # The MIP is a maximal-covering solve on pred_speeding, so the surface is
    # only usable if (a) it ranks observed segments positively WITHIN each
    # fixture, (b) the ranking differs BETWEEN fixtures, and (c) it is
    # calibrated. Every prior metric could pass while all three failed
    # (26107921: identical site sets, per-fixture r < 0). Stage 61 refuses a
    # surface that fails this gate unless ALLOW_WEAK_SURFACE=1.
    try:
        audit["handoff"] = compute_handoff(merged, out, metrics)
        _h = audit["handoff"]
        print("   handoff: %s" % json.dumps(
            {k: _h.get(k) for k in (
                "n_fixtures", "pearson_min", "pearson_mean",
                "top20_coverage_mean", "top20_jaccard",
                "positive_ranking", "game_specific", "calibrated", "pass")},
            default=str))
        if not _h.get("pass"):
            print("   WARN: HANDOFF GATE FAILED (positive_ranking="
                  f"{_h.get('positive_ranking')}, game_specific="
                  f"{_h.get('game_specific')}, calibrated="
                  f"{_h.get('calibrated')}); stage 60 refuses this surface "
                  "unless ALLOW_WEAK_SURFACE=1")
    except Exception as exc:  # noqa: BLE001
        print(f"   WARN: handoff audit failed ({exc})")
        audit["handoff"] = {"error": f"{type(exc).__name__}: {exc}",
                            "pass": False}

    (out_dir / "game_day_holdout_metrics.json").write_text(
        json.dumps({"metrics": metrics, "audit": audit}, indent=2, default=str))

    coefs = info.get("coef")
    if coefs is not None and len(coefs):
        coefs.to_csv(out_dir / "game_day_model_coefs.csv", index=False)
    # SD showcase figure (loop schematic + fitted forms + produced lift).
    # Own guard: cosmetic failure must not touch the shipped surface.
    sd_fig_name = None
    if not getattr(args, "no_sd", False):
        try:
            _sdp = Path(fig_dir) / "game_day_sd_loop.png"
            make_sd_figure(out, sd_curves, prop_lookup, sd_forms,
                           flow_uplift, demand_eta, crowd_med, metrics,
                           _sdp)
            sd_fig_name = "game_day_sd_loop.png"
            print(f"   SD showcase -> {sd_fig_name}")
        except Exception as exc:  # noqa: BLE001
            print(f"   WARN: SD showcase figure failed ({exc})")
    with open(out_dir / "game_day_predict.tex", "w") as tex:
        tex.write("% game_day_predict.tex - generated by 59_game_day_search_predict.py\n")
        tex.write(f"% best BIC: {best_bic}\n")
        for key, val in metrics.items():
            tex.write(f"% {key}: {val}\n")
        tex.write(f"% refit: {json.dumps(audit.get('refit', {}), default=str)}\n")
    # Math-programme fragment for the paper (written even when SD is off).
    try:
        _mp = write_math_program(out_dir, audit, metrics,
                                 sd_fig=sd_fig_name)
        print(f"   math programme -> {_mp.name}")
    except Exception as exc:  # noqa: BLE001 - paper asset must not kill run
        print(f"   WARN: math programme fragment failed ({exc})")

    try:
        import matplotlib
        matplotlib.use("Agg")
        import matplotlib.pyplot as plt
        import seaborn as sns

        sns.set_style("whitegrid")
        if PROGRESS_CSV.exists():
            prog = pd.read_csv(PROGRESS_CSV)
            if "timestamp_iso" in prog.columns:
                prog = prog.sort_values("timestamp_iso").reset_index(drop=True)
            # Generation-level traces from the per-chunk SearchOutputConfig
            # JSONs (finer than chunk bests; also exposes stalls where a
            # chunk evaluates nothing new).
            _traces = []
            try:
                import glob as _glob
                _chunk = int(prog["iters_completed"].diff().fillna(
                    prog["iters_completed"].iloc[:1]).median()
                    if len(prog) else 20) or 20
                for _jf in sorted(_glob.glob(str(out_dir / "search59"
                                                 / "game_day_count_sa_*.json")),
                                  key=lambda p: Path(p).stat().st_mtime):
                    try:
                        _r = json.load(open(_jf))["result"]
                        _st = _r.get("search_stats") or []
                        if isinstance(_st, dict):
                            _st = [ _st ]
                        _g = [(int(x.get("iter", i)),
                               float(x.get("best", float("nan"))),
                               float(x.get("temperature", float("nan"))))
                              for i, x in enumerate(_st)
                              if isinstance(x, dict)]
                        if _g:
                            _traces.append(_g)
                    except Exception:
                        continue
            except Exception:
                _traces = []
            fig, axes = plt.subplots(1, 3, figsize=(18, 4))
            if _traces:
                # Snapshot files carry 1 point (stalled chunk) or a full
                # per-generation trace; x is snapshot order in time, which
                # is monotone in search effort either way.
                _off = 0
                for _k, _g in enumerate(_traces):
                    _xs = list(range(_off, _off + len(_g)))
                    _ys = [g[1] for g in _g]
                    _cur = (_k == len(_traces) - 1)
                    axes[0].plot(_xs, _ys,
                                 "o-" if _cur else "o:",
                                 color="#0B6E4F" if _cur else "#9DBEAF",
                                 ms=4 if _cur else 2,
                                 label="latest chunk" if _cur else None)
                    _off += len(_g)
                axes[0].set_xlabel("search snapshots in time order")
                axes[0].set_title("Best BIC per recorded snapshot")
                axes[0].legend(fontsize=7)
            else:
                _breaks = [0] + [i for i in range(1, len(prog))
                                 if prog["iters_completed"].iloc[i]
                                 < prog["iters_completed"].iloc[i - 1]] + [len(prog)]
                for _a, _b in zip(_breaks[:-1], _breaks[1:]):
                    _seg = prog.iloc[_a:_b]
                    _cur = (_b == len(prog))
                    axes[0].plot(_seg["iters_completed"], _seg["best_bic"],
                                 "o-" if _cur else "o:",
                                 color="#0B6E4F" if _cur else "#9DBEAF",
                                 ms=5 if _cur else 3)
                axes[0].set_xlabel("search iterations")
                axes[0].set_title("Best BIC per chunk")
            axes[0].set_ylabel("best BIC")
            # New evaluator calls per chunk: zeros = stalled chunk (SA
            # re-walks cached solutions; evidence of premature convergence).
            try:
                _ev = pd.to_numeric(prog["n_cache_evals"],
                                    errors="coerce").fillna(0).to_numpy(float)
                _new = np.diff(np.concatenate([[0.0], _ev]))
                _new = np.maximum(_new, 0.0)
                axes[1].bar(np.arange(len(_new)), _new, color="#7A5195")
                axes[1].set_xlabel("chunk")
                axes[1].set_ylabel("new fitness evals")
                axes[1].set_title("Search effort per chunk "
                                  "(0 = stalled chunk)")
            except Exception:
                axes[1].axis("off")
            # Characteristic composition of the best spec per chunk:
            # stacked bars prove WHEN each kind of information
            # (telematics / weather / game / geometry...) entered.
            try:
                _fprog = pd.read_csv(FAMILY_CSV)
                _fams = [f for f in FAMILY_ORDER
                         if f"n_{f}" in _fprog.columns]
                _bot = np.zeros(len(_fprog))
                _cols = {"telematics": "#0B6E4F", "weather": "#3A86FF",
                         "game": "#E36414", "temporal": "#7A5195",
                         "geometry": "#9E9E9E", "calendar": "#FB8C00",
                         "other": "#D3D3D3"}
                for _f in _fams:
                    _v = pd.to_numeric(_fprog[f"n_{_f}"],
                                       errors="coerce").fillna(0).to_numpy(float)
                    axes[2].bar(np.arange(len(_v)), _v, bottom=_bot,
                                color=_cols.get(_f, "#D3D3D3"), label=_f)
                    _bot = _bot + _v
                axes[2].set_xlabel("chunk")
                axes[2].set_ylabel("terms in best spec")
                axes[2].set_title("Best-spec composition by characteristic")
                axes[2].legend(fontsize=6, ncols=2)
            except Exception:
                axes[2].axis("off")
            fig.suptitle("MetaCount structural search convergence",
                         fontsize=10)
            fig.tight_layout(rect=(0, 0, 1, 0.92))
            fig.savefig(fig_dir / "game_day_search_convergence.png", dpi=120)
            plt.close(fig)
        if len(merged) > 10:
            fig, ax = plt.subplots(figsize=(5.5, 5))
            ax.scatter(merged["pred_speeding"], merged["observed"], s=3,
                       alpha=0.25)
            lim = max(float(merged["pred_speeding"].max()),
                      float(merged["observed"].max()))
            ax.plot([0, lim], [0, lim], "r--", lw=1)
            ax.set_xlabel("predicted speeding trips (15-min bin)")
            ax.set_ylabel("observed speeding trips")
            ax.set_title(f"Future games: {metrics.get('bin_spearman', float('nan')):.3f} "
                         "Spearman")
            fig.tight_layout()
            fig.savefig(fig_dir / "game_day_calibration.png", dpi=120)
            plt.close(fig)
        # Per-game surfaces: vehicles vs speeding side by side, rows =
        # per-game top-20 segments ranked by speeding events (log scale so
        # non-hog segments stay visible).
        _dist = {}
        try:
            _dd = ctx[["road_osmid", "dist_stadium_km"]].copy()
            _dd["road_osmid"] = pd.to_numeric(_dd["road_osmid"], errors="coerce")
            _dist = dict(zip(_dd["road_osmid"].astype(np.int64),
                             pd.to_numeric(_dd["dist_stadium_km"], errors="coerce")))
        except Exception:  # noqa: BLE001 - distance is nice-to-have
            _dist = {}
        # Road names + segment midpoints from the OSM extract (for the
        # top-20 table: name and where along the segment).
        _nm, _mid = {}, {}
        try:
            import json as _js
            with open(DATA / "osm_roads_suncorp.geojson") as _gf:
                _gj = _js.load(_gf)
            for _ft in _gj.get("features", []):
                _pr = _ft.get("properties", {}) or {}
                try:
                    _oid = int(float(_pr.get("osmid")))
                except (TypeError, ValueError):
                    continue
                _n = str(_pr.get("name") or "").strip()
                _rr = str(_pr.get("ref") or "").strip()
                _nm[_oid] = _n or _rr or "unnamed"
                try:
                    _coords = _ft["geometry"]["coordinates"]
                    _pts = (_coords if isinstance(_coords[0][0], (int, float))
                            else [p for _part in _coords for p in _part])
                    _mx = _pts[len(_pts) // 2]
                    _mid[_oid] = (round(float(_mx[1]), 5), round(float(_mx[0]), 5))
                except Exception:
                    continue
        except Exception:  # noqa: BLE001 - names are nice-to-have
            pass
        fixtures = list(out["fixture"].unique())
        from matplotlib.colors import LogNorm
        fig, axes = plt.subplots(len(fixtures), 2,
                                 figsize=(13, 3.0 * len(fixtures)),
                                 squeeze=False)
        _top_rows = []
        for i, fx in enumerate(fixtures):
            _fo = out[out["fixture"] == fx]
            _tot = (_fo.groupby("road_osmid")["pred_speeding"].sum()
                    .sort_values(ascending=False))
            _top = _tot.head(20)
            # Report the stage-A denominator when the two-stage shipped: it
            # is the demand surface the speeding prediction was multiplied
            # by, so pred_vehicles and pred_speeding are consistent.
            _flow_col = ("pred_denom" if "pred_denom" in _fo.columns
                         else "pred_flow")
            _flow_tot = _fo.groupby("road_osmid")[_flow_col].sum()
            try:
                _mo = merged[merged["fixture"] == fx]
                _obs_spd = _mo.groupby("road_osmid")["observed"].sum()
                _obs_flo = (_mo.groupby("road_osmid")["obs_flow"].sum()
                            if "obs_flow" in _mo.columns else None)
            except Exception:  # noqa: BLE001
                _obs_spd, _obs_flo = None, None
            for _osm in _top.index:
                _ml = _mid.get(int(_osm), (float("nan"), float("nan")))
                _top_rows.append({
                    "fixture": fx, "road_osmid": int(_osm),
                    "road_name": _nm.get(int(_osm), "unnamed"),
                    "mid_lat": _ml[0], "mid_lon": _ml[1],
                    "pred_speeding": round(float(_top[_osm]), 3),
                    "pred_vehicles": round(float(_flow_tot.get(_osm, float("nan"))), 3),
                    "obs_speeding": round(float(_obs_spd.get(_osm, float("nan"))), 3)
                    if _obs_spd is not None else float("nan"),
                    "obs_vehicles": round(float(_obs_flo.get(_osm, float("nan"))), 3)
                    if _obs_flo is not None else float("nan"),
                    "dist_stadium_km": round(float(_dist.get(int(_osm), float("nan"))), 3)})
            for j, (_col, _cmap) in enumerate((("pred_flow", "viridis"),
                                               ("pred_speeding", "magma"))):
                sub = _fo[_fo["road_osmid"].isin(_top.index)]
                pivot = sub.pivot_table(index="road_osmid", columns="rel_bin",
                                        values=_col, aggfunc="sum").reindex(_top.index)
                ax = axes[i][j]
                _unit = ("vehicles" if _col == "pred_flow"
                         else "speeding events")
                # Scale: linear by default. The values here are order 10^0-10^1
                # per 15-min bin (colorbars ran 2e-1 .. 6e0), and a log axis
                # over that range both compresses the interesting variation
                # and prints tick labels like "6 x 10^0" for what are simply
                # counts of speeding trips. --surface-scale log restores the
                # old behaviour for when a game's surface really is
                # multiplicative.
                if str(getattr(args, "surface_scale", "linear")) == "log":
                    _pmin = max(float(pivot.min().min()), 1e-3)
                    _norm = LogNorm(vmin=_pmin,
                                    vmax=float(pivot.max().max()))
                    _cbl = f"{_unit} per 15-min bin (log scale)"
                else:
                    _norm = None
                    _cbl = f"{_unit} per 15-min bin"
                sns.heatmap(pivot, ax=ax, cmap=_cmap, norm=_norm,
                            cbar_kws={"label": _cbl})
                # Row labels: road name, not osmid. An osmid is meaningless
                # to a reader, and the previous labels made the "ranked by
                # speeding" axis impossible to check by eye.
                #
                # The ticks MUST be set alongside the labels. seaborn's
                # heatmap installs its own y tick locations, and they do not
                # necessarily number len(labels) -- calling
                # set_yticklabels() with a different count raises
                #   ValueError: The number of FixedLocator locations (10) ...
                #             does not match the number of labels (20).
                # That exception was swallowed by the enclosing try/except
                # and took the ENTIRE figure block down with it, so on job
                # 26095208 the surfaces figure, the coefs figure AND
                # game_day_pred_vs_actual.png were all silently skipped with
                # only a one-line WARN to show for it.
                _rowlab = []
                for _osm in _top.index:
                    _nmv = str(_nm.get(int(_osm), "") or "unnamed")
                    _rowlab.append(f"{_nmv[:26]}  {_osm}")
                if len(_rowlab):
                    # Row centres are at i + 0.5 for an imshow-style extent
                    # of [-0.5, n-0.5].
                    ax.set_yticks(np.arange(len(_rowlab)) + 0.5)
                    ax.set_yticklabels(_rowlab, fontsize=5.5, rotation=0)
                ax.tick_params(labelsize=6)
                ax.set_title(_unit + f" | {str(fx)[:44]}", fontsize=8)
                ax.set_xlabel("15-min bin relative to kickoff")
                ax.set_ylabel("road, ranked by predicted speeding (best at top)"
                              if j == 0 else "")
        fig.suptitle("Predicted 15-min surfaces per future game: vehicles vs speeding "
                     "events\n(per-game top-20 segments, ranked by predicted "
                     "speeding; rows identical in both panels so the two are "
                     "comparable)")
        fig.tight_layout()
        fig.savefig(fig_dir / "game_day_surfaces.png", dpi=130)
        plt.close(fig)
        # The proof figure and the top-20 table are separate deliverables
        # from the surfaces plot. They get their own try/except so a
        # cosmetic failure in one figure cannot silently swallow the others
        # -- which is exactly what happened on job 26095208, where one
        # tick/label mismatch cost the surfaces figure, the coefs figure and
        # this proof figure while the job still reported exit 0.
        try:
            # Proof of concept: does the predicted ranking hold up against
            # the ACTUAL observed events for the same games?
            plot_pred_vs_actual(out, merged, fig_dir, out_dir,
                                top_n=int(getattr(args, "value_top_n", 20)))
        except Exception as exc:  # noqa: BLE001
            print("   WARN: pred-vs-actual figure failed (%s)" % exc)
        try:
            pd.DataFrame(_top_rows).to_csv(
                out_dir / "game_day_top20_per_game.csv", index=False)
            print(f"   top-20 per-game table -> game_day_top20_per_game.csv "
                  f"({len(_top_rows)} rows)")
        except Exception as exc:  # noqa: BLE001
            print(f"   WARN: top-20 table failed ({exc})")
        if coefs is not None and len(coefs):
            top = coefs.reindex(coefs["coefficient"].abs()
                                .sort_values(ascending=False).index).head(20)
            fig, ax = plt.subplots(figsize=(7, 6))
            ax.barh(top["variable"][::-1], top["coefficient"][::-1])
            ax.set_title("Refit coefficients (top-20 by |value|)")
            fig.tight_layout()
            fig.savefig(fig_dir / "game_day_coefs.png", dpi=120)
        plt.close(fig)
        # Success manifest. Written even when nothing failed so the harness can
        # distinguish "figures were produced" from "this run never got that far".
        try:
            (Path(out_dir) / "figures_manifest.json").write_text(json.dumps(
                {"tag": tag, "ok": True, "error": None,
                 "figures_present": sorted(
                     p.name for p in Path(fig_dir).glob("*.png"))},
                indent=2, default=str))
        except Exception as _mexc:  # noqa: BLE001
            print(f"   WARN: could not write figures manifest ({_mexc})")
    except Exception as exc:  # noqa: BLE001 - plots must not kill the run
        print(f"   WARN: plotting failed ({exc})")
        # Record the failure in a file the job's own artefact harness can read.
        #
        # The harness used to grep the PBS log for the string "plotting
        # failed". That cannot work: PBS only copies the job's output file when
        # the job ENDS, so while the assertions are running their own log does
        # not exist yet. The harness therefore fell back to the newest t4mip.o*
        # it could see -- the PREVIOUS run's log -- and reported job 26107921
        # as having a plotting failure when it had none, on the strength of a
        # fault from the killed job 26095208.
        #
        # A manifest the script writes is self-contained and unambiguous.
        try:
            _mf = {
                "tag": tag, "ok": False,
                "error": f"{type(exc).__name__}: {exc}",
                "figures_present": sorted(
                    p.name for p in Path(fig_dir).glob("*.png")),
            }
            (Path(out_dir) / "figures_manifest.json").write_text(
                json.dumps(_mf, indent=2, default=str))
        except Exception as _mexc:  # noqa: BLE001
            print(f"   WARN: could not write figures manifest ({_mexc})")
    print(f"[59] DONE ({tag}). metrics: {json.dumps(metrics, default=str)}")
    # ---------------------------------------------------------------- gate
    # A channel that silently failed to compute must NOT look like success.
    # o26765725 shipped "59 OK" with no SD columns, no flow-temporal surface
    # and no regime diagnostic because one NameError was swallowed by a
    # broad except; a downstream job then consumed a parquet that silently
    # lacked a whole model. Fail loudly instead.
    _problems = []
    if audit.get("sd_simulation_ok") is False:
        _problems.append(
            "SD twin produced no columns: "
            f"{audit.get('sd_simulation_failures')}")
    if (sd_curves is not None and prop_lookup is not None
            and not getattr(args, "no_sd", False)
            and "pred_sd_game" not in out.columns
            and not args.pilot):
        _problems.append("SD columns absent from the shipped parquet")
    if (_tmode == "flow" and not args.pilot
            and "pred_speeding_temporal" not in out.columns):
        _problems.append(
            f"temporal-mode=flow but no temporal surface was written")
    if _problems:
        for _p in _problems:
            print(f"[59] GATE FAIL: {_p}")
        raise SystemExit("FATAL: incomplete surface(s): " + "; ".join(_problems))
    print("[59] GATE OK: shipped surface channels are present")


if __name__ == "__main__":
    main()
