#!/bin/bash -l
#PBS -N zigenv_import_check
#PBS -l walltime=00:10:00
#PBS -l select=1:ncpus=1:mem=4GB
#PBS -m n
#PBS -r y
#PBS -j oe

# Tiny compute-node check that zigenv can import the estimator stack.
# Never run this Python on a login node.
set -euo pipefail
cd "${PBS_O_WORKDIR}"

module purge
module load Anaconda3/2024.02-1
conda activate "${CONDA_ENV:-zigenv}"
module unload Anaconda3

echo "host: $(hostname)  python: $(which python)"
python - <<'PYEOF'
import numpy, scipy, pandas, numba, lifelines, pylogit
print("IMPORTS OK",
      "numpy", numpy.__version__,
      "| scipy", scipy.__version__,
      "| pandas", pandas.__version__,
      "| numba", numba.__version__,
      "| lifelines", lifelines.__version__,
      "| pylogit", pylogit.__version__)
PYEOF
echo "check finished: $(date)"
