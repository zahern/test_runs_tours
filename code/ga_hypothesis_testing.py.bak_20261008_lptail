def _save_best_ckpt(searcher, individual) -> None:
    """
    Atomic, throttled best-so-far checkpoint whenever a search finds a new
    global best. Written to $GA_CHECKPOINT_DIR/best_<label>.npz so an OOM or
    walltime kill mid-run still leaves the winning genes behind — the salvage
    path in _run_ga_single_stage can then hand a usable feature set to the
    prediction chain instead of dropping the stage entirely.
    """
    try:
        import time as _time
        # Never checkpoint a poisoned fitness: a -1e9 "best" means every eval
        # so far failed, and persisting it lets a broken run masquerade as
        # having a valid starting point (then burns walltime on -1e9 evals).
        _fit = float(getattr(individual, 'fitness', -np.inf))
        if not np.isfinite(_fit) or _fit <= -1e8:
            return
        now = _time.time()
        if now - float(getattr(searcher, '_last_best_ckpt_t', 0.0)) < 30.0:
            return                                   # ≥30 s between writes
        searcher._last_best_ckpt_t = now
        label = str(getattr(searcher, 'progress_label', '')
                    or f'searcher_{id(searcher):x}')
        slug = ''.join(c if c.isalnum() else '_' for c in label)[:60]
        ckpt_dir = os.environ.get('GA_CHECKPOINT_DIR') or '.'
        os.makedirs(ckpt_dir, exist_ok=True)
        path = os.path.join(ckpt_dir, f'best_{slug}.npz')
        tmp = path + '.tmp.npz'
        feat_names = list(getattr(searcher, 'feature_names', None) or [])
        _genes = np.asarray(individual.genes, dtype=np.int8)
        np.savez_compressed(
            tmp,
            genes=_genes,
            fitness=float(getattr(individual, 'fitness', -np.inf)),
            feat_names=np.array(feat_names, dtype=object),
            label=np.array(label),
            fitness_metric=np.array(str(getattr(searcher, 'fitness_metric', ''))),
            saved_at=np.array(_time.strftime('%Y-%m-%d %H:%M:%S')),
        )
        os.replace(tmp, path)
        # ── Convergence trace (paper-grade improvement curves) ─────────
        # One appended row per new global best: (timestamp, label, fitness,
        # n_features). build_convergence_report.py turns these per-shard
        # traces into best-so-far-over-time curves, so improving convergence
        # is showable even when jobs die at the wall and resume later —
        # something the single-entry aggregate histories cannot do.
        try:
            _trace = os.path.join(ckpt_dir, 'convergence_trace.csv')
            _need_hdr = not os.path.isfile(_trace)
            with open(_trace, 'a') as _fh:
                if _need_hdr:
                    _fh.write('timestamp,label,fitness,n_features,'
                              'fitness_metric\n')
                _fh.write(f"{_time.strftime('%Y-%m-%d %H:%M:%S')},"
                          f"\"{label}\",{float(getattr(individual, 'fitness', float('nan'))):.6f},"
                          f"{int(_genes.sum())},"
                          f"\"{str(getattr(searcher, 'fitness_metric', ''))}\"\n")
        except Exception:
            pass
    except Exception:                                # noqa: BLE001
        pass                                         # never break a search


def _ga_memory_leash() -> None:
    """Bound per-search memory growth (Larch/sharrow/JAX compiled artifacts).

    Each stage-5 fitness eval compiles a fresh utility flow while the
    sharrow/numba/JAX caches are only ever cleared OUTSIDE the search loop,
    so RSS ratchets monotonically (~70 GB over 10 h on work-s5) until the
    cgroup OOM-kills the job (exit 137, e.g. nonmand). The existing
    _maybe_clear_jax_caches leash only runs in the SearchLibrium/MetaCount
    fitness path — never in the stage-5 Larch path.

    Every GA_LEASH_EVERY evals (default 5): gc.collect() always (cheap);
    jax.clear_caches() + SearchLibrium JIT-cache clears only when RSS tops
    80% of GA_JAX_CACHE_MEM_LIMIT_GB (default 48). psutil missing ⇒
    gc-only. Throttled, logged at most once per call-site minute, never
    raises into the search.
    """
    try:
        _every = int(os.environ.get('GA_LEASH_EVERY', '5'))
    except ValueError:
        _every = 5
    if _every <= 0:
        return
    _ga_memory_leash.calls = int(getattr(_ga_memory_leash, 'calls', 0)) + 1
    if _ga_memory_leash.calls % _every:
        return
    try:
        import gc as _gc
        _gc.collect()
    except Exception:
        pass
    try:
        import psutil as _ps
        _rss = int(_ps.Process().memory_info().rss)
    except Exception:
        return
    try:
        _lim_gb = float(os.environ.get('GA_JAX_CACHE_MEM_LIMIT_GB', '48'))
    except ValueError:
        _lim_gb = 48.0
    if _rss < int(_lim_gb * 1e9 * 0.80):
        return
    try:
        import time as _t
        _now = _t.monotonic()
        _last = float(getattr(_ga_memory_leash, 'last_log', 0.0) or 0.0)
        if _now - _last > 60.0:
            _ga_memory_leash.last_log = _now
            try:
                from pipeline_logger import logger as _lg
                _lg.warning(f"GA memory leash: RSS {_rss / 1e9:.1f} GB "
                            f"(>80% of {_lim_gb:.0f} GB) — clearing JIT caches")
            except Exception:
                pass
        import jax as _jax
        _jax.clear_caches()
    except Exception:
        pass
    for _mod, _cls in (('SearchLibrium.multinomial_logit', 'MultinomialLogit'),
                       ('SearchLibrium.MixedLogit', 'MixedLogit')):
        try:
            _m = __import__(_mod, fromlist=[_cls])
            getattr(_m, _cls)._clear_jit_cache()
        except Exception:
            continue


# ── PBS walltime awareness ────────────────────────────────────────────────────
# The chain sets GA_WALLTIME_SECONDS (the job's -l walltime, in seconds). We
# capture the process start once and derive an absolute deadline so any long GA
# search can stop *gracefully* — finishing the current generation and writing its
# checkpoint — instead of being SIGKILLed by PBS mid-generation (which loses the
# whole segment). A margin leaves time to pickle the per-segment checkpoint.
import time as _time_mod
import signal as _signal_mod

_GA_START_MONO = _time_mod.monotonic()
_GA_WALLTIME_LIMIT = None             # absolute monotonic() PBS limit (no margin), or None
_GA_WALLTIME_MARGIN = 300.0           # base reserve for checkpoint/finalise (seconds)
_GA_WALLTIME_HIT = False              # set by the SIGTERM backstop / deadline check
_GA_LAST_CHECK_MONO = None            # monotonic() of the previous guard check
_GA_GEN_SECONDS_EMA = 0.0             # EMA of observed per-generation duration

def _init_walltime_guard(margin_seconds: float = 300.0) -> None:
    """Compute the walltime limit from GA_WALLTIME_SECONDS (if set).

    The deadline is now generation-duration-aware (see _walltime_exceeded):
    we store the absolute PBS limit and the base margin separately, and the
    per-check reserve grows with the observed generation time so a SLOW search
    (e.g. stage-4 tdd timing at ~28 min/gen) stops *before* starting a
    generation it cannot finish — rather than being SIGKILLed mid-generation
    (Exit -29), which loses the finalise step (model save + HTML)."""
    global _GA_WALLTIME_LIMIT, _GA_WALLTIME_MARGIN, _GA_LAST_CHECK_MONO, _GA_GEN_SECONDS_EMA
    try:
        _env_margin = float(
            os.environ.get('GA_WALLTIME_MARGIN_SECONDS', '').strip() or 0) or None
    except (ValueError, TypeError, AttributeError):
        _env_margin = None
    _GA_WALLTIME_MARGIN = float(
        _env_margin if _env_margin else margin_seconds)
    _GA_LAST_CHECK_MONO = None
    _GA_GEN_SECONDS_EMA = 0.0
    wt = os.environ.get('GA_WALLTIME_SECONDS')
    if wt:
        try:
            _GA_WALLTIME_LIMIT = _GA_START_MONO + float(wt)
        except (ValueError, TypeError):
            _GA_WALLTIME_LIMIT = None

def _walltime_exceeded() -> bool:
    """True once we cannot safely start another generation before the PBS wall.

    This is called once per generation at the loop top, so the gap between
    successive calls estimates one generation's wall-time. We reserve the base
    margin PLUS 1.5x that observed generation time: if the projected end of the
    next generation would blow the PBS limit, stop now so the loop breaks, the
    best-so-far checkpoint is written, and the segment is finalised cleanly."""
    global _GA_WALLTIME_HIT, _GA_LAST_CHECK_MONO, _GA_GEN_SECONDS_EMA
    if _GA_WALLTIME_HIT:
        return True
    now = _time_mod.monotonic()
    if _GA_LAST_CHECK_MONO is not None:
        _gap = now - _GA_LAST_CHECK_MONO
        if _gap > 0:
            _GA_GEN_SECONDS_EMA = (_gap if _GA_GEN_SECONDS_EMA == 0.0
                                   else 0.5 * _GA_GEN_SECONDS_EMA + 0.5 * _gap)
    _GA_LAST_CHECK_MONO = now
    if _GA_WALLTIME_LIMIT is not None:
        _reserve = _GA_WALLTIME_MARGIN + 1.5 * _GA_GEN_SECONDS_EMA
        if now >= _GA_WALLTIME_LIMIT - _reserve:
            _GA_WALLTIME_HIT = True
            return True
    return False

def _walltime_sigterm_handler(signum, frame):           # pragma: no cover
    """Backstop: PBS SIGTERM (sent just before SIGKILL) flips the flag so the
    next generation-loop check breaks and the in-progress segment is checkpointed
    cleanly rather than killed with no save."""
    global _GA_WALLTIME_HIT
    _GA_WALLTIME_HIT = True

_signal_mod.signal(_signal_mod.SIGTERM, _walltime_sigterm_handler)


class GeneticAlgorithm:
    """
    Binary-encoded GA with:
    - Fitness caching (no re-evaluation of seen gene patterns)
    - Adaptive mutation (increases when diversity drops)
    - Diversity tracking (mean pairwise Hamming distance)
    - Stagnation detection (triggers early restart / boosted mutation)
    """

    def __init__(
        self,
        n_features:          int,
        fitness_fn:          Callable[[np.ndarray], float],
        pop_size:            int   = 40,
        n_generations:       int   = 60,
        mutation_rate:       float = 0.18,
        mutation_rate_max:   float = 0.35,    # boosted rate when diversity low
        diversity_threshold: float = 0.30,    # fraction below which mutation boosts
        crossover_rate:      float = 0.75,
        elitism_k:           int   = 4,
        min_features:        int   = 3,
        max_features:        int   = None,    # None = no upper limit
        tournament_k:        int   = 4,
        stagnation_limit:    int   = 12,      # gens without improvement ÔåÆ mutation boost
        seed:                int   = 42,
        verbose:             bool  = True,
        feature_names:       List[str] = None,    # required for collinearity repair
        collinear_groups:    List[List[str]] = None,  # from STAGE_COLLINEAR_GROUPS
        require_one_groups:  List[List[str]] = None,  # from STAGE_REQUIRE_ONE_GROUPS
        fixed_features:      Optional[List[str]] = None,
        progress_label:      str = '',
        fitness_metric:      str = 'mean(-BIC/n)',
    ):
        self.n_features          = n_features
        self.fitness_fn          = fitness_fn
        self.pop_size            = pop_size
        self.n_generations       = n_generations
        self.mutation_rate       = mutation_rate
        self.mutation_rate_max   = mutation_rate_max
        self.diversity_threshold = diversity_threshold
        self.crossover_rate      = crossover_rate
        self.elitism_k           = elitism_k
        self.min_features        = min_features
        self.max_features        = max_features or n_features
        self.tournament_k        = tournament_k
        self.stagnation_limit    = stagnation_limit
        self.verbose             = verbose
        self.rng                 = np.random.default_rng(seed)
        self.feature_names       = feature_names or []
        self.collinear_groups    = collinear_groups or []
        self.require_one_groups  = require_one_groups or []
        self.fixed_features      = fixed_features or []
        self.progress_label      = progress_label
        self.fitness_metric      = fitness_metric
        self._fixed_idx          = {
            i for i, name in enumerate(self.feature_names)
            if name in set(self.fixed_features)
        }

        # fitness cache   shared across restarts
        self._cache: dict = {}
        self.cache_hits   = 0

    def _active_feature_names(self, genes: np.ndarray, limit: int = 8) -> str:
        if not self.feature_names:
            return f"n={int(genes.sum())}"
        active = [name for name, flag in zip(self.feature_names, genes) if flag == 1]
        if len(active) > limit:
            shown = active[:limit] + [f"... (+{len(active) - limit})"]
        else:
            shown = active
        return str(shown)

    def _feature_count(self, genes: np.ndarray) -> int:
        """Count the primary feature block, excluding optional gene metadata."""
        return int(np.asarray(genes)[:self.n_features].sum())

    # ÔöÇÔöÇ initialisation ÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇ

    def _random_individual(self, n_active: int = None) -> Individual:
        min_active = max(self.min_features, len(self._fixed_idx))
        if n_active is None:
            hi = max(min_active + 1, self.max_features + 1)
            n_active = int(self.rng.integers(min_active, hi))
        n_active = max(min_active, min(n_active, self.max_features))
        genes    = np.zeros(self.n_features, dtype=int)
        if self._fixed_idx:
            genes[list(self._fixed_idx)] = 1
        extra_needed = max(0, n_active - int(genes.sum()))
        candidate_idx = [i for i in range(self.n_features) if i not in self._fixed_idx]
        if extra_needed > 0 and candidate_idx:
            active = self.rng.choice(candidate_idx, size=min(extra_needed, len(candidate_idx)), replace=False)
            genes[active] = 1
        if self.collinear_groups and self.feature_names:
            genes = _repair_collinearity(genes, self.feature_names,
                                         self.collinear_groups, self.rng,
                                         protected_idx=self._fixed_idx)
        genes = _enforce_feature_bounds(
            genes, min_active, self.max_features, self.rng,
            feature_names=self.feature_names,
            collinear_groups=self.collinear_groups,
            protected_idx=self._fixed_idx,
        )
        if self.require_one_groups and self.feature_names:
            genes = _repair_require_one(genes, self.feature_names,
                                        self.require_one_groups, self.rng,
                                        protected_idx=self._fixed_idx,
                                        collinear_groups=self.collinear_groups)
        return Individual(genes=genes)

    def _init_population(self, seed_individuals: list = None) -> List[Individual]:
        """
        Stratified initialisation: spread the population across four density
        levels so the GA doesn't converge from a single sparsity mode.

          25% sparse    (min_features  .. 25th percentile of range)
          25% medium    (25th  .. 50th percentile)
          25% rich      (50th  .. 75th percentile)
          25% dense     (75th percentile .. max_features)

        Seeded elites from a previous run are inserted first.  Stratification
        ensures the initial BIC landscape is well-explored even when the true
        best model is moderately large.
        """
        pop = []
        if seed_individuals:
            for ind in seed_individuals[:self.elitism_k]:
                pop.append(ind.copy())

        span  = max(self.max_features - self.min_features, 1)
        q1    = self.min_features + span // 4
        q2    = self.min_features + span // 2
        q3    = self.min_features + 3 * span // 4

        def _band_size(idx: int) -> int:
            """Number of individuals to generate for band idx (0-3)."""
            remaining = self.pop_size - len(pop)
            n_bands   = max(1, 4 - idx)
            return max(1, remaining // n_bands)

        for lo, hi, _idx in [
            (self.min_features, max(self.min_features, q1),  0),
            (max(self.min_features, q1), max(q1 + 1, q2),    1),
            (max(q1 + 1, q2),            max(q2 + 1, q3),    2),
            (max(q2 + 1, q3),            self.max_features,  3),
        ]:
            for _ in range(_band_size(_idx)):
                if len(pop) >= self.pop_size:
                    break
                n_act = int(self.rng.integers(lo, hi + 1)) if lo < hi else lo
                pop.append(self._random_individual(n_act))

        while len(pop) < self.pop_size:
            pop.append(self._random_individual())
        return pop

    # ÔöÇÔöÇ diversity ÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇ

    def _diversity(self, pop: List[Individual]) -> float:
        """Mean pairwise Hamming distance, normalised to [0,1]."""
        if len(pop) < 2:
            return 0.0
        genes = np.array([ind.genes for ind in pop], dtype=float)
        n     = len(pop)
        dists = []
        for i in range(min(n, 20)):   # sample pairs for speed
            j = self.rng.integers(0, n)
            if i != j:
                dists.append(np.mean(genes[i] != genes[j]))
        return float(np.mean(dists)) if dists else 0.0

    # ÔöÇÔöÇ selection ÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇ

    def _tournament_select(self, pop: List[Individual]) -> Individual:
        idx      = self.rng.choice(len(pop), size=self.tournament_k, replace=False)
        best_idx = max(idx, key=lambda i: pop[i].fitness)
        return pop[best_idx].copy()

    # ÔöÇÔöÇ crossover ÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇ

    def _crossover(self, p1: Individual, p2: Individual) -> Tuple[Individual, Individual]:
        if self.rng.random() > self.crossover_rate:
            return p1.copy(), p2.copy()
        # uniform crossover   each gene independently inherited from either parent
        mask = self.rng.integers(0, 2, size=self.n_features).astype(bool)
        g1   = np.where(mask, p1.genes, p2.genes)
        g2   = np.where(mask, p2.genes, p1.genes)
        return Individual(genes=g1), Individual(genes=g2)

    # ÔöÇÔöÇ mutation ÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇ

    def _mutate(self, ind: Individual, rate: float) -> Individual:
        genes = ind.genes.copy()
        mutable_idx = np.array([i for i in range(self.n_features) if i not in self._fixed_idx], dtype=int)
        flip = np.zeros(self.n_features, dtype=bool)
        if len(mutable_idx) > 0:
            flip[mutable_idx] = self.rng.random(len(mutable_idx)) < rate
        genes[flip] = 1 - genes[flip]
        if self._fixed_idx:
            genes[list(self._fixed_idx)] = 1

        # repair: enforce min/max features
        if self.collinear_groups and self.feature_names:
            genes = _repair_collinearity(genes, self.feature_names,
                                         self.collinear_groups, self.rng,
                                         protected_idx=self._fixed_idx)
        genes = _enforce_feature_bounds(
            genes,
            max(self.min_features, len(self._fixed_idx)),
            self.max_features,
            self.rng,
            feature_names=self.feature_names,
            collinear_groups=self.collinear_groups,
            protected_idx=self._fixed_idx,
        )
        if self.require_one_groups and self.feature_names:
            genes = _repair_require_one(genes, self.feature_names,
                                        self.require_one_groups, self.rng,
                                        protected_idx=self._fixed_idx,
                                        collinear_groups=self.collinear_groups)

        return Individual(genes=genes)

    # ÔöÇÔöÇ evaluation with caching ÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇ

    def _evaluate_one(self, ind: Individual) -> Individual:
        key = ind.key()
        if key in self._cache:
            ind.fitness = self._cache[key]
            self.cache_hits += 1
        elif ind.fitness == -np.inf:
            try:
                ind.fitness = self.fitness_fn(ind.genes)
            except Exception as e:
                logger.warning(f"fitness_fn error: {e}")
                ind.fitness = -1e9
            self._cache[key] = ind.fitness
        return ind

    def _evaluate(self, pop: List[Individual]) -> List[Individual]:
        for ind in pop:
            self._evaluate_one(ind)
        return pop

    # ÔöÇÔöÇ main loop ÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇ

    def run(self, seed_individuals: list = None) -> Tuple[Individual, List[dict], List[Individual]]:
        """
        Run the GA.

        Parameters
        ----------
        seed_individuals : optional list of Individual from a previous run
                           (used for multi-restart warm-starting)

        Returns
        -------
        best_ever : best Individual seen across all generations
        history   : list of per-generation stat dicts
        pop       : final population
        """
        pop      = self._init_population(seed_individuals)
        pop      = self._evaluate(pop)
        history  = []
        best_ever = max(pop, key=lambda x: x.fitness).copy()
        stagnation_count = 0
        invalid_warned = False

        # ── Hard early-stop on convergence ───────────────────────────────────
        # Most segments find their best solution within a handful of generations
        # (e.g. by gen ~11) and then run the full n_generations budget re-searching
        # a converged space — the dominant, avoidable cost of a staged run. Stop
        # once the best fitness has not improved for `patience` generations, after
        # a `min_gens` exploration floor (so the diversity-injection / mutation
        # boost above still get a chance to escape a local optimum first).
        # Disable with GA_EARLY_STOP=0; tune with GA_EARLY_STOP_PATIENCE /
        # GA_EARLY_STOP_MIN_GENS.
        import os as _os
        _label_lower = str(getattr(self, 'progress_label', '')).lower()
        if 'stage4' in _label_lower or 'stage 4' in _label_lower:
            _stage_prefix = 'GA_STAGE4_'
            _default_patience = max(10 * self.stagnation_limit, 120)
            _default_min_gens = max(8 * self.stagnation_limit, 120)
        elif 'stage2' in _label_lower or 'stage 2' in _label_lower:
            _stage_prefix = 'GA_STAGE2_'
            _default_patience = max(3 * self.stagnation_limit, 24)
            _default_min_gens = max(2 * self.stagnation_limit, 20)
        else:
            _stage_prefix = ''
            _default_patience = max(3 * self.stagnation_limit, 24)
            _default_min_gens = max(2 * self.stagnation_limit, 20)

        _early_raw = _os.environ.get(
            f'{_stage_prefix}EARLY_STOP' if _stage_prefix else 'GA_EARLY_STOP',
            _os.environ.get('GA_EARLY_STOP', '1'),
        )
        _early_stop = str(_early_raw).strip() != '0'

        def _env_int(_name: str, _default: int) -> int:
            try:
                _v = int(_os.environ.get(_name, '0'))
                return _v if _v > 0 else _default
            except ValueError:
                return _default

        _es_patience = _env_int(
            f'{_stage_prefix}EARLY_STOP_PATIENCE' if _stage_prefix
            else 'GA_EARLY_STOP_PATIENCE', _default_patience)
        _es_min_gens = _env_int(
            f'{_stage_prefix}EARLY_STOP_MIN_GENS' if _stage_prefix
            else 'GA_EARLY_STOP_MIN_GENS', _default_min_gens)
        # Fraction of the population replaced by fresh random individuals on each
        # stagnation-limit-multiple plateau generation (partial reheat). 0 = off.
        try:
            _reheat_frac = float(_os.environ.get('GA_REHEAT_FRACTION', '0.3'))
        except ValueError:
            _reheat_frac = 0.3
        _reheat_frac = min(max(_reheat_frac, 0.0), 0.9)  # keep at least 10% + elites
        # Hard mutation floor: the effective mutation rate never drops below this,
        # so the search ALWAYS perturbs and the population can't freeze/collapse
        # to a single genotype — important now that stages 1-3 run more generations.
        try:
            _mut_min = float(_os.environ.get('GA_MUTATION_MIN', '0.05'))
        except ValueError:
            _mut_min = 0.05
        _mut_min = min(max(_mut_min, 0.0), 0.9)

        for gen in range(self.n_generations):
            if _walltime_exceeded():
                self._walltime_hit = True
                print(f"\n  !! Walltime guard tripped at gen {gen} "
                      f"(PBS limit approaching) — stopping search gracefully; "
                      "segment checkpoint will be written on exit.", flush=True)
                break
            print(f"Gen {gen:3d} | evaluating population... ", end='', flush=True)
            fitnesses = [ind.fitness for ind in pop]
            gen_best  = max(pop, key=lambda x: x.fitness)
            div       = self._diversity(pop)

            if gen_best.fitness > best_ever.fitness:
                best_ever        = gen_best.copy()
                stagnation_count = 0
                _save_best_ckpt(self, best_ever)   # incremental best-so-far save
                if self.verbose:
                    label = f" [{self.progress_label}]" if self.progress_label else ""
                    metric = f"BIC/n={-best_ever.fitness:.4f}" if best_ever.fitness > -1e8 else f"fitness={best_ever.fitness:.4f}"
                    print(f"New best{label}: {metric}  feats={self._active_feature_names(best_ever.genes)}")
            else:
                stagnation_count += 1

            if not invalid_warned and gen_best.fitness <= -1e8:
                invalid_warned = True
                label = f" [{self.progress_label}]" if self.progress_label else ""
                print(
                    f"! No valid model yet{label}: all candidates are at the sentinel penalty. "
                    "Check estimator availability, data coverage, or model setup."
                )

            # adaptive mutation: boost when stagnating or diversity low
            if stagnation_count >= self.stagnation_limit or div < self.diversity_threshold:
                cur_rate = self.mutation_rate_max
            else:
                # linearly scale between base and max based on diversity
                t        = max(0.0, 1.0 - div / max(self.diversity_threshold, 1e-6))
                cur_rate = self.mutation_rate + t * (self.mutation_rate_max - self.mutation_rate)
            # Never let mutation stop entirely (guards against population collapse).
            cur_rate = max(cur_rate, _mut_min)

            # Diversity injection: when population has fully collapsed (div==0)
            # for at least stagnation_limit gens, reinitialise all non-elite
            # members from scratch so the search can escape.
            if div == 0.0 and stagnation_count >= self.stagnation_limit:
                elites_now = sorted(pop, key=lambda x: x.fitness, reverse=True)[:self.elitism_k]
                fresh = [self._random_individual() for _ in range(self.pop_size - len(elites_now))]
                pop = self._evaluate(elites_now + fresh)
                if self.verbose:
                    label = f" [{self.progress_label}]" if self.progress_label else ""
                    print(f" ~ Diversity injection at gen {gen}{label}: reinitialised "
                          f"{len(fresh)} members (div was 0, stag={stagnation_count})")

            # ── Stagnation reheat (partial restart on a plateau) ─────────────
            # The full-collapse injection above only fires at div==0, but the
            # common failure mode is a plateau at MODERATE diversity (e.g. best
            # unchanged for 45 gens while div≈0.45) — there the boosted mutation
            # alone can't escape and the run just early-stops. On each multiple of
            # stagnation_limit gens without improvement, replace the weakest
            # GA_REHEAT_FRACTION of the population with fresh random individuals
            # (elites always kept), injecting new genetic material so the search
            # keeps improving over time instead of flatlining. GA_REHEAT_FRACTION=0
            # disables it. Skips the gen the div==0 path already handled.
            elif (_reheat_frac > 0.0
                  and stagnation_count > 0
                  and stagnation_count % self.stagnation_limit == 0
                  # leave ≥ one stagnation_limit window after the last reheat so
                  # it can actually recover before early-stop fires.
                  and stagnation_count <= max(_es_patience - self.stagnation_limit,
                                              self.stagnation_limit)):
                ranked = sorted(pop, key=lambda x: x.fitness, reverse=True)
                n_keep = max(self.elitism_k,
                             int(round(self.pop_size * (1.0 - _reheat_frac))))
                survivors = ranked[:n_keep]
                fresh = [self._random_individual()
                         for _ in range(self.pop_size - len(survivors))]
                pop = self._evaluate(survivors + fresh)
                if self.verbose:
                    label = f" [{self.progress_label}]" if self.progress_label else ""
                    print(f" ~ Stagnation reheat at gen {gen}{label}: replaced "
                          f"{len(fresh)}/{self.pop_size} weakest members "
                          f"(stag={stagnation_count}, div={div:.2f})")

            history.append({
                'generation':    gen,
                'best_fitness':  gen_best.fitness,
                'best_so_far':   best_ever.fitness,
                'mean_fitness':  float(np.mean(fitnesses)),
                'worst_fitness': float(np.min(fitnesses)),
                'n_features':    self._feature_count(gen_best.genes),
                'diversity':     div,
                'mutation_rate': cur_rate,
                'stagnation':    stagnation_count,
            })

            # ── OOM-proof periodic checkpoint ─────────────────────────────
            # A SIGKILL (HPC OOM, e.g. nonmand qld_shard3 exit 137 at gen
            # 22/30) cannot be caught: history lives only in RAM, so the
            # kill loses the whole trajectory and no GA plots can ever be
            # rendered. Every K-th generation persist the trajectory CSV,
            # best genes, and a partial convergence PNG. Tiny files,
            # throttled by K, and never raises into the search.
            try:
                _ckpt_every = int(os.environ.get('GA_CHECKPOINT_EVERY', '5'))
            except ValueError:
                _ckpt_every = 5
            if _ckpt_every > 0 and gen % _ckpt_every == 0:
                try:
                    _ckpt_dir = os.environ.get('GA_CHECKPOINT_DIR') or '.'
                    os.makedirs(_ckpt_dir, exist_ok=True)
                    _ckpt_plots = os.path.join(_ckpt_dir, 'plots')
                    os.makedirs(_ckpt_plots, exist_ok=True)
                    _slug = ''.join(c if c.isalnum() else '_'
                                    for c in str(getattr(self, 'progress_label', '') or 'ga'))[:60]
                    import csv as _csv_mod
                    _hist_path = os.path.join(_ckpt_dir, f'ga_history_partial_{_slug}.csv')
                    with open(_hist_path, 'w', newline='') as _fh:
                        _w = _csv_mod.DictWriter(_fh, fieldnames=list(history[-1].keys()))
                        _w.writeheader()
                        _w.writerows(history)
                    np.savez_compressed(
                        os.path.join(_ckpt_dir, f'ga_best_partial_{_slug}.npz'),
                        genes=np.asarray(best_ever.genes, dtype=np.int8),
                        fitness=float(best_ever.fitness),
                        feat_names=np.array(list(getattr(self, 'feature_names', []) or []), dtype=object),
                        generation=np.array(int(gen)))
                    try:
                        import matplotlib
                        matplotlib.use('Agg')
                        import matplotlib.pyplot as plt
                        _is_bic = 'BIC' in str(getattr(self, 'fitness_metric', ''))
                        _gs = [h['generation'] for h in history]
                        _bf = [(-h['best_so_far'] if _is_bic else h['best_so_far']) for h in history]
                        _mf = [(-h['mean_fitness'] if _is_bic else h['mean_fitness']) for h in history]
                        _fig, _ax = plt.subplots(figsize=(8, 4))
                        _ax.plot(_gs, _bf, label='best so far')
                        _ax.plot(_gs, _mf, label='mean', alpha=0.7)
                        _ax.set_xlabel('generation')
                        _ax.set_ylabel('BIC/n' if _is_bic else 'fitness')
                        _ax.set_title(f'GA convergence (partial, gen {gen})'
                                      + (f' [{self.progress_label}]' if self.progress_label else ''))
                        _ax.legend()
                        _fig.tight_layout()
                        _fig.savefig(os.path.join(_ckpt_plots, f'ga_partial_{_slug}.png'), dpi=120)
                        plt.close(_fig)
                    except Exception:
                        pass
                except Exception:
                    pass

            # Memory leash: bound compiled-artifact growth every few gens so
            # long stage-5 searches ratchet to the cgroup limit (exit 137).
            try:
                _ga_memory_leash()
            except Exception:
                pass

            if self.verbose and gen % 5 == 0:
                if 'BIC' in self.fitness_metric:
                    print(f"  Gen {gen:3d} | best_BIC/n={-gen_best.fitness:.4f} "
                          f"mean_BIC/n={-np.mean(fitnesses):.4f} "
                          f"n_feat={int(gen_best.genes.sum())} "
                          f"div={div:.2f} mut={cur_rate:.3f} "
                          f"stag={stagnation_count}")
                else:
                    print(f"  Gen {gen:3d} | best={gen_best.fitness:.4f} "
                          f"mean={np.mean(fitnesses):.4f} "
                          f"n_feat={int(gen_best.genes.sum())} "
                          f"div={div:.2f} mut={cur_rate:.3f} "
                          f"stag={stagnation_count}")

            # ── Early-stop: best converged, no improvement for `patience` gens ──
            if (_early_stop and gen >= _es_min_gens
                    and stagnation_count >= _es_patience):
                label = f" [{self.progress_label}]" if self.progress_label else ""
                _metric = (f"BIC/n={-best_ever.fitness:.4f}"
                           if best_ever.fitness > -1e8 else f"fitness={best_ever.fitness:.4f}")
                print(f"  Early stop{label} at gen {gen}/{self.n_generations}: "
                      f"best unchanged for {stagnation_count} gens "
                      f"(patience={_es_patience}); {_metric}")
                break

            # elitism
            elites  = sorted(pop, key=lambda x: x.fitness, reverse=True)[:self.elitism_k]
            new_pop = [e.copy() for e in elites]

            while len(new_pop) < self.pop_size:
                p1     = self._tournament_select(pop)
                p2     = self._tournament_select(pop)
                c1, c2 = self._crossover(p1, p2)
                new_pop.append(self._mutate(c1, cur_rate))
                if len(new_pop) < self.pop_size:
                    new_pop.append(self._mutate(c2, cur_rate))

            pop = self._evaluate(new_pop)
            # Track range of non-elite offspring for plot proposed-candidates band
            _prop = [ind.fitness for ind in pop[self.elitism_k:]
                     if np.isfinite(ind.fitness) and ind.fitness > -1e8]
            if _prop and history:
                history[-1]['proposed_min'] = float(min(_prop))
                history[-1]['proposed_max'] = float(max(_prop))

        return best_ever, history, pop

    def run_with_restarts(
        self,
        n_restarts:       int  = 1,
        restart_gens:     int  = None,
        seed_individuals: list = None,
    ) -> Tuple[Individual, List[dict], List[Individual]]:
        """
        Run main GA then n_restarts shorter re-runs, keeping the global best.

        Parameters
        ----------
        n_restarts       : number of random-restart runs after the main run
        restart_gens     : generations per restart (default: n_generations // 3)
        seed_individuals : optional list of Individual to warm-start the MAIN run

        The fitness cache is shared across all runs so restarts benefit from
        all evaluations already done in the main run.

        Restart history entries are offset so generation counts are continuous
        across the full run (no reset to 0 on restart).  Each restart's first
        entry is marked with is_restart_start=True so plot_convergence draws
        a vertical boundary marker at the restart point.

        Returns
        -------
        Same as run() but best_ever is the global best across all restarts.
        """
        restart_gens = restart_gens or max(10, self.n_generations // 3)

        print(f"  Main run: {self.n_generations} generations, pop={self.pop_size}")
        best_ever, history, pop = self.run(seed_individuals=seed_individuals)
        print(f"  Main run best: {best_ever.fitness:.4f}")
        _save_best_ckpt(self, best_ever)

        orig_gens          = self.n_generations
        self.n_generations = restart_gens
        gen_offset         = len(history)   # keep x-axis continuous across restarts

        for r in range(n_restarts):
            print(f"  Restart {r+1}/{n_restarts}: {restart_gens} generations "
                  f"(cache size={len(self._cache)})")
            # warm-start each restart with the current global elites
            best_r, hist_r, pop_r = self.run(seed_individuals=[best_ever])
            # Offset generation numbers so they never reset to 0
            for i, h in enumerate(hist_r):
                h['generation'] += gen_offset
                if i == 0:
                    h['is_restart_start'] = True   # flag for vertical marker in plot
            gen_offset += len(hist_r)
            if best_r.fitness > best_ever.fitness:
                best_ever = best_r.copy()
                print(f"    ^ New global best: {best_ever.fitness:.4f}")
                _save_best_ckpt(self, best_ever)
            history.extend(hist_r)

        self.n_generations = orig_gens
        return best_ever, history, pop


