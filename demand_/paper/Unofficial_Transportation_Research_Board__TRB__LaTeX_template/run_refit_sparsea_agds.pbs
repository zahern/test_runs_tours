#!/bin/bash -l
#PBS -N sparsea_agds
#PBS -l walltime=48:00:00
#PBS -l select=1:ncpus=4:mem=64GB
#PBS -j oe
#PBS -r n
# Stage-1 variable-selection refit with the SparseEA-AGDS-style solver
# (single run per response, no restarts, no SA). Same fitness/penalty/seeds
# as the reported DE benchmarks; compares head-to-head in sparseaagds_vs_de.csv.

PROJ_DIR=/mnt/hpccs01/home/ahernz/test_runs_tours/demand_/paper/Unofficial_Transportation_Research_Board__TRB__LaTeX_template
module purge
module load Anaconda3/2024.02-1
conda activate zigenv
module unload Anaconda3
export PYTHONWARNINGS="ignore::RuntimeWarning"
export OMP_NUM_THREADS=4
export XLA_PYTHON_CLIENT_PREALLOCATE=false
export XLA_PYTHON_CLIENT_MEM_FRACTION=0.6
export JAX_PLATFORMS=cpu
cd "$PROJ_DIR"
echo "Job $PBS_JOBID started on $(hostname) at $(date)"
python -u refit_sparsea_agds.py --data "$PROJ_DIR/near_miss_hb_ecf.csv" --out-dir "$PROJ_DIR" 2>&1
EXIT_CODE=$?
for f in "$PROJ_DIR/hb_sparseaagds_best_nm.tex" "$PROJ_DIR/hb_sparseaagds_best_crash.tex" \
         "$PROJ_DIR/hb_sparseaagds_convergence_nm.png" "$PROJ_DIR/hb_sparseaagds_convergence_crash.png" \
         "$PROJ_DIR/sparseaagds_vs_de.csv"; do
  if [ ! -f "$f" ]; then echo "MISSING refit output: $f"; EXIT_CODE=1; fi
done
echo "Job finished at $(date) exit=$EXIT_CODE"
exit $EXIT_CODE
