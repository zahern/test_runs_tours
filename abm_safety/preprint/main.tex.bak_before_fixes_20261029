\paragraph{Step 5: network transfer and OD accumulation.} Expected crashes are mapped from 100\,m segments to network links (affine plus thin-plate-spline alignment of the US-based network coordinates to Australian coordinates \citep{hartley2003multiple}; links carry lane-proportional shares, $\sim$45\% matched directly, the remainder calibrated by node density). Shortest (distance-weighted, Dijkstra \citep{dijkstra_algorithm}) paths between all 371 SA2 zones yield $137\mbox{,}641$ ordered OD pairs ($371\times371$), and expected crashes accumulate along each path by crash type and in total (\Cref{tab:od_sample}). Higher values concentrate on major urban corridors and arterials.

\paragraph{(C0) Crash-frequency program and absorption into the destination matrix.}
Steps~1--5 are the maximisation program
\begin{equation}
\max_{f_{sc}\in\mathcal{F}^C,\,G_{sc}\subseteq V^C}\ \sum_{(s,c)\in\mathcal{E}}\Bigl[\ell_{sc}(\hat{\boldsymbol{\beta}}_{sc})-\tfrac{1}{2}k_{sc}\ln n_{sc}\Bigr],
\label{eq:c0}
\end{equation}
over stereotype--type pairs $(s,c)\in\mathcal{E}$ (6 stereotypes $\times$ 5 types, 28 estimable): family $f_{sc}\in\mathcal{F}^C=\{\text{Poisson},\text{NB},\text{random-parameter}\}$ and covariate subset $G_{sc}$ of the geometry/exposure pool $V^C$, with $y_i\sim\mathrm{NB}(\lambda_i,\alpha_{sc})$, $\ln\lambda_i=\ln E_i+\mathbf{x}_i(G_{sc})'\boldsymbol{\beta}_{sc}$ (exposure $E_i$ = trips, overdispersion $\alpha_{sc}\in[0.63,1.70]$). Following the hierarchical count formulation (fixed effects, random parameters with heterogeneity in the means, correlated and grouped variants), the segment mean is
\begin{subequations}\label{eq:crash-hier}
\begin{align}
\lambda_i &= \exp\Bigl(\sum_{k}\delta_k\beta_k X_{ik}+\sum_{k}\theta_k\beta_{ik}^R X_{ik}+\varsigma_i\Bigr), &&\forall i
\label{eq:ch-mean}\\
\beta_{ik}^R &= \beta_k+\sum_{n}\phi_{kn}\Delta_{kn}Z_{ikn}+\sum_{p}\gamma_{kp}\sigma_{kp}\,\omega_{ip}, &&\forall i,k
\label{eq:ch-het}\\
\omega_{ik} &= \hat\omega_{gk}, &&\forall i,k:\ \varrho_k=1,\ g=\eta_i\ \text{(grouped)}
\label{eq:ch-group}
\end{align}
\end{subequations}
with binary selectors for model ($\kappa_m$), inclusion ($\delta_k$), random status ($\theta_k$), heterogeneity-in-mean terms ($\phi_{kn}$), correlations ($\gamma_{kp}$), and grouping ($\varrho_k$) --- the $(\mathbf{y},\mathbf{g},\mathbf{r})$ decisions of \eqref{eq:c-family}--\eqref{eq:c-crash} in count-model notation. Empirical Bayes shrinkage stabilises each segment,
\begin{equation}
\mathrm{EB}_i = w_i\hat\lambda_i+(1-w_i)y_i,\qquad w_i=1/(1+\alpha_{sc}\hat\lambda_i),
\label{eq:eb}
\end{equation}
preserving aggregates (201,366 observed; 179,430 expected) while collapsing per-segment dispersion (SD 107.7~$\to$~36.2). Lane-proportional transfer maps segments to links $\ell$, and OD accumulation sums expected crashes along inter-zonal shortest paths $R_{jk}$:
\begin{equation}
\mathrm{CRASH}_{jk}=\sum_{\ell\in R_{jk}}\mathrm{EB}_\ell,
\label{eq:crash-od}
\end{equation}
the $371\times371$ skim of \Cref{tab:od_sample}. Absorption into behaviour
is through the destination and mode utilities. Destination utility contains
$c_{\mathrm{crash}}\log(\mathrm{CRASH}_{jk}+1)$, sign-bounded non-positive and
orthogonalised on log-distance (\eqref{eq:ortho}); the mode logsum carries
mode-level crash disutility into spatial demand, together with
$c_{\mathrm{crash\_veh}}$. Safety therefore enters as a priced OD attribute,
not as a post-hoc overlay: $\mathrm{CRASH}_{jk}$ is the regressor agents
respond to.

\paragraph{(D0) Count-to-skim program: from predicted counts to OD matrices to links.}
Let $\hat T_n$ be the predicted tours per person (Stages~0--4 placed times, Stage~5/5b modes, purposes, destinations). Aggregate to OD demand by mode $m$ and period $p$:
\begin{equation}
D_{jk}^{mp}=\sum_n\sum_{t\in\hat T_n}\mathbf{1}\{o(t)=j,\,d(t)=k,\,m(t)=m,\,p(t)=p\},
\label{eq:od-demand}
\end{equation}
with $o(t),d(t)$ origin/destination zones. Assign to routes: link flows $\mathbf{v}=(v_\ell)$ follow stochastic user equilibrium (DynusT microsimulation in application)
\begin{equation}
v_\ell=\sum_{m,p}\sum_{jk}D_{jk}^{mp}\sum_{r\in R_{jk}}P_r\,\delta_{\ell r},\qquad \tau_\ell=\tau_\ell^0\Bigl(1+\alpha(v_\ell/c_\ell)^\beta\Bigr),
\label{eq:assign}
\end{equation}
with route shares $P_r$, link--route incidence $\delta_{\ell r}$, BPR parameters $(\alpha,\beta)$, and capacities $c_\ell$. Skims are congested shortest paths under $\boldsymbol{\tau}$:
\begin{equation}
S_{jk}^{mp}=\sum_{\ell\in R_{jk}^*(\boldsymbol{\tau})}\tau_\ell,\qquad \mathrm{DIST}_{jk},\ \mathrm{CRASH}_{jk}\ \text{analogously},
\label{eq:skim}
\end{equation}
$\mathrm{CRASH}_{jk}$ from \eqref{eq:crash-od}. The skim matrices re-enter utilities (mode times, logsums, crash exposure), closing the loop $\mathbf{Z}\to\Phi\to\mathbf{Z}$; application iterates to demand--supply consistency (skim-feedback capability).

\paragraph{(D1) System-dynamics extension: accessibility as a dynamic state.}
\eqref{eq:od-demand}--\eqref{eq:skim} resolve supply given demand but leave network condition exogenous to the demand model. We therefore promote network condition to an explicit stock--flow state $\mathbf{s}_t$ over periods $t\in\mathcal{T}$, carrying link flows $\mathbf{v}_t$, incident/hazard stock $\mathbf{H}_t$, transit service capacity $\mathbf{q}_t$, and enforcement deployment $\mathbf{e}_t$. Stocks accumulate, auxiliaries are algebraically determined:
\begin{subequations}\label{eq:sd-flow}
\begin{align}
\mathbf{s}_{t+1} &= \mathbf{s}_t+\Delta_t\bigl[\mathbf{F}^{\mathrm{in}}(\mathbf{s}_t,\mathbf{D}_t)-\mathbf{F}^{\mathrm{out}}(\mathbf{s}_t)\bigr],
&& \forall t\in\mathcal{T} \label{eq:sd-stock}\\
\mathbf{h}_t &= \mathcal{H}(\mathbf{s}_t;\boldsymbol{\Theta}),\quad
\mathbf{q}_t=\mathcal{Q}(\mathbf{s}_t;\boldsymbol{\Theta}),\quad
\boldsymbol{\tau}_t=\mathcal{T}(\mathbf{s}_t;\boldsymbol{\Theta}),
&& \forall t\in\mathcal{T} \label{eq:sd-aux}\\
\boldsymbol{\Theta} &= \boldsymbol{\Theta}^{\mathrm{ext}}\ \text{(fixed)},
&& \label{eq:sd-theta}
\end{align}
\end{subequations}
with $\mathbf{D}_t$ the demand of \eqref{eq:od-demand} evaluated at the current state, $\mathbf{F}^{\mathrm{in/out}}$ the congestion, incident-arrival, service-capacity and enforcement flows, and $\boldsymbol{\Theta}$ the transition parameters \emph{fixed from external microsimulation} (\eqref{eq:assign}, DynusT) rather than searched, which keeps the dynamics identified and leaves the GA search space of \eqref{eq:c-family}--\eqref{eq:c-refine} unchanged. Incidence integrates the crash program, $\mathbf{H}^{\mathrm{in}}_t=\sum_{\ell}\mathrm{CRASH}_{jk}(\boldsymbol{\tau}_{t-1})\mathbf{1}\{\ell\in R^*_{jk}\}$, so the same estimated counts that price safety in Stage~5 also accumulate as a hazard stock.

Accessibility enters the choice models as a state-dependent Hansen logsum measure \citep{Hansen1959HowManyTrips} rather than an ad-hoc index. Feasible reachability is itself state-dependent --- Stage-4 start times and the 5b detour test truncate the reachable set as the network degrades --- so for origin $i$ with window $(t^{o},t^{d})$,
\begin{subequations}\label{eq:acc}
\begin{align}
\mathcal{R}_{jk}(t) &= \Bigl\{j':\ t^{o}+S_{j'j}^{m}(t)\le t^{d}-S_{jk'}^{m}(t)-\varrho_i(t)\Bigr\},
&&\text{state-dependent feasible set} \label{eq:acc-set}\\
\Omega_{i}^{k}(t) &= \ln\!\!\sum_{j'\in\mathcal{R}_{jk}(t)}\exp\!\Bigl(V_{ij'}(\mathbf{s}_t)+\beta_o\ln O_{jk'}\Bigr),
&&\text{opportunity accessibility} \label{eq:acc-logsum}\\
V_{ij}(t) &= \hat{\boldsymbol{\theta}}_{f}'\mathbf{x}_{ij}+\hat{\boldsymbol{\lambda}}\,\Omega_{i}^{k}(t)+\hat{\boldsymbol{\phi}}\,\ln\!\bigl(1+\mathbf{h}_{j}(t)\bigr),
&&\text{choice utility} \label{eq:acc-util}
\end{align}
\end{subequations}
with $\varrho_i(t)$ a residual-time reserve, $O_{jk'}$ destination opportunities (land-use attractors, joint with the ACDC kernel of \eqref{eq:acdc}--\eqref{eq:acdc-mip}), and $\hat{\boldsymbol{\lambda}},\hat{\boldsymbol{\phi}}$ the accessibility and hazard coefficients estimated by the inner penalised MLE of \eqref{eq:p2} subject to $\hat{\boldsymbol{\lambda}},\hat{\boldsymbol{\phi}}\ge0$. $\Omega$ is already in log units, so it is absorbed through the mode logsum without double counting.

Because accessibility is endogenous --- attraction generates demand, demand degrades the network, which shrinks accessibility --- the states are obtained from the damped fixed point rather than a single pass:
\begin{subequations}\label{eq:sd-fp}
\begin{align}
\mathbf{s}^{(n+1)}_{t} &= (1-\omega)\,\mathbf{s}^{(n)}_t+\omega\,F_t\bigl(\mathbf{s}^{(n)}_t;\hat{\boldsymbol{\theta}},\boldsymbol{\Theta}^{\mathrm{ext}}\bigr),
&& \omega\in(0,1] \label{eq:sd-damp}\\
\bigl\|F_t(\mathbf{s}^{\star}_t)-\mathbf{s}^{\star}_t\bigr\|_{\infty} &\le \varepsilon,
&& \forall t\in\mathcal{T} \label{eq:sd-conv}\\
\mathbf{s}^{\star}_{t+1} &\succeq \mathbf{0},\qquad
\sum_{t}\sum_{m,j,k}D_{jk}^{mt}(\mathbf{s}^{\star}_t)=\sum_n\hat T_n,
&& \text{non-negativity, demand conservation} \label{eq:sd-cons}
\end{align}
\end{subequations}
with $\omega=1$ recovering the undamped assignment of \eqref{eq:assign} and $\varepsilon$ set by the skim calibration tolerance. $\mathbf{s}^{\star}$ is validated out-of-sample against observed link travel times, transit accessibility and incident durations; a dynamics block is retained only if it improves out-of-sample prediction over the static-skim baseline of \eqref{eq:skim} on those targets, so the extension is testable rather than assumed.

