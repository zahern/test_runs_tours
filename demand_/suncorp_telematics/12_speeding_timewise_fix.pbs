#!/bin/bash -l
#PBS -N suncorp_speedtime_fix
#PBS -l walltime=04:00:00
#PBS -l select=1:ncpus=4:mem=64GB
#PBS -j oe
#PBS -m abe
#PBS -r y

# ======================================================================
# FIX JOB 1: remodel Fig5 (fig:timewise) on speeding-only counts and fix
# the hour-zero artefact (e.g. risk at hour 4 plotted as 0).
#
# Root causes (scripts/21_eb_timewise_risk.py):
#   - line 180: Y = braking + speeding (generic "risk"), but the paper's
#     enforcement estimand is speeding threshold exceedances.
#   - build_hourly(): out[h] = acc[h] / max(counts[h],1), so unobserved
#     clock hours (01-10, no fixture window covers them) plot as exact 0.
#
# Runs: scripts/42_speeding_timewise_fix.py
# Paper inputs out: results/speeding_timewise_fix.tex,
#   figures/speeding_timewise_phase_curve.png,
#   figures/speeding_timewise_hourly.png
# Submit: cd $PROJ_DIR && qsub 12_speeding_timewise_fix.pbs
# ======================================================================

PROJ_DIR=/mnt/hpccs01/home/ahernz/test_runs_tours/demand_/suncorp_telematics
SCRIPT_DIR=$PROJ_DIR/scripts
DATA_DIR=$PROJ_DIR/data
RESULTS_DIR=$PROJ_DIR/results

module purge
module load Anaconda3/2024.02-1
conda activate zigenv
module unload Anaconda3

export PYTHONWARNINGS="ignore::RuntimeWarning"
export OMP_NUM_THREADS=4
export OPENBLAS_NUM_THREADS=4
export MKL_NUM_THREADS=4

cd "$SCRIPT_DIR"

echo "=================================================================="
echo "Job $PBS_JOBID started on $(hostname) at $(date)"
echo "=================================================================="

for f in "$DATA_DIR/segment_roads_part0_5000.csv.gz" \
         "$DATA_DIR/road_geometry_features.csv"; do
  if [ ! -s "$f" ]; then echo "FATAL: missing input $f"; exit 1; fi
done
echo "Inputs OK."

python -u 42_speeding_timewise_fix.py 2>&1
EXIT_CODE=$?
if [ $EXIT_CODE -ne 0 ]; then echo "FATAL: fix script failed (exit=$EXIT_CODE)"; exit 1; fi

python - "$RESULTS_DIR/speeding_timewise_audit.json" <<'EOF'
import json, os
base = "/mnt/hpccs01/home/ahernz/test_runs_tours/demand_/suncorp_telematics"
a = json.load(open(f"{base}/results/speeding_timewise_audit.json"))
assert a["total_speeding"] > 0, "no speeding counts modelled"
assert len(a["unobserved_hours"]) > 0, "expected some unobserved clock hours"
for f in ["results/speeding_timewise_fix.tex",
          "figures/speeding_timewise_phase_curve.png",
          "figures/speeding_timewise_hourly.png"]:
    assert os.path.getsize(f"{base}/{f}") > 0, f"missing {f}"
print(f"OK: speeding={a['total_speeding']:.0f} unobserved_hours={a['unobserved_hours']}")
EOF
EXIT_CODE=$?

echo "=================================================================="
echo "Job finished at $(date) - exit_code=$EXIT_CODE"
echo "=================================================================="
exit $EXIT_CODE
