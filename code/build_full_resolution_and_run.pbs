#!/bin/bash -l
# =============================================================================
# build_full_resolution_and_run.pbs — one command: rebuild every zone-keyed
# data layer at the new full-SEQ resolution (371 zones, incl. Jimboomba,
# Toowoomba SA4 317, and the NSW Richmond Valley set), then launch the full
# guided ABM chain (search -> apply -> safety showcase).
#
# Usage (from ~/test_runs_tours/code on an aqua login node):
#   qsub build_full_resolution_and_run.pbs                    # TAG=guided03
#   qsub -v TAG=guided04,SKIP_BUILD=0 build_full_resolution_and_run.pbs
#
# What it does, in order (set -e: any failure stops the chain BEFORE the ABM
# jobs are submitted, so a half-built zone system can never be consumed):
#   1. demand_ rebuild at the 371-zone list (zone_ids_sa_only_507.txt):
#      crosswalk -> skims aggregation -> crash matrices -> integrated OMX ->
#      landuse -> OSM counts -> OMX conversion.
#   2. Purge ABM-side caches keyed to the old zone universe (accessibility,
#      CDAP model — its feature list changed to include crash_acc — and the
#      usual-locations cache, which is known to go stale across zone changes).
#   3. Submit the guided chain (submit_guided_run.sh: Jobs A-E).
#
# NOT included: the synth_pop SA-GAN fits for the 47 new zones (multi-day
# GPU pipeline). Until Paper_Plan/synth_pop stages -2..5+12 are rerun, the
# new zones have skims/landuse but keep their previous population (or none),
# and build_synth_population.py --new-pop simply won't find zone files for
# them. Run that pipeline separately when ready:
#   cd ~/Paper_Plan/synth_pop && python run_pipeline.py --from -2
# =============================================================================
#PBS -N build_full_res
#PBS -l select=1:ncpus=4:mem=96GB
#PBS -l walltime=12:00:00
#PBS -m n
#PBS -r y

set -euo pipefail
cd "$PBS_O_WORKDIR"

TAG="${TAG:-guided03}"
SKIP_BUILD="${SKIP_BUILD:-0}"
CONDA_ENV="${CONDA_ENV:-zigenv}"

module purge
module load Anaconda3/2024.02-1
conda activate "$CONDA_ENV"
module unload Anaconda3

DEMAND_DIR="$(cd .. && pwd)/demand_"

if [ "$SKIP_BUILD" != "1" ]; then
    echo "=== [1/3] Rebuilding demand_ layers at 371-zone resolution ==="
    cd "$DEMAND_DIR"
    # Dependency order matters; each script reads zone_ids_sa_only_507.txt
    # (now 371 zones) and regenerates its layer at the new resolution.
    for script in \
        01_zone_crosswalk.py \
        04_aggregate_skims.py \
        05_crash_matrices.py \
        06_build_integrated_omx.py \
        09_build_landuse_507.py \
        10_build_osm_counts_507.py \
        11_convert_skims_to_openmatrix.py
    do
        echo "--- running ${script} ---"
        stdbuf -oL python -u "${script}"
    done
    cd "$PBS_O_WORKDIR"

    echo "=== [2/3] Purging zone-keyed ABM caches ==="
    # accessibility: rebuilt from the new skims on next pipeline start.
    # cdap_model.pkl: feature list changed (crash_acc/walk_acc/transit_acc).
    # usual_locations: known-stale across zone-universe changes.
    for f in saved_data/accessibility.csv \
             saved_data/cdap_model.pkl \
             saved_data/usual_locations.csv; do
        if [ -e "$f" ]; then
            mv "$f" "${f}.pre371.bak"
            echo "  archived $f -> ${f}.pre371.bak"
        fi
    done
else
    echo "=== SKIP_BUILD=1: skipping demand_ rebuild and cache purge ==="
fi

echo "=== [3/3] Submitting guided ABM chain (TAG=${TAG}) ==="
TAG="$TAG" bash submit_guided_run.sh

echo "Done: builds complete, chain submitted. Monitor with: qstat -u \$(whoami)"
