#!/bin/bash -l
#PBS -N suncorp_15min
#PBS -l walltime=10:00:00
#PBS -l select=1:ncpus=8:mem=64GB
#PBS -j oe
#PBS -m abe
#PBS -r y

# Refuse to run outside PBS: keep all compute off the login/head node.
if [ -z "${PBS_JOBID:-}" ] && [ "${ALLOW_HEAD_NODE:-0}" != "1" ]; then
  echo "$(basename "$0"): PBS batch script; refusing to run on $(hostname). Submit with qsub." >&2
  exit 2
fi

# Job 58: segment x 15-minute speeding panel from the all-points Compass extract
# (results/traffic_points_full.csv.gz, produced by 54_extract_parallel.py
# --all-points). One streaming pass + month finalize + merge + summary figures.

PROJ_DIR=/mnt/hpccs01/home/ahernz/test_runs_tours/demand_/suncorp_telematics
SCRIPT_DIR=$PROJ_DIR/scripts
RESULTS_DIR=$PROJ_DIR/results
FIG_DIR=$PROJ_DIR/figures

module purge
module load Anaconda3/2024.02-1
conda activate zigenv
module unload Anaconda3

export PYTHONWARNINGS="ignore::RuntimeWarning"
export OMP_NUM_THREADS=8
export OPENBLAS_NUM_THREADS=8
export MKL_NUM_THREADS=8
export JAX_PLATFORMS=cpu

cd "$SCRIPT_DIR"

echo "=================================================================="
echo "Job $PBS_JOBID started on $(hostname) at $(date)"
echo "58: 15-minute speeding panel (segment x 15-min bins)"
echo "=================================================================="

[ -s "$RESULTS_DIR/traffic_points_full.csv.gz" ] \
  || { echo "FATAL: missing results/traffic_points_full.csv.gz (run 54 --all-points first)"; exit 1; }
[ -s "$PROJ_DIR/data/osm_roads_suncorp.geojson" ] \
  || { echo "FATAL: missing OSM roads geojson"; exit 1; }
[ -s "$PROJ_DIR/data/road_geometry_features.csv" ] \
  || { echo "FATAL: missing road_geometry_features.csv"; exit 1; }

echo "Step 1/2: streaming pass + month finalize..."
python -u 58_build_15min_panel.py --all 2>&1
[ $? -ne 0 ] && { echo "FATAL: 58 build failed"; exit 1; }

echo "Step 2/2: merge + summary figures..."
python -u 58_build_15min_panel.py --merge 2>&1
[ $? -ne 0 ] && { echo "FATAL: 58 merge failed"; exit 1; }

[ -s "$RESULTS_DIR/segment_15min_panel.parquet" ] \
  || { echo "FATAL: missing results/segment_15min_panel.parquet"; exit 1; }
[ -s "$FIG_DIR/segment_15min_panel_summary.png" ] \
  || { echo "FATAL: missing figures/segment_15min_panel_summary.png"; exit 1; }

echo "58 OK: $(ls -la $RESULTS_DIR/segment_15min_panel.parquet)"
echo "Job finished at $(date)"
