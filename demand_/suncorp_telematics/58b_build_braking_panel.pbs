#!/bin/bash -l
#PBS -N suncorp_braking
#PBS -l walltime=4:00:00
#PBS -l select=1:ncpus=4:mem=48GB
#PBS -j oe
#PBS -m abe
#PBS -r y

# Refuse to run outside PBS: keep all compute off the login/head node.
if [ -z "${PBS_JOBID:-}" ] && [ "${ALLOW_HEAD_NODE:-0}" != "1" ]; then
  echo "$(basename "$0"): PBS batch script; refusing to run on $(hostname). Submit with qsub." >&2
  exit 2
fi

# Job 58b: segment x 15-minute HARD-BRAKING panel (copula stage 1). Companion
# to 58; snaps data/hard_braking_events*.csv to the same roads/keys as
# results/segment_15min_panel.parquet so the copula can join the two margins.

PROJ_DIR=/mnt/hpccs01/home/ahernz/test_runs_tours/demand_/suncorp_telematics
SCRIPT_DIR=$PROJ_DIR/scripts
RESULTS_DIR=$PROJ_DIR/results
DATA_DIR=$PROJ_DIR/data
FIG_DIR=$PROJ_DIR/figures

module purge
module load Anaconda3/2024.02-1
conda activate zigenv
module unload Anaconda3

export PYTHONWARNINGS="ignore::RuntimeWarning"
export OMP_NUM_THREADS=4
export OPENBLAS_NUM_THREADS=4
export MKL_NUM_THREADS=4

cd "$SCRIPT_DIR"

echo "=================================================================="
echo "Job $PBS_JOBID started on $(hostname) at $(date)"
echo "58b: 15-minute hard-braking panel (segment x 15-min bins)"
echo "=================================================================="

HB_SRC=""
if [ -s "$DATA_DIR/hard_braking_events_full.csv" ]; then
  HB_SRC="$DATA_DIR/hard_braking_events_full.csv"
elif [ -s "$DATA_DIR/hard_braking_events.csv" ]; then
  HB_SRC="$DATA_DIR/hard_braking_events.csv"
else
  echo "FATAL: no hard-braking source (need data/hard_braking_events_full.csv or data/hard_braking_events.csv)"
  exit 1
fi
echo "braking source: $HB_SRC"
[ -s "$DATA_DIR/osm_roads_suncorp.geojson" ] \
  || { echo "FATAL: missing OSM roads geojson"; exit 1; }
[ -s "$RESULTS_DIR/segment_15min_panel.parquet" ] \
  || { echo "FATAL: missing results/segment_15min_panel.parquet (run 58 first)"; exit 1; }

echo "Step 1/2: build braking panel..."
python -u 58b_build_braking_panel.py --build --events "$HB_SRC" \
  --out "$RESULTS_DIR/segment_15min_panel_braking.parquet" \
  --fig-dir "$FIG_DIR" 2>&1
[ $? -ne 0 ] && { echo "FATAL: 58b build failed"; exit 1; }

echo "Step 2/2: validate against the speeding panel..."
python -u 58b_build_braking_panel.py --validate-panel \
  --out "$RESULTS_DIR/segment_15min_panel_braking.parquet" \
  --panel "$RESULTS_DIR/segment_15min_panel.parquet" \
  --fig-dir "$FIG_DIR" 2>&1
[ $? -ne 0 ] && { echo "FATAL: 58b validate failed"; exit 1; }

[ -s "$RESULTS_DIR/segment_15min_panel_braking.parquet" ] \
  || { echo "FATAL: missing results/segment_15min_panel_braking.parquet"; exit 1; }

echo "58b OK: $(ls -la $RESULTS_DIR/segment_15min_panel_braking.parquet)"
echo "Job finished at $(date)"
