#!/bin/bash -l
#PBS -N eb_searched_rp
#PBS -l walltime=48:00:00
#PBS -l select=1:ncpus=4:mem=64GB
#PBS -j oe
#PBS -r n
# EB SPF on searched condensed specs + random-parameter check + in-job
# best-model searches (Part S).
# Replaces Table 31's 30-var full-model SPFs with per-response searched
# specs (HB 10 vars / crash 8 vars) and adds the missing RP comparison.
# Part A (Hauer EB, log_len): minutes. Part B (4x MCR NB, R=200): ~20 min.
# Part S searches: S1 HB SparseEA-AGDS via metacount + S2 crash via
#   metacountregressor (same penalised-BIC fitness as refit_sparsea_agds,
#   ~6.5h for both) + S3 joint HB+crash copula SparseEA-AGDS on Joe joint
#   BIC (~1h) + S4 MCR role search for RP blocks (~1h). Total ~8-10h.
# Every search writes a convergence PNG with best-so-far, best-current,
# population mean/median, min-max band and faint per-individual traces.
# Single-run only; no restarts.

PROJ_DIR=/mnt/hpccs01/home/ahernz/test_runs_tours/demand_/paper/Unofficial_Transportation_Research_Board__TRB__LaTeX_template
module purge
module load Anaconda3/2024.02-1
conda activate zigenv
module unload Anaconda3
# ALWAYS ensure the pinned estimator: flock-serialized so concurrent paper jobs
# don't race pip into the shared env (hardened after jobs 25258209/25271015).
mkdir -p /mnt/hpccs01/home/ahernz/test_runs_tours/code
(
    flock -w 900 9 2>/dev/null || echo "(flock unavailable, proceeding without lock)"
    pip install --quiet --upgrade --retries 5 --timeout 60 "metacountregressor==1.0.165" 2>&1 | tail -5
) 9>/mnt/hpccs01/home/ahernz/test_runs_tours/code/.pkg_upgrade.lock
# Hard gate (this file has NO `set -e`, so a bare failing assert would NOT stop
# the job -- reads distribution metadata, NOT m.__version__).
python -c "from importlib.metadata import version as _v; v=tuple(map(int, _v('metacountregressor').split('.')[:3])); assert v>=(1,0,165), f\"stale mcr {_v('metacountregressor')} -- aborting\"; print('mcr', _v('metacountregressor'), 'OK')" || exit 1
export PYTHONWARNINGS="ignore::RuntimeWarning"
export OMP_NUM_THREADS=4
export XLA_PYTHON_CLIENT_PREALLOCATE=false
export XLA_PYTHON_CLIENT_MEM_FRACTION=0.6
export JAX_PLATFORMS=cpu
cd "$PROJ_DIR"
echo "Job $PBS_JOBID started on $(hostname) at $(date)"
python -u eb_searched_rp.py --data "$PROJ_DIR/near_miss_hb_ecf.csv" --out-dir "$PROJ_DIR" --search all 2>&1
EXIT_CODE=$?
# Gate: Table 31 replacement + RP verdict must exist.
for f in "$PROJ_DIR/eb_searched_spf.tex" "$PROJ_DIR/eb_searched_rp.tex" \
         "$PROJ_DIR/eb_searched_rp.csv" "$PROJ_DIR/eb_searched_verdict.csv" \
         "$PROJ_DIR/eb_searched_posterior.csv" "$PROJ_DIR/eb_searched_screening.png"; do
  if [ ! -f "$f" ]; then echo "MISSING EB-searched output: $f"; EXIT_CODE=1; fi
done
# Gate: Part-S best-model searches + convergence plots with population traces.
for f in "$PROJ_DIR/eb_search_best_hb.csv" "$PROJ_DIR/eb_search_best_crash.csv" \
         "$PROJ_DIR/eb_search_hist_hb.csv" "$PROJ_DIR/eb_search_hist_crash.csv" \
         "$PROJ_DIR/eb_search_convergence_hb.png" "$PROJ_DIR/eb_search_convergence_crash.png" \
         "$PROJ_DIR/eb_search_joint_best.csv" "$PROJ_DIR/eb_search_joint_best.tex" \
         "$PROJ_DIR/eb_search_hist_joint.csv" "$PROJ_DIR/eb_search_convergence_joint.png" \
         "$PROJ_DIR/eb_search_vs_condensed.csv" \
         "$PROJ_DIR/eb_searched_rp_sds_HB.png" "$PROJ_DIR/eb_searched_rp_sds_Crash.png"; do
  if [ ! -f "$f" ]; then echo "MISSING Part-S output: $f"; EXIT_CODE=1; fi
done
# MCR role searches are best-effort (StructureEvaluatorLC may be unavailable
# on some nodes): warn but do not fail the job if absent.
for f in "$PROJ_DIR/eb_search_mcr_role_HB.csv" "$PROJ_DIR/eb_search_mcr_role_Crash.csv"; do
  if [ ! -f "$f" ]; then echo "WARNING: optional MCR role output absent: $f"; fi
done
echo "Job finished at $(date) exit=$EXIT_CODE"
exit $EXIT_CODE
