#!/bin/bash -l
# Build + run a MATSim scenario from a finished tours-pipeline run, then produce
# network-level analysis plots. Uses the staged, population-INDEPENDENT base
# inputs in matsim/ (network + GTFS transit), so this job only:
#   1. exports (sampled) plans from the run's trips CSV   (matsim_export.py)
#   2. runs the MATSim Controler                          (matsim/RunScenario)
#   3. renders network volume / congestion / mode plots   (matsim_analysis.py)
#
# Usage:
#   qsub -v "RUN_DIR=runs/agds_full_001,MATSIM_SAMPLE_FRAC=0.1" job_matsim_scenario.pbs
#   qsub -v "RUN_ROOT=runs/ga_parallel,RUN_TAG=agds_full_001,MATSIM_SAMPLE_FRAC=0.1,MATSIM_ITERS=20" job_matsim_scenario.pbs
#   qsub -v "RUN_DIR_MARKER=runs/ga_parallel/exp1/prediction_run_dir.txt,MATSIM_SAMPLE_FRAC=0.1" job_matsim_scenario.pbs
#
# For the FULL synthetic population (~2M) prefer a sample (0.05-0.10) with a big
# heap+walltime; 100% needs very large memory and is rarely necessary.

#PBS -m n
#PBS -r y
#PBS -l select=1:ncpus=8:mem=64GB
#PBS -l walltime=12:00:00

set -euo pipefail

cd "$PBS_O_WORKDIR"

# ---- inputs / knobs --------------------------------------------------------
RUN_ROOT=${RUN_ROOT:-runs/ga_parallel}
RUN_TAG=${RUN_TAG:-}
RUN_DIR=${RUN_DIR:-}
RUN_DIR_MARKER=${RUN_DIR_MARKER:-}
MATSIM_SAMPLE_FRAC=${MATSIM_SAMPLE_FRAC:-0.1}   # population sample (0-1)
MATSIM_ITERS=${MATSIM_ITERS:-10}                # MATSim iterations
MATSIM_END_HOURS=${MATSIM_END_HOURS:-30}
# DynusT-like innovation schedule (see matsim/RunScenario.java):
# ReRoute ONLY (modes fixed, as in DTA), reroute weight stepping down across
# iteration bands, then an innovation-free tail so route flows stabilise
# (verify via the relative-gap verdict in matsim_analysis.py).
#   MATSIM_INNOV_FRAC: fractionOfIterationsToDisableInnovation (0.8-0.9
#     recommended; last 10-20% iterations = pure plan selection, no innovation)
#   MATSIM_REROUTE_SCHED: "w0,w1,w2" ReRoute weights for the 0-30% / 0-60% /
#     0-innovFrac bands (entries sum while simultaneously active, so the total
#     reroute probability declines w0+w1+w2 -> w1+w2 -> w2 -> 0 automatically)
MATSIM_INNOV_FRAC=${MATSIM_INNOV_FRAC:-0.8}
MATSIM_REROUTE_SCHED=${MATSIM_REROUTE_SCHED:-0.3,0.2,0.1}
MATSIM_CRS=${MATSIM_CRS:-EPSG:28356}
MATSIM_HEAP=${MATSIM_HEAP:-48g}                 # JVM heap; scale with sample size
MATSIM_SEED=${MATSIM_SEED:-42}
CONDA_ENV=${CONDA_ENV:-zigenv}

M="matsim"                                      # staged base-inputs dir
JAR="$M/pt2matsim-shaded.jar"                   # bundles MATSim + geotools

# Resolve the run directory:
# 1. Explicit RUN_DIR wins
# 2. RUN_DIR_MARKER file (written by prediction job) wins
# 3. RUN_ROOT + RUN_TAG fallback
if [ -n "${RUN_DIR_MARKER}" ] && [ -f "${RUN_DIR_MARKER}" ]; then
  RUN_DIR=$(cat "${RUN_DIR_MARKER}" | tr -d '\n\r')
  echo "Resolved RUN_DIR from marker: ${RUN_DIR}"
elif [ -z "${RUN_DIR}" ]; then
  [ -n "${RUN_TAG}" ] || { echo "ERROR: set RUN_DIR, RUN_DIR_MARKER, or RUN_ROOT + RUN_TAG" >&2; exit 2; }
  RUN_DIR="${RUN_ROOT}/${RUN_TAG}"
fi
[ -d "${RUN_DIR}" ] || { echo "ERROR: run dir ${RUN_DIR} not found" >&2; exit 2; }

# ---- environment: python (conda) + Java 17+ --------------------------------
module purge 2>/dev/null || true
module load Anaconda3/2024.02-1 2>/dev/null || true
conda activate "$CONDA_ENV" 2>/dev/null || true
module unload Anaconda3 2>/dev/null || true
# Java: prefer JAVA_HOME, else a Java module, else conda's java.
if [ -z "${JAVA_HOME:-}" ]; then
  module load java 2>/dev/null || module load Java/17.0.6 2>/dev/null || true
fi
JAVA_BIN="${JAVA_HOME:+$JAVA_HOME/bin/}java"
JAVAC_BIN="${JAVA_HOME:+$JAVA_HOME/bin/}javac"
command -v "${JAVA_BIN}" >/dev/null 2>&1 || JAVA_BIN=java
command -v "${JAVAC_BIN}" >/dev/null 2>&1 || JAVAC_BIN=javac

export PYTHONUTF8=1 PYTHONIOENCODING=utf-8

echo "=========================================================="
echo "MATSim scenario job"
echo "  Run dir      : ${RUN_DIR}"
echo "  Sample frac  : ${MATSIM_SAMPLE_FRAC}   Iters: ${MATSIM_ITERS}   Heap: ${MATSIM_HEAP}"
echo "  CRS          : ${MATSIM_CRS}"
echo "  Java         : \$(${JAVA_BIN} -version 2>&1 | head -1)"
echo "  Started      : $(date)"
echo "=========================================================="

# ---- 0. sanity: staged base inputs ----------------------------------------
for f in "$JAR" "$M/network.xml.gz" "$M/transitSchedule.xml.gz" "$M/transitVehicles.xml.gz"; do
  [ -f "$f" ] || { echo "ERROR: missing staged input \$f (run matsim/build_base_inputs.sh)" >&2; exit 3; }
done

# ---- 1. export (sampled) plans --------------------------------------------
echo "[1/3] exporting plans (sample_frac=${MATSIM_SAMPLE_FRAC}) ..."
python -u -X utf8 matsim_export.py --run-dir "${RUN_DIR}" \
    --out "${RUN_DIR}/matsim" --crs "${MATSIM_CRS}" \
    --sample-frac "${MATSIM_SAMPLE_FRAC}" --seed "${MATSIM_SEED}"
PLANS="${RUN_DIR}/matsim/plans.xml"
[ -f "$PLANS" ] || { echo "ERROR: exporter produced no plans.xml" >&2; exit 4; }

# ---- 2. run MATSim ---------------------------------------------------------
echo "[2/3] running MATSim Controler (innov_frac=${MATSIM_INNOV_FRAC} reroute=${MATSIM_REROUTE_SCHED}) ..."
# Recompile when the class is missing OR older than the source (a stale
# .class would otherwise silently keep the previous strategy schedule).
[ -f "$M/RunScenario.class" ] && [ "$M/RunScenario.class" -nt "$M/RunScenario.java" ] \
    || "${JAVAC_BIN}" -cp "$JAR" "$M/RunScenario.java"
OUT="${RUN_DIR}/matsim/output"
"${JAVA_BIN}" -Xmx"${MATSIM_HEAP}" -cp "$JAR:$M" RunScenario \
    "$M/network.xml.gz" "$PLANS" "$M/transitSchedule.xml.gz" "$M/transitVehicles.xml.gz" \
    "$OUT" "${MATSIM_SAMPLE_FRAC}" "${MATSIM_ITERS}" "${MATSIM_END_HOURS}" \
    "" "${MATSIM_INNOV_FRAC}" "${MATSIM_REROUTE_SCHED}"

# ---- 3. network-level analysis --------------------------------------------
echo "[3/3] network-level analysis plots ..."
python -u -X utf8 matsim_analysis.py --output-dir "$OUT" \
    --out "${RUN_DIR}/matsim/analysis" || echo "  analysis failed (non-fatal)"

echo "=========================================================="
echo "Done: $(date)"
echo "  Plans   : ${PLANS}"
echo "  Output  : ${OUT}"
echo "  Analysis: ${RUN_DIR}/matsim/analysis"
echo "=========================================================="
