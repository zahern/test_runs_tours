#!/bin/bash -l
#PBS -N suncorp_speed_hazard
#PBS -l walltime=04:00:00
#PBS -l select=1:ncpus=8:mem=64GB
#PBS -j oe
#PBS -m abe
#PBS -r y

# Job 16: per-segment speed-exceedance hazard for eq:score (46_speeding_hazard.py)
# Stage A: metacountregressor NB-RP on segment event-window speeding totals.
# Stage B: log-log crowd elasticity on 16 fixtures w/ published attendance.

PROJ_DIR=/mnt/hpccs01/home/ahernz/test_runs_tours/demand_/suncorp_telematics
SCRIPT_DIR=$PROJ_DIR/scripts
DATA_DIR=$PROJ_DIR/data
RESULTS_DIR=$PROJ_DIR/results

module purge
module load Anaconda3/2024.02-1
conda activate zigenv
module unload Anaconda3

export PYTHONWARNINGS="ignore::RuntimeWarning"
export OMP_NUM_THREADS=8
export OPENBLAS_NUM_THREADS=8
export MKL_NUM_THREADS=8
export JAX_PLATFORMS=cpu

cd "$SCRIPT_DIR"

echo "=================================================================="
echo "Job $PBS_JOBID started on $(hostname) at $(date)"
echo "Project dir:  $PROJ_DIR"
echo "=================================================================="

if [ ! -f "$DATA_DIR/segment_roads_part0_5000.csv.gz" ]; then
    echo "ERROR: segment_roads_part0_5000.csv.gz not found!"
    exit 1
fi
if [ ! -f "$DATA_DIR/fixture_calendar.csv" ]; then
    echo "ERROR: fixture_calendar.csv not found!"
    exit 1
fi

echo "Updating PROJ path for HPC..."
sed -i "s|^PROJ = .*|PROJ = \"$PROJ_DIR\"|g" 46_speeding_hazard.py

rm -f "$RESULTS_DIR/speeding_hazard.tex" "$RESULTS_DIR/speeding_hazard_fixture.csv.gz"

echo ""
echo "Running 46_speeding_hazard.py..."
python -u 46_speeding_hazard.py 2>&1
EXIT_CODE=$?

echo ""
echo "Checking outputs..."
OUTPUTS_OK=0
for f in speeding_hazard_base.csv speeding_hazard_fixture.csv.gz speeding_hazard.tex speeding_hazard_audit.json; do
    if [ -f "$RESULTS_DIR/$f" ]; then
        echo "  OK $f"
        OUTPUTS_OK=$((OUTPUTS_OK + 1))
    else
        echo "  MISSING $f"
    fi
done

if [ "$OUTPUTS_OK" -eq 4 ]; then
    echo "Speed-exceedance hazard complete!"
else
    echo "Some outputs missing/stale ($OUTPUTS_OK/4)"
    EXIT_CODE=1
fi

echo "=================================================================="
echo "Job finished at $(date) — exit_code=$EXIT_CODE"
echo "=================================================================="
exit $EXIT_CODE
