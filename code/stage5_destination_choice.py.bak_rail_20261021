def _plc_getcol(df: pd.DataFrame, names, default=np.nan):
    """First present alias column as float array, else default broadcast."""
    n = len(df)
    for nm in names:
        if nm in df.columns:
            try:
                return pd.to_numeric(df[nm], errors='coerce').astype(float).values
            except Exception:
                pass
    return np.full(n, float(default))


def _plc_raw_features(df: pd.DataFrame) -> dict:
    """Raw (unscaled) captivity covariates from a flat tour/person frame.

    Every lookup is guarded: missing columns yield NaN (dropped per-column at
    estimation in _plc_design; zeroed at prediction so the intercept carries
    on). age5p coding follows _mode_probs_numpy: age5p<=3 → under ~15.
    """
    n = len(df)
    lic = _plc_getcol(df, ['CARLICENCE', 'carlicence', 'has_licence'])
    veh = _plc_getcol(df, ['vehrd', 'hh_vehicles_pred', 'HHVEH'])
    nwk = _plc_getcol(df, ['n_workers_hh', 'cdap_hh_n_workers'])
    age = _plc_getcol(df, ['age5p'])
    lic = np.where(np.isfinite(age) & (age <= 3), 0.0, lic)  # hard age gate
    mp = None
    for _c in ('main_purpose', 'tour_purpose', 'purpose'):
        if _c in df.columns:
            try:
                mp = df[_c].astype(str).str.lower().values
            except Exception:
                mp = None
            break
    out = {
        'CARLICENCE': lic,
        'vehrd': veh,
        'has_vehicle': (veh > 0).astype(float),
        'no_vehicle': (veh == 0).astype(float),
        'multi_vehicle': (veh >= 2).astype(float),
        'one_vehicle': (veh == 1).astype(float),
        'veh_ge_workers': ((veh >= nwk) & np.isfinite(nwk)).astype(float),
        'no_licence_has_car': ((lic == 0) & (veh > 0)).astype(float),
        'age_child': (age <= 3).astype(float),
        'joint_travel': _plc_getcol(
            df, ['joint_travel', 'JOINTTRIP', 'JOINT_TRIP'], 0.0),
        'escort_tour': ((mp == 'escort').astype(float)
                        if mp is not None else np.zeros(n)),
        'HHSIZE': _plc_getcol(df, ['HHSIZE', 'nprd']),
        'hh_size_large': _plc_getcol(df, ['hh_size_large']),
        'income_hi': _plc_getcol(df, ['income_hi']),
        'workstat_fulltime': _plc_getcol(df, ['workstat_fulltime']),
        'studying_primary': _plc_getcol(df, ['studying_primary']),
        'studying_secondary': _plc_getcol(df, ['studying_secondary']),
        'auto_work_acc': _plc_getcol(df, ['auto_work_acc']),
        'transit_acc': _plc_getcol(df, ['transit_acc']),
        'ptype_SchoolChild': _plc_getcol(df, ['ptype_SchoolChild']),
    }
    return out


def _plc_design(seg: pd.DataFrame, segment: str, spec=None):
    """Build per-captive-mode design matrices from the segment tour table.

    Returns (Xs, names_list, modes, Av, mids, scaling, chosen, w) where Xs
    holds intercept-first standardised matrices, names are
    `plc_d_<MODE>__<var>` (BIC/SigPen namespace), Av is (n,J) availability
    (captivity only where the alternative is available), and scaling maps
    `plc_s_<MODE>__<var>__mu/sd` for prediction-time standardisation.
    Drops captive modes below _PLC_MIN_AVAIL at-risk rows or
    _PLC_MIN_CHOSEN chosen rows, and zero-variance columns.
    """
    spec = {m: list(c) for m, c in
            dict(spec if spec is not None
                 else PLC_CAPTIVITY_SPEC.get(segment, {})).items()}
    n = len(seg)
    _empty = ([], [], [], np.zeros((n, 0)), [], {}, np.zeros(n, dtype=int),
              np.ones(n))
    if n == 0 or not spec:
        return _empty
    feats = _plc_raw_features(seg)
    try:
        chosen = pd.to_numeric(seg['tour_mode'], errors='coerce'
                               ).fillna(-1).astype(int).values
    except Exception:
        chosen = np.full(n, -1)
    try:
        w = pd.to_numeric(seg['weight'] if 'weight' in seg.columns else 1.0,
                          errors='coerce').fillna(1.0).values.astype(float)
    except Exception:
        w = np.ones(n)
    Xs, Nms, Ms, Avs, scaling = [], [], [], [], {}
    for mname, cols in spec.items():
        mid = MODE_MAP.get(mname)
        if mid is None:
            continue
        if mname == 'DA':
            lic = feats.get('CARLICENCE', np.full(n, np.nan))
            veh = feats.get('vehrd', np.full(n, np.nan))
            av = ((lic > 0) & (veh > 0)).astype(float)  # NaN-safe
        else:
            av = np.ones(n)
        if float(av.sum()) < _PLC_MIN_AVAIL:
            logger.debug(f"[PLC:{segment}] {mname}: at-risk mass "
                         f"{av.sum():.0f} < {_PLC_MIN_AVAIL} — skipped")
            continue
        if int(((chosen == mid) & (av > 0)).sum()) < _PLC_MIN_CHOSEN:
            logger.debug(f"[PLC:{segment}] {mname}: chosen rows below "
                         f"{_PLC_MIN_CHOSEN} — skipped")
            continue
        keep, mats = [], []
        for c in cols:
            v = np.asarray(feats.get(c, np.full(n, np.nan)), dtype=float)
            with np.errstate(all='ignore'):
                sd = float(np.nanstd(v))
            if not np.isfinite(sd) or sd < 1e-9:
                continue
            mu = float(np.nanmean(v))
            mats.append(np.where(np.isfinite(v), (v - mu) / (sd + 1e-12), 0.0))
            keep.append(c)
            scaling[f'plc_s_{mname}__{c}__mu'] = mu
            scaling[f'plc_s_{mname}__{c}__sd'] = sd
        if not keep:
            continue
        Xs.append(np.column_stack([np.ones(n)] + mats))
        Nms.append([f'plc_d_{mname}__const'] +
                   [f'plc_d_{mname}__{c}' for c in keep])
        Ms.append(mname)
        Avs.append(av)
    if not Ms:
        return _empty
    Av = np.column_stack(Avs)
    mids = [MODE_MAP[m] for m in Ms]
    return Xs, Nms, Ms, Av, mids, scaling, chosen, w


def _plc_U(Dvec, Xs, Av):
    """Captivity masses U (n,J) for stacked Dvec. Shared by LL and gradient."""
    n = Xs[0].shape[0]
    U = np.empty((n, len(Xs)))
    o = 0
    for j, X in enumerate(Xs):
        k = X.shape[1]
        U[:, j] = np.exp(np.clip(X @ Dvec[o:o + k], -30.0, 30.0)) * Av[:, j]
        o += k
    return U


def _plc_njit_cached(f):
    """@njit(cache=True) when numba exists, else a no-op (pure-python).

    Larch's own fallback engine is numba, so it is a hard house dependency on
    the cluster; the no-op branch only ever fires on machines without it
    (logic identical, just slower — keeps smoke tests runnable anywhere).
    """
    try:
        from numba import njit
        return njit(cache=True)(f)
    except Exception:
        return f


try:
    from numba import njit as _numba_njit  # noqa: F401 (presence probe only)
    _PLC_NUMBA_COMPILED = True
except Exception:
    _PLC_NUMBA_COMPILED = False


@_plc_njit_cached
def _plc_nb_negloglike(Dvec, Pn, X_all, bstart, bend, Av, mids, chosen, w):
    """Weighted negative log-likelihood, njit row loops (numba or pure-py).

    Packed layout: X_all (n,K) columns ordered by block, bstart/bend (J,)
    block boundaries, Av (n,J), mids (J,) mode ids, chosen (n,) 1..5.
    P_NL(n,i) frozen — only Dvec is traced/optimised. O(n·K) per call.
    """
    n = Pn.shape[0]
    J = bstart.shape[0]
    ll = 0.0
    for i in range(n):
        ch = chosen[i]
        if ch < 1 or ch > 5:
            continue
        usum = 0.0
        uc = 0.0
        for j in range(J):
            s = 0.0
            a0 = bstart[j]
            a1 = bend[j]
            for a in range(a0, a1):
                s += X_all[i, a] * Dvec[a]
            if s > 30.0:
                s = 30.0
            elif s < -30.0:
                s = -30.0
            u = np.exp(s) * Av[i, j]
            usum += u
            if ch == mids[j]:
                uc = u
        pc = Pn[i, ch - 1]
        p = (uc + pc) / (1.0 + usum)
        if p < 1e-300:
            p = 1e-300
        ll += w[i] * np.log(p)
    return -ll


@_plc_njit_cached
def _plc_nb_fill_grad(Dvec, Pn, X_all, bstart, bend, Av, mids, chosen, w, out):
    """Gradient of _plc_nb_negloglike into preallocated out (K,).

    dLL_n/dD_j = X_n·U_nj·[1(i*=j)/(Uc_n+Pc_n) − 1/(1+u_n)] (P_NL frozen);
    negated on write since scipy minimises the negative log-likelihood.
    """
    n = Pn.shape[0]
    J = bstart.shape[0]
    K = X_all.shape[1]
    for a in range(K):
        out[a] = 0.0
    uj = np.empty(J, dtype=np.float64)
    for i in range(n):
        ch = chosen[i]
        if ch < 1 or ch > 5:
            continue
        usum = 0.0
        for j in range(J):
            s = 0.0
            a0 = bstart[j]
            a1 = bend[j]
            for a in range(a0, a1):
                s += X_all[i, a] * Dvec[a]
            if s > 30.0:
                s = 30.0
            elif s < -30.0:
                s = -30.0
            uj[j] = np.exp(s) * Av[i, j]
            usum += uj[j]
        denom = 1.0 + usum
        pc = Pn[i, ch - 1]
        uc = 0.0
        for j in range(J):
            if ch == mids[j]:
                uc = uj[j]
        base = uc + pc
        if base < 1e-300:
            base = 1e-300
        wi = w[i]
        for j in range(J):
            if ch == mids[j]:
                inner = 1.0 / base
            else:
                inner = 0.0
            coef = wi * uj[j] * (inner - 1.0 / denom)
            a0 = bstart[j]
            a1 = bend[j]
            for a in range(a0, a1):
                out[a] += coef * X_all[i, a]
    for a in range(K):
        out[a] = -out[a]


def _plc_pack_blocks(Xs):
    """Stack per-block designs → (X_all (n,K), bstart (J,), bend (J,))."""
    X_all = np.column_stack(Xs).astype(float)
    bstart, bend, o = [], [], 0
    for X in Xs:
        bstart.append(o)
        o += X.shape[1]
        bend.append(o)
    return (X_all,
            np.asarray(bstart, dtype=np.int64),
            np.asarray(bend, dtype=np.int64))


def _plc_jax_closures(Pn, Xs, w, chosen, Av, mids):
    """JIT-compiled (value, grad) via jax.grad over stacked Dvec.

    Only Dvec is traced; P_NL, designs, weights, masks are static constants.
    Warmed (compiled) before return so failures surface here, not in scipy.
    Returns (fun, grad) or (None, None) when JAX is unavailable.
    """
    try:
        if not JAX_AVAILABLE:
            return None, None
        import jax
        from jax import jit as _jit, grad as _jgrad
        import jax.numpy as _jnp
        _Pn = _jnp.asarray(np.asarray(Pn, dtype=float))
        _Xs = [_jnp.asarray(np.asarray(X, dtype=float)) for X in Xs]
        _w = _jnp.asarray(np.asarray(w, dtype=float))
        _Av = _jnp.asarray(np.asarray(Av, dtype=float))
        _ch = np.asarray(chosen)
        n = _Pn.shape[0]
        J = len(_Xs)
        ks = [int(X.shape[1]) for X in Xs]
        _C = np.zeros((n, J))
        for j, mid in enumerate(mids):
            _C[:, j] = ((_ch == mid) & (_ch >= 1) & (_ch <= 5)).astype(float)
        _C = _jnp.asarray(_C)
        _v = _jnp.asarray((_ch >= 1) & (_ch <= 5))
        _Pc = _Pn[_jnp.arange(n), _jnp.clip(_jnp.asarray(_ch) - 1, 0, 4)]

        def _nll(Dvec):
            o = 0
            Ucols = []
            for X, k in zip(_Xs, ks):
                Ucols.append(_jnp.exp(_jnp.clip(X @ Dvec[o:o + k],
                                                -30.0, 30.0)))
                o += k
            U = _jnp.stack(Ucols, axis=1) * _Av
            denom = 1.0 + U.sum(axis=1)
            Uc = (U * _C).sum(axis=1)
            Pch = _jnp.clip((Uc + _Pc) / denom, 1e-300, 1.0)
            return -_jnp.sum(_w[_v] * _jnp.log(Pch[_v]))

        _f = _jit(_nll)
        _g = _jit(_jgrad(_nll))
        _z = _jnp.zeros(sum(ks))
        _f(_z)
        _g(_z)
        return (lambda v: float(_f(_jnp.asarray(np.asarray(v, dtype=float)))),
                lambda v: np.asarray(_g(_jnp.asarray(
                    np.asarray(v, dtype=float))), dtype=float))
    except Exception as _e:
        logger.debug(f"PLC JAX closures unavailable ({_e}) — numba fallback")
        return None, None


def _plc_closures(Pn, Xs, w, chosen, Av, mids):
    """(fun, grad, engine): JAX-jit value+grad first, numba-njit fallback.

    fun(v)->float, grad(v)->np.ndarray over stacked Dvec. Engine recorded for
    logging ('jax' | 'numba' | 'python-loops'); (None, None, 'none') when no
    backend exists — the caller then fails gracefully and keeps the NL.
    """
    _jf, _jg = _plc_jax_closures(Pn, Xs, w, chosen, Av, mids)
    if _jf is not None:
        return _jf, _jg, 'jax'
    X_all, bstart, bend = _plc_pack_blocks(Xs)
    _Pn = np.ascontiguousarray(np.asarray(Pn, dtype=float))
    _X = np.ascontiguousarray(X_all)
    _Av = np.ascontiguousarray(np.asarray(Av, dtype=float))
    _ch = np.ascontiguousarray(np.asarray(chosen, dtype=np.int64))
    _mids = np.ascontiguousarray(np.asarray(list(mids), dtype=np.int64))
    _w = np.ascontiguousarray(np.asarray(w, dtype=float))
    _gbuf = np.empty(_X.shape[1], dtype=float)

    def _fun(v):
        return float(_plc_nb_negloglike(
            np.ascontiguousarray(np.asarray(v, dtype=float)),
            _Pn, _X, bstart, bend, _Av, _mids, _ch, _w))

    def _grad(v):
        _plc_nb_fill_grad(
            np.ascontiguousarray(np.asarray(v, dtype=float)),
            _Pn, _X, bstart, bend, _Av, _mids, _ch, _w, _gbuf)
        return _gbuf.copy()

    _eng = 'numba' if _PLC_NUMBA_COMPILED else 'python-loops'
    return _fun, _grad, _eng


def _plc_fit_D(Pn, Xs, w, chosen, Av, mids, seed=42, n_starts=5):
    """Multi-start L-BFGS-B over D; central-difference Hessian SEs.

    Compute engine from _plc_closures (JAX-jit value+grad first, numba-njit
    fallback) drives both the optimiser and the Hessian — no numpy path
    remains. Intercepts init at ln(0.05)≈−3 (≈5% captivity prior — 0 would
    imply 33%-captive); slopes at 0. Returns (D, SE, engine, negLL) or None.
    """
    try:
        from scipy.optimize import minimize  # lazy: caller guards ImportError
    except Exception:
        return None
    fun, grad, engine = _plc_closures(Pn, Xs, w, chosen, Av, mids)
    if fun is None:
        logger.warning("PLC fit skipped: neither JAX nor numba available")
        return None
    rng = np.random.default_rng(seed)
    K = int(sum(X.shape[1] for X in Xs))
    bounds = []
    for X in Xs:
        bounds += [(-8.0, 2.0)] + [(-5.0, 5.0)] * (X.shape[1] - 1)
    best = None
    for s in range(max(1, int(n_starts))):
        x0 = np.zeros(K)
        o = 0
        for X in Xs:
            x0[o] = -3.0
            o += X.shape[1]
        if s > 0:
            x0 = x0 + rng.normal(0.0, 0.5, K)
        try:
            r = minimize(fun, x0, jac=grad, method='L-BFGS-B',
                         bounds=bounds, options={'maxiter': 500})
        except Exception:
            continue
        if best is None or float(r.fun) < float(best.fun):
            best = r
    if best is None:
        return None
    D = np.asarray(best.x, dtype=float)
    negLL = float(best.fun)
    SE = np.full(K, np.nan)
    try:  # central-difference Hessian of the active backend's gradient
        h = 1e-5 * (1.0 + np.abs(D))
        H = np.empty((K, K))
        for a in range(K):
            dp, dm = D.copy(), D.copy()
            dp[a] += h[a]
            dm[a] -= h[a]
            gp = grad(dp)
            gm = grad(dm)
            H[:, a] = (np.asarray(gp, dtype=float)
                       - np.asarray(gm, dtype=float)) / (2.0 * h[a])
        SE = np.sqrt(np.maximum(np.diag(np.linalg.inv((H + H.T) / 2.0)), 0.0))
    except Exception as _he:
        logger.debug(f"PLC Hessian SEs failed ({_he}) — t-stats as NaN")
    return D, SE, engine, negLL


class _PLCModelProxy:
    """Thin wrapper so downstream code keeps calling Larch methods on mode_mdl.

    Carries _coef_cache = {**nl_coefs, **plc_d_*, **plc_s_*} (the plc_ payload
    rides in the plain dict — see _plc_payload_from_cache); every other
    attribute delegates to the wrapped NL model.
    """

    def __init__(self, nl_model, coef_cache):
        self._nl_model = nl_model
        self._coef_cache = dict(coef_cache)

    def __getattr__(self, name):
        try:
            _nl = object.__getattribute__(self, '_nl_model')
        except AttributeError:
            raise AttributeError(name)
        return getattr(_nl, name)


def _plc_payload_from_cache(cache):
    """Rebuild [(mode, [cols incl 'const'], Dvec, {col:(mu,sd)})] from plc_ keys.

    Returns None when the cache carries no PLC payload (normal NL path).
    """
    if not cache:
        return None
    try:
        keys = list(cache.keys())
    except Exception:
        return None
    dkeys = [k for k in keys
             if isinstance(k, str) and k.startswith('plc_d_')]
    if not dkeys:
        return None
    modes, cols, vals = [], [], []
    for k in sorted(dkeys):
        rest = k[len('plc_d_'):]
        if '__' not in rest:
            continue
        m, v = rest.split('__', 1)
        try:
            modes.append(m)
            cols.append(v)
            vals.append(float(cache[k]))
        except Exception:
            continue
    if not modes:
        return None
    blocks = []
    for m in sorted(set(modes), key=list(modes).index):
        idx = [i for i, x in enumerate(modes) if x == m]
        # canonical order: intercept first, then covariates alphabetically —
        # estimation emits `plc_d_<M>__const` + spec order, and prediction
        # rebuilds X positionally, so the payload parser must restore a fixed
        # order independent of dict iteration.
        idx = sorted(idx, key=lambda i: (0 if cols[i] == 'const' else 1,
                                         cols[i]))
        bcols = [cols[i] for i in idx]
        bD = np.array([vals[i] for i in idx], dtype=float)
        scal = {}
        for c in bcols:
            if c == 'const':
                continue
            try:
                mu = float(cache.get(f'plc_s_{m}__{c}__mu', 0.0))
                sd = float(cache.get(f'plc_s_{m}__{c}__sd', 1.0))
            except Exception:
                mu, sd = 0.0, 1.0
            scal[c] = (mu, sd if sd else 1.0)
        blocks.append((m, bcols, bD, scal))
    return blocks


def _plc_u_from_blocks(feats, blocks, n, avail):
    """Captivity masses {mode: (n,)} from raw feats + payload blocks."""
    U = {}
    for (m, bcols, bD, scal) in blocks:
        parts = [np.ones(n)]
        for c in bcols:
            if c == 'const':
                continue
            v = np.asarray(feats.get(c, np.full(n, np.nan)), dtype=float)
            mu, sd = scal.get(c, (0.0, 1.0))
            parts.append(np.where(np.isfinite(v), (v - mu) / (sd + 1e-12), 0.0))
        X = np.column_stack(parts)
        av = np.asarray(avail.get(m, np.ones(n)), dtype=float)
        U[m] = np.exp(np.clip(X @ bD, -30.0, 30.0)) * av
    return U


def _plc_frame_for_predict(tour_rows, persons, n):
    """Flat predict frame: tour_cols � persons lookup on person_id (guarded)."""
    try:
        if not isinstance(tour_rows, pd.DataFrame) or len(tour_rows) != n:
            return None
        df = tour_rows
        if (persons is not None and isinstance(persons, pd.DataFrame)
                and 'person_id' in df.columns
                and 'person_id' in persons.columns):
            need = [c for c in _PLC_PREDICT_COLS
                    if c not in df.columns and c in persons.columns]
            if need:
                _pp = persons[['person_id'] + need].drop_duplicates('person_id')
                df = df.merge(_pp, on='person_id', how='left')
        return df
    except Exception:
        return None


def _plc_apply_to_probs(probs, tour_rows, persons, cache):
    """Blend captive mass into an (n,5) NL probability matrix. None if no PLC."""
    blocks = _plc_payload_from_cache(cache)
    if not blocks:
        return None
    try:
        P = np.asarray(probs, dtype=float)
        n = P.shape[0]
        if P.shape[1] != 5:
            return None
    except Exception:
        return None
    df = _plc_frame_for_predict(tour_rows, persons, n)
    if df is None:
        return None
    feats = _plc_raw_features(df)
    avail = {}
    for (m, _b, _d, _s) in blocks:
        if m == 'DA':
            avail[m] = ((feats['CARLICENCE'] > 0) &
                        (feats['vehrd'] > 0)).astype(float)
        else:
            avail[m] = np.ones(n)
    U = _plc_u_from_blocks(feats, blocks, n, avail)
    Usum = np.zeros(n)
    for (m, _b, _d, _s) in blocks:
        Usum += U[m]
    denom = 1.0 + Usum
    P = P.copy()
    for (m, _b, _d, _s) in blocks:
        mid = MODE_MAP.get(m)
        if mid is None:
            continue
        P[:, mid - 1] = (U[m] + P[:, mid - 1]) / denom
    tot = P.sum(axis=1, keepdims=True)
    tot = np.where(tot > 0, tot, 1.0)
    return P / tot


def _plc_correct_logsum(ls_nl, V_modes, case_ids, dt_mode, cache):
    """Mixture inclusive value: IV = Σ_j û_j·V_j + (1−Σû)·LS_NL.

    Exact for the PLC mixture (captive-to-i gets V_i; free choosers get the
    NL logsum). û is per-case from dt_mode tour/person nodes; V_j are the
    (n_cases, n_zones) systematic utilities. None → keep the NL logsum.
    """
    blocks = _plc_payload_from_cache(cache)
    if not blocks:
        return None
    try:
        LS = np.asarray(ls_nl, dtype=float)
        n = LS.shape[0]
        tdf = dt_mode['tour'].to_dataframe()
        tdf.index = tdf.index.map(str)
    except Exception:
        return None
    pdf = None
    try:
        pdf = dt_mode['person'].to_dataframe()
    except Exception:
        pdf = None
    try:
        cids = [str(c) for c in case_ids]
        rows = []
        _pmap = {}
        if pdf is not None and 'person_id' in tdf.columns:
            try:
                _pmap = dict(zip(tdf['person_id'].astype(str),
                                 tdf.index.astype(str)))
            except Exception:
                _pmap = {}
            _pdf_idx = pdf.copy()
            try:
                if 'person_id' in _pdf_idx.columns:
                    _pdf_idx = _pdf_idx.set_index('person_id')
                _pdf_idx.index = _pdf_idx.index.map(str)
            except Exception:
                pass
        else:
            _pdf_idx = pdf
        for cid in cids:
            _row = {}
            if cid in tdf.index:
                try:
                    _row.update(tdf.loc[cid].to_dict())
                except Exception:
                    pass
            _pid = str(_row.get('person_id', ''))
            if _pdf_idx is not None and _pid and _pid in _pdf_idx.index:
                try:
                    _prow = _pdf_idx.loc[_pid]
                    if isinstance(_prow, pd.DataFrame):
                        _prow = _prow.iloc[0]
                    _row.update({k: v for k, v in _prow.to_dict().items()
                                 if k not in _row})
                except Exception:
                    pass
            rows.append(_row)
        df = pd.DataFrame(rows)
    except Exception:
        return None
    if len(df) != n:
        return None
    feats = _plc_raw_features(df)
    avail = {}
    for (m, _b, _d, _s) in blocks:
        if m == 'DA':
            avail[m] = ((feats['CARLICENCE'] > 0) &
                        (feats['vehrd'] > 0)).astype(float)
        else:
            avail[m] = np.ones(n)
    U = _plc_u_from_blocks(feats, blocks, n, avail)
    IV = None
    Usum = np.zeros(n)
    for (m, _b, _d, _s) in blocks:
        if m not in V_modes:
            continue
        Vj = np.asarray(V_modes[m], dtype=float)
        if Vj.shape[0] != n:
            continue
        if IV is None:
            IV = np.zeros_like(Vj)
        IV += U[m][:, None] * Vj
        Usum += U[m]
    if IV is None:
        return None
    Usum = np.minimum(Usum, 0.95)
    IV += (1.0 - Usum)[:, None] * LS
    return np.asarray(IV, dtype=ls_nl.dtype if hasattr(ls_nl, 'dtype') else None)


def _estimate_plc(seg: pd.DataFrame, segment: str, mode_model=None,
                  tours=None, persons=None, skims=None, skim_df=None,
                  seed: int = 42, captivity_spec=None,
                  n_starts: int = STAGE5_PLC_NSTARTS):
    """PLC captivity refinement wrapping the fitted NL mode model.

    Freezes P_NL on the estimation sample, maximises over captivity params D
    only (multi-start L-BFGS-B, analytic gradient), one backward pass dropping
    |t|<1 non-intercepts (intercepts never dropped), Hessian/NaN SEs.

    Returns (plc_result, plc_proxy) or (None, None) on failure or rejection.
    plc_result keys: coef, std_err, tstat, ll, ll_nl, delta_bic, rho2,
    captvars, u_shares, n_obs, captive_modes — a superset of the
    _estimate_mixed_logit contract, so downstream stat readers work.
    Accept rule: ΔBIC < −2 AND max captive share ≤ 0.95 (degeneracy guard).
    """
    if mode_model is None or seg is None or len(seg) == 0:
        return None, None
    try:
        from scipy.optimize import minimize  # noqa: F401 (used in _plc_fit_D)
    except Exception as _e:
        logger.warning(f"[{segment}] PLC skipped: scipy unavailable ({_e})")
        return None, None
    # 1. frozen NL choice probs on the estimation sample. No plc_ keys exist
    # in any cache yet, so the _mode_probs_numpy PLC hook is a no-op here.
    try:
        coef0 = _coef_dict_from_model(mode_model, None) or {}
        Pn = _mode_probs_numpy(mode_model, seg, persons, skims,
                               coef_override=None)
    except Exception as _e:
        logger.warning(f"[{segment}] PLC skipped: frozen NL probs failed ({_e})")
        return None, None
    if Pn is None or np.asarray(Pn).shape != (len(seg), 5):
        logger.warning(f"[{segment}] PLC skipped: bad frozen NL probs shape")
        return None, None
    Pn = np.asarray(Pn, dtype=float)
    # 2. design (fixed declarative spec — identification before search).
    spec = {m: list(c) for m, c in
            dict(captivity_spec if captivity_spec is not None
                 else PLC_CAPTIVITY_SPEC.get(segment, {})).items()}
    Xs, Nms, Ms, Av, mids, scaling, chosen, w = _plc_design(seg, segment, spec)
    if not Ms:
        logger.info(f"[{segment}] PLC skipped: no identifiable captive mode")
        return None, None
    # 3. fit (+ single backward pass on |t|<1 non-intercepts).
    D = SE = t = engine = negLL = None
    for _pass in range(2):
        fit = _plc_fit_D(Pn, Xs, w, chosen, Av, mids,
                         seed=int(seed) + _pass,
                         n_starts=int(n_starts) if _pass == 0 else 1)
        if fit is None:
            return None, None
        D, SE, engine, negLL = fit
        with np.errstate(invalid='ignore', divide='ignore'):
            t = D / SE
        if _pass == 0:
            drop = set()
            o = 0
            for X, names in zip(Xs, Nms):
                for a in range(1, X.shape[1]):
                    _tt = t[o + a]
                    if not np.isfinite(_tt) or abs(float(_tt)) < 1.0:
                        drop.add(names[a])
                o += X.shape[1]
            if drop:
                spec2 = {m: [c for c in cols
                             if f'plc_d_{m}__{c}' not in drop]
                         for m, cols in spec.items()}
                _r = _plc_design(seg, segment, spec2)
                if _r[2]:
                    Xs, Nms, Ms, Av, mids, scaling, chosen, w = _r
                    logger.info(f"[{segment}] PLC backward pass dropped "
                                f"{sorted(drop)} — refitting")
                    continue
        break
    # 4. likelihoods, ΔBIC, degeneracy guard.
    n = int(len(seg))
    valid = (chosen >= 1) & (chosen <= 5)
    PnC = Pn[np.arange(n), np.clip(chosen - 1, 0, 4)]
    LL_nl = float(np.sum(w[valid] * np.log(np.clip(PnC[valid], 1e-300, 1.0))))
    LL_plc = -float(negLL)  # optimiser's own minimum — no recompute needed
    kD = int(sum(X.shape[1] for X in Xs))
    dBIC = -2.0 * (LL_plc - LL_nl) + kD * np.log(max(n, 2))
    U = _plc_U(D, Xs, Av)
    Usum = U.sum(axis=1)
    ush = {m: float(np.sum(w * U[:, j] / np.maximum(1.0 + Usum, 1e-300))
                    / max(float(w.sum()), 1e-12))
           for j, m in enumerate(Ms)}
    if not (dBIC < -2.0):
        logger.info(f"[{segment}] PLC rejected: ΔBIC={dBIC:+.2f} (needs < −2)")
        return None, None
    if max(ush.values()) > 0.95:
        logger.warning(f"[{segment}] PLC rejected: captive share "
                       f"{max(ush.values()):.1%} > 95% (degenerate)")
        return None, None
    # market-share null pseudo-R² for reporting (diagnostic only).
    try:
        _tot = float(w[valid].sum())
        _shr = {}
        for _mid in (1, 2, 3, 4, 5):
            _shr[_mid] = float(w[valid & (chosen == _mid)].sum() / max(_tot, 1e-12))
        LL0 = float(np.sum(w[valid] * np.log(
            np.maximum([_shr.get(int(c), 1e-300) for c in chosen[valid]], 1e-300))))
        rho2 = float(1.0 - LL_plc / LL0) if LL0 < 0 else float('nan')
    except Exception:
        rho2 = float('nan')
    # 5. assemble coef dict (D values + scaling ride as reserved plc_ keys).
    dcoef, se_d, t_d = {}, {}, {}
    o = 0
    for X, names in zip(Xs, Nms):
        for a, nm in enumerate(names):
            dcoef[nm] = float(D[o + a])
            try:
                se_d[nm] = float(SE[o + a])
                t_d[nm] = float(t[o + a])
            except Exception:
                se_d[nm] = float('nan')
                t_d[nm] = float('nan')
        o += X.shape[1]
    coef = dict(coef0)
    coef.update(dcoef)
    coef.update(scaling)
    result = {'coef': coef, 'std_err': se_d, 'tstat': t_d, 'll': LL_plc,
              'll_nl': LL_nl, 'delta_bic': float(dBIC), 'rho2': rho2,
              'captvars': [nm for N in Nms for nm in N], 'u_shares': ush,
              'n_obs': n, 'captive_modes': list(Ms), 'engine': engine}
    proxy = _PLCModelProxy(mode_model, coef)
    logger.info(f"[{segment}] PLC captivity accepted [{engine}]: ΔBIC={dBIC:+.2f}, "
                + ", ".join(f"û_{m}={v:.1%}" for m, v in ush.items()))
    return result, proxy


# ���������������������������������������������������������������������������
# M3 — SCHEDULE-CONSTRAINED DESTINATION SETS (Auld & Mohammadian 2011, ADAPTS)
# ───────────────────────────────────────────────────────────────────────────
# Destination choice sets conditioned on the already-placed schedule: a zone
# is in tour k's set only if it is reachable within the scheduled windows.
# Past-conditioning uses Stage-4's previous and next known anchors, so
# estimation ≡ prediction by construction — no simulation order needed:
#   T(prev_anchor → z) ≤ START_k − prev_end + slack
#   T(z → next_anchor) ≤ next_start − END_k + slack
# Home is the fallback anchor when an adjacent activity location is unknown.
# plus the flat DIST bound (STAGE5_SCHED_DIST_BOUND_KM, mirroring the Larch
# availability string exactly) and home-always-feasible (intrazonal).
# Estimation: the Manski-Lerman sampling frame is restricted to feasible
# zones (correction −log q^F with Q_F over feasible∪{chosen}; the observed
# zone is always force-included, violations counted — that rate is itself
# Auld-style evidence). Prediction: the same mask zeroes infeasible
# (chooser × zone) probabilities before sampling (covers polaris / sampled /
# all-zones draws; never empty-sets a tour — DIST-only fallback, counted).
# M-ladder accept rule (run-level, cf. safety_baseline/nosafety): ΔBIC < −2
# AND validation improves (dest MAE/JSD, mode shares, trip-length MAE, and a
# falling STEP-1b post-hoc snap count — M3 moves that guard into the set).
# Enable with STAGE5_SCHED_CONSTRAIN=1 (default off).
# ���������������������������������������������������������������������������


def _sched_windows(tours_df: pd.DataFrame, persons_df=None,
                   day_start=None, day_end=None) -> pd.DataFrame:
    """Per-tour schedule windows from placed Stage-4 times, input row order.

    Returns columns [ptour_id(str), person_id(str), start, end, prev_end,
    next_start, home_person, otaz, sched_prev_taz, sched_next_taz]. Stage-4
    schedule context is used when present; otherwise prev/next times chain
    within person by STARTIME and anchors fall back to home. DAY_START/DAY_END
    are used for first/unresolvable windows. end falls back to
    STARTIME+duration columns, then NaN (caller treats NaN end as loose).
    Raises RuntimeError when STARTIME is unusable (caller skips M3 loudly).
    """
    ds = STAGE5_SCHED_DAY_START if day_start is None else float(day_start)
    de = STAGE5_SCHED_DAY_END if day_end is None else float(day_end)
    df = tours_df.copy()
    if 'STARTIME' not in df.columns:
        raise RuntimeError('M3: no STARTIME column on tours')
    start = pd.to_numeric(df['STARTIME'], errors='coerce')
    if start.isna().all():
        raise RuntimeError('M3: STARTIME all-NaN')
    end = None
    if 'ENDTIME' in df.columns:
        end = pd.to_numeric(df['ENDTIME'], errors='coerce')
    if end is None or end.isna().all():
        dur = None
        for c in ('predicted_duration_min', 'duration'):
            if c in df.columns:
                dur = pd.to_numeric(df[c], errors='coerce')
                break
        end = start + dur if dur is not None else pd.Series(
            np.nan, index=df.index)
    if 'ptour_id' in df.columns:
        pt = df['ptour_id'].astype(str)
    else:
        pt = pd.Index(df.index).astype(str)
    if 'person_id' in df.columns:
        pid = df['person_id'].astype(str)
    else:  # no person linkage: each row its own group (prev_end = day start)
        pid = pd.Index(df.index).astype(str)
    otaz = (pd.to_numeric(df['OTAZ'], errors='coerce')
            if 'OTAZ' in df.columns else pd.Series(np.nan, index=df.index))
    out = pd.DataFrame({'ptour_id': list(pt), 'person_id': list(pid),
                        'start': np.asarray(start, dtype=float),
                        'end': np.asarray(end, dtype=float),
                        'otaz': np.asarray(otaz, dtype=float),
                        'orig': np.arange(len(df))})
    for _col in ('schedule_seq', 'sched_prev_end', 'sched_next_start',
                 'sched_prev_taz', 'sched_next_taz'):
        if _col in df.columns:
            out[_col] = pd.to_numeric(df[_col], errors='coerce').to_numpy()
    _sort_col = 'schedule_seq' if 'schedule_seq' in out.columns else 'start'
    out = out.sort_values(['person_id', _sort_col, 'start', 'orig'])
    if 'sched_prev_end' in out.columns:
        out['prev_end'] = out['sched_prev_end']
    else:
        out['prev_end'] = out.groupby('person_id')['end'].shift(1)
    out['prev_end'] = out['prev_end'].fillna(ds)  # first/unresolvable: loose
    if 'sched_next_start' in out.columns:
        out['next_start'] = out['sched_next_start']
    else:
        out['next_start'] = out.groupby('person_id')['start'].shift(-1)
    out['next_start'] = out['next_start'].fillna(de)
    # home candidate from persons (matrix-membership resolved by caller).
    hmap = {}
    try:
        if persons_df is not None and 'person_id' in persons_df.columns:
            pdf = persons_df.copy()
            pdf['_pid'] = pdf['person_id'].astype(str)
            _hc = [c for c in ('HOME_SA2_2021', 'HOME_SA2', 'home_zone',
                               'HOME_ZONE', 'hhome', 'HOME_TAZ')
                   if c in pdf.columns]
            if _hc:
                _hv = pdf[_hc].apply(pd.to_numeric, errors='coerce')
                _first = _hv.bfill(axis=1).iloc[:, 0]
                hmap = dict(zip(pdf['_pid'].tolist(), _first.tolist()))
    except Exception:
        hmap = {}
    out['home_person'] = out['person_id'].map(hmap)
    if 'sched_prev_taz' not in out.columns:
        out['sched_prev_taz'] = np.nan
    if 'sched_next_taz' not in out.columns:
        out['sched_next_taz'] = np.nan
    out['sched_prev_taz'] = out['sched_prev_taz'].where(
        out['sched_prev_taz'].notna(), out['home_person'])
    out['sched_next_taz'] = out['sched_next_taz'].where(
        out['sched_next_taz'].notna(), out['home_person'])
    out = out.sort_values('orig').reset_index(drop=True)
    return out[['ptour_id', 'person_id', 'start', 'end', 'prev_end',
                'next_start', 'home_person', 'otaz', 'sched_prev_taz',
                'sched_next_taz']]


def _sched_time_matrix(skims=None, skim_df=None, lookup=None):
    """(tdict {(o,d): minutes}, ddict {(o,d): km} or None, zone_set).

    Tries skim_df pivot (SOVTOLL_TIME__AM et al.), then a skim_lookup-style
    {(o,d): rec} dict, then the OMX handle. (None, None, None) when nothing
    resolves — the caller skips M3 loudly (never a silent no-op).
    """
    _TKEYS = ('SOVTOLL_TIME__AM', 'SOVTOLL_TIME__PM', 'TIME', 'time', 'IVT',
              'ivt', 'TT_MIN', 'tt_min', 'AM_TIME')
    _DKEYS = ('SOVTOLL_DIST__AM', 'DIST', 'dist', 'DISTANCE', 'distance')
    _OKEYS = ('OTAZ', 'otaz', 'o', 'origin', 'ORIG')
    _DKEYS2 = ('DTAZ', 'dtaz', 'd', 'destination', 'DEST')
    tdict, ddict = {}, None
    try:
        if skim_df is not None and isinstance(skim_df, pd.DataFrame) \
                and len(skim_df):
            df = skim_df
            oc = next((c for c in _OKEYS if c in df.columns), None)
            dc = next((c for c in _DKEYS2 if c in df.columns), None)
            tc = next((c for c in _TKEYS if c in df.columns), None)
            if oc and dc and tc:
                _t = pd.to_numeric(df[tc], errors='coerce')
                _o = pd.to_numeric(df[oc], errors='coerce').astype('Int64')
                _d = pd.to_numeric(df[dc], errors='coerce').astype('Int64')
                _ok = _t.notna() & _o.notna() & _d.notna()
                tdict = dict(zip(zip(_o[_ok].astype(int), _d[_ok].astype(int)),
                                 _t[_ok].astype(float)))
            dk = next((c for c in _DKEYS if c in df.columns), None)
            if oc and dc and dk:
                _dd = pd.to_numeric(df[dk], errors='coerce')
                _ok = _dd.notna() & _o.notna() & _d.notna()
                ddict = dict(zip(zip(_o[_ok].astype(int), _d[_ok].astype(int)),
                                 _dd[_ok].astype(float)))
    except Exception as _e:
        logger.debug(f'M3 time matrix: skim_df path failed ({_e})')
    try:
        if not tdict and lookup is not None and isinstance(lookup, dict):
            for (o, d), rec in lookup.items():
                try:
                    oi, di = int(o), int(d)
                except Exception:
                    continue
                if not isinstance(rec, dict):
                    continue
                for tk in _TKEYS:
                    if tk in rec:
                        try:
                            tdict[(oi, di)] = float(rec[tk])
                        except Exception:
                            pass
                        break
                if ddict is None:
                    ddict = {}
                for dk in _DKEYS:
                    if dk in rec:
                        try:
                            ddict[(oi, di)] = float(rec[dk])
                        except Exception:
                            pass
                        break
    except Exception as _e:
        logger.debug(f'M3 time matrix: lookup path failed ({_e})')
    try:
        if not tdict and skims is not None:
            import openmatrix as _omx
            _h = _omx.open_file(str(skims)) if isinstance(
                skims, (str, os.PathLike)) else skims
            _mnames = [str(m) for m in _h.list_matrices()]
            _tm = next((m for m in _TKEYS if m in _mnames), None)
            if _tm is not None:
                _map = dict(_h.mapping(_h.listMappings()[0]))
                _zmap = {int(k): int(v) for k, v in _map.items()}
                _arr = np.asarray(_h[_tm]).astype(float)
                for (o, i) in _zmap.items():
                    row = _arr[i, :]
                    for (d, j) in _zmap.items():
                        try:
                            tdict[(o, d)] = float(row[j])
                        except Exception:
                            pass
    except Exception as _e:
        logger.debug(f'M3 time matrix: OMX path failed ({_e})')
    if not tdict:
        return None, None, None
    zones = set(o for o, _d in tdict) | set(d for _o, d in tdict)
    return tdict, ddict, zones


def _sched_feasible_sets(tours_df: pd.DataFrame, persons_df,
                         zone_ids, tmat: dict, dmat=None,
                         day_start=None, day_end=None, slack=None):
    """{ptour_id(str): set(int feasible zones)} + stats dict.

    A zone z is feasible iff it can be reached from the previous known
    location before the scheduled start and can reach the next known
    location after the scheduled end. Stage-4 anchors are used when present;
    home is the fallback for unresolved anchors. Empty time-feasible set →
    DIST-only/all fallback for that tour (counted, never empty).
    Pairwise-missing skim → that pair infeasible (counted via fallback rate).
    """
    ds = STAGE5_SCHED_DAY_START if day_start is None else float(day_start)
    de = STAGE5_SCHED_DAY_END if day_end is None else float(day_end)
    sl = STAGE5_SCHED_SLACK_MIN if slack is None else float(slack)
    zones = np.asarray(sorted(set(int(z) for z in zone_ids)), dtype=np.int64)
    J = len(zones)
    pos = {z: i for i, z in enumerate(zones.tolist())}
    # dense matrices aligned to zones (missing → +inf = infeasible).
    Tm = np.full((J, J), np.inf)
    for (o, d), v in tmat.items():
        try:
            Tm[pos[int(o)], pos[int(d)]] = float(v)
        except KeyError:
            pass
        except Exception:
            pass
    Dm = None
    if dmat:
        Dm = np.full((J, J), np.inf)
        for (o, d), v in dmat.items():
            try:
                Dm[pos[int(o)], pos[int(d)]] = float(v)
            except KeyError:
                pass
            except Exception:
                pass
    W = _sched_windows(tours_df, persons_df, ds, de)
    try:
        _dtaz = pd.to_numeric(tours_df['DTAZ'], errors='coerce') \
            if 'DTAZ' in tours_df.columns else None
    except Exception:
        _dtaz = None
    _dtaz_by_pt = {}
    try:
        _pt = (tours_df['ptour_id'].astype(str)
               if 'ptour_id' in tours_df.columns
               else pd.Index(tours_df.index).astype(str))
        if _dtaz is not None:
            _dtaz_by_pt = dict(zip(_pt.tolist(),
                                   pd.to_numeric(_dtaz, errors='coerce').tolist()))
    except Exception:
        pass
    feas, n_viol, n_empty, sizes = {}, 0, 0, []
    for _, r in W.iterrows():
        pid = str(r['ptour_id'])
        # home resolution: persons home if in matrix, else first-tour OTAZ.
        h = None
        try:
            if np.isfinite(float(r['home_person'])) \
                    and int(r['home_person']) in pos:
                h = int(r['home_person'])
        except Exception:
            h = None
        if h is None:
            try:
                if np.isfinite(float(r['otaz'])) and int(r['otaz']) in pos:
                    h = int(r['otaz'])
            except Exception:
                h = None
        start = float(r['start'])
        end = float(r['end']) if np.isfinite(float(r['end'])) else np.nan
        prev_end = float(r['prev_end']) if np.isfinite(float(r['prev_end'])) \
            else ds
        gap_out = start - prev_end + sl
        next_start = float(r['next_start']) if np.isfinite(float(r['next_start'])) \
            else de
        gap_in = (next_start - end + sl) if np.isfinite(end) \
            else (next_start - start + sl)
        if h is None or J == 0:
            feas[pid] = set(zones.tolist())
            n_empty += 1
            continue
        try:
            prev_anchor = int(r['sched_prev_taz'])
        except (TypeError, ValueError):
            prev_anchor = h
        try:
            next_anchor = int(r['sched_next_taz'])
        except (TypeError, ValueError):
            next_anchor = h
        if prev_anchor not in pos:
            prev_anchor = h
        if next_anchor not in pos:
            next_anchor = h
        prev_i = pos[prev_anchor]
        next_i = pos[next_anchor]
        row = Tm[prev_i, :]
        col = Tm[:, next_i]
        ok = (row <= gap_out) & (col <= gap_in)
        ok[pos[h]] = True  # intrazonal always feasible
        if Dm is not None:
            ok = ok & (((Dm[prev_i, :] <= STAGE5_SCHED_DIST_BOUND_KM)
                        | ~np.isfinite(Dm[prev_i, :])) &
                       ((Dm[:, next_i] <= STAGE5_SCHED_DIST_BOUND_KM)
                        | ~np.isfinite(Dm[:, next_i])))
        F = set(zones[np.where(ok)[0]].tolist())
        if not F:  # never empty-set: DIST-only/all fallback, counted.
            n_empty += 1
            if Dm is not None:
                _dok = (((Dm[prev_i, :] <= STAGE5_SCHED_DIST_BOUND_KM)
                         | ~np.isfinite(Dm[prev_i, :])) &
                        ((Dm[:, next_i] <= STAGE5_SCHED_DIST_BOUND_KM)
                         | ~np.isfinite(Dm[:, next_i])))
                _dok[pos[h]] = True
                F = set(zones[np.where(_dok)[0]].tolist())
            if not F:
                F = set(zones.tolist())
        try:
            _ch = _dtaz_by_pt.get(pid)
            if _ch is not None and np.isfinite(float(_ch)) \
                    and int(_ch) in pos and int(_ch) not in F:
                n_viol += 1
        except Exception:
            pass
        feas[pid] = F
        sizes.append(len(F))
    stats = {'n_tours': int(len(W)),
             'mean_size': float(np.mean(sizes)) if sizes else 0.0,
             'n_violations': int(n_viol),
             'n_empty_fallback': int(n_empty),
             'n_zones': int(J)}
    return feas, stats


def _sched_feasible_mask(tour_rows_df: pd.DataFrame, persons_df,
                         zone_ids, tmat: dict, dmat=None,
                         day_start=None, day_end=None, slack=None):
    """(n,J) bool aligned to tour_rows_df row order + stats (prediction use).

    All-False rows are opened to all-True (never empty-set prediction) and
    counted as empty fallbacks.
    """
    zones = np.asarray(sorted(set(int(z) for z in zone_ids)), dtype=np.int64)
    n = len(tour_rows_df)
    M = np.zeros((n, len(zones)), dtype=bool)
    feas, stats = _sched_feasible_sets(tour_rows_df, persons_df, zones,
                                       tmat, dmat, day_start, day_end, slack)
    try:
        if 'ptour_id' in tour_rows_df.columns:
            _pts = tour_rows_df['ptour_id'].astype(str).tolist()
        else:
            _pts = pd.Index(tour_rows_df.index).astype(str).tolist()
    except Exception:
        _pts = [str(i) for i in range(n)]
    _zpos = {z: i for i, z in enumerate(zones.tolist())}
    for i, pid in enumerate(_pts):
        for z in feas.get(pid, zones.tolist()):
            j = _zpos.get(int(z))
            if j is not None:
                M[i, j] = True
    _empty_rows = int((~M.any(axis=1)).sum())
    if _empty_rows:
        M[~M.any(axis=1), :] = True
        stats['n_empty_fallback'] = int(stats.get('n_empty_fallback', 0)) \
            + _empty_rows
    stats['mean_keep'] = float(M.mean())
    return M, stats


def _estimate_mode_model_mixed_logit(mode_model, segment: str,
                                     distribution_policy: dict,
                                     n_draws: int = 80, seed: int = 42):
    """Fit selected mode-model coefficients as Normal or negative-LogNormal."""
    try:
        mxl = mode_model.copy()
        family_params = {
            'c_ivt': [('c_ivt_auto', 's_ivt_auto'),
                      ('c_ivt_transit', 's_ivt_transit')],
            'c_walk': [('c_walk_time', 's_walk_time')],
            'c_bike': [('c_bike_time', 's_bike_time')],
        }
        random_params = []
        for family, params in family_params.items():
            distribution = str(distribution_policy.get(family, 'fixed')).lower()
            if distribution not in {'normal', 'neglognormal'}:
                continue
            for param, sd_name in params:
                if param not in mxl.pf.index:
                    continue
                mixture = (lx.mixtures.NegLogNormal(param, sd_name)
                           if distribution == 'neglognormal'
                           else lx.mixtures.Normal(param, sd_name))
                mxl.mixtures.append(mixture)
                # The sd_* parameter only enters model.pf after the mixture
                # list is scanned; _pf_set silently no-ops on names not yet in
                # pf.index.  Without this mangle/unmangle the sd value/bounds
                # below were discarded and every mixture ran on Larch's
                # internal defaults.
                try:
                    mxl.mangle()
                    mxl.unmangle()
                except Exception:
                    pass
                try:
                    base_value = float(mode_model.pf.loc[param, 'value'])
                except Exception:
                    base_value = -1.0
                if distribution == 'neglognormal':
                    latent_mean = np.log(max(abs(base_value), 1e-3)) - 0.5 * 0.25**2
                    _pf_set(mxl, param, 'minimum', -4.0)
                    _pf_set(mxl, param, 'maximum', 1.0)
                    _pf_set(mxl, param, 'value', latent_mean)
                else:
                    _pf_set(mxl, param, 'minimum', -5.0)
                    _pf_set(mxl, param, 'maximum', 0.0)
                    _pf_set(mxl, param, 'value', base_value)
                _pf_set(mxl, sd_name, 'value', 0.25)
                _pf_set(mxl, sd_name, 'minimum', 0.01)
                _pf_set(mxl, sd_name, 'maximum', 5.0)
                random_params.append((param, sd_name, distribution))

        mxl.n_draws = int(n_draws)
        mxl.seed = int(seed)
        try:
            mxl.doctor(repair_ch_av="+")
        except Exception:
            pass
        try:
            _mxl_ds = mxl.dataset
            _mxl_av = np.asarray(_mxl_ds["av"].data)
            _mxl_ch = np.asarray(_mxl_ds["ch"].data)
            _mxl_chosen = _mxl_ch > 0
            _mxl_bad = _mxl_chosen & (_mxl_av == 0)
            _mxl_bad_cases = int(_mxl_bad.any(axis=1).sum())
            logger.warning(
                f"[{segment}] selected-mode MXL data: cases={_mxl_ch.shape[0]} "
                f"alts={_mxl_ch.shape[1]} chosen={int(_mxl_chosen.sum())} "
                f"available={int((_mxl_av > 0).sum())} "
                f"chosen_unavailable={_mxl_bad_cases}"
            )
            _mxl_initial_ll = mxl.loglike(
                check_if_best=False, error_if_bad=False)
            logger.warning(
                f"[{segment}] selected-mode MXL initial loglike="
                f"{float(_mxl_initial_ll):.6f}"
            )
        except Exception as _mxl_diag_exc:
            logger.warning(
                f"[{segment}] selected-mode MXL pre-fit diagnostic failed: "
                f"{type(_mxl_diag_exc).__name__}: {_mxl_diag_exc}"
            )
        if not random_params:
            return None, None
        try:
            start_values = {name: float(mxl.pf.loc[name, 'value'])
                            for name in mxl.pf.index}
        except Exception:
            start_values = None

        _enet = elasticnet_objective(mxl)
        _enet.__enter__()
        _guarded_logloss = mxl.logloss
        _guarded_d_logloss = mxl.d_logloss
        _start_pvals = np.asarray(mxl.pvals, dtype=float).copy()
        _invalid_loss = 1e6

        def _safe_mxl_logloss(x=None, **kwargs):
            _x = np.asarray(x if x is not None else mxl.pvals, dtype=float)
            try:
                _value = float(_guarded_logloss(x, **kwargs))
            except Exception:
                _value = float('inf')
            if np.isfinite(_value):
                return _value
            _delta = _x - _start_pvals
            return _invalid_loss + 0.01 * _invalid_loss * float(np.dot(_delta, _delta))

        def _safe_mxl_d_logloss(x=None, **kwargs):
            _x = np.asarray(x if x is not None else mxl.pvals, dtype=float)
            try:
                _gradient = np.asarray(_guarded_d_logloss(x, **kwargs), dtype=float)
            except Exception:
                _gradient = np.full_like(_x, np.nan, dtype=float)
            if np.all(np.isfinite(_gradient)):
                return _gradient
            return 0.02 * _invalid_loss * (_x - _start_pvals)

        mxl.logloss = _safe_mxl_logloss
        mxl.d_logloss = _safe_mxl_d_logloss
        try:
            mxl.maximize_loglike(
                method='slsqp',
                stderr=True,
                options={'ftol': 1e-9, 'maxiter': 300},
                quiet=True,
            )
        finally:
            mxl.logloss = _guarded_logloss
            mxl.d_logloss = _guarded_d_logloss
            _enet.__exit__(None, None, None)

        pf = mxl.pf
        try:
            ll = float(mxl.loglike(check_if_best=False, error_if_bad=False))
        except Exception:
            ll = float('nan')
        coefs = {name: float(pf.loc[name, 'value']) for name in pf.index}
        if not np.isfinite(ll) or not any(np.isfinite(value) for value in coefs.values()):
            return None, None
        if start_values is not None and not any(
                np.isfinite(value) and name in start_values
                and abs(value - start_values[name]) > 1e-10
                for name, value in coefs.items()):
            return None, None
        se_col = next((col for col in ('std_err', 'se', 'stderr') if col in pf.columns), None)
        std_err = {name: float(pf.loc[name, se_col]) if se_col else float('nan')
                   for name in pf.index}
        tstat = {name: (coefs[name] / std_err[name]
                        if np.isfinite(std_err[name]) and std_err[name] != 0 else 0.0)
                 for name in pf.index}
        logsum_coefs = dict(coefs)
        for param, sd_name, distribution in random_params:
            if distribution != 'neglognormal':
                continue
            mu = float(coefs.get(param, np.nan))
            sigma = max(float(coefs.get(sd_name, 0.0)), 0.0)
            if np.isfinite(mu) and np.isfinite(sigma):
                logsum_coefs[param] = -float(np.exp(np.clip(mu + 0.5 * sigma ** 2,
                                                          -20.0, 20.0)))
        randvars = {param: ('NegLogNormal' if distribution == 'neglognormal' else 'Normal')
                    for param, _, distribution in random_params}
        n_params = sum(
            not bool(pf.loc[name].get('holdfast', False))
            for name in pf.index
        )
        result = {
            'coef': coefs,
            'std_err': std_err,
            'tstat': tstat,
            'll': ll,
            'rho2': _rho_sq_null(mxl, ll),
            'randvars': randvars,
            'n_params': int(n_params),
            'n_draws': int(n_draws),
            'distribution_policy': dict(distribution_policy),
            'logsum_coef': logsum_coefs,
            'logsum_method': 'effective_mean_random_coefficient',
        }
        mxl._coef_cache = {name: value for name, value in coefs.items()
                           if np.isfinite(value)}
        return result, mxl
    except Exception as exc:
        logger.warning(f"[{segment}] selected-mode MXL failed: {exc}")
        return None, None


def _estimate_mixed_logit(seg: pd.DataFrame, segment: str,
                          n_draws: int = 200, seed: int = 42,
                          mode_model=None, distribution_policy: dict = None) -> dict:
    """
    Estimate a mixed logit mode choice model using Larch's native mixtures API.

    Follows Professor Ken Train's approach from the mixed-logit notebook:
        1. Build a standard NL model (already done - this refits a fresh one)
        2. Add Normal mixtures for taste-heterogeneous parameters
        3. Set n_draws and seed, then maximize_loglike

    Random coefficients (heterogeneous across travellers):
        c_ivt        ~ Normal(mean, sd)  - IVT sensitivity varies by person
        c_walk_dist  ~ Normal(mean, sd)  - walk distance sensitivity varies
        c_bike_dist  ~ Normal(mean, sd)  - bike distance sensitivity varies

    Fixed coefficients (homogeneous):
        ASCs, availability flags - all ASCs fixed (identified)
        c_veh_avail, c_peak - structural variables, kept fixed

    The groupid is set to person_id so preferences vary across PERSONS not
    across observations (panel correction - see notebook §"Considering Panel Data").

    Parameters
    ----------
    seg      : filtered segment DataFrame (output of _filter_seg)
    segment  : 'work', 'edu', or 'nonmand'
    n_draws  : Halton draws (200 default - increase to 500+ for final results)
    seed     : random seed for Halton sequence

    Returns
    -------
    dict with keys: coef, std_err, tstat, ll, rho2, randvars, n_obs
    or None on failure.
    """
    if mode_model is not None and distribution_policy:
        return _estimate_mode_model_mixed_logit(
            mode_model, segment, distribution_policy, n_draws=n_draws, seed=seed)
    try:
        if len(seg) > MAX_MXL_OBS:
            logger.info(
                f"[{segment}] Mixed logit: {len(seg)} observations exceeds "
                f"MAX_MXL_OBS={MAX_MXL_OBS} - subsampling to {MAX_MXL_OBS} for estimation"
            )
            seg = seg.sample(n=MAX_MXL_OBS, random_state=seed)

        # ── rebuild a fresh mode tree for this segment ────────────────
        # We can't reuse dt_m from the outer function scope here, so we
        # use the segment DataFrame directly - seg already has ptour_id index
        # The standard NL mode model is already estimated; here we build a
        # parallel MXL on the same data using Larch's mixtures API.

        # Import the datatree and landuse from outer scope isn't possible here;
        # instead we build a simplified MNL ca model from the segment's flat data.
        # This is sufficient for the MXL - we don't need the full DataTree.

        # Build idca dataset: one row per (tour × mode)
        # ── Pull per-observation skim values (merged by _run_segment) ────
        # SOVTOLL_TIME__AM: auto IVT in minutes (may have been merged)
        # DISTWALK / DISTBIKE: km - converted to time at 5 / 15 km/h
        # WLK_LOC_WLK_TOTIVT__AM: transit IVT minutes
        # walk_avail / bike_avail: distance-based availability flags
        alt_ids   = list(MODE_MAP.values())   # [1,2,3,4,5]
        rows = []

        # median IVT for this segment - used as denominator to scale to
        # a ~[-2, 0] range for numerical stability
        ivt_vals = pd.to_numeric(seg.get('SOVTOLL_TIME__AM', pd.Series(30.0,
                                  index=seg.index)), errors='coerce').fillna(30.0)
        ivt_median = max(float(ivt_vals.median()), 1.0)

        # ── GSE gradient score g_n (Gradient Score Enhanced mixed logit) ──────
        # SearchLibrium's MixedLogitGSE fits β_nk = μ_k + γ_k·g_nk + σ_k·η_nk,
        # where g_nk is a per-person exogenous "gradient score" (origin
        # accessibility / land-use context). In Larch this decomposes exactly:
        #   μ_k·x_k        → the ordinary term (already in utility_ca)
        #   γ_k·(g_n·x_k)  → a SYSTEMATIC interaction column (added below)
        #   σ_k·(η_nk·x_k) → the Normal mixture (added in Step 2, mxl.mixtures)
        # so enabling GSE + the existing mixtures reproduces the full GSE model.
        # g_n here = standardised origin accessibility (the mode-choice analogue
        # of the imove/gonzalo per-type ACDC-at-origin gradient score).
        _gse_enabled = os.environ.get('STAGE5_ENABLE_GSE', '0') == '1'
        _gse_map = {}
        if _gse_enabled:
            _gcands = [c for c in ('auto_work_acc', 'walk_acc', 'transit_acc',
                                   'auto_shop_acc', 'auto_nonmand_acc', 'incp')
                       if c in seg.columns]
            if _gcands:
                _gser = pd.to_numeric(seg[_gcands[0]], errors='coerce').fillna(0.0)
                _gmu, _gsd = float(_gser.mean()), float(_gser.std())
                _gz = (_gser - _gmu) / (_gsd + 1e-8)   # standardised, O(1)
                _gse_map = dict(zip(seg['ptour_id'].astype(str), _gz))
                logger.info(f"[{segment}] GSE enabled: gradient score = "
                            f"standardised '{_gcands[0]}' over {len(_gse_map)} tours")
            else:
                _gse_enabled = False
                logger.warning(f"[{segment}] GSE requested but no origin "
                               "accessibility/income column present — disabled")

        for _, tour in seg.iterrows():
            pid     = str(tour['ptour_id'])
            chosen  = int(tour.get('tour_mode', 1))

            # auto IVT - use actual skim value if present, else 30 min
            auto_ivt_min  = float(tour.get('SOVTOLL_TIME__AM', 30.0)) or 30.0
            # walk/bike distances → time in minutes
            walk_dist_km  = float(tour.get('DISTWALK',    20.0)) or 20.0
            bike_dist_km  = float(tour.get('DISTBIKE',    20.0)) or 20.0
            walk_time_min = walk_dist_km  * 12.0    # 5 km/h → 12 min/km
            bike_time_min = bike_dist_km  * 4.0     # 15 km/h → 4 min/km
            # transit IVT - use walk-to-transit time if present
            transit_ivt   = float(tour.get('WLK_LOC_WLK_TOTIVT__AM',
                                           auto_ivt_min * 1.5)) or auto_ivt_min * 1.5

            walk_ok = int(tour.get('walk_avail', int(walk_dist_km < 10.0)))
            bike_ok = int(tour.get('bike_avail', int(bike_dist_km < 25.0)))

            # ── person-level attributes (idco → encoded as alt-specific zeros) ─
            vehrd   = float(tour.get('vehrd', 1.0))
            licence = float(tour.get('CARLICENCE', 1.0))
            noveh   = float(vehrd == 0)
            ftwork  = float(int(tour.get('WORKSTAT', 0)) == 1)
            ptwork  = float(int(tour.get('WORKSTAT', 0)) == 2)
            age5p   = float(tour.get('age5p', 3.0))
            young   = float(age5p <= 5)
            nprd    = float(tour.get('nprd', 2.0))
            bikes   = float(tour.get('bikes', 0.0))
            female  = float(int(tour.get('sexp', 0)) == 2)
            incp    = float(tour.get('incp', 50.0))

            # ── Industry of employment (ANZSIC 1-digit, 'indp') ──────────────
            # Groups that strongly predict DA captivity vs transit amenability.
            # 'indp' int 1-20; if absent default to 20 (not employed/other).
            _indp_raw = int(tour.get('indp', 20) or 20)
            _ind_grp  = INDUSTRY_MODE_GROUP.get(_indp_raw, 'other')
            ind_industrial = float(_ind_grp in ('industrial', 'agri'))
            ind_office     = float(_ind_grp in ('office', 'professional'))
            ind_public     = float(_ind_grp == 'public')
            ind_health     = float(_ind_grp == 'health')
            ind_retail     = float(_ind_grp in ('retail', 'hospitality'))

            # ── Occupation (ANZSCO 1-digit, 'occp') ──────────────────────────
            # 1=Managers, 2=Professionals → office locations → mixed modal
            # 5=Clerical/Admin → CBD offices → more transit-amenable
            # 7=Machinery Operators, 8=Labourers → site work → DA captive
            _occp_raw = int(tour.get('occp', 0) or 0)
            occ_mgr_prof = float(_occp_raw in (1, 2))
            occ_labourer = float(_occp_raw in (7, 8))
            occ_clerical = float(_occp_raw == 5)

            # ── Studying status (1=not studying, 2=ft, 3=pt, 4=other) ────────
            _stup_raw = int(tour.get('stup', 1) or 1)
            is_ft_student = float(_stup_raw == 2)
            is_pt_student = float(_stup_raw in (3, 4))

            for alt in alt_ids:
                # Match MODE_UEC expressions exactly:
                #   auto/transit: SOVTOLL_TIME__AM / 60 → hours
                #   walk:         log(DISTWALK * 12 + 1) → log-minutes at 5 km/h
                #   bike:         log(DISTBIKE * 4  + 1) → log-minutes at 15 km/h
                if alt in (1, 2):        # DA, Other - auto hours
                    ivt_h       = auto_ivt_min  / 60.0
                    walk_logmin = 0.0
                    bike_logmin = 0.0
                elif alt == 5:           # Transit - hours
                    ivt_h       = transit_ivt   / 60.0
                    walk_logmin = 0.0
                    bike_logmin = 0.0
                elif alt == 3:           # Walk - log(minutes + 1)
                    ivt_h       = 0.0
                    walk_logmin = float(np.log(walk_time_min + 1.0))
                    bike_logmin = 0.0
                else:                    # Bike - log(minutes + 1)
                    ivt_h       = 0.0
                    walk_logmin = 0.0
                    bike_logmin = float(np.log(bike_time_min + 1.0))

                avail = 1
                if alt == 3 and not walk_ok:
                    avail = 0
                if alt == 4 and not bike_ok:
                    avail = 0

                # Encode personalized attributes as alt-specific columns
                # (idco → idca: place value only for the relevant alternatives)
                rows.append({
                    'case_id':      pid,
                    'alt_id':       alt,
                    'chosen':       int(chosen == alt),
                    'avail':        avail,
                    'gse_g':        float(_gse_map.get(pid, 0.0)),  # GSE gradient score
                    'mxl_ca_ivt_h':   ivt_h,        # hours (auto/transit)
                    'mxl_ca_walk_h':  walk_logmin,  # log-minutes (walk)
                    'mxl_ca_bike_h':  bike_logmin,  # log-minutes (bike); keep names unique to avoid rewrite collisions
                    # global-cache collision: the NL DataTree model compiles log(od.DISTBIKE*4+1)
                    # and sharrow internally caches the result as 'bike_logmin'.  Using the same
                    # name here in the flat-Dataset MXL model can cause a circular
                    # "rewrite to itself" compile error if it collides with cached symbols.
                    # vehicle ownership - DA / Other
                    'p_vehrd_da':   vehrd   if alt == 1 else 0.0,
                    'p_vehrd_sr':   vehrd   if alt == 2 else 0.0,
                    # no-vehicle → transit / walk
                    'p_noveh_tr':   noveh   if alt == 5 else 0.0,
                    'p_noveh_wk':   noveh   if alt == 3 else 0.0,
                    # licence → DA
                    'p_lic_da':     licence if alt == 1 else 0.0,
                    # worker type → DA / SR
                    'p_ftw_da':     ftwork  if alt == 1 else 0.0,
                    'p_ptw_sr':     ptwork  if alt == 2 else 0.0,
                    # age → walk / bike penalty
                    'p_age_wk':     age5p   if alt == 3 else 0.0,
                    'p_age_bk':     age5p   if alt == 4 else 0.0,
                    'p_young_bk':   young   if alt == 4 else 0.0,
                    # household size → SR
                    'p_nprd_sr':    nprd    if alt == 2 else 0.0,
                    # bike ownership → bike
                    'p_bikes_bk':   bikes   if alt == 4 else 0.0,
                    # sex → transit / walk
                    'p_fem_tr':     female  if alt == 5 else 0.0,
                    'p_fem_wk':     female  if alt == 3 else 0.0,
                    # income → DA (positive) / transit (negative)
                    'p_incp_da':    incp    if alt == 1 else 0.0,
                    'p_incp_tr':    incp    if alt == 5 else 0.0,
                    # ── Industry of employment ────────────────────────────
                    # Industrial/agri workers → DA (remote sites, no transit service)
                    'p_ind_da':     ind_industrial if alt == 1 else 0.0,
                    # Office/professional → slightly more transit
                    'p_off_tr':     ind_office     if alt == 5 else 0.0,
                    # Public sector (admin/education) → transit-amenable CBD locations
                    'p_pub_tr':     ind_public     if alt == 5 else 0.0,
                    'p_pub_wk':     ind_public     if alt == 3 else 0.0,
                    # Health workers → transit (hospitals well-served)
                    'p_hlt_tr':     ind_health     if alt == 5 else 0.0,
                    # Retail/hospitality → SR (variable hours reduce PT use)
                    'p_ret_sr':     ind_retail     if alt == 2 else 0.0,
                    # ── Occupation (ANZSCO 1-digit) ───────────────────────
                    # Managers/Professionals → DA (flexible hours, employer parking)
                    'p_mgr_da':     occ_mgr_prof   if alt == 1 else 0.0,
                    # Labourers/Machinery → DA (site-based, tools/equipment)
                    'p_lab_da':     occ_labourer   if alt == 1 else 0.0,
                    # Clerical/Admin → transit (CBD offices, regular hours)
                    'p_clr_tr':     occ_clerical   if alt == 5 else 0.0,
                    # ── Studying status ───────────────────────────────────
                    # Full-time students → transit + walk (campus access)
                    'p_fts_tr':     is_ft_student  if alt == 5 else 0.0,
                    'p_fts_wk':     is_ft_student  if alt == 3 else 0.0,
                    'p_fts_bk':     is_ft_student  if alt == 4 else 0.0,
                    # Part-time students → slight transit preference
                    'p_pts_tr':     is_pt_student  if alt == 5 else 0.0,
                })

        mxl_df = pd.DataFrame(rows)
        # MultiIndex: (case_id, alt_id)
        mxl_df = mxl_df.set_index(['case_id', 'alt_id'])

        try:
            mxl_df.loc[mxl_df['chosen'] == 1, 'avail'] = 1
        except Exception:
            pass

        # build larch Dataset
        ds = lx.Dataset.construct.from_idca(mxl_df)

        # ── Step 1: MNL baseline ──────────────────────────────────────────
        mnl = _lx_model(ds, compute_engine='jax')
        _apply_param_ordering(mnl, kind='mode')
        mnl.choice_ca_var       = 'chosen'
        mnl.availability_ca_var = 'avail'
        mnl.utility_ca = (
            P('c_ivt')          * X('mxl_ca_ivt_h')
            + P('c_walk')       * X('mxl_ca_walk_h')
            + P('c_bike')       * X('mxl_ca_bike_h')
            # vehicle ownership / licence
            + P('c_vehrd_da')   * X('p_vehrd_da')
            + P('c_vehrd_sr')   * X('p_vehrd_sr')
            + P('c_noveh_tr')   * X('p_noveh_tr')
            + P('c_noveh_wk')   * X('p_noveh_wk')
            + P('c_lic_da')     * X('p_lic_da')
            # worker type
            + P('c_ftw_da')     * X('p_ftw_da')
            + P('c_ptw_sr')     * X('p_ptw_sr')
            # age / demographics
            + P('c_age_wk')     * X('p_age_wk')
            + P('c_age_bk')     * X('p_age_bk')
            + P('c_young_bk')   * X('p_young_bk')
            + P('c_nprd_sr')    * X('p_nprd_sr')
            + P('c_bikes_bk')   * X('p_bikes_bk')
            + P('c_fem_tr')     * X('p_fem_tr')
            + P('c_fem_wk')     * X('p_fem_wk')
            + P('c_incp_da')    * X('p_incp_da')
            + P('c_incp_tr')    * X('p_incp_tr')
            # ── industry of employment ────────────────────────────────────
            + P('c_ind_da')     * X('p_ind_da')   # industrial/agri → DA
            + P('c_off_tr')     * X('p_off_tr')   # office/professional → transit
            + P('c_pub_tr')     * X('p_pub_tr')   # public sector → transit
            + P('c_pub_wk')     * X('p_pub_wk')   # public sector → walk
            + P('c_hlt_tr')     * X('p_hlt_tr')   # health workers → transit
            + P('c_ret_sr')     * X('p_ret_sr')   # retail/hospitality → SR
            # ── occupation ────────────────────────────────────────────────
            + P('c_mgr_da')     * X('p_mgr_da')   # managers/professionals → DA
            + P('c_lab_da')     * X('p_lab_da')   # labourers → DA
            + P('c_clr_tr')     * X('p_clr_tr')   # clerical → transit
            # ── studying ─────────────────────────────────────────────────
            + P('c_fts_tr')     * X('p_fts_tr')   # FT students → transit
            + P('c_fts_wk')     * X('p_fts_wk')   # FT students → walk
            + P('c_fts_bk')     * X('p_fts_bk')   # FT students → bike
            + P('c_pts_tr')     * X('p_pts_tr')   # PT students → transit
        )
        # ASCs (DA=0 reference) + random DA affinity term
        # c_da_aff captures person-level taste heterogeneity in DA preference;
        # made random (Normal) in Step 2 below.
        for alt, name in [(2,'ASC_SR'),(3,'ASC_Walk'),(4,'ASC_Bike'),(5,'ASC_Transit')]:
            mnl.utility_co[alt] = P(name)
        mnl.utility_co[1] = P('c_da_aff')   # DA affinity (fixed in MNL, random in MXL)

        # ── GSE systematic gradient loadings γ_k·(g_n·x_k) ────────────────────
        # Add the gradient-score interaction for each random taste parameter, so
        # its mean shifts systematically with the person's origin context before
        # the Normal mixture (Step 2) adds σ_k·η_nk on top. Together this is the
        # exact MixedLogitGSE decomposition, estimated natively in Larch.
        if _gse_enabled:
            mnl.utility_ca = (
                mnl.utility_ca
                + P('g_ivt')  * X('mxl_ca_ivt_h * gse_g')
                + P('g_walk') * X('mxl_ca_walk_h * gse_g')
                + P('g_bike') * X('mxl_ca_bike_h * gse_g')
            )
            # DA affinity gradient loading (g_n shifts the person-specific DA ASC)
            mnl.utility_co[1] = P('c_da_aff') + P('g_da') * X('gse_g')
            for _gp in ('g_ivt', 'g_walk', 'g_bike', 'g_da'):
                try:
                    mnl.set_value(_gp, 0.0)
                except Exception:
                    pass
            logger.info(f"[{segment}] GSE systematic loadings added "
                        "(g_ivt, g_walk, g_bike, g_da) — full GSE = μ + γ·g + σ·η")

        # Starting values from SEGMENT_COEFFICIENTS if available, else defaults.
        seg_init = SEGMENT_COEFFICIENTS.get(segment, {})
        mnl.set_value('c_ivt',        -1.20)
        mnl.set_value('c_walk',       -1.50)
        mnl.set_value('c_bike',       -1.00)
        mnl.set_value('ASC_SR',    seg_init.get('ASC_SR',     -0.5))
        mnl.set_value('ASC_Walk',     seg_init.get('ASC_Walk',   -3.0))
        mnl.set_value('ASC_Bike',     seg_init.get('ASC_Bike',   -3.5))
        mnl.set_value('ASC_Transit',  seg_init.get('ASC_Transit',-1.5))
        mnl.set_value('c_vehrd_da',   seg_init.get('c_veh_da',    0.30))
        mnl.set_value('c_vehrd_sr',   seg_init.get('c_veh_sr',    0.10))
        mnl.set_value('c_noveh_tr',   seg_init.get('c_noveh_transit', 2.0))
        mnl.set_value('c_noveh_wk',   seg_init.get('c_noveh_walk',    1.5))
        # c_lic_da removed - CARLICENCE is now a hard availability constraint
        mnl.set_value('c_ftw_da',     seg_init.get('c_ftwork_da',     0.5))
        mnl.set_value('c_ptw_sr',     seg_init.get('c_ptwork_sr',     0.2))
        mnl.set_value('c_age_wk',     seg_init.get('c_age_walk',     -0.10))
        mnl.set_value('c_age_bk',     seg_init.get('c_age_bike',     -0.15))
        mnl.set_value('c_young_bk',   seg_init.get('c_young_bike',    0.50))
        mnl.set_value('c_nprd_sr',    seg_init.get('c_hhsize_sr',     0.10))
        mnl.set_value('c_bikes_bk',   seg_init.get('c_bikes_bike',    0.40))
        mnl.set_value('c_fem_tr',     seg_init.get('c_female_transit',0.30))
        mnl.set_value('c_fem_wk',     seg_init.get('c_female_walk',   0.20))
        mnl.set_value('c_incp_da',    seg_init.get('c_incp_da',       0.010))
        mnl.set_value('c_incp_tr',    seg_init.get('c_incp_transit',  -0.015))
        # DA affinity: random intercept (zero mean at MNL start; becomes random in MXL)
        mnl.set_value('c_da_aff',     0.0)
        # ── Industry starting values (behaviorally calibrated to SEQ context) ──
        # Industrial/agri → DA: strong positive (remote sites, no PT service)
        mnl.set_value('c_ind_da',     0.70)
        # Office/professional → transit: modest (CBD access, some parking costs)
        mnl.set_value('c_off_tr',     0.25)
        # Public sector → transit: stronger (CBDs, Education/Health precincts)
        mnl.set_value('c_pub_tr',     0.45)
        mnl.set_value('c_pub_wk',     0.15)
        # Health workers → transit: hospitals on PT corridors
        mnl.set_value('c_hlt_tr',     0.30)
        # Retail/hospitality → SR: variable hours reduce transit feasibility
        mnl.set_value('c_ret_sr',     0.20)
        # ── Occupation starting values ──────────────────────────────────────
        mnl.set_value('c_mgr_da',     0.25)   # managers → employer parking, DA
        mnl.set_value('c_lab_da',     0.50)   # labourers → tools/equipment, DA
        mnl.set_value('c_clr_tr',     0.30)   # clerical → CBD office, transit
        # ── Studying starting values ────────────────────────────────────────
        mnl.set_value('c_fts_tr',     0.55)   # FT students → campus transit
        mnl.set_value('c_fts_wk',     0.30)   # FT students → campus walkable
        mnl.set_value('c_fts_bk',     0.20)   # FT students → cycling
        mnl.set_value('c_pts_tr',     0.20)   # PT students → some transit
        mnl.set_cap(8)

        for _p in (
            'c_clr_tr', 'c_mgr_da', 'c_lab_da', 'c_ind_da', 'c_off_tr',
            'c_pub_tr', 'c_pub_wk', 'c_hlt_tr', 'c_ret_sr',
            'c_fts_tr', 'c_fts_wk', 'c_fts_bk', 'c_pts_tr'
        ):
            try:
                if _p in mnl.pf.index:
                    # NOTE: Model has NO set_upper/set_lower_bound methods -
                    # those calls raised AttributeError and were silently
                    # swallowed, so these +/-3 caps never applied. Use the
                    # pf-level helper instead.
                    _pf_set(mnl, _p, 'minimum', -3.0)
                    _pf_set(mnl, _p, 'maximum', 3.0)
            except Exception:
                pass

        # Sign constraints - prevent behaviorally implausible outcomes
        # c_ivt_* must be negative (more travel time → less utility)
        # c_crash_veh must be ≤ 0 (more crash risk → less utility for vehicle modes)
        for _p in ('c_ivt_auto', 'c_ivt_transit', 'c_walk_time', 'c_bike_time'):
            try:
                mnl.set_value(_p, min(mnl.get_value(_p), -0.01))
                # set_upper constrains param ≤ value during optimisation
                mnl.set_upper(_p, -0.001)
            except Exception:
                pass
        try:
            mnl.set_upper('c_crash_veh', 0.0)
        except Exception:
            pass

        _ennet_mnl = elasticnet_objective(mnl)
        _ennet_mnl.__enter__()
        try:
            mnl.maximize_loglike(options={'ftol': 1e-9, 'maxiter': 500}, quiet=True)
        finally:
            _ennet_mnl.__exit__(None, None, None)

        # ── Step 2: Add Normal mixtures ───────────────────────────────────
        # Random parameters capture taste heterogeneity across persons:
        #   c_ivt      ~ Normal: IVT sensitivity varies (commuters vs leisure)
        #   c_walk     ~ Normal: walk aversion varies (fitness, weather sensitivity)
        #   c_bike     ~ Normal: bike aversion varies (infrastructure access)
        #   c_da_aff   ~ Normal: DA affinity varies (person-specific constant)
        #                        Key driver of DA dominance - individuals who
        #                        intrinsically prefer driving regardless of time.
        mxl = mnl.copy()
        _random_params = [
            ('c_ivt',    's_ivt'),    # IVT sensitivity ~ Normal(c_ivt, s_ivt)
            ('c_walk',   's_walk'),   # walk aversion   ~ Normal(c_walk, s_walk)
            ('c_bike',   's_bike'),   # bike aversion   ~ Normal(c_bike, s_bike)
            ('c_da_aff', 's_da'),     # DA affinity     ~ Normal(c_da_aff, s_da)
        ]
        # Central random-coefficient policy: never_random filters the list,
        # force_random + GA_STAGE5_RAND extend it (any Larch param present in
        # the fitted MNL can be promoted to a random coefficient).
        try:
            from ga_constraints import get_constraints, stage5_extra_random_params
            _c5 = get_constraints('stage5_mode')
            _never5 = set(_c5.get('never_random', []))
            _random_params = [(p, s) for p, s in _random_params if p not in _never5]
            _have5 = {p for p, _ in _random_params}
            _extras = [p for p in list(_c5.get('force_random', {}).keys())
                       + stage5_extra_random_params()
                       if p not in _have5 and p not in _never5]
            for _p in _extras:
                if _p in mnl.pf.index:
                    _sd = 's_' + (_p[2:] if _p.startswith('c_') else _p)
                    _random_params.append((_p, _sd))
                    logger.info(f"[{segment}] MXL: added random coefficient {_p} ~ N(., {_sd}) "
                                "(ga_constraints policy)")
        except Exception as _rp_e:
            logger.debug(f"[{segment}] MXL random-param policy skipped: {_rp_e}")
        for param, sd_name in _random_params:
            mxl.mixtures.append(lx.mixtures.Normal(param, sd_name))

        mxl.n_draws = n_draws
        mxl.seed    = seed

        # Initialise std dev params at 0.5 with positive lower bound so the
        # gradient is non-trivial from the start.  Starting at 1.0 puts the
        # model in a near-flat region; 0.5 keeps gradients alive.
        # set_lower_bound enforces s > 0 so the Normal draw is always meaningful.
        # NOTE: Model has NO set_lower_bound/set_upper methods - the original
        # calls raised AttributeError, the silent fallback left symmetric ±5
        # bounds, and BFGS (bounds-blind) drove s_* NEGATIVE (observed
        # s_ivt=-2.04).  Enforce [0.01, 5] at pf level instead.
        for _, sd_name in _random_params:
            try:
                mxl.set_value(sd_name, 0.5)
            except Exception:
                pass
            try:
                _pf_set(mxl, sd_name, 'minimum', 0.01)
                _pf_set(mxl, sd_name, 'maximum', 5.0)
                if float(mxl.pf.loc[sd_name, 'minimum']) != 0.01:
                    raise ValueError(f"minimum bound not applied for {sd_name}")
            except Exception as _sd_e:
                logger.warning(
                    f"[{segment}] MXL: could not enforce positive std-dev "
                    f"bound on {sd_name} ({_sd_e!r}) - falling back to cap"
                )
                try:
                    mxl.set_cap(sd_name, 5.0)
                except Exception:
                    pass

        # No groupid panel correction - person_id is the index so sharrow
        # cannot rewrite it as a regular column (causes 'unable to rewrite' error).
        mxl_final = mxl

        # Snapshot starting values so an all-stuck (zero gradient) outcome can
        # be detected after estimation — see check below coefficient extraction.
        try:
            _mxl_start_vals = {name: float(mxl_final.pf.loc[name, 'value'])
                               for name in mxl_final.pf.index}
        except Exception:
            _mxl_start_vals = None

        print(f"\n  Estimating mixed logit ({n_draws} Halton draws)...")

        # ── best-of-two-phases optimisation ────────────────────────────────
        # The original blind BFGS->SLSQP chain had a catastrophic failure
        # mode: BFGS (which ignores parameter bounds) found a good point,
        # then SLSQP - started from that out-of-bounds vector and handed an
        # ultra-tight ftol - REGRESSED the penalized objective massively yet
        # reported 'terminated successfully' (observed LL -74.05 -> -348.49),
        # and the code kept whichever phase landed last.  Track the best
        # parameter vector across phases by fresh UNPENALIZED loglike
        # (elasticnet_objective patches logloss/d_logloss but NOT loglike, so
        # this is the true likelihood even inside the context) and restore it
        # at the end.

        def _mxl_unpen_ll() -> float:
            try:
                return float(mxl_final.loglike())
            except Exception:
                return float('nan')

        def _clip_to_bounds(vec: np.ndarray) -> np.ndarray:
            """Project a parameter vector into [pminimum, pmaximum].

            BFGS is bounds-blind and will happily inflate Normal-mixture std
            devs to 1e5+ (simulator degeneracy: huge sigma one-hot-fits each
            case).  Clipping the candidate into the declared feasibility box
            keeps the kept vector meaningful and inside the s>=0.01, s<=5
            contract intended for the mixture scales."""
            try:
                lo = np.asarray(mxl_final.pminimum, dtype=float)
                hi = np.asarray(mxl_final.pmaximum, dtype=float)
                out = np.where(np.isfinite(lo), np.maximum(vec, lo), vec)
                out = np.where(np.isfinite(hi), np.minimum(out, hi), out)
                return np.nan_to_num(out, nan=0.0,
                                     posinf=0.0, neginf=0.0) \
                    if not np.all(np.isfinite(out)) else out
            except Exception:
                return vec

        _start_x = np.asarray(mxl_final.pvals, dtype=float).copy()
        _start_x = _clip_to_bounds(_start_x)
        mxl_final.pvals = _start_x
        _best_x = _start_x.copy()
        _best_ll = _mxl_unpen_ll()
        if not np.isfinite(_best_ll):
            _best_x = None   # nothing sane to fall back to

        _ennet_mxl = elasticnet_objective(mxl_final)
        _ennet_mxl.__enter__()
        try:
            # Phase A: BFGS moves params far from start, fast.  BFGS is
            # bounds-blind, so the candidate is clipped back into the
            # feasibility box before it can be kept.
            try:
                mxl_final.maximize_loglike(
                    stderr=False,
                    method='BFGS',
                    # gtol IS valid for BFGS (do not route through _slsqp_options)
                    options={'gtol': 1e-4, 'maxiter': 200},
                    quiet=True,
                )
                _cand_a = _clip_to_bounds(
                    np.asarray(mxl_final.pvals, dtype=float))
                mxl_final.pvals = _cand_a
                _ll_a = _mxl_unpen_ll()
                if np.isfinite(_ll_a) and (_best_x is None or _ll_a > _best_ll):
                    _best_x = _cand_a.copy()
                    _best_ll = _ll_a
            except Exception:
                pass
            # Phase A may have left params outside bounds (BFGS is bounds-
            # blind); restore the best feasible-so-far vector before phase B
            # so SLSQP starts in-bounds.
            if _best_x is not None:
                mxl_final.pvals = _best_x
            # Phase B: SLSQP refine from an in-bounds start.
            # (gtol is BFGS-only; SLSQP ignores it with a warning.)
            try:
                mxl_final.maximize_loglike(
                    stderr=False,
                    options=_slsqp_options({'ftol': 1e-10, 'maxiter': 800}),
                    quiet=True,
                )
            except Exception:
                pass
            _cand_b = _clip_to_bounds(
                np.asarray(mxl_final.pvals, dtype=float))
            mxl_final.pvals = _cand_b
            _ll_b = _mxl_unpen_ll()
        finally:
            _ennet_mxl.__exit__(None, None, None)

        if np.isfinite(_ll_b) and (_best_x is None or _ll_b > _best_ll):
            _best_ll = _ll_b                  # pvals already hold this vector
        elif _best_x is not None:
            _cur = np.asarray(mxl_final.pvals, dtype=float)
            if not np.array_equal(_cur, _best_x):
                mxl_final.pvals = _best_x     # phase B regressed - restore

        # ── extract results ──────────────────────────────────────────
        pf   = mxl_final.pf
        ll   = _best_ll          # true unpenalized LL at the kept parameters
        rho2 = _rho_sq_null(mxl_final, ll)

        coefs  = {name: float(pf.loc[name, 'value'])   for name in pf.index}
        _finite_coefs = {k: v for k, v in coefs.items() if np.isfinite(v)}
        if not _finite_coefs:
            logger.warning(f"[{segment}] MXL returned no finite coefficients - falling back to NL")
            return None, None
        # All-stuck detection: job 23540863's nonmand MXL finished with all 32
        # params (incl. every ASC and Mu_Motor) exactly at their starting
        # values — the jax gradient was zero, so the optimizer never moved. A
        # prior-valued MXL is strictly worse than the NL fallback, which
        # estimates correctly, so treat all-stuck the same as no-finite.
        if _mxl_start_vals is not None:
            _any_moved = any(
                np.isfinite(v) and p in _mxl_start_vals
                and abs(v - _mxl_start_vals[p]) > 1e-12
                for p, v in coefs.items()
            )
            if not _any_moved:
                logger.warning(
                    f"[{segment}] MXL: ALL {len(coefs)} params unmoved from their "
                    "starting values (zero gradient — jax engine returned no "
                    "usable gradient) - falling back to NL"
                )
                return None, None
        # std_err column name varies across Larch versions ('std_err', 'se', 'stderr')
        _se_col = next((c for c in ['std_err', 'se', 'stderr'] if c in pf.columns), None)
        ses    = {name: float(pf.loc[name, _se_col]) if _se_col else float('nan')
                  for name in pf.index}
        tstats = {name: (coefs[name] / ses[name] if ses.get(name, 0) != 0 else 0.0)
                  for name in pf.index}

        _rand_names = {p for p, _ in _random_params}
        result = {
            'coef':     coefs,
            'std_err':  ses,
            'tstat':    tstats,
            'll':       ll,
            'rho2':     rho2,
            'randvars': {p: 'Normal' for p in _rand_names},
            'n_obs':    len(seg),
            'n_draws':  n_draws,
        }

        # print summary
        print(f"\n  ┌─ {segment.upper()} Mixed Logit  LL={ll:.1f}  �²={rho2:.3f}"
              f"  draws={n_draws} ─────────────────")
        print(f"  {'Parameter':<25} {'Value':>9}  {'Std Err':>8}  {'t-stat':>7}  Type")
        print(f"  {'─'*65}")
        rand_params_set = _rand_names | {f's_{p[2:]}' if p.startswith('c_') else f's_{p}'
                                         for p in _rand_names}
        for name in pf.index:
            v  = coefs[name]; se = ses[name]; t = tstats[name]
            sig = '***' if abs(t)>3.3 else '**' if abs(t)>2.6 else '*' if abs(t)>1.96 else ''
            kind = ('random~N' if name in _rand_names else
                    'std dev'  if name.startswith('s_') else 'fixed')
            print(f"  {str(name):<25} {v:>9.4f}  {se:>8.4f}  {t:>7.2f}  {sig:<4} {kind}")
        print(f"  └{'─'*65}")

        # ── Compute frozen cell probabilities from HHTS data ──────────────
        # After estimation we evaluate the model at the MEAN coefficients
        # (no random draws) for each HHTS person, then aggregate to person-
        # type cells.  These cells are applied directly to the synthetic
        # population - no re-estimation or MC noise at prediction time.
        frozen_probs = _compute_frozen_probs(seg, result, segment)
        if frozen_probs is not None:
            result['frozen_probs'] = frozen_probs
            logger.info(
                f"[{segment}] MXL frozen probabilities computed: "
                f"{len(frozen_probs)} cells, "
                f"mean DA={frozen_probs['p_DA'].mean():.1%}  "
                f"Walk={frozen_probs['p_Walk'].mean():.1%}  "
                f"Bike={frozen_probs['p_Bike'].mean():.1%}  "
                f"Transit={frozen_probs['p_Transit'].mean():.1%}"
            )
        else:
            logger.warning(f"[{segment}] Frozen probability computation failed - "
                           "falling back to numpy model at prediction time")

        # Inject coefficient cache so _coef_dict_from_model can find coefficients
        # without needing to access model.pf (which may return NaN after JAX
        # compilation clears the internal parameter store).
        _valid_coefs = {k: v for k, v in coefs.items()
                        if not (isinstance(v, float) and np.isnan(v))}
        if _valid_coefs:
            mxl_final._coef_cache = _valid_coefs
            logger.debug(f"[{segment}] MXL _coef_cache injected with "
                         f"{len(_valid_coefs)} params")
        else:
            logger.warning(f"[{segment}] MXL coefs all NaN - _coef_cache not set; "
                           "logsums will use NL model coefficients")

        return result, mxl_final

    except Exception as e:
        logger.warning(f"Mixed logit failed for {segment}: {e}")
        import traceback; logger.debug(traceback.format_exc())
        return None, None


def _compute_frozen_probs(seg_df: pd.DataFrame, mxl_result: dict,
                          segment: str) -> 'pd.DataFrame | None':
    """
    Compute cell-level frozen mode probabilities from HHTS observations.

    Evaluates the MXL model at its MEAN coefficients (deterministic - no Monte
    Carlo draws) for each HHTS observation, then aggregates to person-type cells
    defined by ``FROZEN_CELL_COLS``.  These cells are stored and applied directly
    to the synthetic population, ensuring:
      - Stable, reproducible predictions (zero MC noise across runs)
      - Full transferability: HHTS attributes → identical cell keys in synth pop
      - DA dominance corrected by industry/occupation/studying heterogeneity

    The utility formula mirrors ``_mode_probs_numpy`` with the additional
    industry/occupation/studying terms estimated by ``_estimate_mixed_logit``.

    Returns
    -------
    DataFrame with columns FROZEN_CELL_COLS + FROZEN_PROB_COLS + ['n_obs'],
    or None on failure.
    """
    if not mxl_result or not mxl_result.get('coef'):
        return None
    try:
        coef = mxl_result['coef']

        def pv(name, default=0.0):
            v = coef.get(name)
            if v is None:
                return default
            try:
                fv = float(v)
                return fv if not np.isnan(fv) else default
            except Exception:
                return default

        df = seg_df.copy().reset_index(drop=True)
        n  = len(df)

        def _col(name, default):
            return pd.to_numeric(df.get(name, pd.Series(default, index=df.index)),
                                 errors='coerce').fillna(default).values

        # ── Skim values ────────────────────────────────────────────────────
        ivt_auto_min   = _col('SOVTOLL_TIME__AM', 30.0)
        ivt_transit_min = _col('WLK_LOC_WLK_TOTIVT__AM', 45.0)
        dist_walk_km   = _col('DISTWALK', 5.0)
        dist_bike_km   = _col('DISTBIKE', 5.0)

        ivt_auto_h    = np.clip(ivt_auto_min   / 60.0, 0.05, 5.0)
        ivt_transit_h = np.clip(ivt_transit_min / 60.0, 0.05, 6.0)
        walk_t = np.log(np.clip(dist_walk_km, 0, None) * 12.0 + 1.0)
        bike_t = np.log(np.clip(dist_bike_km, 0, None) * 4.0  + 1.0)

        # ── Person attributes ──────────────────────────────────────────────
        vehrd   = _col('vehrd', 1.0)
        licence = _col('CARLICENCE', 1.0)
        incp    = _col('incp', 7.0)
        age5p   = _col('age5p', 4.0)
        # Age gate on licence (mirrors _mode_probs_numpy): under-15s can never
        # hold a licence, so DA must be unavailable to them even when the
        # CARLICENCE column is missing and defaulted to 1.
        licence = np.where(age5p <= 3, 0.0, licence)
        sexp    = _col('sexp', 1.0)
        noveh   = (vehrd == 0).astype(float)
        female  = (sexp == 2).astype(float)
        young   = (age5p <= 3).astype(float)
        workstat = _col('WORKSTAT', 0.0)
        studying = _col('STUDYING', 0.0)
        is_worker  = np.clip(workstat, 0, 1).astype(float)
        is_student = (studying > 0).astype(float)

        # ── Industry of employment ─────────────────────────────────────────
        indp_raw = _col('indp', 20.0).astype(int)
        _indp_groups = np.array([INDUSTRY_MODE_GROUP.get(int(v), 'other') for v in indp_raw])
        ind_industrial = np.isin(_indp_groups, ['industrial', 'agri']).astype(float)
        ind_office     = np.isin(_indp_groups, ['office', 'professional']).astype(float)
        ind_public     = (_indp_groups == 'public').astype(float)
        ind_health     = (_indp_groups == 'health').astype(float)
        ind_retail     = np.isin(_indp_groups, ['retail', 'hospitality']).astype(float)

        # ── Occupation (ANZSCO 1-digit) ────────────────────────────────────
        occp_raw    = _col('occp', 0.0).astype(int)
        occ_mgr_prof = np.isin(occp_raw, [1, 2]).astype(float)
        occ_labourer = np.isin(occp_raw, [7, 8]).astype(float)
        occ_clerical = (occp_raw == 5).astype(float)

        # ── Studying status ────────────────────────────────────────────────
        stup_raw = _col('stup', 1.0).astype(int)
        is_ft_student = (stup_raw == 2).astype(float)
        is_pt_student = np.isin(stup_raw, [3, 4]).astype(float)

        # ── Availability ───────────────────────────────────────────────────
        walk_avail_arr    = _col('walk_avail', 1.0)
        bike_avail_arr    = _col('bike_avail', 1.0)
        transit_avail_arr = ((ivt_transit_min > 0) & (ivt_transit_min < 90.0)).astype(float)

        # ── Utility at MEAN coefficients ───────────────────────────────────
        V_DA = (pv('c_ivt') * ivt_auto_h
              + pv('c_vehrd_da') * vehrd
              + pv('c_incp_da') * incp
              + pv('c_ftw_da') * is_worker
              + pv('c_da_aff', 0.0)
              + pv('c_ind_da', 0.0) * ind_industrial
              + pv('c_mgr_da', 0.0) * occ_mgr_prof
              + pv('c_lab_da', 0.0) * occ_labourer)
        V_DA = np.where(licence > 0, V_DA, -1e9)

        V_SR = (pv('ASC_SR', -0.5)
              + pv('c_ivt') * ivt_auto_h
              + pv('c_vehrd_sr') * vehrd
              + pv('c_ret_sr', 0.0) * ind_retail)

        V_TR = (pv('ASC_Transit', -0.5)
              + pv('c_ivt') * ivt_transit_h
              + pv('c_noveh_tr') * noveh
              + pv('c_incp_tr') * incp
              + pv('c_fem_tr') * female
              + pv('c_student_tr', pv('c_fts_tr', 0.5)) * is_student
              + pv('c_off_tr', 0.0) * ind_office
              + pv('c_pub_tr', 0.0) * ind_public
              + pv('c_hlt_tr', 0.0) * ind_health
              + pv('c_clr_tr', 0.0) * occ_clerical
              + pv('c_fts_tr', 0.0) * is_ft_student
              + pv('c_pts_tr', 0.0) * is_pt_student)
        V_TR = np.where(transit_avail_arr > 0, V_TR, -1e9)

        # c_incp_active: income effect on Walk/Bike (mirrors MODE_UEC).
        # NL model uses 'c_incp_active'; MXL may use same or 'c_incp_wk'.
        # Without this, high-income persons get income penalty on DA/SR/Transit
        # but NOT on Walk/Bike, artificially inflating active mode probabilities.
        _incp_active_wk = pv('c_incp_active', pv('c_incp_wk', -0.010))
        _incp_active_bk = pv('c_incp_active', pv('c_incp_bk', -0.010))

        V_WK = (pv('ASC_Walk', -1.0)
              + pv('c_walk', pv('c_walk_time', -1.50)) * walk_t
              + pv('c_noveh_wk') * noveh
              + pv('c_age_wk', pv('c_age_walk', -0.08)) * age5p
              + _incp_active_wk * incp
              + pv('c_fem_wk', pv('c_female_walk', 0.0)) * female
              + pv('c_pub_wk', 0.0) * ind_public
              + pv('c_fts_wk', 0.0) * is_ft_student)
        V_WK = np.where(walk_avail_arr > 0, V_WK, -1e9)

        V_BK = (pv('ASC_Bike', -1.5)
              + pv('c_bike', pv('c_bike_time', -1.00)) * bike_t
              + pv('c_age_bk', pv('c_age_bike', -0.12)) * age5p
              + _incp_active_bk * incp
              + pv('c_young_bk', pv('c_young_bike', 0.50)) * young
              + pv('c_fts_bk', 0.0) * is_ft_student)
        V_BK = np.where(bike_avail_arr > 0, V_BK, -1e9)

        # ── Nested logit (Root{Motor{DA,SR,Transit}, NonMotor{Walk,Bike}}) ──
        # Two-level tree: the intermediate Car{DA,SR} nest was removed (Mu_Car
        # was not identified).  See _nested_mode_probs for the structure.
        mu_motor    = _sanitize_mu(pv('Mu_Motor',    1.0), 'Mu_Motor')
        mu_nonmotor = _sanitize_mu(pv('Mu_NonMotor', 1.0), 'Mu_NonMotor')
        probs = np.asarray(_nested_mode_probs(
            V_DA, V_SR, V_WK, V_BK, V_TR,
            mu_motor=mu_motor, mu_nonmotor=mu_nonmotor, xp=np,
        ))  # (n, 5) - DA, SR, Walk, Bike, Transit

        # ── Cell membership ────────────────────────────────────────────────
        out = df.copy()
        out['p_DA']      = probs[:, 0]
        out['p_SR']      = probs[:, 1]
        out['p_Walk']    = probs[:, 2]
        out['p_Bike']    = probs[:, 3]
        out['p_Transit'] = probs[:, 4]

        # ptype: string label for person type
        if 'ptype' not in out.columns:
            out['ptype'] = 'Unknown'
        else:
            out['ptype'] = out['ptype'].fillna('Unknown').astype(str)

        # indp_group: from ANZSIC code → mode group string
        out['indp_group'] = pd.Series(_indp_groups, index=out.index).fillna('other')

        # income_band: quartiles of incp scale (1-14 bands in HHTS)
        _incp_s = pd.to_numeric(df.get('incp', pd.Series(7.0, index=df.index)),
                                errors='coerce').fillna(7.0)
        out['income_band'] = pd.cut(_incp_s, bins=[0, 4, 7, 10, 99],
                                    labels=['low', 'mid', 'high', 'very_high'],
                                    right=True).astype(str).fillna('mid')

        # veh_bin: vehicle ownership binary
        out['veh_bin'] = np.where(vehrd > 0, 'hasveh', 'noveh')

        # age_group: broad age bands from age5p (1-digit ABS coding)
        out['age_group'] = pd.cut(pd.Series(age5p, index=out.index),
                                  bins=[0, 2, 4, 7, 99],
                                  labels=['young', 'middle', 'older', 'senior'],
                                  right=True).astype(str).fillna('middle')

        # has_licence
        out['has_licence'] = np.where(licence > 0, 'yes', 'no')

        # ── Aggregate to cells ─────────────────────────────────────────────
        cell_df = (out.groupby(FROZEN_CELL_COLS, observed=True)
                   .agg(p_DA=('p_DA', 'mean'), p_SR=('p_SR', 'mean'),
                        p_Walk=('p_Walk', 'mean'), p_Bike=('p_Bike', 'mean'),
                        p_Transit=('p_Transit', 'mean'), n_obs=('p_DA', 'count'))
                   .reset_index())

        # Renormalise (floating-point safety)
        prob_sum = cell_df[FROZEN_PROB_COLS].sum(axis=1).clip(lower=1e-9)
        for col in FROZEN_PROB_COLS:
            cell_df[col] = cell_df[col] / prob_sum

        logger.debug(
            f"_compute_frozen_probs [{segment}]: {len(cell_df)} cells "
            f"from {n} HHTS obs | "
            f"mean DA={cell_df['p_DA'].mean():.1%} "
            f"Walk={cell_df['p_Walk'].mean():.1%} "
            f"Transit={cell_df['p_Transit'].mean():.1%}"
        )
        return cell_df

    except Exception as e:
        logger.warning(f"_compute_frozen_probs [{segment}] failed: {e}")
        import traceback; logger.debug(traceback.format_exc())
        return None


def _assign_frozen_cells(persons_df: pd.DataFrame,
                         tour_rows: pd.DataFrame) -> pd.DataFrame:
    """
    Derive FROZEN_CELL_COLS attributes for a synthetic-population DataFrame.

    Mirrors the cell-assignment logic in ``_compute_frozen_probs`` so that
    synthetic persons map to the same cell keys as HHTS persons.

    Parameters
    ----------
    persons_df : person-level attributes (synthetic population)
    tour_rows  : tour-level rows - used to join person_id → person attributes

    Returns
    -------
    DataFrame with the same index as ``tour_rows`` and columns FROZEN_CELL_COLS.
    """
    def _col(df, name, default):
        return pd.to_numeric(df.get(name, pd.Series(default, index=df.index)),
                             errors='coerce').fillna(default)

    pp = persons_df.copy()
    if 'person_id' not in pp.columns and 'PERSID' in pp.columns:
        pp = pp.rename(columns={'PERSID': 'person_id'})

    pid_col = next((c for c in ['person_id', 'PERSID'] if c in tour_rows.columns), None)
    n = len(tour_rows)

    if pid_col:
        pids   = tour_rows[pid_col].values
        _nonan = pp[pp['person_id'].notna()].drop_duplicates('person_id', keep='first')
        pp_idx = _nonan.set_index('person_id')
        if not pp_idx.index.is_unique:
            pp_idx = pp_idx[~pp_idx.index.duplicated(keep='first')]

        def _pa(col, default):
            if col in pp_idx.columns:
                lkup = pp_idx[col].to_dict()
                return np.array([lkup.get(p, default) for p in pids], dtype=float)
            return np.full(n, default, dtype=float)
    else:
        def _pa(col, default):
            return np.full(n, default, dtype=float)

    vehrd   = _pa('vehrd', 1.0)
    licence = _pa('CARLICENCE', 1.0)
    incp    = _pa('incp', 7.0)
    age5p   = _pa('age5p', 4.0)
    indp_raw = _pa('indp', 20.0).astype(int)

    # ptype - try tour_rows first, then persons
    if 'ptype' in tour_rows.columns:
        ptype_arr = tour_rows['ptype'].fillna('Unknown').astype(str).values
    elif pid_col and 'ptype' in pp_idx.columns:
        lkup = pp_idx['ptype'].to_dict()
        ptype_arr = np.array([str(lkup.get(p, 'Unknown')) for p in pids])
    else:
        ptype_arr = np.full(n, 'Unknown', dtype=object)

    indp_groups  = np.array([INDUSTRY_MODE_GROUP.get(int(v), 'other') for v in indp_raw])

    incp_s   = pd.Series(incp)
    inc_band = pd.cut(incp_s, bins=[0, 4, 7, 10, 99],
                      labels=['low', 'mid', 'high', 'very_high'],
                      right=True).astype(str).fillna('mid').values

    age_band = pd.cut(pd.Series(age5p), bins=[0, 2, 4, 7, 99],
                      labels=['young', 'middle', 'older', 'senior'],
                      right=True).astype(str).fillna('middle').values

    cells = pd.DataFrame({
        'ptype':       ptype_arr,
        'indp_group':  indp_groups,
        'income_band': inc_band,
        'veh_bin':     np.where(vehrd > 0, 'hasveh', 'noveh'),
        'age_group':   age_band,
        'has_licence': np.where(licence > 0, 'yes', 'no'),
    }, index=tour_rows.index)
    return cells


def _mode_probs_frozen(frozen_probs: pd.DataFrame,
                       tour_rows: pd.DataFrame,
                       persons: pd.DataFrame) -> 'np.ndarray | None':
    """
    Apply frozen cell-level mode probabilities to synthetic population tours.

    Matches each tour to its HHTS-estimated cell via ``_assign_frozen_cells``,
    then looks up the cell's mode probabilities.  Unmatched tours fall back to
    the cell with the closest ptype or overall mean.

    Returns
    -------
    np.ndarray of shape (n_tours, 5) - columns [DA, SR, Walk, Bike, Transit]
    or None if frozen_probs is empty / malformed.
    """
    if frozen_probs is None or len(frozen_probs) == 0:
        return None
    try:
        cells = _assign_frozen_cells(persons, tour_rows).reset_index(drop=True)
        merged = cells.merge(frozen_probs[FROZEN_CELL_COLS + FROZEN_PROB_COLS],
                             on=FROZEN_CELL_COLS, how='left')

        # ?? Fallback for unmatched cells ??????????????????????????????????
        # First try ptype-only mean; then global mean.
        unmatched = merged[FROZEN_PROB_COLS].isna().any(axis=1)
        if unmatched.any():
            ptype_mean = (frozen_probs.groupby('ptype', observed=True)[FROZEN_PROB_COLS]
                          .mean().reset_index())
            for idx in np.flatnonzero(unmatched.to_numpy()):
                pt = cells.iloc[idx]['ptype']
                row = ptype_mean[ptype_mean['ptype'] == pt]
                if len(row):
                    merged.loc[idx, FROZEN_PROB_COLS] = row[FROZEN_PROB_COLS].values[0]

        # Remaining unmatched → global mean
        still_unmatched = merged[FROZEN_PROB_COLS].isna().any(axis=1)
        if still_unmatched.any():
            gmean = frozen_probs[FROZEN_PROB_COLS].mean().values
            merged.loc[still_unmatched, FROZEN_PROB_COLS] = gmean

        probs = merged[FROZEN_PROB_COLS].values.astype(np.float64)

        # Renormalise rows (handle any residual NaN from fallbacks)
        row_sums = probs.sum(axis=1, keepdims=True)
        row_sums = np.where(row_sums > 0, row_sums, 1.0)
        probs    = probs / row_sums

        n_unmatched = int(unmatched.sum())
        if n_unmatched:
            logger.debug(f"_mode_probs_frozen: {n_unmatched}/{len(tour_rows)} "
                         "tours unmatched → ptype/global fallback used")
        return probs

    except Exception as e:
        logger.warning(f"_mode_probs_frozen failed: {e}")
        import traceback; logger.debug(traceback.format_exc())
        return None


def _stabilize_mode_probs_stage5(
    mode_probs: np.ndarray,
    alt_ids: list,
    target_shares,
    seg: str = '',
) -> np.ndarray:
    """
    Stabilize predicted mode probabilities toward segment target shares.

    Prevents DA-collapse in fallback paths (e.g., missing/weak coefficients) while
    preserving row-wise probabilistic choice behavior.
    """
    try:
        if mode_probs is None or len(mode_probs) == 0 or target_shares is None:
            return mode_probs

        arr = np.asarray(mode_probs, dtype=float)
        if arr.ndim != 2 or arr.shape[1] != len(alt_ids):
            return mode_probs

        # Build target vector in alt_ids order.
        tv = np.zeros(len(alt_ids), dtype=float)
        _tv_missing = []
        if not hasattr(target_shares, 'get'):
            return mode_probs
        for j, aid in enumerate(alt_ids):
            v = target_shares.get(aid, None)
            if v is None:
                v = target_shares.get(str(aid), None)
            if v is None:
                v = target_shares.get(MODE_NAMES.get(int(aid), ''), None)
            if v is None:
                # No target for this alternative (e.g. 5-mode frozen tables
                # with STAGE5_PT_MODES=1): stay neutral by using the model's
                # own predicted share below instead of pulling it to zero.
                _tv_missing.append(j)
                tv[j] = 0.0
            else:
                try:
                    tv[j] = float(v)
                except Exception:
                    _tv_missing.append(j)
                    tv[j] = 0.0

        pred = np.clip(arr.mean(axis=0), 1e-12, None)
        pred = pred / pred.sum()
        for j in _tv_missing:
            if 0 <= j < len(tv):
                tv[j] = float(pred[j])

        if not np.isfinite(tv).all() or tv.sum() <= 0:
            return mode_probs
        tv = tv / tv.sum()

        # Severe collapse trigger - ANY mode dominating far beyond its target,
        # not just DA. Job 23880279 predicted SR=96% (target 43%) for nonmand
        # and the old DA-only check let it through with the weak alpha=0.22
        # blend (still ~84% SR after stabilisation).
        if 1 in alt_ids:
            i_da = alt_ids.index(1)
            pred_da = float(pred[i_da])
            targ_da = float(tv[i_da])
        else:
            pred_da = 0.0
            targ_da = 0.0

        max_gap = float(np.max(np.abs(pred - tv)))
        severe = bool(np.any((pred > 0.90) & (tv < 0.82))) or max_gap > 0.35
        if not severe and max_gap < 0.06:
            return mode_probs

        # Adaptive blend strength: the further the aggregate is from target,
        # the harder we pull. A mildly-off model keeps most of its own
        # heterogeneity (alpha ~0.22); an unidentified/collapsed one is
        # pulled most of the way to the target shares (alpha up to 0.85).
        alpha = float(np.clip(max_gap * 1.6, 0.22, 0.85))
        if severe:
            alpha = max(alpha, 0.60)
        target = (1.0 - alpha) * pred + alpha * tv
        floor = np.minimum(tv * 0.55, tv)
        target = np.maximum(target, floor)
        target = target / target.sum()

        adj = np.clip(arr, 1e-12, 1.0)
        for _ in range(4):
            cur = np.clip(adj.mean(axis=0), 1e-12, None)
            scale = target / cur
            adj *= scale[None, :]
            adj = np.clip(adj, 1e-12, 1.0)
            adj /= adj.sum(axis=1, keepdims=True)

        if 1 in alt_ids:
            nda = float(adj.mean(axis=0)[alt_ids.index(1)])
            logger.info(
                f"_predict_batch [{seg}] mode-share stabilisation: "
                f"DA {pred_da:.1%}->{nda:.1%} (target {targ_da:.1%})"
            )
        return adj
    except Exception as _e:
        logger.debug(f"_stabilize_mode_probs_stage5 skipped [{seg}]: {_e}")
        return mode_probs


def _estimate_dest_dist_heterogeneity(seg_df: pd.DataFrame,
                                      dest_coef: dict,
                                      segment: str) -> dict:
    """
    Estimate the person-level log-distance heterogeneity from HHTS residuals.

    Computes the between-person standard deviation of mean log(dist+1) for chosen
    destinations.  This captures genuine preference heterogeneity rather than
    noise: some people consistently travel far, others stay close.

    Returns
    -------
    dict with key ``s_log_dist`` (float) - the std dev used to scale frozen draws.
    Falls back to 0.5 if data is insufficient.
    """
    try:
        dist_col = next(
            (c for c in ['DIST', 'SOVTOLL_DIST__AM', 'dist'] if c in seg_df.columns),
            None
        )
        if dist_col is None:
            logger.debug(f"_estimate_dest_dist_heterogeneity [{segment}]: no dist col - using default 0.5")
            return {'s_log_dist': 0.5}

        log_dist = np.log(
            pd.to_numeric(seg_df[dist_col], errors='coerce').fillna(30.0).clip(lower=0.0) + 1.0
        )

        if 'person_id' in seg_df.columns and seg_df['person_id'].nunique() > 10:
            # Between-person variance in mean log-distance
            person_means = (seg_df.assign(_ld=log_dist)
                            .groupby('person_id')['_ld'].mean())
            s_log_dist = float(np.clip(person_means.std(ddof=1), 0.10, 2.0))
        else:
            # Fallback: half the total log-distance std
            s_log_dist = float(np.clip(log_dist.std() * 0.5, 0.10, 1.5))

        logger.info(
            f"_estimate_dest_dist_heterogeneity [{segment}]: "
            f"s_log_dist={s_log_dist:.3f} "
            f"(n_persons={seg_df['person_id'].nunique() if 'person_id' in seg_df.columns else '?'})"
        )
        return {'s_log_dist': s_log_dist}

    except Exception as e:
        logger.warning(f"_estimate_dest_dist_heterogeneity [{segment}] failed: {e}")
        return {'s_log_dist': 0.5}


def _frozen_person_dist_offsets(person_ids, s_log_dist: float) -> pd.Series:
    """
    Deterministic Normal(0, s_log_dist) draws seeded by MD5 hash of person_id.

    Each person receives a reproducible, run-stable distance-sensitivity offset
    that transfers identically from HHTS estimation to the synthetic population -
    as long as person_id values are consistent between the two datasets.

    The MD5 approach avoids NumPy's global RNG state so results are independent
    of what else has been sampled in the session.

    Parameters
    ----------
    person_ids : array-like of person IDs (int or str)
    s_log_dist : float - std dev from _estimate_dest_dist_heterogeneity

    Returns
    -------
    pd.Series indexed by person_id, values ~ N(0, s_log_dist).
    """
    import hashlib
    import struct

    ids = list(person_ids)
    draws = np.empty(len(ids), dtype=np.float64)
    for i, pid in enumerate(ids):
        digest = hashlib.md5(str(pid).encode('utf-8')).digest()
        seed   = struct.unpack('<I', digest[:4])[0]          # 32-bit unsigned
        rng    = np.random.default_rng(int(seed))
        draws[i] = rng.normal(0.0, s_log_dist)

    return pd.Series(draws, index=ids, name='person_dist_draw')


