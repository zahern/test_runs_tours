#  Stage 1: ordered logit   McFadden rho┬▓, AVERAGED over all (purpose, ptype) ÔöÇ

def _stage1_fitness(
    genes: np.ndarray,
    data: pd.DataFrame,
    feature_names: List[str],
    purpose: str,
    ptype: str,
) -> float:
    from stage1_activity_frequency import OrderedLogit
    from scipy.special import expit

    # Deduplicate features while preserving gene-selection order
    _seen_f: set = set()
    feats  = [f for f, g in zip(feature_names, genes)
              if g == 1 and not (_seen_f.__contains__(f) or _seen_f.add(f))]
    col    = f'n_{purpose}_out'
    subset = data[(data['ptype'] == ptype) & data[col].notna()].copy()
    if len(subset) < 30 or col not in subset.columns:
        return -1e9

    y = subset[col].values.astype(int)
    if len(np.unique(y)) < 2:
        return -1e9

    X  = subset[feats].fillna(0).values.astype(float)
    mu = X.mean(0); sd = X.std(0); sd[sd == 0] = 1.0
    X  = (X - mu) / sd

    try:
        m = OrderedLogit()
        m.fit(X, y)
    except Exception:
        return -1e9

    # ── Prune near-zero coefficients: drop weak features, re-fit for cleaner BIC ──
    _zthresh = float(os.environ.get('GA_SIG_COEF_ZERO', '0.01'))
    if _zthresh > 0 and len(feats) > 1:
        coef_arr = np.asarray(m.coef_).ravel()
        keep_idx = np.where(np.abs(coef_arr) >= _zthresh)[0]
        if len(keep_idx) > 0 and len(keep_idx) < len(feats):
            pruned_feats = [feats[i] for i in keep_idx]
            Xp = X[:, keep_idx]
            try:
                mp = OrderedLogit()
                mp.fit(Xp, y)
                if hasattr(mp, 'thresholds_') and len(mp.thresholds_) >= 2:
                    gp = np.diff(np.sort(mp.thresholds_))
                    if gp.min() >= 0.05:
                        m = mp
                        feats = pruned_feats
                        X = Xp
            except Exception:
                pass  # keep original model if re-fit fails

    # Reject degenerate ordered logit: thresholds must be strictly ordered
    # with a minimum gap so the model meaningfully discriminates categories.
    if hasattr(m, 'thresholds_') and len(m.thresholds_) >= 2:
        gaps = np.diff(np.sort(m.thresholds_))
        if gaps.min() < 0.05:
            return -1e9

    classes = np.sort(np.unique(y))
    ll_null = len(y) * np.log(1.0 / len(classes))

    ll_fit = 0.0
    for j, cls in enumerate(m.classes_):
        mask = (y == cls)
        if not mask.any():
            continue
        eta = X[mask] @ m.coef_
        if j == 0:
            p = expit(m.thresholds_[0] - eta)
        elif j == len(m.classes_) - 1:
            p = 1 - expit(m.thresholds_[-1] - eta)
        else:
            p = expit(m.thresholds_[j] - eta) - expit(m.thresholds_[j-1] - eta)
        p = np.clip(p, 1e-10, 1.0)
        ll_fit += np.sum(np.log(p))

    n   = len(y)
    k   = len(feats) + len(classes) - 1          # coef + thresholds
    # _bic_per_obs scales the k·ln(n) term by GA_COMPLEXITY_PENALTY so the
    # search isn't forced to full-BIC parsimony (which flattens the landscape
    # to pure feature-shedding); <1 keeps more predictors and gives the
    # perturbations real gradient to improve on.
    from ga_external_estimators import _bic_per_obs
    return _bic_per_obs(ll_fit, k, n)


def _stage1_fitness_aggregate(
    genes: np.ndarray,
    data: pd.DataFrame,
    feature_names: List[str],
    purposes: List[str],
    ptypes: List[str],
) -> float:
    """Mean rho┬▓ across all (purpose, ptype) pairs with enough data."""
    scores = []
    for purpose in purposes:
        for ptype in ptypes:
            col    = f'n_{purpose}_out'
            subset = data[(data['ptype'] == ptype) & data.get(col, pd.Series(dtype=float)).notna()]
            if col in data.columns and len(subset) >= 30:
                s = _stage1_fitness(genes, data, feature_names, purpose, ptype)
                if s > -1e8:
                    scores.append(s)
    return float(np.mean(scores)) if scores else -1e9


# ÔöÇÔöÇ Stage 2: OLS   adjusted R┬▓, averaged over all targets 

def _stage2_fitness(
    genes: np.ndarray,
    data: pd.DataFrame,
    feature_names: List[str],
    target_col: str,
) -> float:
    feats  = [f for f, g in zip(feature_names, genes) if g == 1]
    subset = data[feats + [target_col]].dropna()
    if len(subset) < 20:
        return -1e9

    X  = subset[feats].values.astype(float)
    y  = subset[target_col].values.astype(float)
    mu = X.mean(0); sd = X.std(0); sd[sd == 0] = 1.0
    Xs = np.column_stack([np.ones(len(X)), (X - mu) / sd])

    try:
        params = np.linalg.lstsq(Xs, y, rcond=None)[0]
    except np.linalg.LinAlgError:
        return -1e9

    # ── Prune near-zero coefficients ──────────────────────────────────────────
    _zthresh = float(os.environ.get('GA_SIG_COEF_ZERO', '0.01'))
    coef_part = params[1:]  # skip intercept
    if _zthresh > 0 and len(feats) > 1:
        keep_idx = np.where(np.abs(coef_part) >= _zthresh)[0]
        if len(keep_idx) > 0 and len(keep_idx) < len(feats):
            pruned_feats = [feats[i] for i in keep_idx]
            try:
                Xp = X[:, keep_idx]
                Xsp = np.column_stack([np.ones(len(Xp)), (Xp - Xp.mean(0)) / (Xp.std(0) + 1e-9)])
                params_p = np.linalg.lstsq(Xsp, y, rcond=None)[0]
                feats = pruned_feats
                Xs = Xsp
                params = params_p
            except np.linalg.LinAlgError:
                pass  # keep original fit

    yhat   = Xs @ params
    ss_res = ((y - yhat) ** 2).sum()
    n, k   = len(y), len(feats) + 1              # feats + intercept
    sigma2 = ss_res / max(n, 1)
    ll_ols = -0.5 * n * (np.log(2 * np.pi * max(sigma2, 1e-12)) + 1.0)
    from ga_external_estimators import _bic_per_obs
    return _bic_per_obs(ll_ols, k, n)   # GA_COMPLEXITY_PENALTY-scaled -BIC/n


def _stage2_fitness_aggregate(
    genes: np.ndarray,
    data: pd.DataFrame,
    feature_names: List[str],
    targets: List[str],
) -> float:
    scores = [_stage2_fitness(genes, data, feature_names, t)
              for t in targets if t in data.columns]
    valid  = [s for s in scores if s > -1e8]
    return float(np.mean(valid)) if valid else -1e9


# ÔöÇÔöÇ Stage 3: lognormal   -AIC, averaged over all purposes ÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇ

def _stage3_fitness(
    genes: np.ndarray,
    data: pd.DataFrame,
    feature_names: List[str],
    purpose: str,
    purpose_col: str = 'main_purpose',
) -> float:
    from stage3_activity_duration import BudgetLognormal, DURATION_BOUNDS

    feats  = [f for f, g in zip(feature_names, genes) if g == 1]
    lo, hi = DURATION_BOUNDS.get(purpose, (5, 600))
    subset = data[data[purpose_col] == purpose].copy()
    if len(subset) < 30:
        return -1e9

    y = subset['duration'].clip(lo, hi).values.astype(float)
    X = subset[feats].fillna(0).values.astype(float)

    try:
        m     = BudgetLognormal()
        m.fit(X, y)
    except Exception:
        return -1e9

    # ── Prune near-zero coefficients ──────────────────────────────────────────
    _zthresh = float(os.environ.get('GA_SIG_COEF_ZERO', '0.01'))
    if _zthresh > 0 and len(feats) > 1:
        coef_arr = np.asarray(m.coef_).ravel()
        keep_idx = np.where(np.abs(coef_arr) >= _zthresh)[0]
        if len(keep_idx) > 0 and len(keep_idx) < len(feats):
            pruned_feats = [feats[i] for i in keep_idx]
            Xp = X[:, keep_idx]
            try:
                mp = BudgetLognormal()
                mp.fit(Xp, y)
                m = mp
                feats = pruned_feats
                X = Xp
            except Exception:
                pass  # keep original model

    log_y  = np.log(np.clip(y, 1e-6, None))
    mu_    = m.mu_; sd_ = m.sd_.copy(); sd_[sd_ == 0] = 1.0
    Xs     = (X - mu_) / sd_
    Xs_aug = np.column_stack([np.ones(len(Xs)), Xs])
    eta    = Xs_aug @ np.concatenate([[m.intercept_], m.coef_])
    resid  = log_y - eta
    sigma  = resid.std() + 1e-9
    ll     = (-len(y) * np.log(sigma)
              - 0.5 * ((resid / sigma) ** 2).sum()
              - log_y.sum())
    n   = len(y)
    k   = len(feats) + 2                         # coefs + intercept + sigma
    from ga_external_estimators import _bic_per_obs
    _fit = _bic_per_obs(ll, k, n)                # GA_COMPLEXITY_PENALTY-scaled -BIC/n
    # ── Behavioural sign gate ──────────────────────────────────────────
    # Penalise selected specs whose fitted coefficients violate
    # EXPECTED_S3_SIGNS (stage3_activity_duration). Scale: fitness moves
    # ~0.006 per useful feature, so the default 0.01/violation breaks ties
    # against wrong-signed specs without dominating BIC. Only the ~8
    # prior-carrying features can trigger it (bounded worst case); the
    # penalty sees POST-prune coefs (m reassigned above), so near-zero
    # terms pruned at GA_SIG_COEF_ZERO never count. Disable with
    # GA_S3_SIGN_PENALTY=0 (audit in estimate_duration_models still runs).
    _sign_w = float(os.environ.get('GA_S3_SIGN_PENALTY', '0.01'))
    if _sign_w > 0:
        try:
            from stage3_activity_duration import s3_sign_violations as _s3sv
            _nv = _s3sv(feats, np.asarray(m.coef_).ravel(), purpose)
            if _nv:
                _fit -= _sign_w * _nv
        except Exception:
            pass
    return _fit


def _stage3_fitness_aggregate(
    genes: np.ndarray,
    data: pd.DataFrame,
    feature_names: List[str],
    purposes: List[str],
    purpose_col: str,
) -> float:
    scores = []
    for p in purposes:
        if len(data[data[purpose_col] == p]) >= 30:
            s = _stage3_fitness(genes, data, feature_names, p, purpose_col)
            if s > -1e8:
                scores.append(s)
    return float(np.mean(scores)) if scores else -1e9


# ÔöÇÔöÇ Stage 4: MNL timing   rho┬▓, averaged over all purposes ÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇ

def _stage4_fitness(
    genes: np.ndarray,
    data: pd.DataFrame,
    feature_names: List[str],
    purpose: str,
) -> float:
    from stage4_schedule_placement import MNLTimingModel, TIME_PERIODS

    feats  = [f for f, g in zip(feature_names, genes) if g == 1]
    _nonmand = {'escort', 'shopping', 'social', 'othmaint', 'othdiscr', 'eat'}
    subset = (data[data['purpose'].isin(_nonmand)].copy()
              if purpose == 'nonmand'
              else data[data['purpose'] == purpose].copy())
    if len(subset) < 30:
        return -1e9

    y = subset['period'].values.astype(int)
    if len(np.unique(y)) < 2:
        return -1e9

    ptypes = sorted(subset['ptype'].dropna().unique()) if 'ptype' in subset.columns else []
    m = MNLTimingModel()
    m.purpose_ = purpose
    m.ptypes_  = ptypes
    m.feature_override_ = feats
    m.include_person_features_ = any(f in feats for f in ['sexp', 'vehrd', 'nprd'])

    try:
        X = m._build_X(subset)
        m.fit(X, y)
    except Exception:
        return -1e9

    if not np.isfinite(m.rho2_) or m.rho2_ < -0.5:
        return -1e9

    ll = float(m.ll_)
    n  = len(y)
    k  = (len(TIME_PERIODS) - 1) * X.shape[1]
    from ga_external_estimators import _bic_per_obs
    return _bic_per_obs(ll, k, n)                # GA_COMPLEXITY_PENALTY-scaled -BIC/n


def _stage4_fitness_aggregate(
    genes: np.ndarray,
    data: pd.DataFrame,
    feature_names: List[str],
    purposes: List[str],
) -> float:
    scores = []
    _nonmand = {'escort', 'shopping', 'social', 'othmaint', 'othdiscr', 'eat'}
    for p in purposes:
        _mask = data['purpose'].isin(_nonmand) if p == 'nonmand' \
            else data['purpose'] == p
        if int(_mask.sum()) >= 30:
            s = _stage4_fitness(genes, data, feature_names, p)
            if s > -1e8:
                scores.append(s)
    return float(np.mean(scores)) if scores else -1e9


# ÔöÇÔöÇ Stage 5 (tour-level): MODE-ONLY and DEST-ONLY fitness functions ÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇ
# Running separate mode and destination GAs lets the user see independent
# convergence plots for each sub-model and avoids the joint-chromosome
# entanglement issue where the mode and destination feature pools compete
# for the same mutation budget.

def _scored_ll(mdl, label: str = '') -> float:
    """Estimator's RECORDED LL first; fresh loglike() only as last resort.

    After _estimate returns (elastic-net unpatched, JAX JIT state changed), a
    fresh model.loglike() can return garbage (~-1.6e34) or raise NaN errors
    even for converged models (job 25302769: dest starter CONVERGED ll=-9541
    but the baseline fitness scored -1e9 off a fresh call). Prefer _cached_ll,
    then most_recent_estimation_result, then fresh — callers gate finiteness.
    Returns float (possibly non-finite; callers must check).
    """
    try:
        _c = getattr(mdl, '_cached_ll', None)
        if _c is not None and np.isfinite(float(_c)) and float(_c) > -1e12:
            return float(_c)
    except Exception:
        pass
    try:
        _r = float(mdl.most_recent_estimation_result.loglike)
        if np.isfinite(_r):
            return _r
    except Exception:
        pass
    try:
        return float(mdl.loglike())
    except Exception as _e:
        logger.debug(f"_scored_ll [{label}]: all LL sources failed ({_e})")
        return float('nan')

def _stage5_mode_only_fitness(
    mode_genes:      np.ndarray,
    mode_candidates: List[str],
    segment:         str,
    tours:           pd.DataFrame,
    persons:         pd.DataFrame,
    landuse:         pd.DataFrame,
    skims,
    distribution_policy: Optional[Dict[str, str]] = None,
    structure: Optional[str] = None,
) -> float:
    """
    Tour-level mode model fitness ONLY (no destination).
    Returns -BIC_mode / n  (higher = better).
    structure: forwarded to _build_mode_model ('nested' default / 'flat').
        Lets shard variant arms score the same spec under each mode family.
    """
    from stage5_destination_choice import (
        _filter_seg, _mode_tree, _build_mode_model, _estimate,
        _estimate_mixed_logit,
    )
    mode_vars = [v for v, g in zip(mode_candidates, mode_genes) if g == 1]
    if not mode_vars:
        return -1e9
    seg_tours = _filter_seg(tours, segment)
    # Floor follows STAGE5_MIN_TOURS (default 50 = QLD behavior); small
    # transfer fixtures (e.g. 33-tour MTC) lower it via env instead of being
    # unsearchable (every genome scores the -1e9 sentinel otherwise).
    if len(seg_tours) < int(os.environ.get('STAGE5_MIN_TOURS', '50')):
        return -1e9
    # Large-model policy: JAX-first always (CPU-only, float64). Legacy numba
    # forcing worked around the e25042407 zero-gradient bug, now fixed via
    # float64 + elasticnet JAX path (see smoke_jax_models.py A1/B1). Numba
    # finite-differences stall/OOM on 371-zone expansions.
    _prev_ga_engine = os.environ.get('GA_LARCH_ENGINE', '')
    os.environ['GA_LARCH_ENGINE'] = 'jax'
    # Guard each stage separately and log the exception repr at WARNING.  A
    # single swallowed try/except here is why a missing SOVTOLL_TIME__AM skim
    # surfaced only as "-1e9" / "BIC/n=1000000000.0000" with no cause for
    # 18h (job 25929034): the KeyError vanished into the sentinel.
    try:
        dt_m = _mode_tree(seg_tours, persons, landuse, skims)
    except Exception as _e:
        logger.warning(
            f"Stage5 mode-only [{segment}]: mode tree build failed ({_e!r}). "
            "Check the skim/od columns the mode utility needs (DIST, "
            "SOVTOLL_TIME__AM) are present in the skim source.")
        return -1e9
    try:
        mode_mdl = _build_mode_model(dt_m, segment, custom_mode_vars=mode_vars,
                                     avail_vars_hint=list(seg_tours.columns),
                                     structure=structure)
    except Exception as _e:
        logger.warning(
            f"Stage5 mode-only [{segment}]: mode model build failed ({_e!r}). "
            "Usually a utility expression referencing a column absent from the "
            "skim (e.g. od.SOVTOLL_TIME__AM).")
        return -1e9
    try:
        mode_mdl = _estimate(mode_mdl, search_mode=True)
        # Force the CHOSEN alternative available before scoring. With DA now gated
        # on (CARLICENCE>0)*(vehrd>0), a chosen-DA record in a zero-vehicle
        # household otherwise gets ~0 probability and drives loglike() to ~-1e35,
        # which poisons the GA fitness and gets the whole segment rejected as
        # "invalid" — this is why work/nonmand disappeared while edu (non-DA-heavy)
        # survived. _run_segment already does this repair at build time; the mode
        # fitness path did not.
        try:
            mode_mdl.doctor(repair_ch_av="+")
        except Exception:
            pass
        _mxl_result = None
        if distribution_policy:
            _mxl_result, _mxl_model = _estimate_mixed_logit(
                seg_tours, segment, n_draws=int(os.environ.get('GA_AGDS_MXL_DRAWS', '80')),
                seed=42, mode_model=mode_mdl,
                distribution_policy=distribution_policy)
            if (_mxl_result is not None and _mxl_model is not None
                    and np.isfinite(_mxl_result.get('ll', np.nan))):
                mode_mdl = _mxl_model
        # The MXL fitter's reported LL is the likelihood evaluated with its
        # simulation draws and repaired availability state. Re-evaluating the
        # returned model can lose that state and score chosen alternatives at
        # near-zero probability, especially for expression-based availability.
        if (_mxl_result is not None
                and np.isfinite(_mxl_result.get('ll', np.nan))):
            mode_ll = float(_mxl_result['ll'])
        else:
            mode_ll = None
        # Score from the estimation's OWN reported LL (result.loglike, cached on
        # the model as _cached_ll), which is finite and well-fitted (e.g. work
        # phase-1 LL≈-5230). A fresh mode_mdl.loglike() can blow up to ~-1e35 even
        # for a well-fitted model, because DA availability is an EXPRESSION
        # ((CARLICENCE>0)*(vehrd>0)) that doctor(repair_ch_av) doesn't materialise,
        # so a chosen-DA/zero-vehicle record floors to ~0 probability on rescoring.
        # That mis-scoring is why work/nonmand mode never produced a valid model
        # while edu (non-DA) did. Fall back to loglike() only if no cached LL.
        if mode_ll is None:
            _cached = getattr(mode_mdl, '_cached_ll', None)
            if _cached is not None and np.isfinite(_cached) and _cached > -1e12:
                mode_ll = float(_cached)
            else:
                mode_ll = float(mode_mdl.loglike())
        if not np.isfinite(mode_ll) or mode_ll < -1e12:
            logger.debug(f"Stage5 mode-only [{segment}]: non-finite/blown LL={mode_ll}")
            return -1e9
        n   = len(seg_tours)
        k   = int(mode_genes[:len(mode_candidates)].sum())
        if _mxl_result is not None:
            k = int(_mxl_result.get('n_params', k))
        _seen = getattr(_stage5_mode_only_fitness, '_valid_logged', set())
        if segment not in _seen:
            print(f"    First valid Stage 5 mode model [{segment}]: LL={mode_ll:.2f}  n={n}  k={k}")
            _seen.add(segment)
            _stage5_mode_only_fitness._valid_logged = _seen
        from ga_external_estimators import (_larch_coef_rows,
                                             _metacount_significance_penalty,
                                             _update_feature_weakness,
                                             _bic_per_obs)
        coef_rows = _larch_coef_rows(mode_mdl)
        sig_pen   = _metacount_significance_penalty(coef_rows)
        _update_feature_weakness(coef_rows, mode_vars)
        # _bic_per_obs scales the k·ln(n) term by GA_COMPLEXITY_PENALTY so the
        # mode search isn't forced to full-BIC parsimony (which shed ~half the
        # behavioural coefficients); sig_pen still evicts insignificant terms.
        return _bic_per_obs(float(mode_ll), k, n) - sig_pen
    except Exception as e:
        # WARNING, not debug: this is the catch-all that turns a real failure
        # into the -1e9 sentinel.  At debug level the cause was invisible and
        # the segment burned its whole walltime on -1e9 evaluations (job
        # 25328790).  Log once per segment so a failing GA can't spam.
        _seen_e = getattr(_stage5_mode_only_fitness, '_err_logged', set())
        if segment not in _seen_e:
            _seen_e.add(segment)
            _stage5_mode_only_fitness._err_logged = _seen_e
            logger.warning(
                f"Stage5 mode-only [{segment}]: fitness raised ({e!r}) — "
                "returning the -1e9 failure sentinel for this genome.")
        return -1e9
    finally:
        # Restore GA_LARCH_ENGINE for any downstream estimation
        if '_prev_ga_engine' in locals():
            if _prev_ga_engine:
                os.environ['GA_LARCH_ENGINE'] = _prev_ga_engine
            else:
                os.environ.pop('GA_LARCH_ENGINE', None)


def _ga_sample_dest_alts(seg_acdc, lu_st, logsums, seed: int = 42):
    """Importance-sample destination alternatives for the GA SEARCH fitness.

    The GA search previously estimated every candidate over ALL zones (371),
    which inflates the effective sample size by ~371×.  That collapses every
    Hessian standard error toward a tiny near-constant (~0.002), so every Wald
    t-stat is in the hundreds, the significance penalty never fires, and the
    -BIC/n landscape is flat — the search freezes at generation 0.

    Estimating on the SAME Manski-Lerman importance sample the final fit uses
    (DEST_EST_SAMPLE_SIZE alternatives, chosen always included) restores honest
    SEs and a discriminating fitness landscape.  Returns a DataFrame with
    ['ptour_id','alt_zone','log_correction'] or None (→ full zone set) on any
    failure, matching _dest_tree's contract.
    """
    try:
        from stage5_destination_choice import (_importance_sample_dest_alts,
                                                DEST_EST_SAMPLE_SIZE,
                                                _default_zone_universe)
        if DEST_EST_SAMPLE_SIZE <= 0:
            return None
        if 'ptour_id' not in seg_acdc.columns or 'DTAZ' not in seg_acdc.columns:
            return None
        if hasattr(logsums, 'coords') and 'zones' in logsums.coords:
            zone_ids = [int(z) for z in logsums.coords['zones'].values]
        else:
            zone_ids = _default_zone_universe()
        return _importance_sample_dest_alts(
            tours_df    = seg_acdc[['ptour_id', 'DTAZ']].copy(),
            landuse     = lu_st,
            zone_ids    = zone_ids,
            sample_size = DEST_EST_SAMPLE_SIZE,
            seed        = seed,
        )
    except Exception as _e:
        logger.debug(f"_ga_sample_dest_alts failed ({_e}) — using full zone set")
        return None


# ── Tour-level destination tree cache + GA case cap ────────────────────────
# `_dest_tree()` takes NO genes: the case-alternative table, OD joins,
# landuse/person attributes and availability are identical for every genome of
# a segment. The GA previously rebuilt it on EVERY evaluation (hundreds of
# times per segment). Cache it in-process instead. The tree depends on the
# inputs (and logsums), so the key is content-based: segment label, case count,
# first/last case id, chosen-zone checksum, plus any caller-provided extra.
_DEST_TREE_CACHE: dict = {}


def _cap_dest_cases(seg_acdc: pd.DataFrame, label: str = "") -> pd.DataFrame:
    """Optional GA-only case cap (STAGE5_DEST_EST_CASES).

    Larch's dense from_idca unstacks the (sampled) CA design to
    cases x all zones, so the case count directly scales the estimation
    matrix. 0 (default) = keep all cases; the final/apply estimation is never
    capped. Capping is deterministic (stable sort by ptour_id) so the tree
    cache key stays stable across evaluations.
    """
    _cap = int(os.environ.get('STAGE5_DEST_EST_CASES', '0') or 0)
    if _cap <= 0 or _cap >= len(seg_acdc):
        return seg_acdc
    _col = 'ptour_id' if 'ptour_id' in seg_acdc.columns else (
        'case_id' if 'case_id' in seg_acdc.columns else None)
    if _col is None:
        return seg_acdc.iloc[:_cap].reset_index(drop=True)
    logger.info(f"Stage5 dest [{label}]: GA case cap STAGE5_DEST_EST_CASES="
                f"{_cap} of {len(seg_acdc)} tours")
    return (seg_acdc.sort_values(_col, kind='stable')
            .iloc[:_cap].reset_index(drop=True))


def _dest_tree_cached(seg_acdc, persons, lu_st, skims, ls_cached,
                      sampled_alts, key_extra: str = ""):
    """Build (or reuse) the genome-independent destination DataTree."""
    from stage5_destination_choice import _dest_tree
    if os.environ.get('STAGE5_DEST_TREE_CACHE', '1').strip() == '0':
        return _dest_tree(seg_acdc, persons, lu_st, skims, ls_cached,
                          sampled_alts=sampled_alts)
    try:
        _pid = (pd.to_numeric(seg_acdc['ptour_id'], errors='coerce')
                if 'ptour_id' in seg_acdc.columns
                else pd.Series(dtype=float))
        _key = (str(key_extra), len(seg_acdc),
                str(_pid.iloc[0]) if len(_pid) else '',
                str(_pid.iloc[-1]) if len(_pid) else '',
                float(pd.to_numeric(seg_acdc.get('DTAZ', pd.Series(dtype=float)),
                                    errors='coerce').sum()))
    except Exception:
        _key = None
    if _key is not None and _key in _DEST_TREE_CACHE:
        return _DEST_TREE_CACHE[_key]
    _dt = _dest_tree(seg_acdc, persons, lu_st, skims, ls_cached,
                     sampled_alts=sampled_alts)
    if _key is not None:
        try:
            _max = max(int(os.environ.get('STAGE5_DEST_TREE_CACHE_MAX', '2')), 1)
            while len(_DEST_TREE_CACHE) >= _max:
                _DEST_TREE_CACHE.pop(next(iter(_DEST_TREE_CACHE)))
            _DEST_TREE_CACHE[_key] = _dt
            logger.info(f"Stage5 dest: cached estimation tree "
                        f"(keys={len(_DEST_TREE_CACHE)}/{_max})")
        except Exception:
            pass
    return _dt


def _stage5_dest_only_fitness(
    dest_genes:      np.ndarray,
    dest_candidates: List[str],
    segment:         str,
    seg_tours:       pd.DataFrame,
    persons:         pd.DataFrame,
    lu_st:           pd.DataFrame,
    skims,
    ls_cached,       # pre-computed mode logsums (from best mode GA run)
    seg_acdc:        pd.DataFrame,
    warm_start:      dict = None,
    custom_uec:      dict = None,
) -> float:
    """
    Tour-level destination model fitness using CACHED mode logsums.
    Returns -BIC_dest / n  (higher = better).
    The mode model is NOT re-estimated here   logsums are pre-computed once
    with the best mode features before the dest GA starts.
    warm_start: {coef: value} from the converged starter (or best-so-far) —
        applied to overlapping params so perturbations test DELTAS from a
        converged point instead of cold-starting every spec from priors.
    custom_uec: optional UEC sub-dict {coef: (expr, segs)} forcing the exact
        utility spec to estimate (bypasses the gene-list → UEC gating, whose
        always-include backbone can pull in extra terms the caller never
        selected). Used for the starter-spec baseline so it estimates the
        same spec the converged starter ran — a converged starter must then
        yield a finite baseline by construction. Search genomes keep the
        default list-gated path (custom_uec=None).
    Each pipeline stage (sample / tree / build / estimate / score) is guarded
    separately and logged at WARNING with the exception repr — a silent
    debug-only -1e9 here once cost a 7.5h segment (job 25328790: starter
    CONVERGED ll=-9541 yet the baseline scored -1e9 with no cause in the
    logs because the raise site was swallowed).
    """
    from stage5_destination_choice import (_dest_tree, _build_dest_model, _estimate,
                                           apply_dest_warm_start,
                                           quarantine_dest_cases)
    dest_vars = [v for v, g in zip(dest_candidates, dest_genes) if g == 1]
    if not dest_vars and custom_uec is None:
        return -1e9
    # Quarantine unrepresentable tours (out-of-universe/NaN chosen zones yield
    # NaN case-likelihoods that abort the whole fit — observed: ~5 such tours
    # kept ~6500 evals at priors). Deterministic per segment (data-only), so
    # BIC/n stays comparable across genomes.
    try:
        _n_acdc_pre = len(seg_acdc)
        seg_acdc = quarantine_dest_cases(seg_acdc, label=f"{segment}/search")
        if len(seg_acdc) < _n_acdc_pre:
            logger.info(f"Stage5 dest-only [{segment}]: quarantined "
                        f"{_n_acdc_pre - len(seg_acdc)} tour(s) before sampling")
    except Exception as _qe:
        logger.debug(f"Stage5 dest-only [{segment}]: quarantine skipped ({_qe})")
    seg_acdc = _cap_dest_cases(seg_acdc, label=f"{segment}/search")
    try:
        _samp = _ga_sample_dest_alts(seg_acdc, lu_st, ls_cached)
    except Exception as _e:
        logger.warning(f"Stage5 dest-only [{segment}]: alt sampling failed ({_e!r})")
        return -1e9
    try:
        dt_d = _dest_tree_cached(seg_acdc, persons, lu_st, skims, ls_cached,
                                 _samp, key_extra=f"{segment}/dest-only")
    except Exception as _e:
        logger.warning(f"Stage5 dest-only [{segment}]: dest tree build failed ({_e!r})")
        return -1e9
    try:
        _bvars = custom_uec if custom_uec is not None else dest_vars
        dest_mdl = _build_dest_model(dt_d, segment, custom_dest_vars=_bvars)
    except Exception as _e:
        logger.warning(f"Stage5 dest-only [{segment}]: model build failed ({_e!r})")
        return -1e9
    if warm_start:
        _n_w = apply_dest_warm_start(dest_mdl, warm_start)
        if _n_w:
            logger.debug(f"Stage5 dest-only [{segment}]: warm-started {_n_w} params")
    try:
        dest_mdl = _estimate(dest_mdl, search_mode=True)
    except Exception as _e:
        logger.warning(f"Stage5 dest-only [{segment}]: estimation raised ({_e!r})")
        return -1e9
    try:
        dest_ll = _scored_ll(dest_mdl, f"{segment}/dest")
    except Exception as _e:
        logger.warning(f"Stage5 dest-only [{segment}]: LL scoring raised ({_e!r})")
        return -1e9
    if not np.isfinite(dest_ll) or dest_ll < -1e12:
        logger.warning(f"Stage5 dest-only [{segment}]: non-finite/blown LL={dest_ll} "
                       f"(vars={dest_vars})")
        return -1e9
    try:
        n   = len(seg_acdc)  # fitted cases (post-quarantine, deterministic per segment)
        k   = int(dest_genes.sum())
        if k == 0 and custom_uec:
            k = len(custom_uec)
        _seen = getattr(_stage5_dest_only_fitness, '_valid_logged', set())
        if segment not in _seen:
            print(f"    First valid Stage 5 dest model [{segment}]: LL={dest_ll:.2f}  n={n}  k={k}")
            _seen.add(segment)
            _stage5_dest_only_fitness._valid_logged = _seen
        from ga_external_estimators import (_larch_coef_rows,
                                             _metacount_significance_penalty,
                                             _update_feature_weakness,
                                             _bic_per_obs)
        coef_rows = _larch_coef_rows(dest_mdl)
        sig_pen   = _metacount_significance_penalty(coef_rows)
        _update_feature_weakness(coef_rows, dest_vars)
        return _bic_per_obs(float(dest_ll), k, n) - sig_pen
    except Exception as e:
        logger.warning(f"Stage5 dest-only [{segment}]: fitness tail failed ({e!r})")
        return -1e9


def _stage5_dest_lc_fitness(
    dest_genes:      np.ndarray,
    dest_candidates: List[str],
    base_candidates: List[str],
    segment:         str,
    seg_tours:       pd.DataFrame,
    persons:         pd.DataFrame,
    lu_st:           pd.DataFrame,
    skims,
    ls_cached,
    seg_acdc:        pd.DataFrame,
) -> float:
    """Latent-class destination fitness for the extended chromosome.

    Only reached when STAGE5_LC_GENES=1 and the genome's lc_on bit is set;
    pooled genomes delegate to the larch path so the current model stays a
    competitor.  LC genomes are scored -BIC/n on the same long frame the
    SearchLibrium estimators use (exact MNL likelihood, so BIC/n is comparable
    with the larch pooled arm), with hard constraints: converged fit, no class
    collapse, and crash_class_gap >= the genome's gap_min.  decode_lc_spec
    repairs a crash component in when the raw genome omitted one.
    """
    from stage5_destination_choice import (_adaptive_dest_choice_frame_full,
                                           quarantine_dest_cases)
    from stage5_lc_genes import decode_lc_spec, fit_lc_genome
    spec = decode_lc_spec(dest_genes, dest_candidates, base_candidates)
    if not spec.get("lc_on"):
        return _stage5_dest_only_fitness(
            dest_genes, base_candidates, segment, seg_tours, persons, lu_st,
            skims, ls_cached, seg_acdc)
    try:
        _n_pre = len(seg_acdc)
        seg_acdc = quarantine_dest_cases(seg_acdc, label=f"{segment}/lc")
        if len(seg_acdc) < _n_pre:
            logger.info(f"Stage5 dest-LC [{segment}]: quarantined "
                        f"{_n_pre - len(seg_acdc)} tour(s) before sampling")
    except Exception as _qe:
        logger.debug(f"Stage5 dest-LC [{segment}]: quarantine skipped ({_qe})")
    seg_acdc = _cap_dest_cases(seg_acdc, label=f"{segment}/lc")
    try:
        _samp = _ga_sample_dest_alts(seg_acdc, lu_st, ls_cached)
    except Exception as _e:
        logger.warning(f"Stage5 dest-LC [{segment}]: alt sampling failed ({_e!r})")
        return -1e9
    try:
        _dt = _dest_tree_cached(seg_acdc, persons, lu_st, skims, ls_cached,
                                _samp, key_extra=f"{segment}/lc")
    except Exception as _e:
        logger.warning(f"Stage5 dest-LC [{segment}]: tree build failed ({_e!r})")
        return -1e9
    try:
        frame, fmap = _adaptive_dest_choice_frame_full(
            _dt, _samp, segment,
            case_covariates=list(spec.get("membership_vars") or []))
    except Exception as _e:
        logger.warning(f"Stage5 dest-LC [{segment}]: frame build failed ({_e!r})")
        return -1e9
    coef_to_col = {str(v): str(k) for k, v in fmap.items()}
    try:
        from ga_external_estimators import _GA_COMPLEXITY_PENALTY as _cp
    except Exception:
        _cp = 1.0
    import zlib
    seed = (int(os.environ.get('STAGE5_LC_SEED', '7'))
            + (zlib.crc32(np.asarray(dest_genes, dtype=np.uint8).tobytes())
               % 100000))
    score, info = fit_lc_genome(frame, coef_to_col, spec,
                                complexity_penalty=float(_cp), seed=seed)
    if score is None or score <= -1e8:
        logger.warning(
            f"Stage5 dest-LC [{segment}]: {info.get('reason', 'failed')} "
            f"(features={spec['features']}, memb={spec['membership_vars']}, "
            f"nc={spec['n_classes']}, gap_min={spec['gap_min']})")
        return -1e9
    _seen = getattr(_stage5_dest_lc_fitness, '_valid_logged', set())
    if segment not in _seen:
        print(f"    First valid Stage 5 dest-LC model [{segment}]: "
              f"BIC/n={-score:.4f} ll={info['ll']:.1f} "
              f"shares={[round(s, 3) for s in info['shares']]} "
              f"crash_gap={info['crash_gap']:.2f} k={info['k']} "
              f"memb={spec['membership_vars']}"
              + (f" pruned={info.get('pruned')}" if info.get('pruned') else ""))
        _seen.add(segment)
        _stage5_dest_lc_fitness._valid_logged = _seen
    return float(score)


# ÔöÇÔöÇ Stage 5: Larch   mode_LL + dest_LL on HHTS only ÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇ
# ESTIMATION ONLY   no prediction over synthetic population.
# Calls _run_segment which uses only HHTS tours.

# Held-out aggregate-fit penalty for _stage5_fitness_larch. In-sample BIC +
# significance penalty alone reward specs that maximise discrete-choice
# likelihood on the estimation sample; they have no way to notice a spec that
# simultaneously collapses the aggregate destination-share distribution onto
# a handful of zones (see 2026-07 sa_bandit_staged validation report - dest
# rho^2 up to 0.68 "excellent" while top25 zone overlap was only 8-16%). The
# JSD term below is evaluated on a held-out split so a spec can't buy a good
# score just by overfitting the split it's scored on.
_STAGE5_HOLDOUT_FRAC   = float(os.environ.get('STAGE5_HOLDOUT_FRAC', '0.2'))
_STAGE5_HOLDOUT_MIN_N  = int(os.environ.get('STAGE5_HOLDOUT_MIN_N', '100'))
_STAGE5_JS_LAMBDA      = float(os.environ.get('STAGE5_JS_LAMBDA', '3.0'))


def _js_divergence_shares(p: np.ndarray, q: np.ndarray) -> float:
    """Jensen-Shannon divergence (base e) between two nonnegative count/share vectors."""
    p = np.nan_to_num(np.asarray(p, dtype=float), nan=0.0, posinf=0.0, neginf=0.0)
    q = np.nan_to_num(np.asarray(q, dtype=float), nan=0.0, posinf=0.0, neginf=0.0)
    p = p / max(p.sum(), 1e-12)
    q = q / max(q.sum(), 1e-12)
    m = 0.5 * (p + q)
    def _kl(a, b):
        mask = (a > 0) & (b > 0)
        if not np.any(mask):
            return 0.0
        return float(np.sum(a[mask] * np.log(a[mask] / b[mask])))
    return 0.5 * _kl(p, m) + 0.5 * _kl(q, m)


def _stage5_fitness_larch(
    mode_genes:      np.ndarray,
    dest_genes:      np.ndarray,
    mode_candidates: List[str],
    dest_candidates: List[str],
    segment:         str,
    tours:           pd.DataFrame,
    persons:         pd.DataFrame,
    landuse:         pd.DataFrame,
    skims,
    skim_df:         pd.DataFrame,
) -> float:
    """
    Estimation-only fitness: fit mode + destination model on a TRAIN split of
    HHTS tours, scored as -BIC/n - significance_penalty - JS_LAMBDA * held_out_JSD.

    held_out_JSD is the Jensen-Shannon divergence between the fitted dest
    model's predicted destination-zone shares and the OBSERVED destination-zone
    shares on a disjoint TEST split (not used for fitting) - this penalises
    specs that fit well in-sample but collapse the aggregate destination
    distribution, which plain BIC/significance can't detect (see module note
    above _STAGE5_HOLDOUT_FRAC). If the held-out evaluation itself fails for
    any reason, it contributes zero penalty rather than failing the genome.

    Uses _run_segment's building blocks (mode/dest tree + Larch estimation),
    HHTS-only - no prediction over synth population.
    """
    from stage5_destination_choice import (
        _filter_seg, _prep_hhts_tours,
        _build_mode_model, _build_dest_model,
        _estimate, _logsums, _mode_tree, _dest_tree,
        _attach_size_term, _attach_acdc_terms,
        _dest_probs_numpy,
        skim_lookup_to_df,
        MODE_UEC, DEST_UEC, DEST_COND,
    )

    mode_vars = [v for v, g in zip(mode_candidates, mode_genes) if g == 1]
    dest_vars = [v for v, g in zip(dest_candidates, dest_genes) if g == 1]
    if not mode_vars or not dest_vars:
        return -1e9

    seg_tours = _filter_seg(tours, segment)
    # Same STAGE5_MIN_TOURS floor as the mode-only fitness above.
    if len(seg_tours) < int(os.environ.get('STAGE5_MIN_TOURS', '50')):
        return -1e9

    # Deterministic train/held-out split - fixed seed so every genome in every
    # generation is scored against the SAME split (comparable JSD across the GA
    # run; not meant as a statistical guarantee, just a consistent yardstick).
    if len(seg_tours) >= _STAGE5_HOLDOUT_MIN_N:
        _rng_split = np.random.RandomState(42)
        _perm = _rng_split.permutation(len(seg_tours))
        _n_test = max(int(len(seg_tours) * _STAGE5_HOLDOUT_FRAC), 20)
        _test_idx, _train_idx = _perm[:_n_test], _perm[_n_test:]
        train_tours = seg_tours.iloc[_train_idx].reset_index(drop=True)
        test_tours  = seg_tours.iloc[_test_idx].reset_index(drop=True)
    else:
        train_tours = seg_tours
        test_tours  = None

    # Large-model policy: JAX-first always (fixed e25042407 via float64+elasticnet).
    _prev_ga_engine = os.environ.get('GA_LARCH_ENGINE', '')
    os.environ['GA_LARCH_ENGINE'] = 'jax'
    try:
        # Mode model on TRAIN
        dt_m     = _mode_tree(train_tours, persons, landuse, skims)
        mode_mdl = _build_mode_model(dt_m, segment, custom_mode_vars=mode_vars,
                                     avail_vars_hint=list(train_tours.columns))
        mode_mdl = _estimate(mode_mdl, search_mode=True)
        mode_ll  = _scored_ll(mode_mdl, f"{segment}/mode")

        # Restore GA_LARCH_ENGINE for destination model (which has its own JAX fallback)
        if _prev_ga_engine:
            os.environ['GA_LARCH_ENGINE'] = _prev_ga_engine
        else:
            os.environ.pop('GA_LARCH_ENGINE', None)

        # Logsums for destination tree
        ls = _logsums(mode_mdl, dt_m, skims=skims, verbose=False)

        # Destination model on TRAIN
        lu_st = _attach_size_term(landuse, segment)
        lu_st, seg_acdc = _attach_acdc_terms(
            lu_st, train_tours,
            skim_df if skim_df is not None else pd.DataFrame(),
            segment
        )
        _samp    = _ga_sample_dest_alts(seg_acdc, lu_st, ls)
        dt_d     = _dest_tree(seg_acdc, persons, lu_st, skims, ls,
                              sampled_alts=_samp)
        dest_mdl = _build_dest_model(dt_d, segment, custom_dest_vars=dest_vars)
        dest_mdl = _estimate(dest_mdl, search_mode=True)
        dest_ll  = _scored_ll(dest_mdl, f"{segment}/dest")

        # Proper BIC: -2*LL + GA_COMPLEXITY_PENALTY*k*ln(n), normalised per obs.
        # The penalty scale lets stage 5 relax full-BIC parsimony (which shed
        # ~half the behavioural coefficients) without editing code.
        from ga_external_estimators import _GA_COMPLEXITY_PENALTY as _gcp
        n   = len(train_tours)
        k   = int(mode_genes.sum() + dest_genes.sum())
        bic = -2.0 * (mode_ll + dest_ll) + _gcp * k * np.log(max(n, 2))
        # Significance penalty: discourage near-zero / insignificant features
        from ga_external_estimators import (_larch_coef_rows,
                                             _metacount_significance_penalty,
                                             _update_feature_weakness)
        mode_rows = _larch_coef_rows(mode_mdl)
        dest_rows = _larch_coef_rows(dest_mdl)
        sig_pen   = (_metacount_significance_penalty(mode_rows)
                     + _metacount_significance_penalty(dest_rows)) / 2.0

        # ── Mode model degeneracy sentinel ─────────────────────────────
        # When >80% of FREE mode-model parameters are weak (p > 0.10, stuck,
        # at-bound, or unidentified), the mode Hessian is likely singular
        # and all SEs are from proxy fill.  A linear sig-penalty of ~0.10
        # is invisible to the GA against BIC differences of 1-10, so the GA
        # can't climb toward better-identified specs.  This sentinel adds a
        # FLAT heavy penalty (tunable via GA_MODE_DEGEN_PENALTY, default 20)
        # that is large enough to push degenerate genomes below viable
        # candidates, forcing the search toward simpler / more-identifiable
        # parameter subspaces.  Only triggers when at least 5 free-mode
        # params exist (meaningful model, not a trivial holdfast-only spec).
        try:
            _mode_free = [r for r in mode_rows
                          if not r.get('holdfast', False)
                          and np.isfinite(r.get('value', float('nan')))
                          and np.isfinite(r.get('p_value', float('nan')))]
            _mode_n_free = len(_mode_free)
            _mode_n_weak = sum(1 for r in _mode_free
                               if (r.get('stuck')
                                   or r.get('at_bound')
                                   or r.get('p_value', 1.0) > 0.10))
            if _mode_n_free >= 5 and _mode_n_weak > 0.8 * _mode_n_free:
                _pen = float(os.environ.get('GA_MODE_DEGEN_PENALTY', '20.0'))
                sig_pen += _pen
                logger.debug(
                    f"Stage5 fitness [{segment}]: mode degeneracy sentinel "
                    f"({_mode_n_weak}/{_mode_n_free} weak) → +{_pen:.1f} penalty"
                )
        except Exception:
            pass

        _update_feature_weakness(mode_rows, mode_vars)
        _update_feature_weakness(dest_rows, dest_vars)

        # ── Held-out aggregate destination-share penalty ────────────────────
        js_pen = 0.0
        if test_tours is not None and len(test_tours) >= 10:
            try:
                dt_m_test  = _mode_tree(test_tours, persons, landuse, skims)
                ls_test    = _logsums(mode_mdl, dt_m_test, skims=skims, verbose=False)
                lu_st_test, seg_acdc_test = _attach_acdc_terms(
                    lu_st, test_tours,
                    skim_df if skim_df is not None else pd.DataFrame(),
                    segment
                )
                dt_d_test  = _dest_tree(seg_acdc_test, persons, lu_st_test, skims, ls_test)
                zone_ids   = list(ls_test.coords['zones'].values)
                probs_test = _dest_probs_numpy(dest_mdl, dt_d_test, ls_test, zone_ids, persons,
                                               landuse=lu_st_test, skim_df=skim_df)
                if probs_test is not None:
                    pred_share = probs_test.sum(axis=0)
                    obs_counts = (seg_acdc_test['DTAZ'].astype(int)
                                  .value_counts().reindex(zone_ids).fillna(0.0).to_numpy())
                    jsd = _js_divergence_shares(obs_counts, pred_share)
                    js_pen = _STAGE5_JS_LAMBDA * jsd
            except Exception as _jse:
                logger.debug(f"Stage5 fitness [{segment}]: held-out JSD penalty skipped ({_jse})")
                js_pen = 0.0

        return -bic / max(n, 1) - sig_pen - js_pen   # -BIC/n - penalty - JSD, higher is better

    except Exception as e:
        logger.debug(f"Stage5 fitness [{segment}]: {e}")
        return -1e9
    finally:
        if _prev_ga_engine:
            os.environ['GA_LARCH_ENGINE'] = _prev_ga_engine
        # else: already popped, leave unset


def _stage5_fitness_aggregate(
    genes:           np.ndarray,
    n_mode:          int,
    mode_candidates: List[str],
    dest_candidates: List[str],
    segments:        List[str],
    tours:           pd.DataFrame,
    persons:         pd.DataFrame,
    landuse:         pd.DataFrame,
    skims,
    skim_df:         pd.DataFrame,
) -> float:
    """Mean fitness across all valid segments."""
    scores = []
    for seg in segments:
        s = _stage5_fitness_larch(
            mode_genes      = genes[:n_mode],
            dest_genes      = genes[n_mode:],
            mode_candidates = mode_candidates,
            dest_candidates = dest_candidates,
            segment         = seg,
            tours           = tours,
            persons         = persons,
            landuse         = landuse,
            skims           = skims,
            skim_df         = skim_df,
        )
        if s > -1e8:
            scores.append(s)
    return float(np.mean(scores)) if scores else -1e9


# ÔöÇÔöÇ Stage 51: TRIP-LEVEL mode + destination choice ÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇ
# Mirrors Stage 5 but operates on individual TRIP legs rather than tours.
# ActivitySim distinction: tour_mode_choice ÔåÆ trip_mode_choice (constrained
# to be a subset of the tour mode) and trip-level destination choice.
# Here we estimate independently on HHTS trips for GA variable selection.

# ── HHTS trips -> conditional stop-trip table (stage-51 destination search) ──
# The stage-51 destination GA must estimate the SAME model that prediction
# applies (stage5b_trip_destination._estimate_mnl_segment), which needs tour
# structure (is_outbound / trip_num_in_tour / tour_id), an anchor_down_taz and
# a tour_mode. The survey trips table carries tour_id + trip_direction (see
# data_connect._assign_tours); fall back to sequence-derived structure when not.
_HHTS_TRIP_PURPOSE_MAP = {
    'Work (my workplace)': 'work', 'Work (other work reason)': 'work',
    'Direct Work Commute': 'work', 'Work Related': 'work',
    'Education': 'edu', 'Childcare or Kindergarten': 'edu',
    'Childcare or kindergarten': 'edu',
    'Social Visit': 'social', 'Recreation/leisure activity': 'social',
    'Recreation': 'social', 'Social': 'social',
    'Pick up or drop off a passenger': 'escort',
    'Pickup/Dropoff Someone': 'escort',
    'Just accompanying someone': 'escort',
    'Shopping': 'shopping',
    'Personal Business': 'othmaint', 'Personal business': 'othmaint',
    'Pickup/deliver something (not work-related)': 'othmaint',
    'Other place (please specify)': 'othdiscr',
    'Other Place': 'othdiscr', 'Refuel my vehicle': 'othdiscr',
    'Eat/drink': 'eat',
}

_TRIPDEST_CTX_CACHE: dict = {}
_TRIP_MODE_LL_CACHE: dict = {}   # (purpose, mode_vars) -> (ll, n_obs)


def _build_hhts_stop_trips(trips: pd.DataFrame, persons: pd.DataFrame) -> pd.DataFrame:
    """Convert HHTS survey trips to the conditional stop-trip schema expected by
    ``stage5b_trip_destination`` (origin_taz/dest_taz/anchor_down_taz,
    is_outbound, trip_num_in_tour, tour_id, tour_mode, purpose, times, mode)."""
    t = trips.copy()
    # Deduplicate columns: a duplicated label (e.g. two 'purpose'/'mode'
    # columns after an upstream rename/merge) makes t[col] a DataFrame and
    # every downstream `.str` call fails with "'DataFrame' object has no
    # attribute 'str'". Keep the first occurrence.
    try:
        if getattr(t.columns, 'duplicated', None) is not None:
            _dup = t.columns.duplicated(keep='first')
            if bool(_dup.any()):
                t = t.loc[:, ~_dup]
    except Exception:
        pass

    pid_t = next((c for c in ('person_id', 'PERSID', 'persid') if c in t.columns), None)
    if pid_t is None:
        return pd.DataFrame()
    if pid_t != 'person_id':
        t = t.rename(columns={pid_t: 'person_id'})

    _ren = {}
    _rename_candidates = {
        'origin_taz': ('OTAZ', 'ORIGZONE', 'orig_taz'),
        'dest_taz': ('DTAZ', 'DESTZONE', 'dest_taz'),
        'depart_time_min': ('STARTIME',),
        'arrive_time_min': ('ENDTIME',),
        'travel_time_min': ('TRAVTIME', 'tt_avg'),
        'mode': ('MAINMODE', 'mode'),
        'purpose_raw': ('DESTPURP', 'purpose'),
    }
    # Choose one source per destination name.  Renaming DESTPURP and purpose
    # to the same target in one pandas call creates duplicate columns; then
    # t['purpose_raw'] is a DataFrame and .str operations fail.
    for _dst, _sources in _rename_candidates.items():
        if _dst in t.columns:
            continue
        _src = next((c for c in _sources if c in t.columns), None)
        if _src is not None:
            _ren[_src] = _dst
    if _ren:
        t = t.rename(columns=_ren)

    # purpose -> canonical trip purpose
    if 'purpose_raw' in t.columns:
        t['purpose'] = (t['purpose_raw'].astype(str).str.strip()
                        .map(_HHTS_TRIP_PURPOSE_MAP)
                        .fillna(t['purpose_raw'].astype(str).str.lower()
                                .str.strip()))
    if 'purpose' not in t.columns:
        t['purpose'] = 'nonmand'

    # times / mode / travel time defaults
    for _c, _d in (('depart_time_min', 480.0), ('arrive_time_min', 0.0),
                   ('travel_time_min', 0.0)):
        if _c not in t.columns:
            t[_c] = _d
        t[_c] = pd.to_numeric(t[_c], errors='coerce').fillna(_d)
    if 'mode' not in t.columns:
        t['mode'] = 'DA'

    # tour structure
    _dir_map = {'outbound': 1, 'main': 1, 'inbound': 0}
    if 'tour_id' not in t.columns:
        # Derive simple tours: a new tour starts at every home-origin trip.
        _home = (_home_zone_series(t, persons))
        t['_is_home_origin'] = (pd.to_numeric(t['origin_taz'], errors='coerce')
                                .fillna(0).astype(int).values
                                == _home.reindex(t.index).values)
        t['tour_id'] = (t.groupby('person_id')['_is_home_origin']
                        .cumsum().clip(lower=1).astype(str))
        t.drop(columns=['_is_home_origin'], inplace=True)
    t['tour_id'] = t['tour_id'].astype(str)
    t = t.sort_values(['person_id', 'depart_time_min']).reset_index(drop=True)
    t['trip_num_in_tour'] = t.groupby(['person_id', 'tour_id']).cumcount() + 1
    if 'trip_direction' in t.columns:
        t['is_outbound'] = (t['trip_direction'].astype(str).str.lower()
                            .map(_dir_map).fillna(0).astype(int))
    else:
        _maxleg = t.groupby(['person_id', 'tour_id'])['trip_num_in_tour'].transform('max')
        t['is_outbound'] = (t['trip_num_in_tour'] <= _maxleg / 2.0).astype(int)

    # tour mode = mode of the tour's primary (main/highest outbound) leg
    _CANON_TO_CODE = {'DA': 1, 'SR': 2, 'Walk': 3, 'Bike': 4, 'Transit': 5}
    _mode_num = None
    try:
        from stage6_mode_choice import RAW_MODE_MAP as _RAW_MODE_MAP
        _mode_num = t['mode'].map(_RAW_MODE_MAP).map(_CANON_TO_CODE)
    except Exception:  # noqa: BLE001
        pass
    if _mode_num is None or float(_mode_num.notna().mean()) < 0.5:
        _mode_num = t['mode'].map(_CANON_TO_CODE)
    _mode_num = pd.to_numeric(_mode_num, errors='coerce')
    t['_mode_num'] = _mode_num.fillna(1).astype(int)
    _prim = (t[t['is_outbound'] == 1]
             .sort_values('trip_num_in_tour')
             .groupby(['person_id', 'tour_id'])['_mode_num'].last())
    t = t.merge(_prim.rename('tour_mode'),
                left_on=['person_id', 'tour_id'], right_index=True, how='left')
    t['tour_mode'] = t['tour_mode'].fillna(t['_mode_num']).astype(int)
    t.drop(columns=['_mode_num'], inplace=True)

    # home taz from persons
    home_col = next((c for c in ('OTAZ', 'HOME_TAZ', 'home_taz', 'home_zone')
                     if persons is not None and c in persons.columns), None)
    pp = persons.copy()
    _ppid = next((c for c in ('person_id', 'PERSID', 'persid') if c in pp.columns), None)
    if home_col and _ppid:
        if _ppid != 'person_id':
            pp = pp.rename(columns={_ppid: 'person_id'})
        _hm = (pp[['person_id', home_col]].rename(columns={home_col: 'home_taz'})
               .drop_duplicates('person_id'))
        t = t.merge(_hm, on='person_id', how='left')
    if 'home_taz' not in t.columns:
        t['home_taz'] = t['origin_taz']

    # person covariates used by the destination MNL candidates
    if persons is not None and not persons.empty:
        _pc = ['is_female', 'income_hi', 'income_lo', 'hh_child', 'occp_group',
               'ptype_FullTimeWorker', 'ptype_UniversityStudent', 'mtwp',
               'WFHWEEK', 'incp']
        _avail = [c for c in _pc if c in persons.columns]
        if _avail:
            _pers = persons.copy()
            if 'person_id' not in _pers.columns and 'PERSID' in _pers.columns:
                _pers = _pers.rename(columns={'PERSID': 'person_id'})
            t = t.merge(_pers[['person_id'] + _avail], on='person_id', how='left')

    from stage5b_trip_destination import build_trip_records
    t = build_trip_records(t, home_taz_col='home_taz')
    try:
        if getattr(t.columns, 'duplicated', None) is not None:
            _dup2 = t.columns.duplicated(keep='first')
            if bool(_dup2.any()):
                t = t.loc[:, ~_dup2]
    except Exception:
        pass
    _purp = t['purpose']
    try:
        import pandas as _pd
        if isinstance(_purp, _pd.DataFrame):
            _purp = _purp.iloc[:, 0]
    except Exception:
        pass
    stop = t[(t['is_tour_dest_leg'] == 0)
             & (_purp.astype(str).str.lower() != 'home')].copy()
    return stop


def _home_zone_series(trips: pd.DataFrame, persons: pd.DataFrame) -> pd.Series:
    """Home zone per person for tour-boundary derivation."""
    pp = persons.copy() if persons is not None else pd.DataFrame()
    _ppid = next((c for c in ('person_id', 'PERSID', 'persid') if c in pp.columns), None)
    home_col = next((c for c in ('OTAZ', 'HOME_TAZ', 'home_taz', 'home_zone')
                     if c in pp.columns), None)
    if _ppid and home_col:
        if _ppid != 'person_id':
            pp = pp.rename(columns={_ppid: 'person_id'})
        return (pp.drop_duplicates('person_id').set_index('person_id')[home_col]
                .reindex(trips['person_id']))
    # Fallback: first observed origin of the day
    return (trips.sort_values('depart_time_min')
            .groupby('person_id')['origin_taz'].first()
            .reindex(trips['person_id']))


def _tripdest_ctx(trips: pd.DataFrame, persons: pd.DataFrame, landuse: pd.DataFrame):
    """Prepare (and cache per process) stop trips + skims + zone table for the
    stage-51 destination GA. Returns None when skims are unavailable."""
    key = (id(trips), len(trips), id(landuse))
    if key in _TRIPDEST_CTX_CACHE:
        return _TRIPDEST_CTX_CACHE[key]
    try:
        from stage5b_trip_destination import _load_skims
        skims_path = (os.environ.get('PIPELINE_SKIMS_PATH') or '').strip()
        if not skims_path or not os.path.isfile(skims_path):
            logger.warning("Stage 51: PIPELINE_SKIMS_PATH unavailable — "
                           "destination search disabled")
            _TRIPDEST_CTX_CACHE[key] = None
            return None
        skims = _load_skims(skims_path)
        zone_col = 'ORDER' if 'ORDER' in landuse.columns else 'zone_id'
        all_zones = (landuse[[zone_col]].drop_duplicates()
                     .reset_index(drop=True))
        taz_index = {int(z): i for i, z in enumerate(all_zones[zone_col])}
        stop_trips = _build_hhts_stop_trips(trips, persons)
        if stop_trips.empty or 'purpose' not in stop_trips.columns:
            logger.warning("Stage 51: no HHTS stop trips could be built")
            _TRIPDEST_CTX_CACHE[key] = None
            return None
        ctx = {"stop_trips": stop_trips, "all_zones": all_zones,
               "skims": skims, "taz_index": taz_index, "zone_col": zone_col}
        # DuckDB CA cache dir: the GA refits the same purpose repeatedly, so the
        # wide (case, alt) feature table is materialised once per purpose.
        _ca_root = (os.environ.get('GA_CHECKPOINT_DIR')
                    or os.environ.get('PIPELINE_OUT_DIR')
                    or os.environ.get('TMPDIR') or '.')
        ctx["ca_dir"] = os.path.join(_ca_root, 'stage51_ca')
        print(f"  [Stage 51] stop-trip table: {len(stop_trips):,} rows | "
              f"purposes={sorted(stop_trips['purpose'].dropna().unique().tolist())[:8]}")
        _TRIPDEST_CTX_CACHE[key] = ctx
        return ctx
    except Exception as exc:  # noqa: BLE001
        import traceback as _tb
        _dup_info = ""
        try:
            _d = trips.columns[trips.columns.duplicated(keep=False)]
            if len(_d):
                _dup_info = f" dup_cols={sorted(set(map(str, _d.tolist)))[:8]}"
        except Exception:
            pass
        logger.warning(f"Stage 51: trip-dest context build failed: {exc}{_dup_info} | {_tb.format_exc(limit=5)}")
        _TRIPDEST_CTX_CACHE[key] = None
        return None


def _stage5_trip_fitness(
    mode_genes:      np.ndarray,
    dest_genes:      np.ndarray,
    mode_candidates: List[str],
    dest_candidates: List[str],
    purpose:         str,
    trips:           pd.DataFrame,
    persons:         pd.DataFrame,
    landuse:         pd.DataFrame,
    skim_df:         pd.DataFrame,
) -> float:
    """
    Trip-level mode + destination BIC fitness.

    Fits a nested logit mode model on individual HHTS trip legs (not tours),
    then fits the SAME conditional stop-destination MNL that prediction
    applies (``stage5b_trip_destination._estimate_mnl_segment``: detour +
    size term + backbone skims + anchor/tour-mode/previous-stop conditioning
    candidates selected by ``dest_genes``), and returns the combined -BIC/n.
    """
    from stage6_mode_choice import NestedLogitModeModel, prepare_mode_data

    mode_vars = [v for v, g in zip(mode_candidates, mode_genes) if g == 1]
    dest_vars = [v for v, g in zip(dest_candidates, dest_genes) if g == 1]
    if not mode_vars and not dest_vars:
        return -1e9

    # ── Trip-level mode model on HHTS ─────────────────────────────────────
    # Cached per (purpose, mode_vars): the destination GA holds the mode genes
    # fixed, so re-fitting the mode NL on every destination evaluation would
    # dominate runtime for no benefit.
    _mode_key = (purpose, tuple(mode_vars))
    if _mode_key in _TRIP_MODE_LL_CACHE:
        mode_ll, n_mode = _TRIP_MODE_LL_CACHE[_mode_key]
    else:
        try:
            mode_data = prepare_mode_data(trips, persons, landuse)
            mode_data_purp = mode_data[mode_data['purpose'] == purpose].copy()
            if len(mode_data_purp) < 30 or mode_data_purp['chosen_mode'].nunique() < 2:
                return -1e9

            for col in mode_vars:
                if col not in mode_data_purp.columns:
                    mode_data_purp[col] = 0.0

            m = NestedLogitModeModel()
            m.fit(mode_data_purp, purpose)
            if m.ll_final_ is None or m.n_obs_ == 0:
                return -1e9
            mode_ll = m.ll_final_
            n_mode  = m.n_obs_
            _TRIP_MODE_LL_CACHE[_mode_key] = (mode_ll, n_mode)
        except Exception as e:
            logger.debug(f"Stage51 mode fitness [{purpose}]: {e}")
            return -1e9

    # ── Trip-level destination model (real conditional MNL) ───────────────
    dest_ll, n_dest, n_dest_params = 0.0, 0, 0
    try:
        ctx = _tripdest_ctx(trips, persons, landuse)
        if ctx is not None and dest_vars:
            seg = ctx["stop_trips"][ctx["stop_trips"]["purpose"] == purpose].copy()
            if len(seg) >= 30:
                from stage5b_trip_destination import (
                    _estimate_mnl_segment, MAX_ESTIMATION_OBS)
                # GA fitness sample: every generation refits this MNL, so keep
                # the idca expansion tractable (n_obs x n_zones). Larch's dense
                # from_idca unstacks to cases x all zones, so this cap directly
                # bounds the design matrix. Full-population prediction is
                # unaffected — it reuses these coefficients.
                _cap = min(MAX_ESTIMATION_OBS,
                           int(float(os.environ.get('STAGE51_DEST_EST_OBS', '8000'))))
                if len(seg) > _cap:
                    seg = seg.sample(n=_cap, random_state=42)
                res = _estimate_mnl_segment(
                    stop_trips   = seg,
                    all_zones    = ctx["all_zones"],
                    skims        = ctx["skims"],
                    landuse      = landuse,
                    purpose      = purpose,
                    taz_index    = ctx["taz_index"],
                    g_tripdest   = list(np.asarray(dest_genes, dtype=int)),
                    zone_id_col  = ctx["zone_col"],
                    persons      = persons,
                    ca_dir       = (None if os.environ.get(
                                        'STAGE5B_CA_BACKEND', '').strip().lower()
                                    in ('off', '0', 'pandas') else ctx.get("ca_dir")),
                )
                if res is not None:
                    dest_ll = float(res["log_likelihood"])
                    n_dest = int(res["n_obs"])
                    n_dest_params = int(res.get("n_params", int(dest_genes.sum())))
    except Exception as e:
        logger.debug(f"Stage51 dest fitness [{purpose}]: {e}")

    # ── Combined BIC ──────────────────────────────────────────────────────
    total_ll = mode_ll + dest_ll
    n        = n_mode + max(n_dest, 0)
    k        = int(mode_genes.sum()) + n_dest_params
    bic      = -2.0 * total_ll + k * np.log(max(n, 2))
    return -bic / max(n, 1)    # -BIC/n, higher is better


def _stage5_trip_fitness_aggregate(
    genes:           np.ndarray,
    n_mode:          int,
    mode_candidates: List[str],
    dest_candidates: List[str],
    purposes:        List[str],
    trips:           pd.DataFrame,
    persons:         pd.DataFrame,
    landuse:         pd.DataFrame,
    skim_df:         pd.DataFrame,
) -> float:
    """Mean trip-level fitness across all valid purposes."""
    scores = []
    for purp in purposes:
        s = _stage5_trip_fitness(
            mode_genes      = genes[:n_mode],
            dest_genes      = genes[n_mode:],
            mode_candidates = mode_candidates,
            dest_candidates = dest_candidates,
            purpose         = purp,
            trips           = trips,
            persons         = persons,
            landuse         = landuse,
            skim_df         = skim_df,
        )
        if s > -1e8:
            scores.append(s)
    return float(np.mean(scores)) if scores else -1e9


# ÔöÇÔöÇ Stage 6: nested logit   rho┬▓ ÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇ

def _stage6_fitness(
    genes:         np.ndarray,
    data:          pd.DataFrame,
    feature_names: List[str],
    purpose:       str,
) -> float:
    from stage6_mode_choice import NestedLogitModeModel

    feats  = [f for f, g in zip(feature_names, genes) if g == 1]
    subset = data[data['purpose'] == purpose].copy()
    if len(subset) < 30 or subset['chosen_mode'].nunique() < 2:
        return -1e9

    for col in feats:
        if col not in subset.columns:
            subset[col] = 0.0
    try:
        m = NestedLogitModeModel()
        m.fit(subset, purpose)
        if m.ll_final_ is None or m.n_obs_ == 0:
            return -1e9
        # k = selected features + fixed structural params (ASCs, nesting logsum params)
        k_structural = 6   # ASC_SR, ASC_TR, ASC_WK, ASC_BK, mu_M, mu_NM
        k   = int(genes.sum()) + k_structural
        n   = m.n_obs_
        bic = -2.0 * m.ll_final_ + k * np.log(max(n, 2))
        return -bic / max(n, 1)                  # -BIC/n, higher is better
    except Exception:
        return -1e9


def _stage6_fitness_aggregate(
    genes:         np.ndarray,
    data:          pd.DataFrame,
    feature_names: List[str],
    purposes:      List[str],
) -> float:
    scores = []
    for p in purposes:
        if len(data[data['purpose'] == p]) >= 30 and data[data['purpose'] == p]['chosen_mode'].nunique() >= 2:
            s = _stage6_fitness(genes, data, feature_names, p)
            if s > -1e8:
                scores.append(s)
    return float(np.mean(scores)) if scores else -1e9


# ÔöÇÔöÇ CDAP: Larch MNL   mean rho┬▓ over H/N/M classification ÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇ
# Chromosome = binary mask over MNL_FEATURES candidate set.
# Fitness = McFadden rho┬▓ of the 3-alternative MNL on HHTS persons.
# Uses numba engine (same as estimate_cdap) to avoid JAX OOM.

def _cdap_fitness(
    genes:         np.ndarray,
    data:          pd.DataFrame,   # output of prepare_cdap_data()
    feature_names: List[str],
) -> float:
    """
    Estimate a CDAP MNL on HHTS with the selected features.
    Returns McFadden rho┬▓ (higher = better).
    Fitness is penalised by number of active features (parsimony).
    """
    # SEARCH fitness uses a self-contained RIDGE multinomial logit (scipy) by
    # default: no sklearn dependency, regularization embedded, milliseconds per
    # fit, and finite SEs for the significance penalty. The Larch path rebuilds a
    # DataTree and triggers fresh sharrow/jax flow compiles for EVERY candidate
    # spec — run guided03 spent 16h 57m on Stage 0 alone (~100 compiles/eval,
    # ~9 s each) — so it is impractical for a GA. Larch remains the engine for
    # the FINAL CDAP model after selection (estimate_cdap, with elastic-net);
    # set GA_CDAP_FITNESS=larch to use Larch during the search too.
    if os.environ.get('GA_CDAP_FITNESS', 'numpy').strip().lower() != 'larch':
        return _cdap_fitness_numpy(genes, data, feature_names)

    try:
        import larch as lx
    except ImportError:
        return _cdap_fitness_numpy(genes, data, feature_names)

    feats = [f for f, g in zip(feature_names, genes) if g == 1]
    if not feats:
        return -1e9

    # Check all selected features actually exist
    available = [f for f in feats if f in data.columns]
    if not available:
        return -1e9

    try:
        case_ids = data['person_id'].astype(str).tolist()
        alt_ids  = [0, 1, 2]

        ca_idx = pd.MultiIndex.from_product(
            [case_ids, alt_ids], names=['person_id', '_altid_'])
        ca_df  = pd.DataFrame({'chosen': 0}, index=ca_idx)
        # vectorised chosen-flag assignment (was a per-row iterrows loop over
        # every HHTS person, per candidate evaluation)
        _chosen_idx = pd.MultiIndex.from_arrays(
            [data['person_id'].astype(str), data['cdap_obs'].astype(int)],
            names=['person_id', '_altid_'])
        ca_df.loc[ca_df.index.isin(_chosen_idx), 'chosen'] = 1
        ds_ca = lx.Dataset.construct.from_idca(ca_df)

        co_df = data.set_index(data['person_id'].astype(str))[available].fillna(0).copy()
        co_df.index.name = 'person_id'
        ds_co = lx.Dataset.construct.from_idco(co_df)

        dt = lx.DataTree(base=ds_ca, person=ds_co,
                         relationships=('base.person_id @ person.person_id',))

        mnl = lx.Model(dt, compute_engine='jax')
        mnl.choice_ca_var = 'chosen'
        mnl.utility_co[1] = lx.P('ASC_N')
        mnl.utility_co[2] = lx.P('ASC_M')
        for feat in available:
            mnl.utility_co[1] += lx.P(f'b_N_{feat}') * lx.X(f'person.{feat}')
            mnl.utility_co[2] += lx.P(f'b_M_{feat}') * lx.X(f'person.{feat}')
        mnl.set_cap(10)
        r = mnl.maximize_loglike(options={'ftol': 1e-7, 'maxiter': 200}, quiet=True)
        ll_fit = float(r.loglike)

        # BIC: k = 2 params per feature (one for N, one for M) + 2 ASCs
        n   = len(data)
        k   = 2 * len(available) + 2
        bic = -2.0 * ll_fit + k * np.log(max(n, 2))
        return -bic / max(n, 1)                  # -BIC/n, higher is better

    except Exception as e:
        logger.debug(f"CDAP Larch fitness failed: {e}")
        return _cdap_fitness_numpy(genes, data, feature_names)


def _multinomial_ridge_fit(X: np.ndarray, y: np.ndarray, l2: float = 1.0,
                           maxiter: int = 150):
    """Baseline-category (class 0 reference) multinomial logit with RIDGE, via
    scipy — no sklearn. The ridge penalty keeps the (penalized) Hessian
    non-singular even under perfect separation, so standard errors are finite and
    coefficients don't blow up (no pinned bounds needed). Returns
    (B[K-1, p+1], unpenalized_ll, SE[K-1, p+1])."""
    from scipy import optimize as _sopt
    n, p = X.shape
    K = int(y.max()) + 1
    pk = p + 1
    Xb = np.column_stack([np.ones(n), X])

    def negll(th, pen=True):
        B = th.reshape(K - 1, pk)
        eta = Xb @ B.T                                  # (n, K-1)
        M = np.maximum(0.0, eta.max(1))
        logZ = M + np.log(np.exp(-M) + np.exp(eta - M[:, None]).sum(1))
        chosen = np.where(y > 0,
                          np.take_along_axis(eta, np.clip(y[:, None] - 1, 0, K - 2), 1).ravel(),
                          0.0)
        ll = np.sum(chosen - logZ)
        r = l2 * np.sum(B[:, 1:] ** 2) if pen else 0.0  # ridge, exclude intercepts
        return -(ll - r)

    res = _sopt.minimize(negll, np.zeros((K - 1) * pk), method='L-BFGS-B',
                         options={'maxiter': maxiter})
    B = res.x.reshape(K - 1, pk)
    ll = -negll(res.x, pen=False)
    # SEs from the penalized-Hessian diagonal (finite differences); ridge makes
    # this positive even under separation → finite, meaningful SEs.
    diagH = np.empty_like(res.x)
    h = 1e-4
    f0 = negll(res.x)
    for i in range(len(res.x)):
        e = np.zeros_like(res.x); e[i] = h
        diagH[i] = (negll(res.x + e) - 2.0 * f0 + negll(res.x - e)) / (h * h)
    se = np.where(diagH > 1e-8, 1.0 / np.sqrt(np.abs(diagH)), np.nan).reshape(K - 1, pk)
    return B, float(ll), se


def _cdap_fitness_numpy(
    genes:         np.ndarray,
    data:          pd.DataFrame,
    feature_names: List[str],
) -> float:
    """Fast, dependency-free CDAP search fitness: a RIDGE multinomial logit
    (scipy, no sklearn, no Larch compilation) scored by -BIC/n minus a Wald
    significance penalty. Regularization is embedded (GA_CDAP_L2, ridge), so
    coefficients stay finite and identified without pinned bounds; separated /
    insignificant terms get large SEs → penalised → evicted by the search."""
    feats     = [f for f, g in zip(feature_names, genes) if g == 1]
    available = [f for f in feats if f in data.columns]
    if not available:
        return -1e9
    X = data[available].fillna(0).values.astype(float)
    y = data['cdap_obs'].values.astype(int)
    if len(np.unique(y)) < 2:
        return -1e9
    mu = X.mean(0); sd = X.std(0); sd[sd == 0] = 1.0
    Xs = (X - mu) / sd
    try:
        l2 = float(os.environ.get('GA_CDAP_L2', '1.0'))
        B, ll_fit, se = _multinomial_ridge_fit(Xs, y, l2=l2)
        n = len(y)
        k = B.size                                      # (K-1)*(p+1)
        bic = -2.0 * ll_fit + k * np.log(max(n, 2))
        score = -bic / max(n, 1)

        # Wald significance penalty over the slope coefficients (drop intercepts).
        w = float(os.environ.get('GA_SIG_PENALTY_WEIGHT', '1.50'))
        t_thresh = float(os.environ.get('GA_SIG_T_THRESH', '1.96'))
        if w > 0:
            slope_B, slope_se = B[:, 1:], se[:, 1:]
            with np.errstate(divide='ignore', invalid='ignore'):
                t = slope_B / np.where(slope_se > 0, slope_se, np.nan)
            n_tot = slope_B.size
            if n_tot:
                n_weak = int(np.sum((~np.isfinite(t)) | (np.abs(t) < t_thresh)))
                score -= w * (n_weak / n_tot)
        return score
    except Exception as e:
        logger.debug(f"CDAP numpy fitness failed: {e}")
        return -1e9


# Backwards-compatible alias (old name referenced elsewhere / in checkpoints).
_cdap_fitness_sklearn = _cdap_fitness_numpy


# ÔöÇÔöÇ Usual Location: decay_b and attractor column selection ÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇ
# Chromosome is CONTINUOUS (not binary)   see _run_ga_usual_loc.
# We encode decay_b as two continuous genes in [0.01, 0.20].
# Attractor column selection uses binary genes over the landuse columns.
# Fitness = log-likelihood of observed work/school zones given the model.

def _usual_loc_fitness(
    genes:          np.ndarray,
    obs_work:       pd.DataFrame,    # observed (OTAZ, WORK_TAZ) pairs from HHTS
    obs_school:     pd.DataFrame,    # observed (OTAZ, SCHOOL_TAZ) pairs from HHTS
    landuse:        pd.DataFrame,
    skim_flat:      pd.DataFrame,
    work_att_names: List[str],       # candidate attractor column names
    edu_att_names:  List[str],
    n_work_att:     int,             # how many genes are work attractor flags
) -> float:
    """
    Fitness = mean log-probability of observed work/school zone given the
    weighted gravity model P(z|orig) ÔêØ att(z) ├ù exp(-b├ùtt(orig,z)).

    Chromosome layout:
        genes[0]            : work_decay_b  (mapped to [0.01, 0.20])
        genes[1]            : school_decay_b (mapped to [0.01, 0.20])
        genes[2:2+n_work_att]        : binary   which work attractor cols to use
        genes[2+n_work_att:]         : binary   which edu attractor cols to use
    """
    from usual_location import _get_tt_vector

    # decode genes
    work_b   = float(np.clip(genes[0], 0.01, 0.20))
    school_b = float(np.clip(genes[1], 0.01, 0.20))
    work_att_flags = genes[2: 2 + n_work_att].astype(int)
    edu_att_flags  = genes[2 + n_work_att:].astype(int)

    work_cols = [c for c, g in zip(work_att_names, work_att_flags) if g == 1]
    edu_cols  = [c for c, g in zip(edu_att_names,  edu_att_flags)  if g == 1]

    if not work_cols and not edu_cols:
        return -1e9

    zone_col  = 'ORDER' if 'ORDER' in landuse.columns else landuse.columns[0]
    zone_ids  = landuse[zone_col].astype(int).values
    # 371-only: no `!= 330` drop — ORDER 330 is a real zone in the 371 system.
    zone_ids  = zone_ids[zone_ids > 0]
    zone_idx  = {z: i for i, z in enumerate(zone_ids)}
    N         = len(zone_ids)
    lu_vals   = landuse.set_index(zone_col)

    total_ll = 0.0
    n_obs    = 0

    # ÔöÇÔöÇ work LL ÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇ
    if work_cols and len(obs_work) > 0:
        att = np.zeros(N)
        for col in work_cols:
            if col in lu_vals.columns:
                att += lu_vals[col].reindex(zone_ids).fillna(0).values.astype(float)
        att = np.clip(att, 0, None)

        for _, row in obs_work.iterrows():
            otaz = int(row.get('OTAZ', row.get('ORDER', 0)))
            wtaz = int(row.get('WORK_TAZ', 0))
            if wtaz <= 0 or wtaz not in zone_idx:
                continue
            tt = _get_tt_vector(skim_flat, otaz, zone_ids, 'SOVTOLL_TIME__AM')
            w  = att * np.exp(-work_b * tt)
            ws = w.sum()
            if ws <= 0:
                continue
            p = w[zone_idx[wtaz]] / ws
            total_ll += np.log(max(p, 1e-10))
            n_obs    += 1

    # ÔöÇÔöÇ school LL ÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇ
    if edu_cols and len(obs_school) > 0:
        att = np.zeros(N)
        for col in edu_cols:
            if col in lu_vals.columns:
                att += lu_vals[col].reindex(zone_ids).fillna(0).values.astype(float)
        att = np.clip(att, 0, None)

        for _, row in obs_school.iterrows():
            otaz = int(row.get('OTAZ', row.get('ORDER', 0)))
            staz = int(row.get('SCHOOL_TAZ', 0))
            if staz <= 0 or staz not in zone_idx:
                continue
            tt = _get_tt_vector(skim_flat, otaz, zone_ids, 'SOVTOLL_TIME__AM')
            w  = att * np.exp(-school_b * tt)
            ws = w.sum()
            if ws <= 0:
                continue
            p = w[zone_idx[staz]] / ws
            total_ll += np.log(max(p, 1e-10))
            n_obs    += 1

    if n_obs == 0:
        return -1e9

    return total_ll / n_obs   # mean log-probability (higher = better)


# ---------------------------------------------------------------------------
# 3.  CANDIDATE FEATURE SETS PER STAGE
# ---------------------------------------------------------------------------
# WORKSTAT and STUDYING are nominal codes with no meaningful linear scale, so
# rather than feed the raw ordinal/categorical codes to the CDAP candidate set
# we use their per-category binary indicators (workstat_*, studying_*) built
# in cdap.build_person_profiles() — the same function used for both HHTS
# estimation and synth-pop prediction, so the GA-selected binaries exist and
# are derived identically at predict time. occp_group is left as-is for now
# (same "grouped, no ordering" concern noted for future consideration).
def _cdap_candidates(data: pd.DataFrame) -> List[str]:
    """
    All candidate features for CDAP (coordinated daily activity pattern).
    Sourced from build_person_profiles() + raw synth columns + accessibility
    + ABS census-derived variables (from census_bridge.map_census_to_hhts).
    """
    ptype_dummies = [
        'ptype_FullTimeWorker', 'ptype_PartTimeWorker',
        'ptype_UniversityStudent', 'ptype_WorkingStudent',
        'ptype_SchoolChild', 'ptype_Retired', 'ptype_Preschool',
    ]
    age_vars  = ['age_child', 'age_teen', 'age_working', 'age_older',
                 'age_senior', 'age_norm',
                 # ABS-derived (census_bridge)
                 'age_retired', 'age_young']
    hh_vars   = ['hh_child', 'hh_spouse', 'hh_parent', 'hh_alone', 'hh_size_large',
                 'n_workers_hh']   # household-level worker count (census_bridge)
    access    = ['has_vehicle', 'has_licence']
    work_vars = ['is_female', 'wfh', 'income_midplus', 'mandatory_role',
                 'income_hi', 'income_lo']   # census_bridge income flags
    acc_cols  = (['auto_work_acc', 'walk_acc', 'transit_acc', 'auto_nonmand_acc',
                  'crash_acc']   # home-zone crash exposure - lets the search test
                                 # safety in CDAP/generation, not only mode/dest
                                 # utilities (ATRF reviewer request)
                 + _LOGSUM_ACC_CANDIDATES)  # upstream logsum cascade (ActivitySim)
    raw_synth = ['vehrd', 'nprd', 'incp', 'sexp',
                 'workstat_fulltime', 'workstat_parttime', 'workstat_notworking',
                 'studying_none', 'studying_primary', 'studying_secondary',
                 'studying_tertiary_pt', 'studying_tertiary_ft',
                 'CARLICENCE', 'occp_group']
    abs_cols  = ['empp', 'occp', 'rntrd', 'mstp',  # ABS direct (census_bridge)
                 'mtwp',          # travel-to-work mode   strong CDAP predictor
                 'preferred_mode_DA', 'preferred_mode_Transit',
                 'preferred_mode_Walk', 'preferred_mode_Bike']
    all_cands = (ptype_dummies + age_vars + hh_vars + access +
                 work_vars + acc_cols + raw_synth + abs_cols)
    return [c for c in all_cands if c in data.columns]


