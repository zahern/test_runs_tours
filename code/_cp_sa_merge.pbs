SYNTH_POP=/home/ahernz/Paper_Plan/synth_pop
cd "$SYNTH_POP" || exit 1
source /home/ahernz/miniconda3/etc/profile.d/conda.sh
conda activate syn_env

export RESULTS_DIR="$SYNTH_POP/outputs/cp_pool_results"
python -u "$SYNTH_POP/merge_cp_sa_summaries.py"
rc=$?
echo "MERGE_EXIT=$rc"
exit $rc