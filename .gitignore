# ─────────────────────────────────────────────────────────────────────────
# Generated pipeline data & large binaries — never track (kept git fast and
# pushable; these are all regenerable outputs).
# ─────────────────────────────────────────────────────────────────────────
*.pkl
*.omx
*.pstats
*.h5

# Stage / model / synth outputs
**/saved_data/*_output.csv
**/saved_data/cdap_output.csv
**/saved_data/synth_population*.csv
**/saved_data/synth_persons*.csv
**/synth_population*.csv
**/synth_persons*.csv
**/saved_data/*.html
**/saved_data/vehicle.dat

# Run artefacts, figures, profiling
runs/
**/Figures/
**/plots/
profile_*.pstats

# DTA engine directories (multi-GB binaries: VehTrajectory, AltPath, fort.*, …)
DTA/**/

# PBS job logs
*.o[0-9]*
*.e[0-9]*

# Keep small tracked references (negations after the broad rules above)
!code/saved_data/seq_zone_ids_371.csv
!**/seq_zone_ids_.csv
!demand_/sa2_zones_reference_357.csv
