#!/bin/bash -l
#PBS -N suncorp_temporal
#PBS -l walltime=02:00:00
#PBS -l select=1:ncpus=8:mem=64GB
#PBS -j oe
#PBS -m abe
#PBS -r y

# ══════════════════════════════════════════════════════════════════════════════
# Job 7: Temporal dynamics — random-walk / time-series risk modelling
#   A. Network-level local-level (Kalman RW) state-space fit per Event/Control
#   B. Per-segment dynamic EB with random-walk prior (momentum g* tuned)
#   C. Post-event decay on control days
#   D. Holdout: static EB vs dynamic-RW EB
# Depends on Job 1b (geometry features) and Job 2 (SPF covariate parity not
# required; 26 fits its own SPF on training fixtures).
# ══════════════════════════════════════════════════════════════════════════════

PROJ_DIR=/mnt/hpccs01/home/ahernz/test_runs_tours/demand_/suncorp_telematics
SCRIPT_DIR=$PROJ_DIR/scripts
DATA_DIR=$PROJ_DIR/data
RESULTS_DIR=$PROJ_DIR/results

# ── Load environment ──────────────────────────────────────────────────────────
module purge
module load Anaconda3/2024.02-1
conda activate zigenv
module unload Anaconda3

echo "Checking/installing required Python packages..."
python -c "import scipy" 2>/dev/null || pip install --force-reinstall --no-deps scipy
python -c "import statsmodels" 2>/dev/null || pip install --force-reinstall --no-deps statsmodels

# ── Environment variables ─────────────────────────────────────────────────────
export PROJ="$PROJ_DIR"
export PYTHONWARNINGS="ignore::RuntimeWarning"
export OMP_NUM_THREADS=8
export OPENBLAS_NUM_THREADS=8
export MKL_NUM_THREADS=8

cd "$SCRIPT_DIR"

echo "════════════════════════════════════════════════════════════════"
echo "Job $PBS_JOBID started on $(hostname) at $(date)"
echo "Project dir:  $PROJ_DIR"
echo "════════════════════════════════════════════════════════════════"

if [ ! -f "$DATA_DIR/segment_roads_part0_5000.csv.gz" ]; then
    echo "✗ ERROR: segment_roads_part0_5000.csv.gz not found!"
    exit 1
fi

echo ""
echo "Running 26_temporal_dynamics.py..."
echo ""

python -u 26_temporal_dynamics.py 2>&1
EXIT_CODE=$?

echo ""
OK=0
for f in temporal_level.csv temporal_summary.csv temporal_holdout.csv \
         temporal_dynamic_event.csv temporal_dynamics.tex; do
    if [ -f "$RESULTS_DIR/$f" ]; then
        echo "✓ $f created"; OK=$((OK + 1))
    else
        echo "✗ MISSING: $f"
    fi
done
[ $OK -lt 5 ] && EXIT_CODE=1

echo ""
echo "════════════════════════════════════════════════════════════════"
echo "Job finished at $(date) — exit_code=$EXIT_CODE"
echo "════════════════════════════════════════════════════════════════"

exit $EXIT_CODE
