#!/bin/bash -l
#PBS -N t6bgrouped
#PBS -l walltime=04:00:00
#PBS -l select=1:ncpus=4:mem=192GB
#PBS -j oe
#PBS -m abe
#PBS -r y

# T6b — force the grouped-probe winners (rel_sin / rel_cos into the role-4
# grouped server) into the refit spec, starting from the T6 best spec. The
# SA search cannot reach role 4 on its own, so this is the evidence-driven
# path: the grouped probe in T6 said rel_sin wins (BIC delta ~ -144k
# single-term, -539 full-spec), so --force-grouped-temporal on puts it in
# the refit and --group-by segment gives the per-segment grouping.
#
# Needs metacountregressor >= 1.0.165 (temporal_models) for the stage 2b
# AR refit; outputs to results_tests/t6b_grouped_temporal so it does NOT
# blow away T6's own files.
set -u

PROJ_DIR=/mnt/hpccs01/home/ahernz/test_runs_tours/demand_/suncorp_telematics
SCRIPT_DIR=$PROJ_DIR/scripts
OUT_DIR=$PROJ_DIR/results_tests/t6b_grouped_temporal
FIG_DIR=$PROJ_DIR/figures_tests/t6b_grouped_temporal
T6_DIR=$PROJ_DIR/results_tests/t6_grouped_temporal

# Refuse to run outside PBS: keep all compute off the login/head node.
if [ -z "${PBS_JOBID:-}" ] && [ "${ALLOW_HEAD_NODE:-0}" != "1" ]; then
  echo "$(basename "$0"): PBS batch script; refusing to run on $(hostname). Submit with qsub." >&2
  exit 2
fi

[ -s "$T6_DIR/game_day_search_best.json" ] || {
  echo "FATAL: missing $T6_DIR/game_day_search_best.json (t6_grouped_temporal must finish first)" >&2
  exit 1
}

module purge
module load Anaconda3/2024.02-1
conda activate zigenv
module unload Anaconda3

export PYTHONWARNINGS="ignore::RuntimeWarning"
export OMP_NUM_THREADS=4
export OPENBLAS_NUM_THREADS=4
export MKL_NUM_THREADS=4
export JAX_PLATFORMS=cpu
export PYTHONIOENCODING=utf-8

cd "$SCRIPT_DIR"
rm -rf "$OUT_DIR" "$FIG_DIR"
mkdir -p "$OUT_DIR" "$FIG_DIR"
cp "$T6_DIR/game_day_search_best.json" "$OUT_DIR/game_day_search_best.json"

echo "=================================================================="
echo "T6b force-grouped-temporal smoke test started on $(hostname) at $(date)"
echo "=================================================================="
echo "package: $(python -c 'from importlib.metadata import version; print(version("metacountregressor"))')"
echo

python -u 59_game_day_search_predict.py \
  --out-dir "$OUT_DIR" --fig-dir "$FIG_DIR" \
  --search-iters 1 --search-chunk 1 \
  --n-starts 1 --search-R 5 --refit-R 10 \
  --search-vars slim --target trips_mean_gt_10 \
  --group-by segment \
  --group-temporal on \
  --force-grouped-temporal on \
  --n-future 2 \
  --two-stage on \
  --temporal-mode ar1 --temporal-refit ar2 \
  --resume \
  2>&1

RC=$?
echo
echo "=================================================================="
echo "T6b python exit code: $RC"
echo

python - "$OUT_DIR" <<'PY'
import json, os, sys
d = sys.argv[1]
p = os.path.join(d, "game_day_holdout_metrics.json")
if not os.path.exists(p):
    print("FAIL: no holdout metrics json written")
    sys.exit(1)
j = json.load(open(p))
a = j.get("audit") or {}
m = j.get("metrics") or {}
print("group_temporal:", a.get("group_temporal"))
print("force_grouped_temporal:", a.get("force_grouped_temporal"))
print("temporal_mode:", a.get("temporal_mode"))
print("temporal_stage:", json.dumps(a.get("temporal_stage") or {}, sort_keys=True)[:600])
print("grouped_probe summary:", json.dumps({
    k: v.get("grouped_wins")
    for k, v in ((a.get("grouped_probe") or {}).get("results") or {}).items() if v.get("ok")}
    , sort_keys=True)[:600])
print("metrics:", {k: m.get(k) for k in (
    "rmse", "calibration_slope", "segment_top20",
    "temporal_bin_spearman", "temporal_segment_spearman",
    "temporal_segment_top20")})
PY
if [ "$RC" -ne 0 ]; then
  echo "FAILED (python exit $RC)"
  exit "$RC"
fi
echo
echo "=================================================================="
echo "T6b finished at $(date)"
echo "=================================================================="
