    # Compute TOTEMP if not present (sum of sectoral employment)
    if 'TOTEMP' not in lu.columns:
        _emp_cols = ['FPSEMPN', 'HEREMPN', 'RETEMPN', 'MWTEMPN', 'OTHEMP', 'AGREMPN']
        _available = [c for c in _emp_cols if c in lu.columns]
        if _available:
