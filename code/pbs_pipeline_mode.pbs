#!/bin/bash -l
# Generic PBS runner for pipeline_logger.py modes.
#
# Submit via qsub with environment variables, for example:
#   qsub -v MODE=main,ZONE_ARG=40,CONDA_ENV=zigenv,THREADS=2 pbs_pipeline_mode.pbs

#PBS -m n
#PBS -r y

set -euo pipefail

MODE=${MODE:-main}
ZONE_ARG=${ZONE_ARG:-}
CONDA_ENV=${CONDA_ENV:-zigenv}
THREADS=${THREADS:-1}
S5_WORKERS=${S5_WORKERS:-1}
RUN_ROOT=${RUN_ROOT:-runs}
PIPELINE_ACCELERATOR=${PIPELINE_ACCELERATOR:-cpu}
PIPELINE_RUN_TAG=${PIPELINE_RUN_TAG:-${PBS_JOBID:-$(date +%Y%m%d_%H%M%S)}}
GA_ESTIMATOR=${GA_ESTIMATOR:-default}
INSTALL_ESTIMATORS=${INSTALL_ESTIMATORS:-1}
ESTIMATOR_SOURCE=${ESTIMATOR_SOURCE:-pypi}

cd "$PBS_O_WORKDIR"

module purge
module load Anaconda3/2024.02-1
conda activate "$CONDA_ENV"
module unload Anaconda3

# ── Ensure MetaCount + SearchLibrium are installed ─────────────────────────
# INSTALL_ESTIMATORS=1  → force (re-)install regardless of current state.
# ESTIMATOR_SOURCE=pypi (default) always installs latest published releases.
# ESTIMATOR_SOURCE=editable uses local source trees when present.
#
#   Editable-source setup (optional, for package development):
#     pip install -e /mnt/hpccs01/home/ahernz/source/MetaCount
#     pip install -e /mnt/hpccs01/home/ahernz/source/SearchLibrium
#     pip install jax jaxlib jaxopt
#
_HPC_MC=/mnt/hpccs01/home/ahernz/source/MetaCount
_HPC_SL=/mnt/hpccs01/home/ahernz/source/SearchLibrium

_need_metacount=0
_need_searchlib=0
case "$GA_ESTIMATOR" in
    metacount)     _need_metacount=1 ;;
    searchlibrium) _need_searchlib=1 ;;
    both)          _need_metacount=1; _need_searchlib=1 ;;
esac

if [ "$INSTALL_ESTIMATORS" = "1" ] || [ "$_need_metacount" = "1" ]; then
    echo "[pkg] Installing MetaCount estimator (${ESTIMATOR_SOURCE})..."
    if [ "$ESTIMATOR_SOURCE" = "editable" ] && [ -d "$_HPC_MC" ]; then
        pip install -e "$_HPC_MC" --upgrade -q \
            && echo "[pkg] MetaCount installed (editable: $_HPC_MC)"
    else
        pip install --upgrade --no-cache-dir -q "metacountregressor" \
            && echo "[pkg] MetaCount installed (PyPI latest)"
    fi
    pip install --upgrade --no-cache-dir -q jax jaxlib jaxopt \
        && echo "[pkg] jax/jaxlib/jaxopt installed"
fi

if [ "$INSTALL_ESTIMATORS" = "1" ] || [ "$_need_searchlib" = "1" ]; then
    echo "[pkg] Installing SearchLibrium estimator (${ESTIMATOR_SOURCE})..."
    if [ "$ESTIMATOR_SOURCE" = "editable" ] && [ -d "$_HPC_SL" ]; then
        pip install -e "$_HPC_SL" --upgrade -q \
            && echo "[pkg] SearchLibrium installed (editable: $_HPC_SL)"
    else
        pip install --upgrade --no-cache-dir -q "SearchLibrium" \
            && echo "[pkg] SearchLibrium installed (PyPI latest)"
    fi
fi
# ──────────────────────────────────────────────────────────────────────────

# Keep linear algebra and numba-backed sections from oversubscribing cores.
# THREADS controls BLAS/numba; S5_WORKERS controls Stage 5 zone parallelism.
# Rule of thumb: S5_WORKERS = ncpus / THREADS  (e.g. ncpus=8,THREADS=1 → S5_WORKERS=8)
export OMP_NUM_THREADS="$THREADS"
export OPENBLAS_NUM_THREADS="$THREADS"
export MKL_NUM_THREADS="$THREADS"
export NUMEXPR_NUM_THREADS="$THREADS"
export STAGE5_WORKERS="$S5_WORKERS"
export PIPELINE_ACCELERATOR
export PIPELINE_RUN_TAG
export PIPELINE_RUN_ROOT="$RUN_ROOT"
export GA_ESTIMATOR
# Force Larch to use numba engine during GA fitness evaluations to avoid
# cusolver_gesvdj_ffi CUDA kernel errors (jaxlib 0.10.0 / CUDA 13 incompatibility).
# Small per-purpose datasets in GA context are faster on numba CPU anyway.
export GA_LARCH_ENGINE="${GA_LARCH_ENGINE:-numba}"
# Force MetaCount to always use CPU (cusolver_gesvdj_ffi unavailable on CUDA 13).
export GA_METACOUNT_FORCE_CPU="${GA_METACOUNT_FORCE_CPU:-1}"
# For GA search modes, force JAX to CPU to prevent CUDA kernel errors during
# per-case fitness evaluations (small batches are faster on numba/CPU anyway).
# ga_stage5_smoke is excluded: it uses GPU (JAX/XLA) for the final model fit,
# which benefits from CUDA when a GPU node is requested (--gpu 1 --accelerator gpu).
case "$MODE" in
    ga|ga_metacount|ga_searchlibrium)
        export JAX_PLATFORMS=cpu
        ;;
    ga_stage5_smoke)
        if [ "${PIPELINE_ACCELERATOR:-cpu}" != "gpu" ]; then
            export JAX_PLATFORMS=cpu
        fi
        ;;
esac

# Derive SAFETY_EXPERIMENT_MODE from mode name so the pipeline knows which arm to run.
# This avoids needing to pass it as a separate -v variable from submit_pipeline_runs.sh.
case "$MODE" in
    safety_baseline*)  export SAFETY_EXPERIMENT_MODE="${SAFETY_EXPERIMENT_MODE:-baseline}" ;;
    safety_nosafety*)  export SAFETY_EXPERIMENT_MODE="${SAFETY_EXPERIMENT_MODE:-nosafety}"  ;;
    safety_analysis*)  export SAFETY_EXPERIMENT_MODE="${SAFETY_EXPERIMENT_MODE:-both}"      ;;
esac

# Enable joint participation model estimation for the dedicated joint_model job.
if [ "$MODE" = "joint_model" ]; then
    export JOINT_PARTICIPATION_MODEL=1
fi

run_suffix="$MODE"
if [ -n "$ZONE_ARG" ]; then
    safe_arg=${ZONE_ARG//\//_}
    safe_arg=${safe_arg//\\/_}
    safe_arg=${safe_arg// /}
    run_suffix="${MODE}_${safe_arg}"
fi
# Append estimator name so parallel estimator-variant runs land in distinct dirs.
# e.g. main_metacount__JOBID/  vs  main__JOBID/  vs  main_both__JOBID/
if [ -n "$GA_ESTIMATOR" ] && [ "$GA_ESTIMATOR" != "default" ]; then
    run_suffix="${run_suffix}_${GA_ESTIMATOR}"
fi
run_suffix="${run_suffix}__${PIPELINE_RUN_TAG}"

mkdir -p "$RUN_ROOT/$run_suffix/plots"

echo "=========================================="
echo "PBS job ${PBS_JOBID:-unknown}"
echo "Mode:        $MODE"
echo "Zone arg:    ${ZONE_ARG:-<all>}"
echo "Conda env:   $CONDA_ENV"
echo "Threads:     $THREADS"
echo "Accelerator: $PIPELINE_ACCELERATOR"
echo "GA estimator:$GA_ESTIMATOR"
echo "Run tag:     $PIPELINE_RUN_TAG"
echo "Working dir: $PBS_O_WORKDIR"
echo "Run dir:     ${RUN_ROOT}/${run_suffix}"
echo "Started:     $(date)"
echo "=========================================="

# ── Write run outline ───────────────────────────────────────────────────────
# Describes what this job is testing so outputs in the run dir are self-contained.
_outline="${RUN_ROOT}/${run_suffix}/run_outline.txt"
cat > "$_outline" <<OUTLINE
Run Outline
===========
PBS job       : ${PBS_JOBID:-unknown}
Submit host   : ${PBS_O_HOST:-unknown}
Mode          : ${MODE}
Zone argument : ${ZONE_ARG:-<all zones>}
GA estimator  : ${GA_ESTIMATOR}
GA budget     : ${GA_BUDGET:-standard}
Accelerator   : ${PIPELINE_ACCELERATOR}
Threads       : ${THREADS}
S5 workers    : ${S5_WORKERS}
Resources     : $(qstat -f "${PBS_JOBID:-unknown}" 2>/dev/null | grep Resource_List | head -1 | sed 's/.*Resource_List.//' || echo 'n/a')
Conda env     : ${CONDA_ENV}
Working dir   : ${PBS_O_WORKDIR}
Run dir       : ${RUN_ROOT}/${run_suffix}
Log file      : ${RUN_ROOT}/${run_suffix}/pipeline_run.log
Started       : $(date -Iseconds)

What this job tests
-------------------
$(case "$MODE" in
    main)
        echo "Full ABM pipeline (stages 1–6) on synthetic population."
        echo "Estimates models on HHTS data, predicts for all SA2 zones."
        echo "Estimator: ${GA_ESTIMATOR} (controls activity frequency / duration models)."
        ;;
    ga)
        echo "GA variable selection on HHTS data (stages 1–5, estimation only)."
        echo "Identifies best feature subsets via genetic algorithm."
        echo "Estimator: ${GA_ESTIMATOR}."
        echo "No synthetic-population prediction — run ga_staged or main afterwards."
        ;;
    ga_staged)
        echo "GA variable selection (stages 1–5) + full pipeline prediction."
        echo "Applies GA-selected features to synth population after estimation."
        echo "Estimator: ${GA_ESTIMATOR}."
        ;;
    ga_stage5_smoke)
        echo "GA Stage 5-only smoke test (ultra-small GA budget)."
        echo "Runs estimation-only wiring check and writes stage reports/checkpoints."
        echo "No full synthetic-population prediction in this mode."
        ;;
    safety_baseline)
        echo "Safety experiment — baseline run with crash-risk skims active."
        echo "Generates trip plans used to measure safety-aware mode shift."
        ;;
    safety_nosafety)
        echo "Safety experiment — counterfactual run with crash-risk skims zeroed."
        echo "Contrast with safety_baseline to measure mode-shift from safety utility."
        ;;
    safety_analysis)
        echo "Safety experiment — compares baseline vs no-safety trip plans."
        echo "Produces safety_experiment_report.html and zone-ranking CSV."
        ;;
    joint_model)
        echo "Joint participation + duration model comparison."
        echo "Fits Tobit-I and Heckman models on HHTS day-duration data."
        echo "Writes stage2_joint_model_comparison.html into the most recent main run dir."
        ;;
    mcr_search)
        echo "MetaCount ExperimentBuilder structure search."
        echo "Family: ${MCR_FAMILY:-n/a}  Algorithm: ${MCR_ALGO:-sa}"
        echo "Max iterations: ${MCR_MAX_ITER:-2000}  Halton draws R=${MCR_R:-200}."
        echo "Searches over model structure (random parameters, dispersion, zero-inflation)."
        ;;
    *)
        echo "Mode: ${MODE} — see pipeline_logger.py for details."
        ;;
esac)

Outputs expected
----------------
$(case "$MODE" in
    main|ga_staged)
        echo "  stage1_coefficients.html  stage2_coefficients.html  stage3_coefficients.html"
        echo "  stage4_coefficients.html  stage5_models_coefficients.html"
        echo "  stage6_output.csv  trips_for_aimsun.csv"
        echo "  plots/  — activity patterns, destination share, mode share"
        ;;
    ga)
        echo "  ga_results.pkl  ga_reports/ga_summary.html"
        echo "  ga_reports/ga_stage*_best_model.txt  ga_reports/ga_stage*_best_features.csv"
        echo "  plots/ga_stage*.png  plots/ga_all_stages.png"
        ;;
    ga_stage5_smoke)
        echo "  ga_results_stage5_smoke.pkl"
        echo "  stage_reports/ga_stage5_smoke.*"
        echo "  ga_reports/ga_summary.html  plots/ga_stage5.png"
        ;;
    mcr_search)
        echo "  mcr_search_result.json  best_spec.json  mcr_search_summary.html"
        ;;
    *)
        echo "  See pipeline_run.log for outputs."
        ;;
esac)
OUTLINE
echo "  run_outline.txt → ${_outline}"

set +e
if [ "$MODE" = "safety_analysis" ]; then
    stdbuf -oL python -u safety_experiment_analysis.py \
        2>&1 | stdbuf -oL tee -a "${RUN_ROOT}/${run_suffix}/pipeline_run.log"
elif [ "$MODE" = "joint_model" ]; then
    # Tobit-I + Heckman joint participation+duration comparison.
    # Loads data and the already-estimated Stage 2 models from the most-recent
    # main run, then runs estimate_stage2_joint() and writes the comparison HTML.
    stdbuf -oL python -u - << 'PYEOF' \
        2>&1 | stdbuf -oL tee -a "${RUN_ROOT}/${run_suffix}/pipeline_run.log"
import sys, os
sys.path.insert(0, '.')
os.environ.setdefault('JOINT_PARTICIPATION_MODEL', '1')

from pipeline_logger import load_data, estimate_stage2_joint, OUT_DIR
from stage2_day_duration import load_models
import glob, os as _os

out = load_data()

# Find the most recent stage2_models.pkl in any main run directory
s2_pkl = _os.path.join(OUT_DIR, 'stage2_models.pkl')
if not _os.path.isfile(s2_pkl):
    candidates = sorted(glob.glob('runs/main*/stage2_models.pkl'), key=_os.path.getmtime)
    if candidates:
        s2_pkl = candidates[-1]
        print(f'Using stage2 models from: {s2_pkl}')

s2_models = None
if _os.path.isfile(s2_pkl):
    s2_models = load_models(s2_pkl)
    print(f'Loaded two-stage models: {s2_pkl}')
else:
    print('WARNING: stage2_models.pkl not found - comparison will show joint models only')

estimate_stage2_joint(out, s2_models=s2_models)
print('Joint model estimation complete.')
PYEOF
else
    if [ -n "$ZONE_ARG" ]; then
        stdbuf -oL python -u pipeline_logger.py "$MODE" "$ZONE_ARG" \
            2>&1 | stdbuf -oL tee -a "${RUN_ROOT}/${run_suffix}/pipeline_run.log"
    else
        stdbuf -oL python -u pipeline_logger.py "$MODE" \
            2>&1 | stdbuf -oL tee -a "${RUN_ROOT}/${run_suffix}/pipeline_run.log"
    fi
fi
EXIT_CODE=$?
set -e
echo "Finished: $(date)  exit_code=${EXIT_CODE}"
exit "$EXIT_CODE"