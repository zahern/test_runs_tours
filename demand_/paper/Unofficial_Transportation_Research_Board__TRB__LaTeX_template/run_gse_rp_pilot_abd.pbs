#!/bin/bash -l
#PBS -N gse_rp_ABD
#PBS -l walltime=40:00:00
#PBS -l select=1:ncpus=4:mem=64GB
#PBS -j oe
#PBS -r n
# Single-engine (metacountregressor 1.0.189) repeat of pilot arms A/B/D for
# BOTH responses, to complete the structured-RP table alongside the 1.0.189
# C-arm rerun (job 26839180). Writes gse_rp_pilot_partial_abd.* sidecars;
# the final aggregates are merged offline with the child's C-arm partials.

PROJ_DIR=/mnt/hpccs01/home/ahernz/test_runs_tours/demand_/paper/Unofficial_Transportation_Research_Board__TRB__LaTeX_template
module purge
module load Anaconda3/2024.02-1
conda activate zigenv
module unload Anaconda3
mkdir -p /mnt/hpccs01/home/ahernz/test_runs_tours/code
(
    flock -w 900 9 2>/dev/null || echo "(flock unavailable, proceeding without lock)"
    pip install --quiet --upgrade --retries 5 --timeout 60 metacountregressor==1.0.189 2>&1 | tail -5
) 9>/mnt/hpccs01/home/ahernz/test_runs_tours/code/.pkg_upgrade.lock
python -c "from importlib.metadata import version as _v; v=tuple(map(int, _v('metacountregressor').split('.')[:3])); assert v==(1,0,189), f\"unexpected mcr {_v('metacountregressor')} -- aborting\"; print('mcr', _v('metacountregressor'), 'OK (pinned)')" || exit 1
export PYTHONWARNINGS="ignore::RuntimeWarning"
export OMP_NUM_THREADS=4
export XLA_PYTHON_CLIENT_PREALLOCATE=false
export XLA_PYTHON_CLIENT_MEM_FRACTION=0.6
export JAX_PLATFORMS=cpu
cd "$PROJ_DIR"
echo "Job $PBS_JOBID started on $(hostname) at $(date)"
python -u gse_rp_pilot.py --data "$PROJ_DIR/near_miss_hb_ecf.csv" --out-dir "$PROJ_DIR" --arms A-unstruct,B-hetmean,D-gse --suffix _partial_abd 2>&1
EXIT_CODE=$?
for f in "$PROJ_DIR/gse_rp_pilot_partial_abd.csv" "$PROJ_DIR/gse_rp_pilot_verdict_partial_abd.csv" "$PROJ_DIR/gse_rp_pilot_partial_abd.tex"; do
  if [ ! -f "$f" ]; then echo "MISSING pilot output: $f"; EXIT_CODE=1; fi
done
echo "Job finished at $(date) exit=$EXIT_CODE"
exit $EXIT_CODE
