_sa2_to_order_cache: dict = {}


def _sa2_to_order_bridge() -> dict:
    """Cached SA2 zone_id → ORDER map (seq_zone_ids_371.csv). Empty on failure."""
    global _sa2_to_order_cache
    if '_loaded' not in _sa2_to_order_cache:
