#!/bin/bash -l
#PBS -N suncorp_transfer
#PBS -l walltime=01:00:00
#PBS -l select=1:ncpus=4:mem=32GB
#PBS -j oe
#PBS -m abe
#PBS -r y

# ══════════════════════════════════════════════════════════════════════════════
# Job 8: Crash transferability validation
#   A. SEQ statewide ranking & calibration (HB-EB vs crash-EB)
#   B. 5-fold CV: does HB improve crash prediction over geometry alone?
#   C. Suncorp SA2 zone-level validation (HB-EB vs SA2 crash density)
# Depends on Job 2 (needs eb_predictions.csv for Suncorp zone part)
# ══════════════════════════════════════════════════════════════════════════════

PROJ_DIR=/mnt/hpccs01/home/ahernz/test_runs_tours/demand_/suncorp_telematics
SCRIPT_DIR=$PROJ_DIR/scripts
DATA_DIR=$PROJ_DIR/data
RESULTS_DIR=$PROJ_DIR/results

module purge
module load Anaconda3/2024.02-1
conda activate zigenv
module unload Anaconda3

echo "Checking/installing required Python packages..."
python -c "import geopandas" 2>/dev/null || pip install --force-reinstall --no-deps geopandas pyogrio
python -c "import scipy" 2>/dev/null || pip install --force-reinstall --no-deps scipy

export PROJ="$PROJ_DIR"
export PYTHONWARNINGS="ignore::RuntimeWarning"
export OMP_NUM_THREADS=4
export OPENBLAS_NUM_THREADS=4
export MKL_NUM_THREADS=4

cd "$SCRIPT_DIR"

echo "════════════════════════════════════════════════════════════════"
echo "Job $PBS_JOBID started on $(hostname) at $(date)"
echo "Project dir:  $PROJ_DIR"
echo "════════════════════════════════════════════════════════════════"

if [ ! -f "$RESULTS_DIR/eb_predictions.csv" ]; then
    echo "✗ ERROR: eb_predictions.csv not found! Run 02_eb_analysis.pbs first."
    exit 1
fi

echo ""
echo "Running 27_crash_transfer_validation.py..."
echo ""

python -u 27_crash_transfer_validation.py 2>&1
EXIT_CODE=$?

echo ""
OK=0
for f in crash_transfer_ranking.csv crash_transfer_holdout.csv suncorp_zone_validation.csv crash_transfer_validation.tex; do
    if [ -f "$RESULTS_DIR/$f" ]; then
        echo "✓ $f created"; OK=$((OK + 1))
    else
        echo "✗ MISSING: $f"
    fi
done
[ $OK -lt 4 ] && EXIT_CODE=1

echo ""
echo "════════════════════════════════════════════════════════════════"
echo "Job finished at $(date) — exit_code=$EXIT_CODE"
echo "════════════════════════════════════════════════════════════════"

exit $EXIT_CODE
