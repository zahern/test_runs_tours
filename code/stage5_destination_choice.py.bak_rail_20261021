                pd.to_numeric(lu[c], errors='coerce').fillna(0.0) for c in _available
            )
            logger.info(f"_lu_idx: computed TOTEMP from {_available} "
                        f"(mean={lu['TOTEMP'].mean():.0f}, max={lu['TOTEMP'].max():.0f})")
    return lu


