#!/bin/bash -l
#PBS -N suncorp_survival
#PBS -l walltime=01:00:00
#PBS -l select=1:ncpus=4:mem=32GB
#PBS -j oe
#PBS -m abe
#PBS -r y

# ======================================================================
# Inter-arrival survival (hazard) of finable speeding. Runs AFTER job 13
# (needs results/finable_exceedances.csv.gz).
# Paper inputs: results/duration_survival.tex, figures/survival_km.png
# Submit: cd $PROJ_DIR && qsub 14_duration_survival.pbs
# ======================================================================

PROJ_DIR=/mnt/hpccs01/home/ahernz/test_runs_tours/demand_/suncorp_telematics
SCRIPT_DIR=$PROJ_DIR/scripts
RESULTS_DIR=$PROJ_DIR/results

module purge
module load Anaconda3/2024.02-1
conda activate zigenv
module unload Anaconda3

export PROJ="$PROJ_DIR"
export PYTHONWARNINGS="ignore::RuntimeWarning"
export OMP_NUM_THREADS=4
export OPENBLAS_NUM_THREADS=4
export MKL_NUM_THREADS=4

cd "$SCRIPT_DIR"

echo "=================================================================="
echo "Job $PBS_JOBID started on $(hostname) at $(date)"
echo "=================================================================="

if [ ! -s "$RESULTS_DIR/finable_exceedances.csv.gz" ]; then
  echo "FATAL: finable_exceedances.csv.gz missing - run 13_finable_speeding.pbs first."
  exit 1
fi
echo "Inputs OK."

python -u 44_duration_survival.py 2>&1
EXIT_CODE=$?
if [ $EXIT_CODE -ne 0 ] || [ ! -s "$RESULTS_DIR/duration_survival_audit.json" ]; then
  echo "FATAL: survival pipeline failed (exit=$EXIT_CODE)"
  exit 1
fi

python - "$RESULTS_DIR/duration_survival_audit.json" <<'EOF'
import json, os
base = "/mnt/hpccs01/home/ahernz/test_runs_tours/demand_/suncorp_telematics"
a = json.load(open(f"{base}/results/duration_survival_audit.json"))
assert a["n_gaps"] > 1000, "too few gaps"
for f in ["results/duration_survival.tex", "figures/survival_km.png"]:
    assert os.path.getsize(f"{base}/{f}") > 0, f"missing {f}"
print(f"OK: gaps={a['n_gaps']} weibull={a['weibull']['in_window']}")
print(f"OK: rates={a['phase_rates']}")
EOF
EXIT_CODE=$?

echo "=================================================================="
echo "Job finished at $(date) - exit_code=$EXIT_CODE"
echo "=================================================================="
exit $EXIT_CODE
