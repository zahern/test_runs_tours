# ============================================================
# .gitignore — test_runs_tours/code
# ============================================================
# NOTE: Git cannot filter by file size in .gitignore.
# GitHub hard-rejects any single file > 100 MB at push time.
# Add known large files explicitly in the section below, or
# use Git LFS:  git lfs track "*.omx"
# ============================================================

# ── Virtual environment ─────────────────────────────────────
.venv/
venv/
env/

# ── Editor / AI assistant ───────────────────────────────────
.vscode/
.claude/
.idea/
TSP_Paper/
TSP__Departmentment_of_Infrastructure___Mathematical_Program/
# ── Cluster / PBS log files (*.err, *.out, *.eNNNNNNN, *.oNNNNNNN) ─────────
*.err
*.out
*.e[0-9]*
*.o[0-9]*

# ── Generated outputs and run artefacts ─────────────────────
# saved_data/ is ignored in bulk, but zone_ids_sa2/ is source-controlled
# (it is the synthetic population input, not a generated output).
# Git cannot negate a directory-level rule, so we use wildcard form:

#saved_data/*
#!saved_data/zone_ids_sa2/
runs/
_runs/

# ── External library bundled in repo ────────────────────────
activitysim-main/

# ── Shapefile / GIS folders and large spatial data ──────────
SA1_SHP/
SA2_2021_AUST_SHP_GDA2020/
*.shp
*.shx
*.dbf
*.prj
*.cpg
*.sbn
*.sbx

# ── Large spreadsheets and datasets ─────────────────────────
*.xlsx
*.xls
*.png
*.html
code/comprehensive_dataset.csv
code/initial_trips_hhts.csv
code/pddopulation_by_order_with_osm_and_landuse.csv

# ── Text / LaTeX files (keep README.md, ignore everything else) ─────────────
*.txt
*.tex
*.pdf
*.ppt
*.cmd
*.pdf
*.json
*.csv
*.docx
*.zip
*.htm
*.pptx
*.log
*.exe
*.pkl
*.dat
*.out
*.o
*.e



# ── Known large binary / data files (> 100 MB) ──────────────
# Uncomment or add any file whose size exceeds GitHub's 100 MB limit.
# To check sizes:  Get-ChildItem -Recurse | Where-Object {$_.Length -gt 100MB}
*.omx
# comprehensive_dataset.csv
# initial_trips_hhts.csv
# pddopulation_by_order_with_osm_and_landuse.csv

# ── Python cache / compiled files ───────────────────────────
__pycache__/
*.py[cod]
*.pyo
.pytest_cache/
*.egg-info/
dist/
build/

# ── OS artefacts ────────────────────────────────────────────
.DS_Store
Thumbs.db

