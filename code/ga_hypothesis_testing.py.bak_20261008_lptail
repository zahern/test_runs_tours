def _add_taste_interactions(data: pd.DataFrame, stage_id: int) -> List[str]:
    """Materialise the stage's taste-variation columns (idempotent) and return
    the names available as GA perturbations. Called from the stage candidate
    builders (search side) and from ensure_ga_search_columns (refit side) so
    a selected ix* column resolves in BOTH frames."""
    if int(stage_id) == 4:
        cont = _TASTE_STAGE4_CONTINUOUS
    else:
        cont = _TASTE_STAGE_CONTINUOUS.get(int(stage_id), [])
    if not cont:
        return []
    return _taste_interaction_candidates(
        data, cont, _TASTE_SEGMENTS, prefix=f'ix{int(stage_id)}', max_pairs=120)


def _meaningful_interaction_candidates(
    data: pd.DataFrame,
    specs: List[Tuple[str, str, str]],
    min_nonzero_share: float = 0.05,
    max_abs_corr: float = 0.97,
) -> List[str]:
    """Create only interactions with usable coverage and without parent duplication."""
    added: List[str] = []
    for left, right, name in specs:
        if left not in data.columns or right not in data.columns:
            continue
        lhs = pd.to_numeric(data[left], errors='coerce').fillna(0.0).astype(float)
        rhs = pd.to_numeric(data[right], errors='coerce').fillna(0.0).astype(float)
        vals = lhs * rhs
        nonzero_share = float((np.abs(vals) > 1e-9).mean())
        if vals.std() <= 1e-9 or nonzero_share < min_nonzero_share:
            continue
        keep = True
        for parent in (lhs, rhs):
            if parent.std() <= 1e-9:
                continue
            corr = np.corrcoef(vals, parent)[0, 1]
            if np.isfinite(corr) and abs(float(corr)) >= max_abs_corr:
                keep = False
                break
        if not keep:
            continue
        data[name] = vals
        added.append(name)
    return added


def _available_feature_list(data: pd.DataFrame, names: List[str]) -> List[str]:
    return [c for c in dict.fromkeys(names) if c in data.columns]


