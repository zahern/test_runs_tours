\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces \textcolor {Highlight}{\textbf  {Predicted 15-minute surfaces per held-out fixture.}} Per-fixture top-20 segments ranked by predicted speeding, showing predicted vehicles (left panel) and predicted speeding events per bin (right). The within-fixture timing shapes differ---evening NRL fixtures peak before kick-off, the afternoon and 17:15 fixtures lean post-game---while the leading streets are shared across fixtures.}}{5}{figure.caption.18}\protected@file@percent }
\newlabel{fig:surfaces}{{1}{5}{\textcolor {Highlight}{\textbf {Predicted 15-minute surfaces per held-out fixture.}} Per-fixture top-20 segments ranked by predicted speeding, showing predicted vehicles (left panel) and predicted speeding events per bin (right). The within-fixture timing shapes differ---evening NRL fixtures peak before kick-off, the afternoon and 17:15 fixtures lean post-game---while the leading streets are shared across fixtures}{figure.caption.18}{}}
\newlabel{fig:surfaces@cref}{{[figure][1][]1}{[1][4][]5}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces \textcolor {Highlight}{\textbf  {Prediction calibration on held-out fixtures.}} Observed against predicted event mass per segment-bin. The slope is $0.759$, so the surface is monotone in ranking but conservative in level; deployment uses the ranking, and we do not rescale to force unit slope because the uncorrected surface is what the optimiser consumes.}}{6}{figure.caption.19}\protected@file@percent }
\newlabel{fig:calib}{{2}{6}{\textcolor {Highlight}{\textbf {Prediction calibration on held-out fixtures.}} Observed against predicted event mass per segment-bin. The slope is $0.759$, so the surface is monotone in ranking but conservative in level; deployment uses the ranking, and we do not rescale to force unit slope because the uncorrected surface is what the optimiser consumes}{figure.caption.19}{}}
\newlabel{fig:calib@cref}{{[figure][2][]2}{[1][4][]6}}
