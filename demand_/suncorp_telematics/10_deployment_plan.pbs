#!/bin/bash -l
#PBS -N suncorp_depplan
#PBS -l walltime=01:00:00
#PBS -l select=1:ncpus=4:mem=32GB
#PBS -j oe
#PBS -m abe
#PBS -r y

# ══════════════════════════════════════════════════════════════════════════════
# Job 10: Fixture-day deployment plan (Programme P5) on P4-selected posts.
# Builds space-time catchment risk r[j,h] from the hard-braking stream over the
# six March-2026 fixtures (+ one ordinary evening contrast), then solves the
# relocation-aware deployment MIP exactly (HiGHS), with static/random/
# free-movement baselines and a squad-size Pareto scan.
# Runs AFTER 09_post_selection.pbs (needs results/post_selection_mip.csv).
# Outputs: results/deployment_plan.csv, deployment_summary.json,
#          results/deployment_riskscore.tex,
#          figures/fig32_mip_schedule.png, figures/fig33_mip_value.png
# ══════════════════════════════════════════════════════════════════════════════

PROJ_DIR=/mnt/hpccs01/home/ahernz/test_runs_tours/demand_/suncorp_telematics
SCRIPT_DIR=$PROJ_DIR/scripts
DATA_DIR=$PROJ_DIR/data

module purge
module load Anaconda3/2024.02-1
conda activate zigenv
module unload Anaconda3

echo "Checking/installing required Python packages..."
python -c "import scipy; assert int(scipy.__version__.split('.')[1]) >= 15" 2>/dev/null \
    || pip install -U --no-deps scipy
python -c "import networkx" 2>/dev/null || pip install --force-reinstall --no-deps networkx

export PROJ="$PROJ_DIR"
export PYTHONWARNINGS="ignore::RuntimeWarning"
export OMP_NUM_THREADS=4
export OPENBLAS_NUM_THREADS=4
export MKL_NUM_THREADS=4

cd "$SCRIPT_DIR"

echo "════════════════════════════════════════════════════════════════"
echo "Job $PBS_JOBID started on $(hostname) at $(date)"
echo "Project dir:  $PROJ_DIR"
echo "════════════════════════════════════════════════════════════════"

if [ ! -f "$DATA_DIR/hard_braking_events.csv" ] || [ ! -f "$PROJ_DIR/results/post_selection_mip.csv" ]; then
    echo "✗ ERROR: need hard_braking_events.csv and post_selection_mip.csv (run Job 9 first)."
    exit 1
fi

echo ""
echo "Running 29_deployment_plan.py ..."
echo ""

python -u 29_deployment_plan.py \
    --data-dir "$DATA_DIR" \
    --out-results "$PROJ_DIR/results" \
    --out-figures "$PROJ_DIR/figures" \
    --posts "$PROJ_DIR/results/post_selection_mip.csv" \
    --squad 5 --lam 0.25 --time-limit 300 2>&1
EXIT_CODE=$?

echo ""
if [ -f "$PROJ_DIR/results/deployment_summary.json" ]; then
    echo "✓ Success! Deployment plan outputs:"
    wc -l "$PROJ_DIR/results/deployment_plan.csv"
else
    echo "✗ FAILED: deployment_summary.json not created"
    EXIT_CODE=1
fi

echo ""
echo "════════════════════════════════════════════════════════════════"
echo "Job finished at $(date) — exit_code=$EXIT_CODE"
echo "════════════════════════════════════════════════════════════════"

exit $EXIT_CODE
