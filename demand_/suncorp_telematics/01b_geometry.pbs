#!/bin/bash -l
#PBS -N suncorp_geometry
#PBS -l walltime=01:00:00
#PBS -l select=1:ncpus=4:mem=32GB
#PBS -j oe
#PBS -m abe
#PBS -r y

# ══════════════════════════════════════════════════════════════════════════════
# Job 1b: Derive crash-prone road-geometry / network features from OSM (+Overture)
# Creates data/road_geometry_features.csv and merges them into near_miss_hb_ecf.csv
# Runs AFTER 01_prepare_data.pbs (needs the OSM geojson + near_miss table).
# ══════════════════════════════════════════════════════════════════════════════

PROJ_DIR=/mnt/hpccs01/home/ahernz/test_runs_tours/demand_/suncorp_telematics
SCRIPT_DIR=$PROJ_DIR/scripts
DATA_DIR=$PROJ_DIR/data

# ── Load environment ──────────────────────────────────────────────────────────
module purge
module load Anaconda3/2024.02-1
conda activate zigenv
module unload Anaconda3

# Ensure required packages are present in the conda env (force-repair broken installs)
echo "Checking/installing required Python packages..."
python -c "import geopandas" 2>/dev/null || pip install --force-reinstall --no-deps geopandas pyogrio
python -c "import scipy" 2>/dev/null || pip install --force-reinstall --no-deps scipy

# ── Environment variables ─────────────────────────────────────────────────────
export PROJ="$PROJ_DIR"
export PYTHONWARNINGS="ignore::RuntimeWarning"
export OMP_NUM_THREADS=4
export OPENBLAS_NUM_THREADS=4
export MKL_NUM_THREADS=4

cd "$SCRIPT_DIR"

echo "════════════════════════════════════════════════════════════════"
echo "Job $PBS_JOBID started on $(hostname) at $(date)"
echo "Project dir:  $PROJ_DIR"
echo "Data dir:     $DATA_DIR"
echo "════════════════════════════════════════════════════════════════"

# ── Check inputs ──────────────────────────────────────────────────────────────
if [ ! -f "$DATA_DIR/osm_roads_suncorp.geojson" ]; then
    echo "✗ ERROR: osm_roads_suncorp.geojson not found!"
    echo "   Please run 01_prepare_data.pbs first."
    exit 1
fi

# ── Run geometry feature extraction ───────────────────────────────────────────
echo ""
echo "Running 25_road_geometry_features.py..."
echo ""

python -u 25_road_geometry_features.py 2>&1
EXIT_CODE=$?

# ── Check outputs ─────────────────────────────────────────────────────────────
echo ""
if [ -f "$DATA_DIR/road_geometry_features.csv" ]; then
    echo "✓ Success! Created road_geometry_features.csv"
    wc -l "$DATA_DIR/road_geometry_features.csv"
else
    echo "✗ FAILED: road_geometry_features.csv not created"
    EXIT_CODE=1
fi

echo ""
echo "════════════════════════════════════════════════════════════════"
echo "Job finished at $(date) — exit_code=$EXIT_CODE"
echo "════════════════════════════════════════════════════════════════"

exit $EXIT_CODE
