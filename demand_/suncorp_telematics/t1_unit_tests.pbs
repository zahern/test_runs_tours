#!/bin/bash -l
#PBS -N t1unit
#PBS -l walltime=00:30:00
#PBS -l select=1:ncpus=4:mem=16gb
#PBS -j oe
#PBS -m abe
#PBS -r y

# T1 — unit / integration tests for the session's changes, on SYNTHETIC data.
#
# Purpose: prove each mechanism works before spending 7.5h of cluster time
# on a real search. Every check here runs in seconds; the failures it is
# designed to catch (a collinear probe scaffold, a 1e12 sentinel read as a
# real delta, an offset that never reaches the likelihood) each took two
# full runs to notice by hand.
#
# Covers:
#   A. train/future split on fixture_id  (label collision across seasons)
#   B. grouped probe: scaffolds build, no INCONCLUSIVE, deltas are real
#   C. hazard offset: logexp removed from design, offset reaches eta
#   D. free-coefficient recovery + nested LRT discrimination
#   E. alpha alpha-scale parse (no exp() overflow to inf)
#   F. search-gen / candidate-set sanity
set -u

PROJ_DIR=/mnt/hpccs01/home/ahernz/test_runs_tours/demand_/suncorp_telematics
SCRIPT_DIR=$PROJ_DIR/scripts
TEST_DIR=$PROJ_DIR/tests
RESULTS_DIR=$PROJ_DIR/results_tests
FIG_DIR=$PROJ_DIR/figures_tests

module purge
module load Anaconda3/2024.02-1
conda activate zigenv
module unload Anaconda3

export PYTHONWARNINGS="ignore::RuntimeWarning"
export OMP_NUM_THREADS=4
export OPENBLAS_NUM_THREADS=4
export MKL_NUM_THREADS=4
export JAX_PLATFORMS=cpu
export PYTHONIOENCODING=utf-8

cd "$SCRIPT_DIR"
mkdir -p "$RESULTS_DIR" "$FIG_DIR"

echo "=================================================================="
echo "T1 unit/integration tests started on $(hostname) at $(date)"
echo "=================================================================="
python - <<'PY'
import os, sys, importlib.util
from importlib.metadata import version
import metacountregressor as m
import metacountregressor.main_hpc as mh
print('package :', os.path.dirname(m.__file__))
print('version :', version('metacountregressor'))
src = open(mh.__file__, encoding='utf-8', errors='replace').read()
print('reject_summary present :', hasattr(mh.StructureEvaluator, 'reject_summary'))
print('variance barrier      :', '_variance_barrier' in src)
PY
echo

if [ ! -f "$TEST_DIR/test_session_fixes.py" ]; then
  echo "FATAL: missing $TEST_DIR/test_session_fixes.py"
  exit 1
fi

# The package on the cluster is pip-installed 1.0.165, which does NOT carry
# this session's main_hpc.py diagnostics (reject_summary). The test asserts
# the probe works regardless and reports the diagnostics as present/absent
# rather than failing, so T1 measures the SCRIPTS on the real package.
python -u "$TEST_DIR/test_session_fixes.py" 2>&1
RC=$?

echo
echo "=================================================================="
echo "T1 exit code: $RC"
echo "finished at $(date)"
echo "=================================================================="
exit $RC
