#!/bin/bash -l
#PBS -N safety_refit_val
#PBS -P FPAXJW8067
#PBS -l walltime=04:00:00
#PBS -l select=1:ncpus=8:mem=96GB
#PBS -j oe
#PBS -m n
cd $PBS_O_WORKDIR
source /mnt/hpccs01/home/ahernz/miniconda3/etc/profile.d/conda.sh
conda activate zigenv
export PIPELINE_SKIMS_PATH=../demand_/skims_371.omx
export STAGE5_ZONE_BRIDGE=1
export STAGE5_STRICT_ZONES=1
export STAGE5_REQUIRE_LOGSUM_VARIANCE=1
export JAX_PLATFORMS=cpu
export OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1

pick_arm () {
  local prefix="$1"
  local d
  for d in $(ls -dt runs/${prefix}__* 2>/dev/null); do
    if [ -f "$d/stage5_models.pkl" ] && { [ -f "$d/stage6_output.csv" ] || [ -f "$d/stage5_output.csv" ]; }; then
      echo "$d"
      return 0
    fi
  done
  return 1
}

BASE=$(pick_arm safety_baseline) || { echo "FATAL: no complete safety_baseline arm"; exit 2; }
NOSA=$(pick_arm safety_nosafety) || { echo "FATAL: no complete safety_nosafety arm"; exit 2; }
echo "[$(date)] M_S=$BASE"
echo "[$(date)] M_0=$NOSA"

python -u validate_safety_arms.py \
  --run-dir "$BASE" --m0-run-dir "$NOSA" \
  --out runs/safety_validation_refit \
  --split random --frac 0.30 --segments work,edu,nonmand \
  --skims ../demand_/skims_371.omx
RC1=$?
echo "[$(date)] validate_safety_arms exit=$RC1"

python -u safety_plan_impact.py \
  --baseline "$BASE" --nosafety "$NOSA" \
  --out runs/safety_plan_impact_refit
RC2=$?
echo "[$(date)] safety_plan_impact exit=$RC2"
if [ "$RC1" -ne 0 ] || [ "$RC2" -ne 0 ]; then exit 1; fi
