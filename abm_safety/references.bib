@article{Calastri2019Mode,
    title = {{Mode choice with latent availability and consideration: Theory and a case study}},
    author = {Calastri, Chiara and Hess, Stephane and Choudhury, Charisma and Daly, Andrew and Gabrielli, Lorenzo},
    journal = {Transportation Research Part B: Methodological},
    year = {2019},
    volume = {123},
    pages = {374--385},
    doi = {10.1016/j.trb.2017.06.016},
    abstract = {Over the last two decades, passively collected data sources, like GPS traces, have emerged as a very promising source for understanding travel behaviour. This paper addresses the data challenges by estimating a mode choice model with probabilistic availability and consideration, using a secondary dataset consisting of annotated GPS traces. Stated mode availability by part of the sample enabled the specification of an availability component, while the panel nature of the data and explicit incorporation of spatial and environmental factors enabled estimation of latent trip specific consideration sets. The model produces reasonable results, including meaningful value of travel time (VTT) measures.}
}

@article{Daly2020VTT,
    title = {{VTT or VTTS: a note on terminology for value of travel time work}},
    author = {Daly, Andrew and Hess, Stephane},
    journal = {Transportation},
    year = {2020},
    volume = {47},
    number = {3},
    pages = {1359--1364},
    doi = {10.1007/s11116-018-9966-4},
    abstract = {The value of travel time (VTT) can be said to be the most important number in transport economics. The addition of the word ``savings'' is incorrect, misleading and unhelpful. Unlike money, time cannot be stored or borrowed. The modelling approaches used for many of the more advanced VTT studies produce valuations bracketed between gains and losses in time, and an average between these gains and losses is then used as the VTT.}
}

@article{Haque2019ICMNL,
    title = {{Modelling residential location choices with implicit availability of alternatives}},
    author = {Haque, Md Bashirul and Choudhury, Charisma and Hess, Stephane},
    journal = {Journal of Transport and Land Use},
    year = {2019},
    volume = {12},
    number = {1},
    pages = {597--618},
    doi = {10.5198/jtlu.2019.1450},
    abstract = {Choice set generation is a challenging aspect of disaggregate level residential location choice modelling due to the large number of candidate alternatives. This study proposes an Improved Constrained Multinomial Logit Model (ICMNL) with a higher order formulation of the CMNL penalty term that does not depend on the number of alternatives in the choice set. The performance of the ICMNL model is evaluated in an empirical study of residential location choices in the Greater London Area.}
}

@article{Palma2021MDCEV,
    title = {{Modelling multiple occurrences of activities during a day: an extension of the MDCEV model}},
    author = {Palma, David and Enam, Annesha and Hess, Stephane and Calastri, Chiara and Crastes dit Sourd, Romain},
    journal = {Transportmetrica B: Transport Dynamics},
    year = {2021},
    volume = {9},
    number = {1},
    pages = {456--478},
    doi = {10.1080/21680566.2021.1900755},
    abstract = {The increased interest in time use among transport researchers has led to a search for flexible but tractable models of time use, such as Bhat's Multiple Discrete Continuous Extreme Value (MDCEV) model. MDCEV formulations typically model aggregate time allocation into different activity types during a given period. We propose a modified MDCEV model where an activity-episode, rather than an activity type, is the basic choice alternative, using a modified utility function to capture the reduced likelihood of individuals performing a very large number of episodes of the same activity. Results from two large revealed preference datasets exhibit equivalent forecast accuracy between the traditional and proposed approach at an aggregate level, but the latter also provides insights on the number and duration of activity-episodes with significant accuracy.}
}

@article{Calastri2017MDCNEV,
    title = {{Does the social context help with understanding and predicting the choice of activity type and duration? An application of the Multiple Discrete-Continuous Nested Extreme Value model to activity diary data}},
    author = {Calastri, Chiara and Hess, Stephane and Daly, Andrew and Carrasco, Juan Antonio},
    journal = {Transportation Research Part A: Policy and Practice},
    year = {2017},
    volume = {104},
    pages = {1--20},
    doi = {10.1016/j.tra.2017.07.003},
    abstract = {An understanding of activity choices and duration is a key requirement for better policy making, in transport and beyond. In this paper, the Multiple Discrete-Continuous Nested Extreme Value (MDCNEV) model is applied to the choice of activity type and duration over the course of two days, using data from the Chilean city of Concepci\'on. Different social network and social capital measures are found to be significantly correlated with the choice and duration of different activities. A forecasting exercise highlights the differences in substitution patterns from a standard MDCEV model.}
}

@article{Hess2026Significance,
    title = {{Statistical significance in choice modelling: computation, usage and reporting}},
    author = {Hess, Stephane and Daly, Andrew and Bliemer, Michiel and Guevara, Angelo and Daziano, Ricardo and Dekker, Thijs},
    journal = {Journal of Choice Modelling},
    year = {2026},
    volume = {60},
    pages = {100611},
    doi = {10.1016/j.jocm.2026.100611},
    abstract = {This paper offers a commentary on the use of notions of statistical significance in choice modelling. We argue that there is an over-reliance on 95\% confidence levels and misunderstandings of the meaning of significance. The paper stresses the importance of considering behavioural or policy significance in addition to statistical significance, and notes points specific to choice modelling including willingness-to-pay, random heterogeneity, and repeated choice data.}
}