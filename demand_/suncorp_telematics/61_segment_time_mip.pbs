#!/bin/bash -l
#PBS -N suncorp_segtime_mip
#PBS -l walltime=12:00:00
#PBS -l select=1:ncpus=4:mem=96GB
#PBS -j oe
#PBS -m abe
#PBS -r y

set -euo pipefail

# End-to-end chain:
#   58: build segment x 15-minute speeding panel (submitted separately)
#   59: search the temporal speeding model and predict future fixtures
#   60: solve the time-indexed MIP on exact segment midpoints

PROJ_DIR=/mnt/hpccs01/home/ahernz/test_runs_tours/demand_/suncorp_telematics
SCRIPT_DIR=$PROJ_DIR/scripts
DATA_DIR=$PROJ_DIR/data
RESULTS_DIR=$PROJ_DIR/results
FIG_DIR=$PROJ_DIR/figures

module purge
module load Anaconda3/2024.02-1
conda activate zigenv
module unload Anaconda3

export PYTHONWARNINGS="ignore::RuntimeWarning"
export OMP_NUM_THREADS=4
export OPENBLAS_NUM_THREADS=4
export MKL_NUM_THREADS=4
export JAX_PLATFORMS=cpu

cd "$SCRIPT_DIR"

python -m pip install --upgrade metacountregressor
python -c "from importlib.metadata import version; import metacountregressor as m; v=version('metacountregressor'); print('metacountregressor distribution:',v,'module:',getattr(m,'__version__','?'),'code:',m.__file__); t=tuple(int(x) for x in v.split('.')[:3]); assert t>=(1,0,159), v"

echo "=================================================================="
echo "Job $PBS_JOBID started on $(hostname) at $(date)"
echo "61: segment time search -> segment midpoint MIP"
echo "=================================================================="

[ -s "$RESULTS_DIR/segment_15min_panel.parquet" ] \
  || { echo "FATAL: missing segment_15min_panel.parquet; run 58 first"; exit 1; }
[ -s "$DATA_DIR/fixture_calendar.csv" ] \
  || { echo "FATAL: missing fixture_calendar.csv"; exit 1; }
[ -s "$DATA_DIR/osm_roads_suncorp.geojson" ] \
  || { echo "FATAL: missing osm_roads_suncorp.geojson"; exit 1; }

SEARCH_ARGS=(
  --search-iters 40 --search-chunk 20 --chunk-time 7200
  --wall-budget 20000 --n-starts 1
  --search-R 25 --refit-R 100 --search-vars slim
  --target trips_mean_gt_10 --group-by event
  --two-stage on --temporal-refit ar1
)
# BAYES=on ships the approximate-Bayes posterior mean (Laplace) instead of
# the plug-in two-stage, and records both surfaces' holdout metrics. Off by
# default so the A/B is explicit: qsub -v BAYES=on 61_segment_time_mip.pbs
[ "${BAYES:-off}" = "on" ] && SEARCH_ARGS+=(--bayes on)
# --group-by event: per-event split — each fixture gets its own grouped
# coefficients, shrunk toward game-attribute-driven means (fxt_*/ko_* already
# eligible as heterogeneity drivers), so unseen future events predict from
# attributes. Supersedes the latent-class idea: classes are observed.
# NOTE 2: --search-iters 40, not 140: SEARCH_GEN=3 adds 8 wide vars
# (dim 69->85, ~11 min/iter), so a fresh search needs ~7.5h for 40 iters;
# refit + AR stage + predict + MIP take the rest inside 12h. The search is
# resumable — later runs continue from this checkpoint. The quality gate
# below guarantees the MIP runs even if the search is still partial.
# NOTE: --no-de-warm/--no-slsqp deliberately NOT passed. The cold
# LBFGS-only refit diverges on the 9-term forced-game spec (max|b|~1e5,
# wasting hours before the warm retry saves it); DE warm-start + SLSQP
# converges first try at N*R=10M (auto memory guard trips only above 12M,
# RSS ~30GB << 96GB). --search-iters 140 (not 160): checkpoint is at 136,
# so 4 iters finish the search and leave ~10h for refit+predict+MIP.
[ -s "$RESULTS_DIR/game_day_search_best.json" ] && SEARCH_ARGS+=(--resume)

echo "[61/1] searching temporal segment speeding model and predicting future games..."
python -u 59_game_day_search_predict.py "${SEARCH_ARGS[@]}" 2>&1

for f in game_day_pred_15min.parquet game_day_holdout_metrics.json \
         game_day_search_best.json; do
  [ -s "$RESULTS_DIR/$f" ] || { echo "FATAL: missing search output $f"; exit 1; }
done

# Quality-before-MIP gate: refuse rosters only when predictions are unusable.
# Iter-count alone is the wrong test (a 136/160 search already yields slope
# 1.44 / top20 0.38). Proceed when converged OR holdout quality passes;
# refuse only when the surface is demonstrably garbage or missing.
# Set REQUIRE_CONVERGED=1 to restore the strict iters-only refusal.
python - "$RESULTS_DIR/game_day_search_best.json" "$RESULTS_DIR/game_day_holdout_metrics.json" <<'EOF'
import json, os, sys
d = json.load(open(sys.argv[1]))
done, total = int(d.get("iters_completed", 0)), int(d.get("iters", 0))
converged = total > 0 and done >= total
allow_weak = os.environ.get("ALLOW_WEAK_SURFACE") == "1"
ok_quality = False
handoff_ok = False
try:
    full = json.load(open(sys.argv[2]))
    m = full.get("metrics") or {}
    a = full.get("audit") or {}
    slope = float(m.get("calibration_slope", float("nan")))
    top20 = float(m.get("segment_top20", 0.0) or 0.0)
    rmse = float(m.get("rmse", float("inf")))
    ok_quality = (0.2 <= slope <= 5.0) and (top20 >= 0.05) and (rmse < 10.0)
    h = a.get("handoff") or {}
    handoff_ok = bool(h.get("pass"))
    ts = a.get("two_stage") or {}
    print(f"holdout quality: slope={slope:.3f} top20={top20:.3f} rmse={rmse:.3f}")
    print("handoff: pass=%s pearson_min=%s jaccard_top20=%s "
          "coverage_top20=%s" % (h.get("pass"), h.get("pearson_min"),
                                 h.get("top20_jaccard"),
                                 h.get("top20_coverage_mean")))
    print(f"two-stage: shipped={ts.get('shipped')} "
          f"denominator={ts.get('denominator')}")
except Exception as exc:
    print(f"WARN: no readable holdout metrics ({exc})")
print(f"search: {done}/{total} converged={converged}")
if not handoff_ok and not allow_weak:
    print("FATAL: handoff gate failed (positive per-fixture ranking / "
          "game-specific plan / calibration); refusing MIP. "
          "Set ALLOW_WEAK_SURFACE=1 to override.")
    sys.exit(1)
if converged or ok_quality:
    print("GATE PASS: solving MIP" + (" (on partial search, quality-verified)" if not converged else ""))
elif os.environ.get("REQUIRE_CONVERGED") == "1":
    print(f"FATAL: REQUIRE_CONVERGED=1 and search partial ({done}/{total})")
    sys.exit(1)
else:
    print(f"FATAL: search partial ({done}/{total}) AND predictions unusable; refusing MIP. Resubmit 61 to resume.")
    sys.exit(1)
EOF
[ $? -ne 0 ] && exit 1

echo "[61/2] solving time-indexed segment-midpoint MIP..."
python -u 60_game_day_mip.py \
  --min-marg 0.5 --max-segments 250 --squads all \
  --travel-speed-kmh 43.2 --detour-factor 1.3 \
  --setup-min 5 --max-travel-m 4000 --obs-m 100 2>&1

for f in game_day_mip_sites.csv game_day_mip_plans.csv \
         game_day_mip_schedule.csv game_day_mip_summary.json \
         game_day_mip.tex; do
  [ -s "$RESULTS_DIR/$f" ] || { echo "FATAL: missing MIP output $f"; exit 1; }
done

for f in game_day_search_convergence.png game_day_calibration.png \
         game_day_surfaces.png game_day_coefs.png \
         game_day_mip_map.png game_day_mip_schedules.png \
         game_day_mip_coverage.png game_day_mip_summary.png; do
  [ -s "$FIG_DIR/$f" ] || echo "WARN: missing figure $f"
done

echo "=================================================================="
echo "61 OK: future segment-time predictions and segment-based temporal MIP"
echo "Job finished at $(date)"
echo "=================================================================="