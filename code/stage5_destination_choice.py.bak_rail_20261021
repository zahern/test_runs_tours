    "c_power_rel_da":      ("emp.power_reliability_acc",  {"DA": None}),
    "c_power_rel_sr":      ("emp.power_reliability_acc",  {"SR": None}),
    "c_power_rel_transit": ("emp.power_reliability_acc",  {"Transit": None}),
