#!/bin/bash -l
#PBS -N suncorp_dashboard
#PBS -l walltime=02:00:00
#PBS -l select=1:ncpus=4:mem=32GB
#PBS -j oe
#PBS -m abe
#PBS -r y

# ══════════════════════════════════════════════════════════════════════════════
# Job 5: Interactive time-based risk dashboard (22_build_dashboard.py)
# Builds a self-contained HTML dashboard from the timewise EB outputs (Job 4).
# Depends on Job 4 (eb_timewise_hourly.csv, eb_timewise_segment_phase.csv).
# ══════════════════════════════════════════════════════════════════════════════

PROJ_DIR=/mnt/hpccs01/home/ahernz/test_runs_tours/demand_/suncorp_telematics
SCRIPT_DIR=$PROJ_DIR/scripts
DATA_DIR=$PROJ_DIR/data
RESULTS_DIR=$PROJ_DIR/results
FIG_DIR=$PROJ_DIR/figures

module purge
module load Anaconda3/2024.02-1
conda activate zigenv
module unload Anaconda3

for pkg in geopandas shapely pandas numpy; do
    python -c "import ${pkg%%-*}" 2>/dev/null || pip install --upgrade $pkg
done

export PYTHONWARNINGS="ignore::RuntimeWarning"
export OMP_NUM_THREADS=4

cd "$SCRIPT_DIR"

echo "════════════════════════════════════════════════════════════════════════════"
echo "Job $PBS_JOBID started on $(hostname) at $(date)"
echo "════════════════════════════════════════════════════════════════════════════"

for f in eb_timewise_hourly.csv eb_timewise_hourly_control.csv eb_timewise_segment_phase.csv; do
    if [ ! -f "$RESULTS_DIR/$f" ]; then
        echo "ERROR: $f missing (run 04_eb_timewise.pbs first)"
        exit 1
    fi
done

sed -i "s|^PROJ = .*|PROJ = \"$PROJ_DIR\"|g" 22_build_dashboard.py

echo ""
echo "Running 22_build_dashboard.py..."
python -u 22_build_dashboard.py 2>&1
EXIT_CODE=$?

if [ -f "$FIG_DIR/risk_dashboard.html" ]; then
    echo "OK dashboard created"
else
    echo "Dashboard HTML missing"
    EXIT_CODE=1
fi

echo "════════════════════════════════════════════════════════════════════════════"
echo "Job finished at $(date) — exit_code=$EXIT_CODE"
echo "════════════════════════════════════════════════════════════════════════════"
exit $EXIT_CODE
