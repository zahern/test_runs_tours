#!/bin/bash -l
#PBS -N suncorp_sd_fbstack
#PBS -l walltime=00:30:00
#PBS -l select=1:ncpus=2:mem=8GB
#PBS -j oe
#PBS -m abe
#PBS -r y

set -euo pipefail

PROJ_DIR=/mnt/hpccs01/home/ahernz/test_runs_tours/demand_/suncorp_telematics

module purge
module load Anaconda3/2024.02-1
conda activate zigenv
module unload Anaconda3

export PYTHONWARNINGS="ignore::RuntimeWarning"
export OMP_NUM_THREADS=2

cd "$PROJ_DIR/scripts"
# OVERRIDE RUN (human directive 2026-10-16): the stage-1 guard returned
# no_gain; the decision-maker elected to deploy the SD-feedback surface
# anyway. --override writes game_day_pred_15min_sdfb.parquet regardless of
# the guard and records the contrary evidence in the report. lam=0.0 is the
# full SD swap (base + sd_lift), the arm the guard evaluated.
python -u 66_sd_feedback_stack.py --override --override-lam 0.0 2>&1
echo "sd feedback stack done at $(date)"
