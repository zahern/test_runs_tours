#!/bin/bash -l
#PBS -N suncorp_gameday_mip_sdfb
#PBS -l walltime=03:00:00
#PBS -l select=1:ncpus=8:mem=64GB
#PBS -j oe
#PBS -m abe
#PBS -r y

# Refuse to run outside PBS: keep all compute off the login/head node.
if [ -z "${PBS_JOBID:-}" ] && [ "${ALLOW_HEAD_NODE:-0}" != "1" ]; then
  echo "$(basename "$0"): PBS batch script; refusing to run on $(hostname). Submit with qsub." >&2
  exit 2
fi

set -euo pipefail

# Job 60c: police site-selection MIP on the SD-feedback surface
# (game_day_pred_15min_sdfb.parquet, column pred_speeding_sdfb).
#
# OVERRIDE ARM: the stage-1 guard returned no_gain (see
# results/sd_feedback_stack_report.json, decision="override"). This arm
# exists because a human decision-maker elected to deploy the SD-feedback
# surface despite the holdout evidence; the contrary evidence is recorded
# in the report and in results/sd_feedback_diagnostics.json. It writes only
# to results/mip_sdfb and figures/mip_sdfb -- the shipped MIP outputs are
# untouched.

PROJ_DIR=/mnt/hpccs01/home/ahernz/test_runs_tours/demand_/suncorp_telematics
SCRIPT_DIR=$PROJ_DIR/scripts
RESULTS_DIR=$PROJ_DIR/results
FIG_DIR=$PROJ_DIR/figures

module purge
module load Anaconda3/2024.02-1
conda activate zigenv
module unload Anaconda3

export PYTHONWARNINGS="ignore::RuntimeWarning"
export OMP_NUM_THREADS=8
export OPENBLAS_NUM_THREADS=8
export MKL_NUM_THREADS=8

cd "$SCRIPT_DIR"

echo "=================================================================="
echo "Job $PBS_JOBID started on $(hostname) at $(date)"
echo "60c: game-day MIP on the SD-feedback surface (override arm)"
echo "=================================================================="

[ -s "$RESULTS_DIR/game_day_pred_15min_sdfb.parquet" ] \
  || { echo "FATAL: missing results/game_day_pred_15min_sdfb.parquet (run 66 --override first)"; exit 1; }
[ -s "$PROJ_DIR/data/osm_roads_suncorp.geojson" ] \
  || { echo "FATAL: missing data/osm_roads_suncorp.geojson (segment midpoints)"; exit 1; }

python -u 60_game_day_mip.py \
  --pred "$RESULTS_DIR/game_day_pred_15min_sdfb.parquet" \
  --pred-col pred_speeding_sdfb \
  --out-dir "$RESULTS_DIR/mip_sdfb" \
  --fig-dir "$FIG_DIR/mip_sdfb" \
  --min-marg 0.5 --max-segments 250 \
  --chunk-m 150 --max-chunks-per-road 3 \
  --travel-speed-kmh 43.2 --detour-factor 1.3 \
  --setup-min 5 --max-travel-m 4000 2>&1

for f in game_day_mip_sites.csv game_day_mip_plans.csv game_day_mip_summary.json \
         game_day_mip_schedule.csv game_day_mip.tex; do
  [ -s "$RESULTS_DIR/mip_sdfb/$f" ] || { echo "FATAL: 60c missing $f"; exit 1; }
done
for f in game_day_mip_map.png game_day_mip_schedules.png \
         game_day_mip_coverage.png game_day_mip_summary.png; do
  [ -s "$FIG_DIR/mip_sdfb/$f" ] || echo "WARN: missing figure $f"
done

echo "60c OK (override arm)"
echo "Job finished at $(date)"
