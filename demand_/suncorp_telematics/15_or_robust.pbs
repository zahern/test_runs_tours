#!/bin/bash -l
#PBS -N suncorp_or_layer
#PBS -l walltime=02:00:00
#PBS -l select=1:ncpus=4:mem=32GB
#PBS -j oe
#PBS -m abe
#PBS -r y

# ======================================================================
# OR layer: P7 robust staffing + P8 two-stage stochastic roster + VNS
# matheuristic vs exact P5 (Burdett & Corry 2026 framing).
# Paper inputs: results/robust_stochastic.tex, figures/robust_tau.png
# Submit: cd $PROJ_DIR && qsub 15_or_robust.pbs
# ======================================================================

PROJ_DIR=/mnt/hpccs01/home/ahernz/test_runs_tours/demand_/suncorp_telematics
SCRIPT_DIR=$PROJ_DIR/scripts
RESULTS_DIR=$PROJ_DIR/results

module purge
module load Anaconda3/2024.02-1
conda activate zigenv
module unload Anaconda3

export PROJ="$PROJ_DIR"
export PYTHONWARNINGS="ignore::RuntimeWarning"
export OMP_NUM_THREADS=8
export OPENBLAS_NUM_THREADS=8
export MKL_NUM_THREADS=8

cd "$SCRIPT_DIR"

echo "=================================================================="
echo "Job $PBS_JOBID started on $(hostname) at $(date)"
echo "=================================================================="

if [ ! -s "$RESULTS_DIR/surfaces.npz" ]; then
  echo "FATAL: surfaces.npz missing - run the deployment rebuild first."
  exit 1
fi
echo "Inputs OK."

python -u 45_robust_stochastic.py --squad 5 2>&1
EXIT_CODE=$?
if [ $EXIT_CODE -ne 0 ] || [ ! -s "$RESULTS_DIR/robust_stochastic_audit.json" ]; then
  echo "FATAL: OR layer failed (exit=$EXIT_CODE)"
  exit 1
fi

python - "$RESULTS_DIR/robust_stochastic_audit.json" <<'EOF'
import json, os
base = "/mnt/hpccs01/home/ahernz/test_runs_tours/demand_/suncorp_telematics"
a = json.load(open(f"{base}/results/robust_stochastic_audit.json"))
assert a["p7"] and a["p8"]["exp_cov"] > 0 and a["vns"]["gap_pct"] < 5.0
for f in ["results/robust_stochastic.tex", "figures/robust_tau.png"]:
    assert os.path.getsize(f"{base}/{f}") > 0, f"missing {f}"
print(f"OK: P7 tau=0.50 covers {a['p7'][2]['fixtures_covered']}/{a['p7'][2]['of']}")
print(f"OK: VSS={a['p8']['vss']:+.4f} EVPI={a['p8']['evpi']:+.4f}")
print(f"OK: VNS gap={a['vns']['gap_pct']:.2f}%")
EOF
EXIT_CODE=$?

echo "=================================================================="
echo "Job finished at $(date) - exit_code=$EXIT_CODE"
echo "=================================================================="
exit $EXIT_CODE
